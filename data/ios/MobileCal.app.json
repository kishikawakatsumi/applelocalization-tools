    "NSContactsUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Der Kalender kann deine Kontakte verwenden, um Personen zu Ereignissen einzuladen, Geburtstage anzuzeigen und standortsbezogene Suchen zu verbessern."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "היישום ״לוח שנה״ משתמש באנשי הקשר שלך כדי להזמין אנשים לאירועים, להציג ימי הולדת ולשפר חיפושים מבוססי-מיקום."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "يمكن أن يستخدم التقويم جهات اتصالك لدعوة الأشخاص إلى الأحداث وعرض تواريخ الميلاد وتحسين عمليات البحث عن الموقع."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Το Ημερολόγιο μπορεί να χρησιμοποιήσει τις επαφές σας για πρόσκληση ατόμων σε γεγονότα, εμφάνιση γενεθλίων και βελτίωση αναζητήσεων τοποθεσίας."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "“カレンダー”でイベントへの参加を依頼したり、誕生日を表示したり、より正確な場所検索を行うために、“連絡先”が使用されます。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Calendar can use your contacts to invite people to events, display birthdays, and improve location searches."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Календар може використовувати ваші контакти для запрошення людей на події, показу днів народження та покращення пошуку геопозицій."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Calendario puede usar tus contactos para enviar invitaciones a eventos, mostrar los cumpleaños y mejorar las búsquedas de ubicaciones."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "O Calendário pode usar os seus contactos para convidar pessoas para eventos, mostrar datas de nascimento e melhorar pesquisas de localização."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "La app Calendario utiliza tus contactos para enviar invitaciones a eventos, mostrar cumpleaños y mejorar la búsqueda de ubicaciones."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Kalender kan bruge dine kontakter til at invitere personer til begivenheder, vise fødselsdage og forbedre lokalitetssøgninger."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "L'app Calendario può utilizzare i contatti per invitare persone agli eventi, mostrare i compleanni e migliorare le ricerche basate sulla posizione."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Kalendár môže používať vaše kontakty na pozývanie ľudí na udalosti, zobrazovanie narodenín a zlepšovanie vyhľadávaní polohy."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "“日历”可使用您的通讯录信息邀请联系人参加日程、显示生日以及改进位置搜索。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Kalendar boleh menggunakan kenalan anda untuk menjemput orang ke peristiwa, memaparkan hari lahir dan meningkatkan carian lokasi."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Kalender kan använda dina kontakter till att bjuda in personer till aktiviteter, visa födelsedagar och förbättra platssökningar."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Calendar can use your contacts to invite people to events, display birthdays and improve location searches."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Aplikace Kalendář využívá vaše kontakty při zvaní účastníků událostí a zobrazování narozenin a také k vylepšení výsledků hledání míst."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "캘린더 앱이 이벤트에 사람을 초대하고, 생일을 표시하고, 위치 검색을 향상하는 데 연락처를 사용할 수 있습니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Kalender kan bruke kontaktene dine til å invitere personer til hendelser, vise bursdager og forbedre stedssøk."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A Naptár felhasználhatja az Ön kontaktjait emberek eseményekre való meghívására, születésnapok megjelenítésére és a helyalapú keresések javítására."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Takvim; kişileri etkinliklere davet etmek, doğum günlerini görüntülemek ve konum aramalarını iyileştirmek için kişilerinizi kullanabilir."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Kalendarz może używać Twoich kontaktów do zapraszania osób na wydarzenia, powiadamiania o urodzinach oraz udoskonalania wyszukiwań lokalnych."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "L’app Calendrier peut se servir de Contacts pour inviter des personnes à des événements, afficher des fêtes et améliorer les recherches de lieux."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Lịch có thể sử dụng danh bạ của bạn để mời người vào sự kiện, hiển thị sinh nhật và cải thiện các tìm kiếm vị trí."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Календарь может использовать Ваши контакты для рассылки приглашений на события, отображения дней рождения и более точного поиска на основе геопозиции."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Calendar can use your contacts to invite people to events, display birthdays and improve location searches."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "L’app Calendrier peut utiliser vos contacts pour inviter des personnes à vos évènements, afficher les anniversaires et améliorer vos recherches géographiques."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Kalenteri voi käyttää yhteystietojasi käyttäjien kutsumiseen tapahtumiin, syntymäpäivien näyttämiseen sekä parantamaan sijaintihakuja."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Kalender dapat menggunakan kontak Anda untuk mengundang orang ke acara, menampilkan ulang tahun, dan meningkatkan pencarian lokasi."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "De Agenda-app kan je contacten gebruiken om personen uit te nodigen voor activiteiten, verjaardagen weer te geven en het zoeken naar locaties te verbeteren."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "ปฏิทินสามารถใช้รายชื่อของคุณเพื่อเชิญผู้คนเข้าร่วมกิจกรรม แสดงวันเกิด และปรับปรุงการค้นหาตามตำแหน่งที่ตั้งได้"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt",
        "target": "O Calendário pode usar os seus contatos para convidar pessoas para eventos, exibir aniversários e melhorar buscas de localizações."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Aplicația Calendar poate utiliza contactele dvs. pentru invitarea persoanelor la evenimente, afișarea zilelor de naștere și îmbunătățirea căutării locurilor."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "「日曆」可使用你的通訊錄以邀請聯絡人參與行程、顯示生日和改進位置搜尋。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Aplikacija Kalendar može koristiti vaše kontakte za pozivanje osoba na događaje, prikazivanje rođendana i poboljšanje pretraživanja lokacija."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "कैलेंडर आपके संपर्कों का उपयोग लोगों को इवेंट में आमंत्रित करने, जन्मदिन दिखाने और स्थान खोज को बेहतर बनाने के लिए कर सकता है।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "L’app Calendari pot fer servir els contactes per convidar persones als esdeveniments, mostrar aniversaris i millorar les cerques d’ubicacions."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "「行事曆」可使用您的聯絡人來邀請他們加入行程、顯示生日和改進位置搜尋結果。"
      }
    ],
