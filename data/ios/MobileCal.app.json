    "NSLocationWhenInUseUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Dein Standort wird für Hinweise zum Aufbrechen verwendet, um ortsbezogene Suchen zu optimieren und Standorte für zukünftige Ereignisse vorzuschlagen."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "נתוני המיקום שלך ישמשו לקביעת הגדרות שעת יציאה, לשיפור חיפושי מקומות ולהצעת מקומות לאירועים."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "يُستخدم موقعك لتنبيهات وقت المغادرة، ولتحسين عمليات البحث عن الموقع، ولاقتراح مواقع للحدث في المستقبل."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Η τοποθεσία σας χρησιμοποιείται για ειδοποιήσεις ώρας αναχώρησης, βελτίωση των αναζητήσεων τοποθεσίας και προτάσεις τοποθεσιών γεγονότων."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "位置情報は、出発時刻の通知、場所検索の改善、およびイベントの場所の提案に使用されます。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Your location is used for time to leave alerts, to improve location searches, and to suggest event locations."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Ваша геопозиція використовується для надання сповіщень «Час вирушати», удосконалення пошуку місць і пропонування розташувань для подій."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Tu ubicación se utiliza para notificar la hora a la que debes salir, mejorar las búsquedas de ubicación y sugerir ubicaciones de eventos futuros."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "A sua localização é usada para os avisos da hora de sair, para melhorar as pesquisas de localização e para sugerir locais para eventos."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Tu ubicación se usa para definir los avisos de hora de salida, mejorar las búsquedas de ubicación y sugerir las ubicaciones de los eventos."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Din lokalitet bruges til advarsler om, hvornår det er tid til at tage afsted og til at forbedre lokalitetssøgninger og foreslå lokaliteter for begivenheder."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "La tua posizione viene utilizzata per avvisarti quando è il momento migliore per uscire, per migliorare le ricerche basate sulla posizione e suggerirti luoghi degli eventi futuri."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Vaša poloha sa používa na zobrazovanie upozornení, že je čas vyraziť, vylepšovanie vyhľadávaní polohy a navrhovanie miest pre udalosti."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "您的位置会用于出发时间提醒、改进位置搜索以及建议日程地点。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Lokasi anda digunakan bagi isyarat masa untuk bertolak, untuk meningkatkan carian lokasi dan mencadangkan lokasi peristiwa."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Din plats används till att beräkna meddelanden om att det är dags att lämna platsen, förbättra platssökningar och föreslå platser för aktiviteter."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Your location is used for time to leave alerts, to improve location searches and to suggest event locations."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Vaše poloha se používá k zobrazování upozornění, že je potřeba vydat se na cestu, k zlepšování polohově závislých hledání a doporučování míst událostí."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "사용자의 위치는 출발 시간 알림을 보내고, 위치 검색을 향상하며, 이벤트 위치를 제안하는 데 사용됩니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Posisjonen din brukes for å gi varsler om avreisetidspunkt, forbedre stedssøk og foreslå steder for hendelser."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A helyzete az indulási időkre való figyelmeztetéshez, a helyalapú keresések javításához és eseményhelyek javasolásához van felhasználva."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Konumunuz; konum aramalarını iyileştirmek ve etkinlik konumlarını önermek ve ayrılma uyarıları için kullanılır."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Twoje położenie służy do generowania alertów funkcji Czas ruszać, udoskonalania wyszukiwań lokalnych oraz sugerowania miejsc wydarzeń."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Votre position est utilisée pour les alertes d’heure de départ, pour améliorer les recherches de lieux et pour suggérer des lieux d’événement."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Vị trí của bạn được sử dụng cho cảnh báo giờ đi, để cải thiện tìm kiếm vị trí và để gợi ý địa điểm sự kiện."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Ваша геопозиция используется для напоминаний о времени убытия, для улучшения услуг поиска на основе геопозиции и предложения будущих геопозиций."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Your location is used for time to leave alerts, to improve location searches and to suggest event locations."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Votre position est utilisée pour vous envoyer des alertes vous indiquant quand partir, améliorer vos recherches géographiques et vous suggérer des lieux pour vos évènements."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Sijaintiasi käytetään aika lähteä -hälytyksille, parantamaan sijaintihakuja ja ehdottamaan tapahtumien sijainteja."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Lokasi Anda digunakan untuk peringatan waktunya pergi, untuk meningkatkan pencarian lokasi, dan untuk menyarankan lokasi acara."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Je locatie wordt gebruikt voor meldingen wanneer het tijd is om te vertrekken, om het zoeken naar locaties te verbeteren en om locaties voor activiteiten voor te stellen."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "ตำแหน่งที่ตั้งของคุณถูกใช้สำหรับการเตือนเวลาที่ต้องออกเดินทาง ปรับปรุงผลการค้นหาสถานที่ และแนะนำสถานที่ของกิจกรรม"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt",
        "target": "Sua localização é usada para alertas da hora de sair, melhorar buscas de localização e sugerir localizações de eventos."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Localizarea dvs. este utilizată pentru alertele despre ora de plecare, îmbunătățirea căutării locurilor și sugerarea locurilor evenimentelor."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "你的位置會用於出發時間提示、改進地點搜尋和建議行程地點。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Vaša lokacija koristi se za podsjetnike za vrijeme odlaska, poboljšanje pretraživanja lokacija i predlaganje lokacija događaja."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "आपके स्थान का उपयोग निकलने के समय के अलर्ट, स्थान खोज में सुधार करने और इवेंट के स्थान सुझाने के लिए किया जाता है।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "La teva ubicació s’utilitza per avisar‑te quan has de marxar, per millorar les cerques d’ubicacions i per suggerir‑te ubicacions per celebrar esdeveniments."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "您的位置會用於提示時間提示，改進地點搜尋結果和建議行程地點。"
      }
    ],
