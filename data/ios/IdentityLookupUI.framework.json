    "%@_HAS_BLOCKED_%@_MESSAGE": [
      {
        "filename": "IdentityLookupUI.strings",
        "language": "de",
        "target": "%@ hat %@ blockiert. Öffne die Einstellungen, um die Blockierung von Telefonnummern aufzuheben."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "he",
        "target": "מספר הטלפון של %2$@ נחסם על-ידי %1$@. ניתן לבטל חסימת מספרי טלפון דרך ״הגדרות״"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ar",
        "target": "قام(ت) %@ بحظر %@. الرجاء الانتقال إلى الإعدادات لإلغاء حظر أرقام الهاتف"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "el",
        "target": "Αποκλείστηκε το %@ από «%@». Μεταβείτε στις Ρυθμίσεις για να καταργήσετε τον αποκλεισμό αριθμών τηλεφώνου"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ja",
        "target": "%@によって%@がブロックされています。“設定”に移動して電話番号のブロックを解除してください"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "en",
        "target": "%@ has blocked %@. Please visit Settings to unblock phone numbers"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "uk",
        "target": "%@ блокує %@. Перейдіть у Параметри, що розблокувати телефонні номери"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "es_419",
        "target": "%2$@ bloqueó a %1$@. Ve a Configuración para desbloquear números de teléfono."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "pt_PT",
        "target": "%@ bloqueou %@. Nas Definições pode desbloquear números de telefone"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "es",
        "target": "%@ ha bloqueado el número %@. Ve a Ajustes para desbloquear números de teléfono"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "da",
        "target": "%@ har blokeret %@. Åbn Indstillinger for at ophæve blokering af telefonnumre"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "it",
        "target": "%@ ha bloccato %@. Vai in Impostazioni per sbloccare i numeri di telefono"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "sk",
        "target": "%@ blokuje „%@“. Telefónne čísla môžete odblokovať v Nastaveniach"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "zh_CN",
        "target": "%@屏蔽了%@。请访问“设置”以取消屏蔽电话号码"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ms",
        "target": "%@ telah menyekat %@. Sila lawati Seting untuk menyahsekat nombor telefon"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "sv",
        "target": "%@ har blockerat %@. Gå till Inställningar om du vill ta bort blockeringen av telefonnummer"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "en_AU",
        "target": "%@ has blocked %@. Please visit Settings to unblock phone numbers"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "cs",
        "target": "%@ blokuje „%@“. Telefonní čísla můžete odblokovat v Nastavení"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ko",
        "target": "%@이(가) %@을(를) 차단했습니다. 전화번호를 차단 해제하려면 설정으로 이동하십시오."
