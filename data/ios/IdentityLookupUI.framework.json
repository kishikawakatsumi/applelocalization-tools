        "filename": "IdentityLookupUI.strings",
        "language": "no",
        "target": "%@ har blokkert %@. Nummerblokkeringer kan fjernes i Innstillinger."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "hu",
        "target": "A(z) %@ letiltotta a következőt: %@. Kérjük, nyissa meg a Beállításokat a telefonszámok feloldásához."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "tr",
        "target": "%1$@, %2$@ tarafından engellendi. Telefon numaralarının engelini kaldırmak için lütfen Ayarlar’a gidin"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "pl",
        "target": "Numer %2$@ został zablokowany przez: %1$@. Aby odblokować numery telefoniczne, przejdź do Ustawień."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "fr_CA",
        "target": "%@ a bloqué %@. Accédez à Réglages pour débloquer des numéros de téléphone."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "vi",
        "target": "%@ đã chặn %@. Vui lòng truy cập Cài đặt để bỏ chặn các số điện thoại"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ru",
        "target": "%@ заблокировал(а) %@. Разблокировать номера телефонов можно в Настройках."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "en_GB",
        "target": "%@ has blocked %@. Please visit Settings to unblock phone numbers"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "fr",
        "target": "%@ a bloqué le %@. Accédez à Réglages pour débloquer des numéros de téléphone."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "fi",
        "target": "%2$@ on estetty (%1$@). Poista puhelinnumeroiden estot Asetuksissa."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "id",
        "target": "%@ telah memblokir %@. Kunjungi Pengaturan untuk membuka blokir nomor telepon"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "nl",
        "target": "%@ heeft %@ geblokkeerd. Ga naar Instellingen om telefoonnummers te deblokkeren."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "th",
        "target": "%@ ได้ปิดกั้น %@ โปรดไปที่การตั้งค่าเพื่อเลิกปิดกั้นเบอร์โทรศัพท์"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "pt",
        "target": "%@ bloqueou %@. Visite os Ajustes para desbloquear números de telefone"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ro",
        "target": "%@ a blocat %@. Deblocați numerele de telefon în Configurări."
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "zh_HK",
        "target": "%@已封鎖%@。請前往「設定」解除封鎖電話號碼"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "hr",
        "target": "Korisnik %@ blokirao je %@. Telefonske brojeve možete odblokirati u Postavkama"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "hi",
        "target": "%@ ने %@ को ब्लॉक किया है। फ़ोन नंबर अनब्लॉक करने के लिए कृपया सेटिंग्ज़ में जाएँ"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "ca",
        "target": "%@ ha bloquejat el número %@. Ves a la configuració per desbloquejar números de telèfon"
      },
      {
        "filename": "IdentityLookupUI.strings",
        "language": "zh_TW",
        "target": "%@已封鎖%@。請參訪「設定」來解除封鎖電話號碼。"
