    "NSUserNotificationsUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Du wirst per Mitteilungen benachrichtigt, wenn deine Erinnerungen fällig sind."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "עדכונים מיידעים אותך לגבי תאריכי יעד של תזכורות."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "تُعلِمك الإشعارات عندما يحين موعد تذكيراتك."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Οι γνωστοποιήσεις σάς ενημερώνουν όταν οι υπομνήσεις σας λήγουν."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "リマインダーの期限が来たとき、通知でお知らせします。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Notifications let you know when your reminders are due."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Сповіщення інформують, коли надходить час виконання нагадування."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Las notificaciones te avisarán cuando tus recordatorios hayan vencido."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "As notificações avisam quando é a data limite dos lembretes."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Las notificaciones te avisan cuando vencen tus recordatorios."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Notifikationer fortæller dig, når dine påmindelser forfalder."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "Le notifiche ti avvisano quando i promemoria sono in scadenza."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Hlásenia vás upozornia na blížiace sa termíny pripomienok."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "通知可在提醒事项到期时提醒您。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Pemberitahuan memberitahu anda apabila peringatan anda dijangka."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Notiser meddelar när dina påminnelser ska vara avklarade."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Notifications let you know when your reminders are due."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Oznámení vás upozorní na termíny připomínek."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "미리 알림의 마감이 다가오면 알림을 받을 수 있습니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Påminnelser bruker varslinger til å minne deg på tidsfrister."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "Az értesítések tájékoztatják, amikor az emlékeztetői esedékesek."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Bildirimler, anımsatıcılarınızın zamanının geldiğini bildirir."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Powiadomienia informują o przypomnieniach ze zbliżającym się terminem."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Les notifications vous indiquent quand vos rappels expirent."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Thông báo cho bạn biết khi lời nhắc của bạn đến hạn."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Благодаря уведомлениям Вы будете вовремя получать свои напоминания."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Notifications let you know when your reminders are due."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Les notifications vous préviennent quand vos rappels arrivent à échéance."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Sinulle ilmoitetaan, kun muistutuksilla on määräaika."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Pemberitahuan memberi tahu Anda saat pengingat tenggat."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Dankzij meldingen weet je wanneer je herinneringen vervallen."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "การแจ้งเตือนช่วยให้คุณทราบเมื่อเตือนความจำของคุณถึงกำหนด"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt",
        "target": "As notificações informam o prazo dos seus lembretes."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Notificările vă informează când aveți mementouri scadente."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "「通知」可在提醒事項到期時通知你。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Obavijesti vas obavještavaju o isteku podsjetnika."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "रिमाइंडर देय होने पर सूचनाएँ आपको उनके बारे में बताती हैं।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "Les notificacions t’avisen del venciment dels recordatoris."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "「通知」可在提醒事項到期時讓您知道。"
      }
    ]
