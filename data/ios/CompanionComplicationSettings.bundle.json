    "NANO_COMPLICATION_NO_COMPLICATIONS": [
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "de",
        "target": "Auf deiner Apple Watch wurden noch keine Apps mit Zifferblattkomplikationen installiert."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "he",
        "target": "אין לך עדיין יישומים עם תצוגות שעון שמותקנים ב-Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ar",
        "target": "لم يتم تثبيت أي تطبيقات تحتوي على إضافات واجهة ساعة على Apple Watch الخاصة بك حتى الآن."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "el",
        "target": "Δεν έχει εγκατασταθεί ακόμη καμία εφαρμογή με πολυπλοκότητες πρόσοψης ρολογιού στο Apple Watch σας."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ja",
        "target": "文字盤のコンプリケーションに対応したAppはまだApple Watchにインストールされていません。"
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "en",
        "target": "You have no apps with watch face complications installed on your Apple Watch yet."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "uk",
        "target": "На вашому Apple Watch ще не інстальовано жодної програми з функціями на циферблаті."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "es_419",
        "target": "Aún no has instalado apps compatibles con complicaciones de carátulas en tu Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "pt_PT",
        "target": "Não foi ainda instalada no seu Apple Watch nenhuma aplicação com complicações de relógio."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "es",
        "target": "Aún no tienes ninguna app en el Apple Watch que muestre información en la esfera del reloj."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "da",
        "target": "Du har endnu ikke installeret nogen apps med urskivekomplikationer på dit Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "it",
        "target": "Non sono ancora state installate su Apple Watch app che offrono supporto per le complicazioni."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "sk",
        "target": "Na vaše Apple Watch zatiaľ neboli nainštalované žiadne apky obsahujúce komplikácie."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "zh_CN",
        "target": "您的Apple Watch上还没有安装可在表盘复杂功能中显示的App。"
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "pt_BR",
        "target": "Você ainda não tem nenhum app com complicações de mostrador instalado no Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ms",
        "target": "Anda masih belum mempunyai app dengan komplikasi muka jam yang dipasang pada Apple Watch anda."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "sv",
        "target": "Du har ännu inte några appar med urtavelskomplikationer installerade på Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "en_AU",
        "target": "You have no apps with watch face complications installed on your Apple Watch yet."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "cs",
        "target": "Zatím jste do Apple Watch nenainstalovali žádné aplikace podporující komplikace."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ko",
        "target": "Apple Watch에 시계 페이스 컴플리케이션이 있는 앱이 아직 설치되지 않았습니다."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "no",
        "target": "Du har ingen apper med urskivekomplikasjoner installert på Apple Watch enda."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "hu",
        "target": "Az Apple Watchra még nincs telepítve óraszámlap-komplikációkkal rendelkező app."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "tr",
        "target": "Apple Watch’unuza yüklenmiş ve saat kadranı komplikasyonları olan uygulamanız yok."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "pl",
        "target": "Na Twoim Apple Watch nie zainstalowano jeszcze aplikacji z komplikacjami tarczy."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "fr_CA",
        "target": "Aucune app à complications de cadran n’est installée sur votre Apple Watch pour l’instant."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "vi",
        "target": "Bạn chưa cài đặt ứng dụng nào có tổ hợp mặt đồng hồ trên Apple Watch của bạn."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ru",
        "target": "На Apple Watch пока не установлено ни одного приложения с расширениями для циферблата."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "en_GB",
        "target": "You have no apps with watch face complications installed on your Apple Watch yet."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "fr",
        "target": "Vous n’avez pas encore d’apps comportant des complications installées sur votre Apple Watch."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "fi",
        "target": "Apple Watchiin ei ole vielä asennettu appeja, joissa on kellotaulukomplikaatioita."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "id",
        "target": "Anda tidak memiliki app dengan komplikasi wajah jam yang terinstal di Apple Watch Anda."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "nl",
        "target": "Je hebt nog geen apps met wijzerplaatcomplicaties op je Apple Watch geïnstalleerd."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "th",
        "target": "คุณยังไม่มีแอปที่ติดตั้งกลไกหน้าปัดนาฬิกาบน Apple Watch ของคุณ"
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ro",
        "target": "Pe Apple Watch‑ul dvs. nu aveți încă instalate aplicații cu complicații pentru cadranele de ceas."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "zh_HK",
        "target": "你沒有在Apple Watch安裝附有錶面複雜功能的App。"
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "hr",
        "target": "Na vaš Apple Watch još niste instalirali nijednu aplikaciju s dodacima za brojčanik."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "hi",
        "target": "आपकी Apple Watch पर अभी तक घड़ी के कॉम्प्लिकेशन वाले कोई ऐप्स इंस्टॉल नहीं किए गए हैं।"
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "ca",
        "target": "Encara no tens cap app a l’Apple Watch que mostri informació a l’esfera del rellotge."
      },
      {
        "filename": "CompanionComplicationSettings.strings",
        "language": "zh_TW",
        "target": "您尚未在Apple Watch上安裝附有錶面複雜功能的App。"
