        "filename" : "Localizable-Hades.loctable"
      },
      {
        "filename" : "Localizable-Hades.loctable",
        "target" : "Inspirada en un diseño de Hermès del año 1938, esta carátula cuenta con números tipográficos que cambian conforme pasan las horas.",
        "language" : "es_419"
      },
      {
        "language" : "fi",
