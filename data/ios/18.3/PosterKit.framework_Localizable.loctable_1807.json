    "%@ Widgets are visible to everyone, but widget content is only visible while your primary device is in the home." : [
      {
        "filename" : "Localizable.loctable",
        "language" : "fr",
        "target" : "Les widgets %@ sont visibles pour tout le monde, mais leur contenu n’est visible que lorsque votre appareil principal est à votre domicile."
      },
      {
        "target" : "%@ Widgetar visas för alla, men widgetinnehållet är endast synligt när din primära enhet finns i hemmet.",
        "language" : "sv",
        "filename" : "Localizable.loctable"
      },
      {
        "target" : "%@ Τα widget είναι ορατά σε όλα τα άτομα αλλά το περιεχόμενο widget είναι ορατό μόνο ενώ η κύρια συσκευή σας είναι στην οικία.",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "uk",
        "target" : "%@ Віджети може бачити будь-хто, проте вміст зʼявлятиметься, тільки коли основний пристрій перебуває в домі."
      },
      {
        "target" : "%@ Widgets sind für alle sichtbar, der Inhalt der Widgets ist jedoch nur sichtbar, solange sich dein Primärgerät in deinem Zuhause befindet.",
        "language" : "de",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "fr_CA",
        "target" : "Les widgets %@ sont visibles pour tout le monde, mais le contenu des widgets n’est visible que lorsque l’appareil principal se trouve dans la maison.",
        "filename" : "Localizable.loctable"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "hu",
        "target" : "%@ A widgetek mindenki számára láthatók, azonban a widget tartalma csak akkor látható, amikor az Ön elsődleges eszköze az otthonban tartózkodik."
      },
      {
        "language" : "id",
        "target" : "Widget %@ dapat dilihat oleh semua orang, tapi konten widget hanya terlihat saat perangkat utama Anda berada di rumah.",
        "filename" : "Localizable.loctable"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "fi",
        "target" : "%[tt]@-widgetit näkyvät kaikille, mutta widgetin sisältö näkyy vain, kun ensisijainen laitteesi on kotona."
      },
      {
        "target" : "Widżety %@ są widoczne dla każdego, ale ich zawartość jest wyświetlana tylko, gdy Twoje urządzenie główne znajduje się w domu.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "bg",
        "target" : "Инструментите %@ са видими за всички, но съдържанието на инструментите е видимо само докато основното устройство е в дома."
