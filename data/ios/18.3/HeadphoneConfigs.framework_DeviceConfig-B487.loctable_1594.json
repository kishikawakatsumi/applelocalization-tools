  "localizations" : {
    "VOLUME_CONTROL_FOOTER" : [
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "sl",
        "target" : "Pritisnite in pridržite levi oziroma desni gumb na slušalkah Beats Pill, da povečate in zmanjšate glasnost."
      },
      {
        "language" : "fr_CA",
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Appuyez de façon prolongée sur le bouton gauche ou droit de l’enceinte Beats Pill pour augmenter ou baisser le volume."
      },
      {
        "target" : "Mantén premut el botó dret o esquerre de l’altaveu Beats Pill per controlar el volum.",
        "language" : "ca",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "Tekan dan tahan tombol kiri atau kanan pada Beats Pill untuk menyesuaikan volume naik dan turun.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "id"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Säädä äänenvoimakkuutta pitämällä Beats Pill -kaiuttimen vasenta tai oikeaa painiketta painettuna.",
        "language" : "fi"
      },
      {
        "language" : "uk",
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Натисніть і утримуйте ліву або праву кнопку на Beats Pill, щоб збільшити чи зменшити гучність."
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "sk",
        "target" : "Hlasitosť môžete zvýšiť alebo znížiť stlačením a podržaním ľavého alebo pravého tlačidla na Beats Pill."
      },
      {
        "target" : "Țineți apăsat butonul din stânga sau dreapta de pe Beats Pill pentru a mări sau micșora volumul.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "ro"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "pl",
        "target" : "Aby zwiększyć lub zmniejszyć głośność, naciśnij i przytrzymaj lewy lub prawy przycisk głośnika Beats Pill."
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "es_419",
        "target" : "Mantén presionados los botones de la Beats Pill para subir o bajar el volumen."
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "ko",
        "target" : "Beats Pill의 왼쪽 또는 오른쪽 버튼을 길게 눌러서 음량을 위아래로 조절합니다."
      },
      {
        "target" : "Trykk og hold på den venstre eller høyre knappen på Beats Pill for å justere volumet opp eller ned.",
        "language" : "no",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "language" : "bg",
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Натиснете и задръжте левия или десния бутон на Beats Pill, за да увеличите или намалите силата за звука."
      },
      {
        "target" : "Druk op de linker- of de rechter-Beats Pill en houd vast om het volume harder en zachter te zetten.",
        "language" : "nl",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "Press and hold on either the left or right button on Beats Pill to adjust volume up and down.",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "ניתן ללחוץ לחיצה ארוכה על הכפתור הימני או השמאלי של ה-Beats Pill כדי לכוון את עוצמת השמע למעלה ולמטה.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "he"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "اضغط مطولًا على الز الأيمن أو الأيسر لـ Beats Pill لرفع وخفض مستوى الصوت.",
        "language" : "ar"
      },
      {
        "target" : "Mantenha premido o botão da esquerda ou da direita na Beats Pill para aumentar ou diminuir o volume.",
        "language" : "pt_PT",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "language" : "lt",
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Paspauskite ir palaikykite kairįjį arba dešinįjį „Beats Pill“ mygtuką, kad padidintumėte arba sumažintumėte garsumą."
      },
      {
        "language" : "en_AU",
        "target" : "Press and hold on either the left or right button on Beats Pill to adjust volume up and down.",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "da",
        "target" : "Tryk og hold nede på enten venstre eller højre knap på Beats Pill for at skrue op eller ned for lyden."
      },
      {
        "language" : "zh_HK",
        "target" : "按住Beats Pill左右任何一邊的按鈕以調高和調低音量。",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "el",
        "target" : "Για να αυξήσετε ή να μειώσετε την ένταση ήχου, πατήστε παρατεταμένα είτε το αριστερό είτε το δεξί κουμπί στο Beats Pill."
      },
      {
        "language" : "hr",
        "target" : "Za smanjenje i povećanje glasnoće pritisnite i zadržite na lijevoj ili desnoj tipki slušalica Beats Pill.",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "Sesi açmayı ve kısmayı ayarlamak için Beats Pill’deki sol veya sağ düğmeyi basılı tutun.",
        "language" : "tr",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "es_US",
        "target" : "Mantén presionados los botones de la Beats Pill para subir o bajar el volumen."
      },
      {
        "target" : "Press and hold on either the left or right button on Beats Pill to adjust volume up and down.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "en"
      },
      {
        "language" : "cs",
        "target" : "Hlasitost můžete zvyšovat a snižovat stisknutím a podržením levého nebo pravého tlačítka na reproduktoru Beats Pill.",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "Mantenha pressionado um dos fones Beats Pill para aumentar ou diminuir o volume.",
        "language" : "pt_BR",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "Mantén pulsado el auricular izquierdo o el derecho de los Beats Pill para ajustar el volumen.",
        "language" : "es",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "按住Beats Pill左右任一侧按钮调节音量高低。",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Per alzare o abbassare il volume, tieni premuto il pulsante sinistro o quello destro su Beats Pill.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "it"
      },
      {
        "language" : "ja",
        "target" : "Beats Pillの左右どちらか一方のボタンで長押しをして音量の上げ下げを調節します。",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "Чтобы увеличить или уменьшить громкость, нажмите и удерживайте левую или правую кнопку на колонке Beats Pill.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "ru"
      },
      {
        "language" : "kk",
        "filename" : "DeviceConfig-B487.loctable",
        "target" : "Дыбыс деңгейін көтеру немесе төмендету үшін Beats Pill құлаққабындағы сол не оң жақ түймені басып тұрыңыз."
      },
      {
        "target" : "Halte die linke oder rechte Taste auf der Beats Pill gedrückt, um die Lautstärke zu erhöhen oder zu verringern.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "de"
      },
      {
        "language" : "hu",
        "target" : "A Beats Pill bal vagy jobb oldali gombjának nyomva tartásával növelheti és csökkentheti a hangerőt.",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "target" : "按住Beats Pill上的左側或右側按鈕來調整音量高低。",
        "language" : "zh_TW",
        "filename" : "DeviceConfig-B487.loctable"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "fr",
        "target" : "Maintenez appuyé le bouton gauche ou droit de la Beats Pill pour augmenter ou baisser le volume."
      },
      {
        "target" : "Tekan dan tahan pada sama ada butang kiri atau kanan pada Beats Pill untuk melaraskan kelantangan naik dan turun.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "ms"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "th",
        "target" : "กดปุ่มซ้ายหรือปุ่มขวาบน Beats Pill ค้างไว้เพื่อปรับเพิ่มและลดเสียง"
      },
      {
        "target" : "Nhấn và giữ nút bên trái hoặc bên phải trên Beats Pill để tăng và giảm âm lượng.",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "vi"
      },
      {
        "target" : "वॉल्यूम को अधिक और कम ऐडजस्ट करने के लिए Beats Pill पर बाएँ या दाएँ बटन में से कोई भी दबाए रखें।",
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "hi"
      },
      {
        "filename" : "DeviceConfig-B487.loctable",
        "language" : "sv",
        "target" : "Håll in på antingen högra eller vänstra knappen på Beats Pill för att höja och sänka volymen."
      }
