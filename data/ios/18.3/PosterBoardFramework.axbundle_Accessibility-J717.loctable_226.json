    "j7xx.value" : [
      {
        "target" : "चमकती लकीरों से भरा गहरे रंग का लिक्विड मेटल घुमावदार और ऊँची-नीची ढलान वाली सतह के ऊपर तैर रहा है।",
        "language" : "hi",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "target" : "Efecto de metal líquido oscuro con franjas de colores vibrantes que fluyen sobre una superficie curva y contorneada.",
        "language" : "es",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "language" : "ca",
        "target" : "Efecte de metall líquid fosc amb reflexos de colors llampants que flueix sobre una superfície corba i perfilada.",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "kk",
        "target" : "Жарық толқындармен қанықтырылған күңгірт, сұйық металл иілген сызық және сызылған бет бойымен таралады."
      },
      {
        "language" : "fi",
        "target" : "Tumma nestemäinen metalli virtaa kirkkain värein väreilevänä kaarevan, muotoillun pinnan yli.",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "target" : "Dark, liquid metal, imbued with vibrant ramparts, flows over a curved and contoured surface.",
        "filename" : "Accessibility-J717.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "โลหะเหลวเข้มเงาวาวส่องแสงสเปกตรัมไหลผ่านพื้นผิวเรียบเว้าโค้งมน",
        "filename" : "Accessibility-J717.loctable",
        "language" : "th"
      },
      {
        "target" : "Dunkles, flüssiges Metall mit bunten Erhebungen fließt über eine gewölbte, geschwungene Oberfläche.",
        "filename" : "Accessibility-J717.loctable",
        "language" : "de"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "cs",
        "target" : "Temný tekutý kov, prostoupený zářivě barevnými valy, přetéká přes zakřivený a tvarovaný povrch."
      },
      {
        "target" : "Тъмен, течен метал, изпълнен с ярки релефи, се стича по извита и контурна повърхност.",
        "filename" : "Accessibility-J717.loctable",
        "language" : "bg"
      },
