    "FACE_GALLERY_ESTERBROOK_DESCRIPTION" : [
      {
        "filename" : "LocalizableCompanion.loctable",
        "target" : "Représentant le mondialement célèbre beagle Snoopy, ce cadran met en vedette l’esprit espiègle de ce chien.",
        "language" : "fr_CA"
      },
      {
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ja",
        "target" : "世界で一番有名なビーグル犬をモチーフにしたこの文字盤では、茶目っ気たっぷりなスヌーピーを見ることができます。"
      },
      {
        "language" : "pt_PT",
        "target" : "Com o famoso beagle Snoopy como protagonista, este mostrador exibe o espírito brincalhão da personagem canina dos Peanuts.",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "target" : "Ovaj brojčanik prikazuje svjetski slavnog bigla Snoopyja i utjelovljuje zaigrani duh psećeg člana ekipe Peanuts.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "hr"
      },
      {
        "language" : "kk",
        "target" : "Әлемдегі ең танымал Снупи атты бигл итін қарсы алыңыз! Бұл циферблат әйгілі иттің ойнақы табиғатына арналған.",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "target" : "Αυτή η πρόσοψη με τον Σνούπι, το παγκοσμίως διάσημο μπιγκλ του κόμικ «Πίνατς».",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "el"
      },
      {
        "target" : "Esta esfera plasma el espíritu juguetón de Snoopy, el famoso beagle de la tira cómica Peanuts.",
        "language" : "es",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "language" : "sl",
        "target" : "Ta številčnica prikazuje živahnost in razigranost priljubljenega angleškega braka Snoopyja iz stripa Peanuts.",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "language" : "tr",
        "target" : "Dünyaca ünlü beagle Snoopy’yi içeren bu kadran, Peanuts köpeğinin şakacı ruhunu öne çıkarır.",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "filename" : "LocalizableCompanion.loctable",
        "language" : "he",
        "target" : "עיצוב שעון זה מציג את הרוח השובבה של סנופי, כלב הביגל של ״פינאטס״ המפורסם בכל רחבי העולם."
      },
      {
        "target" : "หน้าปัดนี้แสดงให้เห็นถึงความร่าเริงของสุนัขจากเรื่องพีนัทส์โดยมีสนูปี้เป็นสุนัขพันธุ์บีเกิ้ลที่โด่งดังไปทั่วโลก",
        "language" : "th",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "filename" : "LocalizableCompanion.loctable",
        "language" : "es_US",
        "target" : "Esta carátula presenta al beagle más famoso del mundo en su juguetona esencia: ¡Snoopy!"
      },
      {
        "language" : "lt",
        "target" : "Šis ciferblatas, kuriame yra garsusis Snūpis, demonstruoja žaismingą keturkojo dvasią.",
        "filename" : "LocalizableCompanion.loctable"
      },
      {
        "target" : "تمثل هذه الواجهة الروح المرحة لشخصية Snoopy المشهورة عالميًا، وهو كلب البيغل ضمن مجموعة Peanut.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ar"
      },
      {
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ro",
        "target" : "Avându‑l în rol principal pe Snoopy, beagle‑ul celebru în întreaga lume, acest cadran ilustrează spiritul jucăuș al cățelului din gașca Peanuts."
      },
      {
        "filename" : "LocalizableCompanion.loctable",
        "language" : "fr",
        "target" : "Mettant à l’honneur Snoopy, le plus célèbre des beagles, ce cadran incarne l’esprit joueur du personnage de Peanuts."
      },
      {
