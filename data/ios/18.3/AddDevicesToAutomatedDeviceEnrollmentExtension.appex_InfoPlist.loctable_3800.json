        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "es",
        "target" : "El sistema de inscripción automatizada de dispositivos usará Bluetooth para detectar los dispositivos que se van a añadir a tu organización."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ko",
        "target" : "자동 기기 등록에서 Bluetooth를 사용하여 근처에 있는 기기를 찾아 사용자의 조직에 추가합니다."
      },
      {
        "language" : "pl",
        "target" : "Funkcja automatycznej rejestracji urządzeń będzie używała Bluetooth do wykrywania pobliskich urządzeń w celu dodania ich do Twojej organizacji.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Automatizirano prijavljivanje uređaja koristit će Bluetooth za otkrivanje obližnjih uređaja za dodavanje u vašu organizaciju.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
        "language" : "vi",
        "filename" : "InfoPlist.loctable",
        "target" : "Đăng ký thiết bị được tự động hóa sẽ sử dụng Bluetooth để tìm kiếm các thiết bị ở gần sẽ được thêm vào tổ chức của bạn."
      },
      {
        "target" : "Automaattinen laiterekisteröinti käyttää Bluetoothia etsiäkseen lähellä olevia laitteita lisättäväksi organisaatioosi.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable",
