    "NSBluetoothAlwaysUsageDescription" : [
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Înscrierea automată a dispozitivelor va utiliza Bluetooth pentru a detecta dispozitivele din apropiere de adăugat la organizația dvs.",
        "language" : "ro"
      },
      {
        "language" : "sv",
        "filename" : "InfoPlist.loctable",
        "target" : "Automatisk enhetsregistrering använder Bluetooth till att upptäcka enheter i närheten som ska läggas till i organisationen."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN",
        "target" : "“自动设备注册”将使用蓝牙发现附近待添加至你组织的设备。"
      },
      {
        "language" : "pt_BR",
        "target" : "O Registro Automático de Dispositivo usa o Bluetooth para detectar dispositivos por perto que serão adicionados à sua organização.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "no",
        "target" : "Automatisk enhetsregistrering bruker Bluetooth til å finne enheter i nærheten som kan legges til i organisasjonen din.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Automatiškai registruojant įrenginį „Bluetooth“ ryšiu bus aptinkami netoliese esantys įrenginiai, kurie turi būti įtraukti į jūsų organizaciją.",
        "language" : "lt"
      },
      {
        "target" : "Pendaftaran Peranti Automatik akan menggunakan Bluetooth untuk menemui peranti berdekatan untuk ditambahkan ke organisasi anda.",
        "language" : "ms",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ar",
        "target" : "سيستخدم \"التسجيل الآلي للأجهزة\" Bluetooth لاكتشاف الأجهزة المجاورة التي ستُضاف إلى مؤسستك."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sk",
        "target" : "Automatická registrácia zariadenia bude cez rozhranie Bluetooth hľadať zariadenia v blízkosti, ktoré sa majú pridať do vašej organizácie."
      },
      {
        "language" : "ca",
        "target" : "La inscripció automàtica de dispositius utilitzarà el Bluetooth per detectar dispositius a prop que calgui afegir a l’organització.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "Automated Device Enrolment will use Bluetooth to discover nearby devices to be added to your organisation.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Automated Device Enrollment will use Bluetooth to discover nearby devices to be added to your organization.",
        "language" : "en"
      },
      {
        "language" : "cs",
        "target" : "Automatizovaná registrace zařízení bude přes rozhraní Bluetooth hledat blízká zařízení, která mají být přidána do vaší organizace.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "id",
        "target" : "Pendaftaran Perangkat Terautomasi akan menggunakan Bluetooth untuk menemukan perangkat di sekitar untuk ditambahkan ke organisasi Anda.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "การลงทะเบียนการกำหนดสิทธิ์อุปกรณ์อัตโนมัติจะใช้บลูทูธเพื่อค้นหาอุปกรณ์ที่อยู่ใกล้เคียงเพื่อเพิ่มไปยังองค์กรของคุณ",
        "language" : "th",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Den automatiserede enhedstilmelding bruger Bluetooth til at finde enheder i nærheden, der skal føjes til din organisation.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "language" : "fr_CA",
        "target" : "L’inscription automatisée des appareils utilisera Bluetooth pour détecter les appareils à proximité à ajouter à votre organisation.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "fr",
        "target" : "L’inscription d’appareil automatisée utilisera le Bluetooth pour découvrir les appareils à proximité à ajouter à votre organisation."
      },
      {
        "target" : "ऑटोमेटेड डिवाइस नामांकन के द्वारा Bluetooth का इस्तेमाल आस-पास के डिवाइस का पता लगाने के लिए किया जाएगा जिन्हें आपके संगठन में जोड़ा जाना है।",
        "language" : "hi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Automatische apparaatinschrijving gebruikt Bluetooth om apparaten in de buurt te vinden, zodat ze kunnen worden toegevoegd aan je organisatie.",
        "filename" : "InfoPlist.loctable",
        "language" : "nl"
      },
      {
        "language" : "pt_PT",
        "target" : "O registo automático de dispositivos utilizará o Bluetooth para detetar dispositivos nas proximidades que podem ser adicionados à sua organização.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ru",
        "target" : "При автоматической регистрации устройств будет использоваться Bluetooth, чтобы обнаруживать устройства рядом, которые можно добавить в Вашу организацию.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "「自動裝置註冊」會使用藍牙來尋找附近裝置以加入你的組織。",
