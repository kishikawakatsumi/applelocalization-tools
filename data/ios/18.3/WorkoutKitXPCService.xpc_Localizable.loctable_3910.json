    "SYNC_PERMISSION_ALERT_MESSAGE" : [
      {
        "filename" : "Localizable.loctable",
        "target" : "%@ quiere agregar entrenamientos al Apple Watch. La app también podrá saber si se completan o no esos entrenamientos.",
        "language" : "es_US"
      },
      {
        "target" : "“%@” gostaria de adicionar treinos ao Apple Watch. A aplicação poderá também verificar se estes treinos foram concluídos ou não.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "»%@« želi dodajati vadbe v uro Apple Watch. Prav tako bo lahko aplikacija prebrala, ali so te vadbe dokončane ali ne.",
        "filename" : "Localizable.loctable",
        "language" : "sl"
      },
      {
        "filename" : "Localizable.loctable",
        "target" : "L’app %@ vol afegir entrenaments a l’Apple Watch. També podrà consultar si els has completat.",
        "language" : "ca"
      },
      {
        "target" : "“%@” ingin menambahkan olahraga ke Apple Watch. App juga akan dapat membaca apakah olahraga ini telah diselesaikan atau tidak.",
        "language" : "id",
        "filename" : "Localizable.loctable"
      },
      {
        "target" : "“%@” would like to add workouts to Apple Watch. The app will also be able to read whether or not these workouts have been completed.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "%@ vorrebbe aggiungere gli allenamenti su Apple Watch. L’app potrà anche leggere se sono stati completati o meno.",
        "language" : "it",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "no",
        "filename" : "Localizable.loctable",
        "target" : "%@ vil legge til treningsøkter på Apple Watch. Appen vil også kunne se om treningsøktene er fullførte eller ikke."
      },
      {
        "language" : "zh_TW",
        "filename" : "Localizable.loctable",
        "target" : "「%@」想要將體能訓練加入Apple Watch。該App也可以讀取這些體能訓練是否已完成的資料。"
      },
      {
        "language" : "de",
        "filename" : "Localizable.loctable",
        "target" : "„%@“ möchte Trainings zur Apple Watch hinzufügen. Die App wird dadurch auch abrufen können, ob diese Trainings abgeschlossen wurden."
      },
      {
        "target" : "« %@ » souhaite ajouter des entraînements à l’Apple Watch. L’app pourra également savoir si ces entraînements ont été terminés ou non.",
        "language" : "fr_CA",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "th",
        "target" : "“%@” ต้องการที่จะเพิ่มการออกกำลังกายไปยัง Apple Watch แอปจะสามารถอ่านได้ด้วยว่าการออกกำลังกายเหล่านี้เสร็จแล้วหรือไม่",
        "filename" : "Localizable.loctable"
      },
      {
        "filename" : "Localizable.loctable",
        "target" : "“%@”でワークアウトをApple Watchに追加しようとしています。このアプリでこれらのワークアウトが完了したかどうかも読み込むことができます。",
        "language" : "ja"
      },
      {
        "target" : "« %@ » souhaite ajouter des exercices à l’Apple Watch. Cette app pourra également déterminer si vous avez terminé ces exercices ou non.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "O app “%@” deseja adicionar exercícios ao Apple Watch. O app também poderá constatar se esses exercícios foram ou não concluídos.",
        "language" : "pt_BR",
        "filename" : "Localizable.loctable"
      },
