        "filename" : "Localizable.loctable"
      },
      {
        "target" : "Стисніть двічі вказівний і великий пальці, щоб відповісти на виклик чи повідомлення, відкрити Динамічний стос тощо.",
        "language" : "uk",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "en_AU",
        "target" : "Tap your index finger and thumb together twice to answer a call, reply to a message, see your Smart Stack and more.",
        "filename" : "Localizable.loctable"
