      {
        "target" : "Chạm ngón trỏ và ngón cái của bạn vào nhau hai lần để trả lời cuộc gọi, trả lời tin nhắn, xem ngăn xếp thông minh, v.v.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
