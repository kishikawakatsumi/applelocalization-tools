      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "kk",
        "target" : "Қолданбаларға қол жеткізу үшін Apple Watch сағатындағы Digital Crown дөңгелекшесін басыңыз. Ұсынылған қолданба көріністерінің біреуін таңдаңыз."
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
