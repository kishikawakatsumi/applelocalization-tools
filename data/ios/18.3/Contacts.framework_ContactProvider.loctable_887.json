    "ENABLE_ALERT_MESSAGE %@" : [
      {
        "language" : "es_419",
        "target" : "%@ quiere agregar sus contactos como una lista propia. Los que se agreguen así, se pueden eliminar de Configuración.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "%@ souhaite ajouter ses contacts dans sa propre liste. Les contacts ajoutés de la sorte peuvent être supprimés à partir de Réglages.",
        "language" : "fr_CA",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "de",
        "target" : "%@ möchte Kontakte als eigene Liste hinzufügen. Auf diese Weise hinzugefügte Kontakte können aus den Einstellungen entfernt werden.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "pl",
        "filename" : "ContactProvider.loctable",
        "target" : "Aplikacja %@ chce dodać swoje kontakty na osobnej liście. Kontakty dodane w ten sposób można usunąć w Ustawieniach."
      },
      {
        "target" : "%@ želi dodavati svoje kontakte u vlastiti popis. Kontakti koji su dodani na ovaj način mogu se ukloniti u Postavkama.",
        "language" : "hr",
        "filename" : "ContactProvider.loctable"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "pt_PT",
        "target" : "A aplicação %@ pretende adicionar os respetivos contactos numa lista própria. Os contactos que forem adicionados podem ser removidos nas Definições."
      },
      {
        "target" : "Aplikace %@ chce přidat své kontakty jako vlastní seznam. Kontakty přidané tímto způsobem lze smazat v Nastavení.",
        "filename" : "ContactProvider.loctable",
        "language" : "cs"
      },
      {
        "target" : "%@ иска да добави своите контакти като свой собствен списък. Контактите, добавени по този начин, могат да бъдат премахнати от Настройки.",
        "language" : "bg",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "%@想將其聯絡人加入，作為自己的列表。透過此方式加入的聯絡人可以從「設定」中移除。",
        "filename" : "ContactProvider.loctable",
        "language" : "zh_HK"
      },
      {
        "language" : "en_AU",
        "target" : "%@ would like to add its contacts as its own List. Contacts added this way can be removed from Settings.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "ca",
        "filename" : "ContactProvider.loctable",
        "target" : "L’app %@ vol afegir contactes en una llista pròpia. Per eliminar algun contacte que s’hagi afegit d’aquesta manera, ves a la configuració."
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ vill lägga till sina kontakter som sin egen lista. Du kan ta bort kontakter som blivit tillagda på detta sätt från Inställningar.",
        "language" : "sv"
      },
      {
        "target" : "Aplikacija %@ želi svoje stike dodati kot lasten seznam. Stike, dodane na ta način, lahko odstranite v Nastavitvah.",
        "filename" : "ContactProvider.loctable",
        "language" : "sl"
      },
      {
        "language" : "nl",
        "target" : "%@ wil contacten toevoegen als eigen lijst. Contacten die op deze manier worden toegevoegd, kunnen worden verwijderd uit Instellingen.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "%[tt]@想要將其聯絡人加入成個別列表。透過此方式加入的聯絡人可以從「設定」中移除。",
        "filename" : "ContactProvider.loctable",
        "language" : "zh_TW"
      },
      {
        "language" : "he",
        "target" : "היישום ״⁨%@⁩״ מבקש להוסיף את אנשי הקשר שלו בתור רשימה נפרדת. ניתן להסיר אנשי קשר שנוספים בצורה זו דרך ״הגדרות״.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "ko",
        "filename" : "ContactProvider.loctable",
        "target" : "%@ 앱이 자체적으로 연락처 목록을 추가하려고 합니다. 이렇게 추가된 연락처는 설정에서 제거할 수 있습니다."
      },
      {
        "target" : "%@ muốn thêm các liên hệ dưới dạng Danh sách riêng. Các liên hệ được thêm theo cách này có thể được xóa từ Cài đặt.",
        "filename" : "ContactProvider.loctable",
        "language" : "vi"
      },
      {
        "target" : "%[tt]@想要添加其联系人并单独创建列表。以此方式添加的联系人可从“设置”移除。",
        "filename" : "ContactProvider.loctable",
        "language" : "zh_CN"
      },
      {
