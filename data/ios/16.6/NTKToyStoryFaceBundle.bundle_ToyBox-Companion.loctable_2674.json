    "GALLERY_INFINITY_DESCRIPTION" : [
      {
        "target" : "Esta esfera presenta a varios personajes míticos con animaciones personalizadas exclusivas para el Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "es"
      },
      {
        "target" : "This face features iconic characters with custom animations made just for Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Esta carátula incluye personajes distintivos con animaciones personalizadas para el Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Ovaj brojčanik sadrži kultne likove s animacijama izrađenim posebno za Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "hr"
      },
      {
        "target" : "Este mostrador apresenta personagens icônicos com animações personalizadas feitas exclusivamente para o Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "pt"
      },
      {
        "target" : "Na tomto ciferníku ožívají slavné postavičky v animacích určených jen pro Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "cs"
      },
      {
        "target" : "Този циферблат съдържа емблематични герои със специални анимации, направени специално за Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "bg"
      },
      {
        "target" : "Denne urskiven viser legendariske figurer med tilpassede animasjoner laget kun for Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "no"
      },
      {
        "target" : "Den här urtavlan visar kända figurer med animeringar som har skapats speciellt för Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "sv"
      },
      {
        "target" : "Questo quadrante offre le animazioni personalizzate di alcuni dei personaggi più amati. In esclusiva su Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "it"
      },
      {
        "target" : "Bu kadran, yalnızca Apple Watch için hazırlanmış özelleştirilebilir hareketlere sahip karakterler içerir.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "tr"
      },
      {
        "target" : "Циферблат зображає культових персонажів в анімаціях, створених саме для Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "uk"
      },
      {
        "target" : "此表盘使用了经典卡通人物形象，并针对Apple Watch特别定制了动画。",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "עיצוב שעון זה מציג קטעי הנפשה עם דמויות מוכרות שנוצרו במיוחד עבור Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "he"
      },
      {
        "target" : "Ce cadran met en scène des personnages emblématiques avec des animations personnalisées réalisées exclusivement pour l’Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "fr"
      },
      {
        "target" : "Auf diesem Zifferblatt sind Kultfiguren mit speziell für die Apple Watch entwickelten Animationen zu sehen.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "de"
      },
      {
        "target" : "Neste mostrador encontrará personagens icónicas com animações concebidas exclusivamente para o Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Αυτή η πρόσοψη δείχνει κλασικούς χαρακτήρες με προσαρμοσμένες κινήσεις, που έχουν δημιουργηθεί ειδικά για το Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "el"
      },
      {
        "target" : "Conçu spécialement pour l’Apple Watch, ce cadran présente des personnages emblématiques aux animations personnalisées.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "此錶面包含了專為Apple Watch設計、帶有自訂動畫效果的經典卡通人物。",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "zh_TW"
