      {
        "target" : "यह फ़ेस प्रसिद्ध पात्रों को ख़ास तौर पर Apple Watch के लिए बनाए गए कस्टम ऐनिमेशन के साथ फ़ीचर करता है।",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "hi"
      },
      {
        "target" : "Tarcza zawiera znane postaci ożywione animacjami stworzonymi specjalnie dla Apple Watch.",
        "filename" : "ToyBox-Companion.loctable",
        "language" : "pl"
      },
      {
