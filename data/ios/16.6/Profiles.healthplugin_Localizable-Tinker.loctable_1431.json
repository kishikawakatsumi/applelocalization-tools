      {
        "target" : "נא לוודא שהמכשיר מחובר לאינטרנט ולנסות שוב.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "he"
      },
      {
        "target" : "請確定你的裝置已連接互聯網，然後再試。",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Certifique-se de o que dispositivo esteja conectado à internet e tente novamente.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "pt"
      },
      {
        "target" : "Құрылғыңыздың интернетке қосылғанына көз жеткізіп, әрекетті қайталаңыз.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "kk"
      },
      {
        "target" : "Asigurați-vă că dispozitivul este conectat la internet și reîncercați.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "ro"
      },
      {
        "target" : "Provjerite je li uređaj spojen na internet i pokušajte ponovno.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "hr"
      },
      {
        "target" : "Please ensure your device is connected to the internet and try again.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Kontrollera att den här enheten är ansluten till internet och försök igen.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "sv"
      },
      {
        "target" : "インターネットに接続していることを確認してから、やり直してみてください。",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "ja"
      },
      {
        "target" : "الرجاء التأكد من أن جهازك متصل بالإنترنت وحاول مرة أخرى.",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "ar"
      },
      {
