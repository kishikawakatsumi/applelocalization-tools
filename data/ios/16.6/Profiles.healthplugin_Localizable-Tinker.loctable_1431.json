        "filename" : "Localizable-Tinker.loctable",
        "language" : "de"
      },
      {
        "target" : "请确保设备已接入互联网，然后再试一次。",
        "filename" : "Localizable-Tinker.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Zorg dat je apparaat is verbonden met het internet en probeer het opnieuw.",
