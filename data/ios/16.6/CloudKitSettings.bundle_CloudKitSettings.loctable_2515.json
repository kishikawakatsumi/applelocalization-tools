    "CLOUDKIT_EXPLANATORY_TEXT" : [
      {
        "target" : "Apper som har bedt om tillatelse til å finne deg ved hjelp av din Apple‑ID, vises her. Personer som søker etter deg, vil se for- og etternavnet ditt.",
