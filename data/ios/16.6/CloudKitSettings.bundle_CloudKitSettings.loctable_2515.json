      {
        "target" : "Tu sa zobrazia apky, ktoré požiadali o práva na vaše vyhľadanie podľa Apple ID. Užívateľom sa pri vyhľadaní zobrazí vaše meno a priezvisko.",
        "filename" : "CloudKitSettings.loctable",
