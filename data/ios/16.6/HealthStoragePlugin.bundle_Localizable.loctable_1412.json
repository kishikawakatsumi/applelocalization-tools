    "DATA_TYPES_GROUP_DESCRIPTION" : [
      {
        "target" : "Anda boleh menyemak, mengurus dan memadamkan data kesihatan anda dalam app Kesihatan.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Az egészségügyi adatait áttekintheti, kezelheti és törölheti az Egészség appban.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "Svoje zdravotné dáta si môžete prezerať, spravovať a vymazávať v apke Zdravie.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "Pots revisar, gestionar i eliminar les dades de salut a l’app Salut.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "Bạn có thể xem lại, quản lý và xóa dữ liệu sức khỏe trong ứng dụng Sức khỏe.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Pode rever, gerir e apagar os seus dados de saúde na aplicação Saúde.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Swoje dane zdrowotne możesz przeglądać, organizować i usuwać w aplikacji Zdrowie.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "Μπορείτε να εξετάσετε, να διαχειριστείτε και να διαγράψετε τα δεδομένα Υγεία σας στην εφαρμογή «Υγεία».\n\n",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "Voit tarkastella, hallita ja poistaa terveystietojasi Terveys-apissa.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "Du kan se gjennom, administrere og slette helsedata i Helse-appen.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "你可以在「健康」App檢視、管理和刪除你的健康資料。\n\n",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Денсаулық туралы деректеріңізді «Денсаулық» қолданбасында қарап шығуға, басқаруға және жоюға болады.\n",
        "filename" : "Localizable.loctable",
        "language" : "kk"
      },
      {
        "target" : "באפשרותך לבדוק, לנהל ולמחוק את נתוני הבריאות שלך ביישום ״בריאות״.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "Puoi consultare, gestire ed eliminare i tuoi dati sanitari nell'app Salute.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Можете да прегледате, управлявате и изтриете вашите здравни данни от приложението Здраве.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "bg"
      },
      {
        "target" : "आप सेहत ऐप में सेहत डेटा की समीक्षा कर सकते हैं, उसे प्रबंधित और डिलीट कर सकते हैं।\n\n",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "You can review, manage, and delete your health data in the Health app.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "Anda dapat meninjau, mengelola, dan menghapus data kesehatan Anda di app Kesehatan.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "id"
      },
      {
        "target" : "В приложении «Здоровье» можно просматривать и удалять свои медданные, а также управлять ими.\n",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "You can review, manage and delete your health data in the Health app.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "건강 앱에서 건강 데이터를 검토하고, 편집하고, 삭제할 수 있습니다.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Você pode revisar, gerenciar e apagar os seus dados de saúde no app Saúde.\n\n",
        "filename" : "Localizable.loctable",
        "language" : "pt"
      },
      {
