    "NSLocationWhenInUseUsageDescription" : [
      {
        "target" : "ตำแหน่งที่ตั้งของคุณจะถูกใช้เพื่อหาโรงพยาบาลและเครือข่ายทางสุขภาพที่อยู่ใกล้คุณ",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "target" : "會使用你的位置來尋找附近的醫院和健康網絡。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "주변의 병원 및 의료 네트워크를 찾는 데 사용자의 위치가 사용됩니다.",
        "filename" : "InfoPlist.loctable",
        "language" : "ko"
      },
      {
        "target" : "Localizarea dvs. este utilizată pentru a găsi spitale și rețele de sănătate din apropiere.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      },
      {
        "target" : "Posisjonen din brukes til å finne sykehus og behandlernettverk nær deg.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "La tua posizione viene utilizzata per trovare ospedali o servizi sanitari vicino a dove ti trovi.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Sua localização é usada para encontrar hospitais e redes de saúde perto de você.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt"
      },
      {
        "target" : "Your location is used to find hospitals and health networks near you.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "يستخدم موقعك الحالي لإظهار المشافي والشبكات القريبة.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Your location is used to find hospitals and health networks near you.",
        "filename" : "InfoPlist.loctable",
        "language" : "en"
      },
      {
        "target" : "Votre position est utilisée pour trouver des hôpitaux et des réseaux de santé à proximité.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "आपका स्थान आपके नज़दीकी अस्पताल और सेहत नेटवर्क ढूँढने के लिए उपयोग किया जाता है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Sijaintiasi käytetään sairaaloiden ja terveydenhuoltoverkostojen etsimiseen lähelläsi.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "Ваша геопозиція використовується для пошуку лікарень і медичних мереж поблизу вас.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "Se está utilizando tu ubicación para encontrar hospitales y redes de salud cerca de ti.",
        "filename" : "InfoPlist.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Din platsinformation används till att hitta sjukhus och behandlingsinstitutioner nära dig.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Konumunuz yakınınızdaki hastaneleri ve sağlık ağlarını bulmak için kullanılıyor.",
        "filename" : "InfoPlist.loctable",
        "language" : "tr"
      },
      {
        "target" : "Вашето местоположение се използва за намиране близо до вас на болници и мрежи, предоставящи медицински услуги.",
        "filename" : "InfoPlist.loctable",
        "language" : "bg"
      },
      {
        "target" : "A sua localização será usada para encontrar hospitais e redes de saúde perto de si.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Din lokalitet bruges til at finde hospitaler og sundhedsnetværk i nærheden.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "target" : "你的位置用于查找附近的医院和健康网络。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Vị trí của bạn được sử dụng để tìm các bệnh viện và mạng lưới chăm sóc sức khỏe gần bạn.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Your location is used to find hospitals and health networks near you.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Dein Standort wird verwendet, um Krankenhäuser und andere Gesundheitseinrichtungen in deiner Nähe zu finden.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "La teva ubicació s’utilitza per buscar hospitals i xarxes de salut a prop teu.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "Ваша геопозиция используется для поиска больниц и групп поставщиков медицинских услуг, находящихся рядом.",
        "filename" : "InfoPlist.loctable",
        "language" : "ru"
      },
      {
        "target" : "Az Ön helyzete közeli kórházak és egészségügyi hálózatok kereséséhez van felhasználva.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "Vaša lokacija koristi se za pronalaženje obližnjih bolnica i zdravstvenih mreža.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
        "target" : "Геолокацияңыз жақын жердегі ауруханалар мен медициналық орталық желілерін табу үшін пайдаланылады.",
        "filename" : "InfoPlist.loctable",
        "language" : "kk"
      },
      {
        "target" : "Lokasi Anda digunakan untuk menemukan rumah sakit dan jaringan kesehatan di dekat Anda.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "Η τοποθεσία σας χρησιμοποιείται για εύρεση νοσοκομείων και δικτύων υγείας κοντά σας.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "Twoje położenie służy do znajdowania szpitali i ośrodków opieki zdrowotnej w pobliżu.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "La ubicación se utiliza para buscar hospitales y centros de salud cercanos.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "你的位置用作尋找附近的醫院及醫療網絡。",
