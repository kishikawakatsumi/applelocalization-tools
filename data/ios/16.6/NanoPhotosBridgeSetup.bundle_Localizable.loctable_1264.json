    "WELCOME_MESSAGE" : [
      {
        "target" : "คุณสามารถแชร์อัลบั้มรูปภาพกับ%1$[tt]@ เพื่อใช้สร้างหน้าปัดนาฬิการูปภาพในแอปรูปภาพบน Apple Watch ได้",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "Anda boleh berkongsi album foto dengan %1$@ yang boleh digunakan untuk mencipta muka jam Foto dalam app Foto pada Apple Watch.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "S užívateľom %1$@ môžete zdieľať album fotiek, ktorý bude možné použiť na vytvorenie ciferníka Fotky v apke Fotky na Apple Watch.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "Puteți partaja cu %1$@ un album foto, care poate fi utilizat pentru a crea un cadran de ceas de tip Poză în aplicația Poze de pe Apple Watch.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Anda dapat membagikan album foto dengan %1$@ yang dapat digunakan untuk membuat wajah jam Foto pada app Foto di Apple Watch.",
        "filename" : "Localizable.loctable",
        "language" : "id"
      },
      {
        "target" : "S uživatelem %1$@ můžete sdílet fotoalbum, které bude možné využít v aplikaci Fotky na Apple Watch k vytvoření ciferníku Foto.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
