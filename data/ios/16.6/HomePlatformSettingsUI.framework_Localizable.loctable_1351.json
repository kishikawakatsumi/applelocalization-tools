{
  "loctablePath" : "\/System\/Library\/PrivateFrameworks\/HomePlatformSettingsUI.framework\/Localizable.loctable",
  "bundlePath" : "\/System\/Library\/PrivateFrameworks\/HomePlatformSettingsUI.framework",
