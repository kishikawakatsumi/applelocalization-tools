        "language" : "zh_TW"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Задайте график за автоматична промяна на изгледа. iPhone може да изчака да извърши промяната, когато не използвате екрана.\",\"ipad\":\"Задайте график за автоматична промяна на изгледа. iPad може да изчака да извърши промяната, когато не използвате екрана.\"}}",
