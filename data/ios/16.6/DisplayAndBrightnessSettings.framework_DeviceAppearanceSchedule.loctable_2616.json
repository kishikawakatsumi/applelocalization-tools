    "APPEARANCE_SCHEDULE_FOOTER" : [
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Jadualkan masa untuk menukar penampilan secara automatik. iPhone mungkin menunggu untuk beralih sehingga anda tidak menggunakan skrin.\",\"ipad\":\"Jadualkan masa untuk menukar penampilan secara automatik. iPad mungkin menunggu untuk beralih sehingga anda tidak menggunakan skrin.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "ms"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"ניתן לתזמן את שינוי המראה באופן אוטומטי. יתכן שה-iPhone ימתין עם ההחלפה לזמן שבו המסך אינו בשימוש.\",\"ipad\":\"ניתן לתזמן את שינוי המראה באופן אוטומטי. יתכן שה-iPad ימתין עם ההחלפה לזמן שבו המסך אינו בשימוש.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "he"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"حدد مواعيد لتغيير المظهر تلقائيًا. قد ينتظر iPhone حتى تتوقف عن استخدام الشاشة للانتقال.\",\"ipad\":\"حدد مواعيد لتغيير المظهر تلقائيًا. قد ينتظر iPad حتى تتوقف عن استخدام الشاشة للانتقال.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "ar"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Programa a quines hores canviarà automàticament l’aspecte. El canvi s’aplicarà quan no estiguis utilitzant la pantalla de l’iPhone.\",\"ipad\":\"Programa a quines hores canviarà automàticament l’aspecte. El canvi s’aplicarà quan no estiguis utilitzant la pantalla de l’iPad.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "ca"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Imposta gli orari per il cambiamento automatico dell'aspetto. iPhone potrebbe attendere che tu usi nuovamente lo schermo prima di effettuare la transizione.\",\"ipad\":\"Imposta gli orari per il cambiamento automatico dell'aspetto. iPad potrebbe attendere che tu usi nuovamente lo schermo prima di effettuare la transizione.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "it"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Nastavení rozvrhu automatických změn vzhledu. iPhone může se změnou počkat, dokud nepřestanete používat obrazovku.\",\"ipad\":\"Nastavení rozvrhu automatických změn vzhledu. iPad může se změnou počkat, dokud nepřestanete používat obrazovku.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "cs"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"กำหนดเวลาเพื่อเปลี่ยนรูปแบบโดยอัตโนมัติ iPhone อาจรอเวลาเปลี่ยนเมื่อคุณไม่ใช้หน้าจอ\",\"ipad\":\"กำหนดเวลาเพื่อเปลี่ยนรูปแบบโดยอัตโนมัติ iPad อาจรอเวลาเปลี่ยนเมื่อคุณไม่ใช้หน้าจอ\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "th"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Plane, zu welchen Zeiten sich das Erscheinungsbild automatisch ändern soll. Auf dem iPhone erfolgt der Wechsel möglicherweise erst, wenn der Bildschirm nicht mehr benutzt wird.\",\"ipad\":\"Plane, zu welchen Zeiten sich das Erscheinungsbild automatisch ändern soll. Auf dem iPad erfolgt der Wechsel möglicherweise erst, wenn der Bildschirm nicht mehr benutzt wird.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "de"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"Planifiez des horaires pour modifier l’apparence automatiquement. L’iPhone peut attendre que vous arrêtiez d’utiliser l’écran avant de faire la transition.\",\"ipad\":\"Planifiez des horaires pour modifier l’apparence automatiquement. L’iPad peut attendre que vous arrêtiez d’utiliser l’écran avant de faire la transition.\"}}",
        "filename" : "DeviceAppearanceSchedule.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "{\"NSStringDeviceSpecificRuleType\":{\"iphone\":\"排定時間來自動更改外觀。iPhone可能會等到你未使用螢幕時，才會轉換外觀。\",\"ipad\":\"排定時間來自動更改外觀。iPad可能會等到你未使用螢幕時，才會轉換外觀。\"}}",
