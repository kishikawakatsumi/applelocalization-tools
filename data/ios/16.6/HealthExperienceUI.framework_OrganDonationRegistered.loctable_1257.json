      {
        "target" : "תרומה של אדם אחד יכולה להציל חיים של עד שמונה אנשים. Apple מאפשרת לך להירשם בקלות למאגר תורמי האיברים של Donate Life America.",
        "filename" : "OrganDonationRegistered.loctable",
