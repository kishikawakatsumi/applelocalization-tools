    "NSRegulatoryPrivacyDisclosureSummary" : [
      {
        "target" : "To play books, Audiobooks may access data such as your media library.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Ljudböcker kan använda data som ditt mediebibliotek för att spela upp böcker.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Sesli Kitaplar, kitapları seslendirmek için ortam arşiviniz gibi verilere erişebilir.",
        "filename" : "InfoPlist.loctable",
        "language" : "tr"
      },
      {
        "target" : "Untuk memutar buku, Buku Audio dapat mengakses data seperti perpustakaan media Anda.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "Pour écouter des livres, l’app Livres audio pourrait accéder à des données telles que votre bibliothèque multimédia.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "لتشغيل الكتب، قد تصل الكتب الصوتية إلى بيانات مثل مكتبة الوسائط.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Кітаптарды ойнату үшін «Аудиокітаптар» кітапхана сияқты деректеріңізге қол жеткізуі мүмкін.",
        "filename" : "InfoPlist.loctable",
        "language" : "kk"
      },
      {
        "target" : "ブックを再生するのに、オーディオブックでメディアライブラリなどのデータにアクセスする場合があります。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "target" : "Чтобы воспроизводить книги, приложению «Аудиокниги» необходим доступ к таким данным, как Ваша медиатека.",
        "filename" : "InfoPlist.loctable",
        "language" : "ru"
      },
      {
        "target" : "為了播放書籍，「有聲書」可能會取用你的媒體資料庫等資料。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Um Bücher wiederzugeben, kann „Hörbücher“ auf Daten wie deine Mediathek zugreifen.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "Để phát các sách, Sách nói có thể truy cập các dữ liệu như thư viện phương tiện của bạn.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Аудіокнигам потрібен доступ до даних, як‑от вашої медіатеки, для відтворення книг.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "Perquè puguis reproduir llibres, l’app Audiollibres podrà accedir a dades com la biblioteca multimèdia.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "Aby odtwarzać książki, aplikacja Książki audio może uzyskiwać dostęp do danych takich jak Twoja biblioteka multimediów.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "Äänikirjat voi käyttää tietoja, kuten mediakirjastoa, jotta se voi toistaa kirjoja.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "ในการเล่นหนังสือ หนังสือเสียงอาจเข้าถึงข้อมูล เช่น คลังสื่อของคุณ",
