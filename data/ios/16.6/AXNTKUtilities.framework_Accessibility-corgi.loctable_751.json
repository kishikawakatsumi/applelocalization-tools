{
  "loctablePath" : "\/System\/Library\/PrivateFrameworks\/AXNTKUtilities.framework\/Accessibility-corgi.loctable",
  "bundlePath" : "\/System\/Library\/PrivateFrameworks\/AXNTKUtilities.framework",
  "framework" : "AXNTKUtilities.framework",
  "localizations" : {
    "keyline.hint.no.crown" : [
      {
        "target" : "轻点两下以自定。向左或向右轻扫选取不同项目。",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Koppintson duplán a testreszabáshoz. Legyintsen balra vagy jobbra egy másik elem kiválasztásához.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "hu"
      },
      {
        "target" : "Баптау үшін екі рет түртіңіз. Басқа элементті таңдау үшін солға немесе оңға жанап өтіңіз.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "kk"
      },
      {
        "target" : "Торкніть двічі, щоб налаштувати. Проведіть ліворуч або праворуч, щоб вибрати інший елемент.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "uk"
      },
      {
        "target" : "Touchez deux fois pour personnaliser. Balayez l’écran vers la gauche ou la droite pour choisir un élément différent.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "點兩下即可自訂。向左或向右掃即可選擇不同項目。",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Fes dos tocs per personalitzar l’ítem. Llisca cap a l’esquerra o la dreta per triar un altre ítem.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ca"
      },
      {
        "target" : "Dobbelttrykk for å tilpasse. Sveip mot høyre eller venstre for å velge et annet objekt.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "no"
      },
      {
        "target" : "Apăsați dublu pentru a personaliza. Glisați în stânga sau în dreapta pentru a alege alt articol.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ro"
      },
      {
        "target" : "Ketuk dua kali untuk menyesuaikan. Gesek ke kiri atau kanan untuk memilih item lain.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "id"
      },
      {
        "target" : "Докоснете двукратно за персонализиране. Плъзнете наляво или надясно за избор на друг елемент.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "bg"
      },
      {
        "target" : "Chạm hai lần để tùy chỉnh. Vuốt sang trái hoặc phải để chọn một mục khác.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "vi"
      },
      {
        "target" : "Toca dos veces para personalizar. Desliza a la izquierda o derecha para elegir otro elemento.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Double-tap to customize. Swipe left or right to choose a different item.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "en"
      },
      {
        "target" : "點兩下來自訂。左右滑動來選擇其他項目。",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Toque duas vezes para personalizar. Passe o dedo para a esquerda ou para a direita para escolher um item diferente.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "pt"
      },
      {
        "target" : "Tryk to gange for at tilpasse. Skub til venstre eller højre for at vælge et andet emne.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "da"
      },
      {
        "target" : "Tik dubbel om aan te passen. Veeg naar links of rechts om een ander onderdeel te kiezen.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "nl"
      },
      {
        "target" : "कस्टमाइज़ करने के लिए डबल टैप करें। कोई दूसरा आइटम चुनने के लिए बाएँ या दाएँ स्वाइप करें।",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "hi"
      },
      {
        "target" : "Stuknij dwukrotnie, aby dostosować. Przesuń w lewo lub w prawo, aby wybrać inną rzecz.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "pl"
      },
      {
        "target" : "Dvojitým klepnutím upravujete. Potiahnutím do strán vyberiete inú položku.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "sk"
      },
      {
        "target" : "Tocca due volte per personalizzare. Scorri a sinistra o a destra per scegliere un altro elemento.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "it"
      },
      {
        "target" : "Muokkaa kaksoisnapauttamalla. Valitse eri kohde pyyhkäisemällä vasemmalle tai oikealle.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "fi"
      },
      {
        "target" : "Touchez deux fois pour personnaliser. Balayez vers la gauche ou vers la droite pour choisir un autre élément.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "fr"
      },
      {
        "target" : "Zum Anpassen doppeltippen. Nach links oder rechts wischen, um etwas anderes zu wählen.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "de"
      },
      {
        "target" : "Коснуться дважды, чтобы настроить. Смахнуть влево или вправо, чтобы выбрать другой объект.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ru"
      },
      {
        "target" : "แตะสองครั้งเพื่อปรับแต่ง ปัดซ้ายหรือขวาเพื่อเลือกรายการ",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "th"
      },
      {
        "target" : "Double-tap to customise. Swipe left or right to choose a different item.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Dwiketik untuk menyesuaikan. Leret ke kiri atau kanan untuk memilih item berbeza.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ms"
      },
      {
        "target" : "Αγγίξτε δύο φορές για προσαρμογή. Σαρώστε αριστερά ή δεξιά για επιλογή διαφορετικού στοιχείου.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "el"
      },
      {
        "target" : "Double-tap to customise. Swipe left or right to choose a different item.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "カスタマイズするには、ダブルタップします。左右にスワイプすると、別の項目を選択できます。",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ja"
      },
      {
        "target" : "Dodirnite dvaput za prilagođavanje. Za odabir druge stavke povucite ulijevo ili udesno.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "hr"
      },
      {
        "target" : "Chcete-li upravit, poklepejte. Přejetím doleva nebo doprava vyberete jinou položku.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "cs"
      },
      {
        "target" : "اضغط مرتين للتخصيص. قم سحب إلى اليسار أو اليمين لاختيار عنصر مختلف.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ar"
      },
      {
        "target" : "Tryck snabbt två gånger om du vill anpassa. Svep åt vänster eller höger om du vill välja ett annat objekt.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "sv"
      },
      {
        "target" : "Özelleştirmek için çift tıklayın. Farklı bir öğe seçmek için sola veya sağa kaydırın.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "tr"
      },
      {
        "target" : "이중 탭하여 사용자화하십시오. 다른 항목을 선택하려면 좌우로 쓸어넘기십시오.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "ko"
      },
      {
        "target" : "ניתן להקיש פעמיים להתאמה אישית, ולהחליק ימינה ושמאלה לבחירת פריט אחר.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "he"
      },
      {
        "target" : "Dê dois toques para personalizar. Passe o dedo para a esquerda ou direita para escolher outro elemento.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Toca dos veces para personalizar. Desliza el dedo hacia la derecha o hacia la izquierda para seleccionar un ítem diferente.",
        "filename" : "Accessibility-corgi.loctable",
        "language" : "es"
      }
    ],
