    "HIGHLIGHTALERT_SUBHEAD_LOW_CARDIO_FITNESS_NOTIFICATION_1" : [
      {
        "target" : "Việc này có thể do mức hoạt động thể lực thấp hoặc một tình trạng y tế.",
