        "language" : "fi"
      },
      {
        "target" : "Bantu kami memahami sebab anda menyahaktifkan pembetulan auto dengan berkongsi maklum balas anda.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Envoyez-nous un commentaire pour nous aider à comprendre pourquoi vous avez désactivé la correction automatique.",
