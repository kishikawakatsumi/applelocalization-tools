    "FEEDBACK_AUTOCORRECTION_DISABLED_MESSAGE" : [
      {
        "target" : "Надішліть відгук, щоб допомогти нам зрозуміти, чому ви вимкнули функцію автовиправлення.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "Aidez-nous à comprendre pourquoi vous avez désactivé la correction automatique en nous faisant part de vos commentaires.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Пікіріңізді бөлісу арқылы авто түзетуді неліктен өшіргеніңізді анықтауға көмектесіңіз.",
        "filename" : "Localizable.loctable",
        "language" : "kk"
      },
      {
        "target" : "Podziel się swoją opinią, aby pomóc nam zrozumieć, dlaczego nie używasz już automatycznej korekty.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "Hjälp oss att förstå varför du stängde av automatisk korrigering genom att dela med dig av din feedback.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "Partajați feedbackul dvs. pentru a ne ajuta să înțelegem de ce ați dezactivat corectarea automată.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Compártenos tus comentarios para ayudarnos a entender por qué desactivaste la autocorrección.",
