      {
        "target" : "分享反馈以帮助我们了解你关闭自动改正的原因。",
        "filename" : "Localizable.loctable",
        "language" : "yue_CN"
      },
      {
        "target" : "Geri bildiriminizi paylaşarak otomatik düzeltmeyi neden kapattığınızı anlamamıza yardımcı olun.",
