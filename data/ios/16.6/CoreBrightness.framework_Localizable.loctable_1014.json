  "localizations" : {
    "BLR_ALERT_TEXT_2" : [
      {
        "target" : "Night Shift функциясы түнгі уақытта көзге түсетін жүктемені азайту үшін дисплей түстерін автоматты түрде реттей алады.",
        "filename" : "Localizable.loctable",
        "language" : "kk"
      },
      {
        "target" : "A Night Shift képes éjjel automatikusan átállítani a kijelző színeit, hogy Ön kevésbé erőltesse meg a szemeit",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "'Night Shift' kan de kleuren op het scherm 's avonds automatisch aanpassen om ze rustgevender voor je ogen te maken",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "Night Shift može automatski prilagoditi boje na zaslonu noću kako bi se smanjilo naprezanje očiju",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "Night Shift can automatically adjust the colors of your display at night to reduce eye strain",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "El modo “Night Shift” puede ajustar automáticamente los colores de la pantalla por la noche para reducir la fatiga ocular.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "Night Shift는 밤에 화면의 색상을 자동으로 변경하여 눈의 피로를 덜어 줍니다.",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Mit Night Shift können die Farben auf dem Display nachts automatisch angepasst werden, um die Augen zu schonen.",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "Night Shift může v noci automaticky upravovat barevné spektrum displeje a ulevit tak vašim očím.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "Night Shift automaticky upraví farby na displeji tak, aby v noci šetril vaše oči.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "Η λειτουργία Night Shift μπορεί να προσαρμόζει αυτόματα τα χρώματα της οθόνης σας τη νύχτα για να μειώνει την καταπόνηση των ματιών.",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "Night Shift, geceleri göz yorgunluğunu azaltmak için ekranınızın renklerini otomatik olarak değiştirebilir.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "Night Shift boleh melaraskan warna paparan anda secara automatik pada waktu malam untuk mengurangkan keletihan mata",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "「夜覽」會在夜間自動調整螢幕的顏色，以舒緩眼睛疲勞。",
        "filename" : "Localizable.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "À noite, o modo Night Shift pode mudar automaticamente as cores do ecrã para reduzir a fadiga ocular.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Night Shift can automatically adjust the colours of your display at night to reduce eye strain",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Night Shift може самостійно вирівнювати кольори дисплея вночі для зменшення втоми очей",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "Le mode Night Shift règle automatiquement les couleurs de votre écran la nuit pour réduire la fatigue visuelle.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Night Shift kan automatisk justere farverne på din skærm om natten for at nedsætte belastningen af dine øjne",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "Night Shift can automatically adjust the colours of your display at night to reduce eye strain",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "L'opzione “Night Shift” regola automaticamente l'intensità dei colori dello schermo e ti aiuta a ridurre l'affaticamento degli occhi durante le ore notturne",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Night Shift có thể tự động điều chỉnh màu của màn hình vào ban đêm để giảm mỏi mắt",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Opțiunea Night Shift poate să ajusteze automat culorile afișajului pe timpul nopții pentru a reduce solicitarea ochilor.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Night Shift peut régler automatiquement les couleurs d’affichage pour réduire la fatigue visuelle la nuit.",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "夜览可在夜间自动调节屏幕颜色，以缓解眼疲劳。",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Night Shift द्वारा रात के समय आपकी आँखों पर पड़ने वाले दबाव को कम करने के लिए आपके डिस्प्ले के रंग को ऑटोमैटिकली ऐडजस्ट किया जा सकता है",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "Night Shift może automatycznie modyfikować kolory ekranu w nocy, aby zmniejszyć zmęczenie oczu.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "「夜覽」會在晚間自動調整螢幕色調以紓緩眼睛疲勞",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Night Shift puede cambiar automáticamente los colores de tu pantalla para que esfuerces menos la vista durante la noche",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "El Night Shift pot ajustar automàticament els colors de la pantalla a la nit per reduir danys als ulls.",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "Para reduzir o esforço ocular, o Night Shift pode ajustar automaticamente as cores da tela à noite.",
        "filename" : "Localizable.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "تعمل ميزة الإضاءة الدافئة على ضبط ألوان الشاشة تلقائيًا في الليل للحد من إجهاد العين",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "Night Shift dapat menyesuaikan warna layar Anda secara otomatis pada malam hari untuk mengurangi kelelahan pada mata",
        "filename" : "Localizable.loctable",
        "language" : "id"
      },
      {
        "target" : "‏Night Shift יכול לשנות באופן אוטומטי את צבעי התצוגה שלך בלילה כדי להפחית מאמץ של העיניים",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "Night Shift voi muuttaa automaattisesti näytön värejä yöaikaan, jotta silmät rasittuisivat vähemmän.",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "Night Shift kan automatisk justere fargen på skjermen om kvelden for å gjøre den mer behagelig for øynene",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "Night Shiftでは、目の緊張を緩和するために夜間にディスプレイの色が自動的に調整されます。",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "Функция Night Shift может автоматически изменять цвета дисплея, чтобы уменьшить нагрузку на глаза в ночное время.",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "Night Shift може автоматично да настрои цветовете на екрана през нощта, за да намали умората на очите",
        "filename" : "Localizable.loctable",
        "language" : "bg"
      },
      {
        "target" : "Night Shift สามารถปรับโทนสีของจอภาพของคุณโดยอัตโนมัติในตอนกลางคืนเพื่อไม่ให้ปวดตา",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "Night Shift kan automatiskt justera färgerna på skärmen på natten så att du anstränger ögonen mindre.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      }
    ],
