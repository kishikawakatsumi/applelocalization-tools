    "EDIT_MODE_CHRONO_DENSITY_DESCRIPTION" : [
      {
        "target" : "تعرض مقاييس الوقت الأقل وحدات زمنية أصغر لقياس الفاصل الزمني بدقة أكبر.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ar"
      },
      {
        "target" : "Escalas mais pequenas apresentam unidades de tempo mais pequenas para uma medição mais precisa do tempo.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Οι χαμηλότερες χρονικές κλίμακες εμφανίζουν μικρότερες μονάδες χρόνου για πιο ακριβή μέτρηση μεσοδιαστημάτων.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "el"
      },
      {
        "target" : "Kleinere tijdschalen geven kleinere tijdeenheden weer voor meer nauwkeurige meting van intervallen.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "nl"
      },
      {
        "target" : "Les échelles de temps inférieures affichent des unités de temps plus petites pour une mesure des intervalles plus précise.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "fr"
      },
      {
        "target" : "Lower timescales display smaller units of time for more precise interval measurement.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "en"
      },
      {
        "target" : "Escalas de tempo menores exibem unidades menores para oferecer uma medição de intervalos mais precisa.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "pt"
      },
      {
        "target" : "Scalele de timp mai scăzute afișează unități mai mici pentru măsurarea mai precisă a intervalelor.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ro"
      },
      {
        "target" : "Lower timescales display smaller units of time for more precise interval measurement.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Escalas temporales menores muestran unidades de tiempo más pequeñas para medir los intervalos con más precisión.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Med kortare tidsskalor visas mindre tidsenheter för mer exakt intervallmätning.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "sv"
      },
      {
        "target" : "Lavere tidsskalaer viser mindre tidsenheder og giver mere præcis måling af tidsintervaller.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "da"
      },
      {
        "target" : "Les plus petites échelles de temps affichent de plus petites unités afin d’obtenir un intervalle de mesure plus précis.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "समय के छोटे पैमानों के लिए समय अधिक छोटी इकाइयों में प्रदर्शित किया जाता है जिससे कि समय अंतराल को सटीक ढंग से मापा जा सके।",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "hi"
      },
      {
        "target" : "Alemmissa aika-asteikoissa näkyvät pienemmät aikayksiköt tarkempaa aikavälin mittausta varten.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "fi"
      },
      {
        "target" : "Dolne skale czasowe wyświetlają mniejsze jednostki czasu, pozwalając na dokładniejsze mierzenie interwałów.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "pl"
      },
      {
        "target" : "קנה מידה קטן יותר של זמן מציג יחידות זמן קטנות יותר לקבלת מדידת מרווחים מדויקת יותר.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "he"
      },
      {
        "target" : "더 촘촘한 시계 눈금은 간격이 더 짧은 시간을 정밀하게 측정하여 표시합니다.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "ko"
      },
      {
        "target" : "มาตราส่วนเวลาที่น้อยลงจะแสดงหน่วยเวลาที่เล็กลงเพื่อช่วงเวลาการวัดที่แม่นยำมากขึ้น",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "th"
      },
      {
        "target" : "較低的時間刻度顯示較小的時間單位，以獲得更精確的間隔測量。",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Нижні шкали мають дрібніші одиниці часу для точнішого виміру інтервалів.",
        "filename" : "LocalizableCompanion.loctable",
        "language" : "uk"
      },
