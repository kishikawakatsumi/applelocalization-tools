      },
      {
        "target" : "Siri uses your location for things like answering questions and offering suggestions about what’s nearby.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Siri używa Twojego położenia, aby na przykład odpowiadać na pytania i podawać informacje dotyczące Twojego otoczenia.",
