{
  "loctablePath" : "\/System\/Library\/PreferenceBundles\/AccessibilitySettings.bundle\/GuidedAccessTimeRestrictionsSettings.loctable",
  "bundlePath" : "\/System\/Library\/PreferenceBundles\/AccessibilitySettings.bundle",
  "framework" : "AccessibilitySettings.bundle",
  "localizations" : {
    "GUIDED_ACCESS_TIME_RESTRICTIONS_TITLE_FOOTER" : [
      {
        "target" : "時間快結束時播放提示聲並朗讀剩下的「引導使用模式」時間。",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Възпроизвеждане на звук и изговаряне на оставащото време с контролиран достъп, преди да приключи.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "bg"
      },
      {
        "target" : "Putar bunyi dan atur agar waktu Akses Terpandu tersisa diucapkan sebelum waktu berakhir.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "id"
      },
      {
        "target" : "השמע קול ואמור כמה זמן נותר לפני תום הזמן שהוקצה ל״גישה מודרכת״.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "he"
      },
      {
        "target" : "Süre bitmeden bir ses çalın ve kalan Denetimli Erişim süresinin seslendirilmesini sağlayın.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "tr"
      },
      {
        "target" : "播放铃声并在“引导式访问”时限结束前播报剩余时间。",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "ส่งเสียงและบอกเวลาที่เหลือของการใช้งานเครื่องตามที่กำหนดก่อนเวลาจะหมด",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "th"
      },
      {
        "target" : "Émettre un son et énoncer le temps restant de la session Accès guidé avant qu’elle ne soit écoulée.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "fr"
      },
      {
        "target" : "Afspil en lyd eller få den resterende tid af Forenklet adgang læst op.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "da"
      },
      {
        "target" : "終了前に、サウンドを再生するか、残り時間を読み上げることができます。",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ja"
      },
      {
        "target" : "Mainkan bunyi dan biarkan baki masa Akses Dibantu dituturkan sebelum masa tamat.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ms"
      },
      {
        "target" : "Play a sound and have the remaining Guided Access time spoken before time ends.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Riproduce un suono e legge ad alta voce il tempo restante della sessione Accesso Guidato prima che scada.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "it"
      },
      {
        "target" : "Reproducirajte zvuk kako bi se izgovorilo preostalo vrijeme za vođeni pristup prije isteka vremena.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "hr"
      },
      {
        "target" : "Laat een geluid horen en laat de resterende tijd voor begeleide toegang uitspreken voordat de tijd om is.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "nl"
      },
      {
        "target" : "Phát âm thanh và yêu cầu đọc phần Truy cập Được hướng dẫn trước khi thời gian kết thúc.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "vi"
      },
      {
        "target" : "Reproduir un so i fer que l’accés guiat indiqui per veu el temps restant abans que s’acabi el temps.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ca"
      },
      {
        "target" : "Redați un sunet și ascultați enunțarea timpului rămas pentru Acces ghidat înainte de expirarea timpului.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ro"
      },
      {
        "target" : "Spill av en lyd og hør hvor mye tid av Begrenset tilgang som gjenstår, før tiden utløper.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "no"
      },
      {
        "target" : "사운드를 재생하고 사용법 유도 종료까지 남은 시간을 알려줍니다.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ko"
      },
      {
        "target" : "कोई ध्वनि बजाएँ और समय समाप्ति से पहले शेष गाइडेड ऐक्सेस समय बोलने दें।",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "hi"
      },
      {
        "target" : "Сповістити звуком і озвучувати залишок часу для поточного сеансу Керованого доступу.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "uk"
      },
      {
        "target" : "Reproduzir um som e fazer com que o tempo restante do Acesso Guiado seja falado antes que o tempo acabe.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Spiele einen Ton und eine gesprochene Ansage der verbleibenden Zeit für den geführten Zugriff ab, bevor die Zeit abläuft.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "de"
      },
      {
        "target" : "Prehrá zvuk alebo prerozpráva zostávajúci čas Asistovaného prístupu pred jeho vypršaním.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "sk"
      },
      {
        "target" : "時間快結束時播放提示聲，並朗讀剩餘的「指導模式」時間。",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Play a sound and have the remaining Guided Access time spoken before time ends.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Hang lejátszása és az Irányított hozzáférés hátralévő idejének kimondása, mielőtt az idő lejár.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "hu"
      },
      {
        "target" : "Toista ääni ja puhu Ohjatun käytön jäljellä oleva aika.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "fi"
      },
      {
        "target" : "Spela upp ett ljud och tala den återstående tiden för Guidad åtkomst.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "sv"
      },
      {
        "target" : "Play a sound and have the remaining Guided Access time spoken before time ends.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "en"
      },
      {
        "target" : "Antes de que el tiempo se agote, oír un sonido o una voz indicando el tiempo que queda con el acceso guiado.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "es"
      },
      {
        "target" : "تشغيل صوت ونطق الوقت المتبقي للوصول الموجه قبل انتهاء الوقت.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ar"
      },
      {
        "target" : "Reproduzir um som e enunciar o tempo que falta do Acesso guiado antes de terminar o tempo.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Αναπαραγωγή ήχου και εκφώνηση του υπόλοιπου χρόνου Καθοδηγούμενης πρόσβασης προτού λήξει ο χρόνος.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "el"
      },
      {
        "target" : "Se escuchará un sonido y el tiempo que le resta a Acceso guiado antes de que se agote.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Дыбысты ойнатып, «Басқарылмалы қолданыс» функциясының аяқталуына дейін қалған уақытты дыбыстау.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "kk"
      },
      {
        "target" : "Přehraje se zvuk a hlas oznámí čas zbývající do konce asistovaného přístupu.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "cs"
      },
      {
        "target" : "Émettre un son et énoncer le temps restant de la session Accès guidé avant qu’elle ne soit écoulée.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Przed upływem czasu Dostępu nadzorowanego odtworzony zostanie dźwięk i odczytany pozostały czas.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "pl"
      },
      {
        "target" : "Позволить устройству воспроизводить звук и произносить время, оставшееся до завершения работы гид‑доступа.",
        "filename" : "GuidedAccessTimeRestrictionsSettings.loctable",
        "language" : "ru"
      }
    ],
