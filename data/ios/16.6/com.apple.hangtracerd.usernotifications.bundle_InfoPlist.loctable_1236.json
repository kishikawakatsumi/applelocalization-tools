    "HANG_LOG_NOTIFICATION_SUMMARY_MILLISECONDS%@%@" : [
      {
        "target" : "Apka %2$@ na %1$@ ms zamrzla. Klepnutím zobrazíte záznamy.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "Ανιχνεύτηκε μια διακοπή απόκρισης διάρκειας %@ χιλιοστών δευτερολέπτου στο «%@». Αγγίξτε για προβολή των αρχείων καταγραφής.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "Appen %2$@ svarede ikke i %1$@ millisekunder. Tryk for at se logarkiver.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "target" : "%2$[tt]@で、%1$@ミリ秒のハングが検出されました。ログを表示するにはタップしてください。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "target" : "Se ha detectado una interrupción de %@ milisegundos en %@. Toca para ver los registros.",
