  "framework" : "NTKCTritiumSettings.bundle",
  "localizations" : {
    "TRITIUM_SETTINGS_DESCRIPTION" : [
      {
        "target" : "Pots triar quines complicacions mostren dades quan tens el canell abaixat.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ca"
      },
      {
        "target" : "Anda dapat memilih komplikasi mana yang menampilkan data saat tangan Anda diturunkan.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "id"
      },
      {
        "target" : "Anda boleh memilih komplikasi yang menunjukkan data apabila pergelangan tangan anda diturunkan.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ms"
      },
      {
        "target" : "आप यह चुन सकते हैं कि कलाई के नीचे रहने पर किन कॉम्प्लिकेशन में डेटा दिखाए जाएँ।",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "hi"
      },
      {
        "target" : "Можно выбрать расширения, данные которых отображаются, даже когда Вы не подняли запястье.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ru"
      },
      {
        "target" : "באפשרותך לבחור אילו תצוגות יציגו מידע כאשר היד לא מורמת.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "he"
      },
      {
        "target" : "你可以选择手腕放下时显示数据的复杂功能。",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Možete odabrati dodatke koji prikazuju podatke kad vam je zapešće spušteno.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "hr"
      },
      {
        "target" : "Puedes elegir qué complicaciones muestran datos cuando no tienes la muñeca levantada.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "es"
      },
      {
        "target" : "Bạn có thể lựa chọn những tổ hợp nào hiển thị dữ liệu khi đưa cổ tay xuống.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "vi"
      },
      {
        "target" : "You can choose which complications show data when your wrist is down.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Можете да избирате кои добавки показват данни, когато китката ви е отпусната надолу.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "bg"
      },
      {
        "target" : "คุณสามารถเลือกกลไกหน้าปัดที่จะแสดงข้อมูลเมื่อคุณวางข้อมือลงได้",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "th"
      },
      {
        "target" : "Voit valita, missä komplikaatioissa näkyy tietoja, kun ranteesi on alhaalla.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "fi"
      },
      {
        "target" : "손목을 내렸을 때에도 데이터를 표시할 컴플리케이션을 선택할 수 있습니다.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ko"
      },
      {
        "target" : "Kolunuz aşağıdayken hangi komplikasyonların veri göstereceğini seçebilirsiniz.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "tr"
      },
      {
        "target" : "Можна вибрати, які саме функції відображатимуть дані, коли руку опущено.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "uk"
      },
      {
        "target" : "Umožňuje vybrať komplikácie, ktoré budú zobrazovať dáta aj po spustení zápästia.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "sk"
      },
      {
        "target" : "Pode escolher as complicações que mostram dados quando baixa o pulso.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "你可以選擇手腕放下時要顯示資料的複雜功能。",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "You can choose which complications show data when your wrist is down.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Você pode escolher quais complicações mostram dados mesmo com o braço para baixo.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "pt"
      },
      {
        "target" : "Kiválaszthatja, hogy mely komplikációk jelenítsenek meg adatokat, amikor a csuklója le van engedve.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "hu"
      },
      {
        "target" : "手首を下げているときにどのコンプリケーションのデータを表示するかを選択することができます。",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ja"
      },
      {
        "target" : "Μπορείτε να επιλέξετε ποιες πολυπλοκότητες θα εμφανίζουν δεδομένα όταν είναι κατεβασμένος ο καρπός σας.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "el"
      },
      {
        "target" : "Je kunt bepalen op welke complicaties gegevens worden getoond als je je pols niet optilt.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "nl"
      },
      {
        "target" : "Du kannst auswählen, welche Komplikationen bei gesenktem Handgelenk Daten anzeigen.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "de"
      },
      {
        "target" : "Puedes elegir cuáles complicaciones muestran datos cuando bajas la muñeca.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "es_419"
      },
      {
        "target" : "你可以選擇放下手腕時要顯示資料的複雜功能。",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "يمكنك اختيار الإضافات التي تعرض البيانات عندما لا يكون معصمك مرفوعًا.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ar"
      },
      {
        "target" : "Білегіңіз төмен түсірілгенде деректер көрсетілетін кеңейтімдерді таңдауға болады.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "kk"
      },
      {
        "target" : "Vous pouvez choisir les complications qui affichent des données lorsque vous ne levez pas le poignet.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "fr"
      },
      {
        "target" : "Vous pouvez choisir les complications qui affichent des données quand votre poignet est baissé.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Zde můžete vybrat komplikace, jejichž data se budou zobrazovat i při svěšeném zápěstí.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "cs"
      },
      {
        "target" : "Puteți alege ce complicații să afișeze date atunci când încheietura mâinii este coborâtă.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "ro"
      },
      {
        "target" : "Du kan välja vilka komplikationer som ska visa data när handleden inte är höjd.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "sv"
      },
      {
        "target" : "Możesz wybrać komplikacje, które mają wyświetlać dane, gdy nadgarstek jest opuszczony.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "pl"
      },
      {
        "target" : "You can choose which complications show data when your wrist is down.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "en"
      },
      {
        "target" : "Du kan velge hvilke komplikasjoner som viser data når håndleddet er senket.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "no"
      },
      {
        "target" : "Puoi scegliere quali complicazioni mostrano dati quando il polso è abbassato.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "it"
      },
      {
        "target" : "Du kan vælge, hvilke komplikationer der viser data, når håndleddet ikke er løftet.",
        "filename" : "NTKTritiumSettings.loctable",
        "language" : "da"
      }
