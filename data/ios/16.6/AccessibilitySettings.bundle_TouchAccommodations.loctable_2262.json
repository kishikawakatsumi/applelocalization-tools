  "localizations" : {
    "TOUCH_ACCOMMODATIONS_USAGE_MESSAGE" : [
      {
        "target" : "Prilagodbe dodira mijenjaju geste koje koristite za upravljanje uređajem Apple Watch.\nSigurno želite nastaviti?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "hr"
      },
      {
        "target" : "Funkcja Udogodnienia dotyku modyfikuje gesty sterujące Apple Watch.\nCzy na pewno chcesz kontynuować?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "pl"
      },
      {
        "target" : "Touch Accommodations changes the gestures used to control your Apple Watch.\nAre you sure you want to continue?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "'Aangepaste aanraking' verandert de gebaren waarmee je je Apple Watch bedient.\nWeet je zeker dat je wilt doorgaan?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "nl"
      },
      {
        "target" : "Kosketusten mukautus muuttaa Apple Watchin ohjaamiseen käytettäviä eleitä.\nJatketaanko?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "fi"
      },
      {
        "target" : "Адаптації дотику змінюють рухи для керування вашим Apple Watch.\nСправді продовжити?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "uk"
      },
      {
        "target" : "Tilpasning af berøring ændrer de bevægelser, der bruges til at betjene dit Apple Watch.\nEr du sikker på, at du vil fortsætte?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "da"
      },
      {
        "target" : "Las facilidades táctiles modifican los gestos que se usan para controlar el Apple Watch.\n¿Seguro que quieres continuar?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "es"
      },
      {
        "target" : "Az Érintési beállítások megváltoztatja az Apple Watch vezérlésére használt kézmozdulatokat.\nBiztos benne, hogy folytatni szeretné?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "hu"
      },
      {
        "target" : "Τα Βοηθήματα αφής αλλάζουν τις χειρονομίες που χρησιμοποιούνται για έλεγχο του Apple Watch.\nΕίστε βέβαιοι ότι θέλετε να συνεχίσετε;",
        "filename" : "TouchAccommodations.loctable",
        "language" : "el"
      },
      {
        "target" : "タッチ調整によりApple Watchの操作に使用するジェスチャが変更されます。\n続けてもよろしいですか?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ja"
      },
      {
        "target" : "״התאמות למגע״ משנה את המחוות המשמשות לשליטה ב-Apple Watch.\nבטוח שברצונך להמשיך?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "he"
      },
      {
        "target" : "Touch Accommodations changes the gestures used to control your Apple Watch.\nAre you sure you want to continue?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "en"
      },
      {
        "target" : "L'opzione “Regolazione tocco” modifica i gesti usati per controllare Apple Watch.\nVuoi continuare?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "it"
      },
      {
        "target" : "Използваните жестове за управление на вашия Apple Watch, се променят от Улеснения за докосване.\nСигурни ли сте, че искате да продължите?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "bg"
      },
      {
        "target" : "Trykktilpassing endrer bevegelsene som brukes til å styre Apple Watch.\nEr du sikker på at du vil fortsette?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "no"
      },
      {
        "target" : "‏\"تسهيلات اللمس\" تغيّر الإيماءات المستخدمة للتحكم في الـ Apple Watch.\nهل ترغب بالتأكيد في المتابعة؟",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ar"
      },
      {
        "target" : "Touch Accommodations changes the gestures used to control your Apple Watch.\nAre you sure you want to continue?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "触控调节会更改用于控制Apple Watch的手势。\n你确定要继续吗？",
        "filename" : "TouchAccommodations.loctable",
        "language" : "yue_CN"
      },
      {
        "target" : "“Adaptări tactile” schimbă gesturile utilizate pentru a controla Apple Watch-ul.\nSigur doriți să continuați?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ro"
      },
      {
        "target" : "As Opções de toque alteram os gestos usados para controlar o Apple Watch.\nTem a certeza de que pretende continuar?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "« Adaptation aux pressions » modifie les gestes utilisés pour contrôler l’Apple Watch.\nSouhaitez-vous vraiment poursuivre ?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "fr"
      },
      {
        "target" : "Dokunma Kolaylıkları Apple Watch’unuzu denetlemek için kullanılan hareketleri değiştirir.\nSürdürmek istediğinizden emin misiniz?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "tr"
      },
      {
        "target" : "As Adaptações de Toque alteram os gestos usados para controlar o Apple Watch.\nTem certeza de que deseja continuar?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "pt"
      },
      {
        "target" : "Adaptation tactile modifie les gestes utilisés pour contrôler votre Apple Watch.\nSouhaitez-vous vraiment poursuivre?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "触控调节会更改用于控制Apple Watch的手势。\n你确定要继续吗？",
        "filename" : "TouchAccommodations.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "«Түрту әрекетін бейімдеу» функциясы Apple Watch сағатын басқару үшін қолданылатын қимылдарды өзгертеді.\nЖалғастыру қажеттігіне сенімдісіз бе?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "kk"
      },
      {
        "target" : "Med Pekhjälpmedel ändras gesterna som används till att styra Apple Watch.\nÄr du säker på att du vill fortsätta?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "sv"
      },
      {
        "target" : "터치 조절을 사용하면 Apple Watch의 명령 제스처가 변경됩니다.\n계속하겠습니까?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ko"
      },
      {
        "target" : "Touch-Anpassungen verwenden andere Bedienungsgesten für die Apple Watch.\nMöchtest du wirklich fortfahren?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "de"
      },
      {
        "target" : "การช่วยปรับการสัมผัสจะเปลี่ยนคำสั่งนิ้วที่ใช้ควบคุม Apple Watch\nคุณแน่ใจหรือไม่ว่าคุณต้องการดำเนินการต่อ",
        "filename" : "TouchAccommodations.loctable",
        "language" : "th"
      },
      {
        "target" : "「觸控調節」會更改控制Apple Watch的手勢。\n確定要繼續嗎？",
        "filename" : "TouchAccommodations.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "टच सुविधाएँ आपकी Apple Watch को नियंत्रित करने के लिए प्रयुक्त जेस्चर को परिवर्तित करता है।\nक्या आप निश्चित हैं कि आप जारी रखना चाहते हैं?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "hi"
      },
      {
        "target" : "「觸控調節」會更改控制Apple Watch的手勢。\n確定要繼續嗎？",
        "filename" : "TouchAccommodations.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Функция «Адаптация касания» изменяет жесты, используемые для управления Apple Watch.\nВы действительно хотите продолжить?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ru"
      },
      {
        "target" : "Les facilitats tàctils canvien els gestos que s’utilitzen per controlar l’Apple Watch.\nConfirmes que vols continuar?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ca"
      },
      {
        "target" : "Prispôsobenie dotykov mení gestá, ktorými ovládate Apple Watch.\nNaozaj chcete pokračovať?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "sk"
      },
      {
        "target" : "Penyesuaian Sentuhan menukar gerak isyarat yang digunakan untuk mengawal Apple Watch anda.\nAdakah anda pasti mahu teruskan?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "ms"
      },
      {
        "target" : "Přizpůsobení dotyků změní gesta používaná k ovládání Apple Watch.\nUrčitě chcete pokračovat?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "cs"
      },
      {
        "target" : "Thích nghi cảm ứng thay đổi các thao tác được sử dụng để điều khiển Apple Watch của bạn.\nBạn có chắc chắn muốn tiếp tục không?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "vi"
      },
      {
        "target" : "Las adaptaciones táctiles cambian los gestos usados para controlar tu Apple Watch.\n¿Quieres continuar?",
        "filename" : "TouchAccommodations.loctable",
        "language" : "es_419"
      },
      {
