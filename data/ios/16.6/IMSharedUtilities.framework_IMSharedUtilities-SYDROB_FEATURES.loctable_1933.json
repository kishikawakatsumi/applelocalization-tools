    "TS_EMERGENCY_USER_BODY_FIRST_MESSAGE" : [
      {
        "target" : "%@ har kontaktet nødetatene via satellitt og har delt meldingene med deg",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "no"
      },
      {
        "target" : "%[tt]@ได้ติดต่อบริการฉุกเฉินผ่านดาวเทียมและแชร์บทสนทนากับคุณ",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "th"
      },
      {
        "target" : "%@ hat die Rettungsdienste via Satellit kontaktiert und den Chat mit dir geteilt.",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "de"
      },
      {
        "target" : "%@ heeft via satelliet contact opgenomen met de hulpdiensten en heeft de chat met je gedeeld",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "nl"
      },
      {
        "target" : "%@ contatou os Serviços de Emergência via satélite e compartilhou a conversa com você",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "pt"
      },
      {
        "target" : "%@已透過衛星聯絡緊急服務並與你分享聊天內容",
        "filename" : "IMSharedUtilities-SYDROB_FEATURES.loctable",
        "language" : "zh_TW"
      },
