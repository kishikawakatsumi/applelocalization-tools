    "EDIT_MODE_TIMELAPSE_CONTENT_DESCRIPTION" : [
      {
        "target" : "Klokkeslettet på hvert sted vises basert på klokkeslettet der du selv befinner deg.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "no"
      },
      {
        "target" : "Әр геолокация үшін тәулік уақыты уақыт белдеуіндегі уақытқа байланысты өзгереді.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "kk"
      },
      {
        "target" : "El momento del día en cada sitio cambia según la hora en tu ubicación actual.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "es"
      },
      {
        "target" : "Время суток для каждого места изменяется в зависимости от времени в Вашем часовом поясе.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "ru"
      },
      {
        "target" : "يتغير الوقت من اليوم لكل موقع بناءًا على الوقت في موقعك الحالي.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "ar"
      },
      {
        "target" : "Each location’s time of day changes based on the time at your current location.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "A parte do dia de cada localização muda de acordo com o horário na sua localização atual.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "pt"
      },
      {
        "target" : "Jokaisen paikan vuorokaudenaika seuraa tämänhetkisen sijaintisi aikaa.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "fi"
      },
      {
        "target" : "आपके वर्तमान स्थान के आधार पर हर स्थान का दिन का समय बदल जाता है।",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "hi"
      },
      {
        "target" : "Masa dalam hari setiap lokasi berubah berasaskan masa di lokasi semasa anda.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "ms"
      },
      {
        "target" : "Vad klockan är på varje plats ändras baserat på vad klockan är där du befinner dig.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "sv"
      },
      {
        "target" : "Le moment de la journée dépeint pour chaque lieu varie en fonction de l’heure de votre position actuelle.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Vrijeme dana za svaku lokaciju mijenja se ovisno o vremenu na vašoj trenutačnoj lokaciji.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "hr"
      },
      {
        "target" : "Le moment de la journée de chaque lieu change en fonction de l’heure qu’il est à l’endroit où vous vous trouvez.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "fr"
      },
      {
        "target" : "Denní doba v každém místě se mění na základě aktuálního času v místě, kde právě jste.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "cs"
      },
      {
        "target" : "Thời gian trong ngày của mỗi vị trí thay đổi dựa trên thời gian tại vị trí hiện tại của bạn.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "vi"
      },
      {
        "target" : "Each location’s time of day changes based on the time at your current location.",
        "filename" : "Timelapse-Companion.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Minden helyszín napszakja az Ön aktuális helyzetének ideje szerint változik.",
