    "CLOUD_CALLING_SHOW_CARRIER_WEB_VIEW_ERROR_MESSAGE_WIFI" : [
      {
        "target" : "Per consentire le chiamate Wi-Fi su questo account, contatta il tuo gestore.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "it"
      },
      {
        "target" : "若要允许此帐户的Wi-Fi通话，请联系你的运营商。",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Για να επιτρέπονται οι Κλήσεις Wi-Fi σε αυτόν τον λογαριασμό, επικοινωνήστε με τον φορέα σας.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "el"
      },
      {
        "target" : "Per permetre les trucades per Wi-Fi en aquest compte, contacta amb l’operador.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ca"
      },
      {
        "target" : "כדי לאפשר את ״שיחות דרך רשת אלחוטית״ בחשבון זה, יש לפנות למפעיל הסלולרי.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "he"
      },
      {
        "target" : "Ak chcete v tomto účte povoliť Volania cez Wi-Fi, kontaktujte svojho operátora.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "sk"
      },
      {
        "target" : "Para activar llamadas por Wi-Fi en esta cuenta, ponte en contacto con tu operador.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Kontakt operatøren for å aktivere Wi‑Fi-anrop for denne kontoen.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "no"
      },
      {
        "target" : "Za omogućavanje Wi-Fi poziva na ovom računu, obratite se vašem operateru.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "hr"
      },
      {
        "target" : "للسماح بمكالمات Wi-Fi على هذا الحساب، قم بالاتصال بشركة الاتصالات.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ar"
      },
      {
        "target" : "Бұл аккаунтта Wi-Fi арқылы қоңырау шалу функциясына рұқсат беру үшін операторға хабарласыңыз.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "kk"
      },
      {
        "target" : "Untuk membenarkan panggilan Wi-Fi pada akaun ini, panggil pembawa anda.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ms"
      },
      {
        "target" : "Pentru a permite apelarea Wi‑Fi pentru acest cont, contactați operatorul dvs.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ro"
      },
      {
        "target" : "Para permitir ligações Wi-Fi nesta conta, contate sua operadora.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "pt"
      },
      {
        "target" : "Para permitir las llamadas por Wi-Fi en esta cuenta, ponte en contacto con tu operador.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "es"
      },
      {
        "target" : "Um WLAN-Anrufe mit diesem Account zu erlauben, wende dich an deinen Netzbetreiber.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "de"
      },
      {
        "target" : "इस खाते से वाई-फ़ाई कॉलिंग अनुमति प्राप्त करने के लिए अपने कैरियर से संपर्क करें।",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "hi"
      },
      {
        "target" : "Для Wi-Fi-викликів з цього рахунку зверніться до свого оператора.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "uk"
      },
      {
        "target" : "이 계정에서 Wi‑Fi 통화를 허용하려면 이동통신사에 문의하십시오.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ko"
      },
      {
        "target" : "За да разрешите Wi-Fi обаждания на тази регистрация, се свържете с вашия доставчик.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "bg"
      },
      {
        "target" : "Jos haluat sallia Wi-Fi-puhelut tällä tilillä, ota yhteys operaattoriisi.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "fi"
      },
      {
        "target" : "Để cho phép cuộc gọi Wi-Fi trên tài khoản này, hãy liên hệ với nhà cung cấp của bạn.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "vi"
      },
      {
        "target" : "To allow Wi-Fi calling on this account, contact your network provider.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Untuk mengizinkan panggilan Wi-Fi pada akun ini, hubungi operator Anda.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "id"
      },
      {
        "target" : "Ha engedélyezni akarja a Wi-Fi-hívásokat ebben a fiókban, akkor lépjen kapcsolatba a szolgáltatóval.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "hu"
      },
      {
        "target" : "Pour autoriser les appels Wi-Fi sur ce compte, contactez votre opérateur.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "fr"
      },
      {
        "target" : "Para permitir chamadas por Wi‑Fi através desta conta, contacte a sua operadora.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "このアカウントでWi-Fi通話を許可するには、通信事業者に問い合わせてください。",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ja"
      },
      {
        "target" : "Pour permettre les appels Wi-Fi sur ce compte, contactez votre opérateur.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Hvis du vil tillade Wi-Fi-opkald for dette abonnement, skal du kontakte din operatør.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "da"
      },
      {
        "target" : "ในการอนุญาตการโทรผ่าน Wi-Fi สำหรับบัญชีนี้ ให้ติดต่อผู้ให้บริการของคุณ",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "th"
      },
      {
        "target" : "Chcete‑li v tomto účtu povolit Wi‑Fi hovory, kontaktujte svého operátora.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "cs"
      },
      {
        "target" : "To allow Wi-Fi calling on this account, contact your service provider.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Чтобы разрешить вызовы по Wi‑Fi с этой учетной записью, обратитесь к своему оператору сотовой связи.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "ru"
      },
      {
        "target" : "To allow Wi-Fi calling on this account, contact your carrier.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "en"
      },
      {
        "target" : "Kontakta din operatör om du vill tillåta Wi-Fi-samtal på det här kontot.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "sv"
      },
      {
        "target" : "Neem contact op met je aanbieder om bellen via wifi in te schakelen voor deze account.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "nl"
      },
      {
        "target" : "如要在此帳户啟用「Wi-Fi通話」，請聯絡你的電訊商。",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Bu hesapta Wi-Fi ile Arama’ya izin vermek için operatörünüze danışın.",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "tr"
      },
      {
        "target" : "若要允許此帳號的「Wi-Fi通話」，請聯絡你的電信業者。",
        "filename" : "CloudCallingURLController.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Aby włączyć rozmowy przez Wi‑Fi na tym koncie, skontaktuj się z operatorem.",
