{
  "bundlePath": "/System/Library/PrivateFrameworks/PairingProximity.framework",
  "framework": "PairingProximity.framework",
  "localizations": {
    "WATCH_NEARBY_MESSAGE": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Um dieses iPhone mit einer Apple Watch-App zu koppeln, muss die Apple Watch-App vom App Store wiederhergestellt werden."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "כדי לקשר iPhone זה עם Apple Watch, יהיה עליך לשחזר את יישום ה-Apple Watch דרך ה-App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "لإقران هذا الـ iPhone مع Apple Watch، ستحتاج إلى استعادة تطبيق Apple Watch من الـ App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Για ζευγοποίηση αυτού του iPhone με ένα Apple Watch, πρέπει να επαναφέρετε την εφαρμογή Apple Watch από το App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "このiPhoneをApple Watchとペアリングするには、Apple Watch AppをApp Storeから復元する必要があります。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "To pair this iPhone with an Apple Watch, you’ll need to restore the Apple Watch app from the App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Щоб спарити цей iPhone з Apple Watch, вам потрібно відновити програму Apple Watch з App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Para enlazar este iPhone con un Apple Watch, tendrás que restaurar la app Apple Watch mediante App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Para emparelhar este iPhone com um Apple Watch, tem de restaurar a aplicação Apple Watch a partir da App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "Para enlazar este iPhone con un Apple Watch, deberás restaurar la app Apple Watch desde App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Hvis du vil danne par mellem denne iPhone og et Apple Watch, skal du gendanne appen Apple Watch fra App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Per abbinare iPhone con Apple Watch, devi ripristinare l'app Watch da App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Ak chcete tento iPhone spárovať s hodinkami Apple Watch, v App Store budete musieť obnoviť apku pre Apple Watch."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "若要将此iPhone与Apple Watch配对，您需要从App Store还原Apple Watch App。"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_BR",
        "target": "Para emparelhar este iPhone com um Apple Watch, você precisará restaurar o app Watch na App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Untuk memasangkan iPhone ini dengan Apple Watch, anda perlu memulihkan app Apple Watch daripada App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Om du vill parkoppla denna iPhone med en Apple Watch måste du återskapa Apple Watch-appen från App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "To pair this iPhone with an Apple Watch, you’ll need to restore the Apple Watch app from the App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Chcete-li spárovat iPhone s Apple Watch, je nutné obnovit z App Storu aplikaci Apple Watch."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "이 iPhone을 Apple Watch에 페어링하려면, App Store에서 Apple Watch 앱을 복원해야 합니다."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "Du må gjenopprette Apple Watch-appen fra App Store for å koble iPhone og Apple Watch sammen."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Ha párosítani szeretné ezt az iPhone-t egy Apple Watchcsal, akkor vissza kell állítania az Apple Watch appot az App Store-ból."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "Bu iPhone’u bir Apple Watch ile eşlemek için App Store’dan Apple Watch uygulamasını geri yüklemeniz gerekir."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Aby połączyć tego iPhone'a w parę z Apple Watch, musisz odtworzyć aplikację Apple Watch z App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "Pour jumeler cet iPhone avec une Apple Watch, vous devez restaurer l’app Watch à partir de l’App Store"
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Để ghép đôi iPhone này với Apple Watch, bạn sẽ cần khôi phục ứng dụng Apple Watch từ App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Чтобы создать пару между этим iPhone и часами Apple Watch, необходимо восстановить приложение Apple Watch из App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "To pair this iPhone with an Apple Watch, you’ll need to restore the Apple Watch app from the App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "Pour jumeler cet iPhone à une Apple Watch, vous devez restaurer l’app Apple Watch depuis l’App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Jotta voit muodostaa parin tästä iPhonesta ja Apple Watchista, sinun on palautettava Apple Watch ‑appi App Storesta."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Untuk memasangkan iPhone ini dengan Apple Watch, Anda harus memulihkan app Apple Watch dari App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Om deze iPhone te koppelen met een Apple Watch, moet je de Apple Watch-app terugzetten via de App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "ในการจับคู่ iPhone เครื่องนี้กับ Apple Watch คุณจะต้องกู้คืนแอป Apple Watch จาก App Store"
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Pentru a asocia acest iPhone cu un Apple Watch, va trebui să restaurați aplicația Apple Watch din App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "要將此iPhone配對Apple Watch，你需要在App Store還原Apple Watch App。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Za uparivanje ovog iPhonea s Apple Watchem trebat ćete obnoviti aplikaciju Apple Watch iz App Storea."
      },
      {
        "filename": "Localizable.strings",
        "language": "hi",
        "target": "इस iPhone को किसी Apple Watch के साथ पेयर करने हेतु आपको Apple Watch ऐप को App Store से रीस्टोर करना होगा।"
      },
      {
        "filename": "Localizable.strings",
        "language": "ca",
        "target": "Per enllaçar l’iPhone amb un Apple Watch, cal que restauris l’app Apple Watch des de l’App Store."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_TW",
        "target": "若要將此iPhone與Apple Watch配對，您需要從App Store回復Apple Watch App。"
      }
