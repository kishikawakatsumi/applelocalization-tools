    "ONBOARDING_WATCH_BODY_RR" : [
      {
        "target" : "El Apple Watch puede registrar cuánto duermes junto con las fases del sueño que atraviesas y despertarte con una alarma en tu muñeca. También puede monitorear tu frecuencia respiratoria.",
        "filename" : "Localizable-Acacia.loctable",
