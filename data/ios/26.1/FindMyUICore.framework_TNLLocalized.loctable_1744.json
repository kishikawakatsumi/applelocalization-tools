    "TNL_REMIND_ALERT_MESSAGE" : [
      {
        "language" : "ms",
        "target" : "Masalah telah berlaku. Sila cuba lagi atau pergi ke Akaun Apple anda dalam Seting untuk mendayakan Cari dari sana.",
