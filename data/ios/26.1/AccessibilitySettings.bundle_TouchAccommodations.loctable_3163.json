    "TOUCH_ACCOMMODATIONS_USAGE_MESSAGE" : [
      {
        "language" : "ms",
        "target" : "Penyesuaian Sentuhan menukar gerak isyarat yang digunakan untuk mengawal Apple Watch anda.\nAdakah anda pasti mahu meneruskan?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "es",
        "target" : "Las facilidades táctiles modifican los gestos que se usan para controlar el Apple Watch.\n¿Seguro que quieres continuar?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "bn",
        "target" : "টাচ আকোমোডেশন আপনার Apple Watch-কে নিয়ন্ত্রণ করার জন্য ব্যবহৃত জেসচারগুলি পরিবর্তন করে।\nআপনি কি চালিয়ে যাওয়ার ব্যাপারে নিশ্চিত?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "ru",
        "target" : "Функция «Адаптация касания» изменяет жесты, используемые для управления Apple Watch.\nВы действительно хотите продолжить?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "hr",
        "target" : "Prilagodbe dodira mijenjaju geste koje koristite za upravljanje uređajem Apple Watch.\nSigurno želite nastaviti?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "th",
        "target" : "การช่วยปรับการสัมผัสจะเปลี่ยนคำสั่งนิ้วที่ใช้ควบคุม Apple Watch\nคุณแน่ใจหรือไม่ว่าคุณต้องการดำเนินการต่อ",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "ca",
        "target" : "Les facilitats tàctils canvien els gestos que s’utilitzen per controlar l’Apple Watch.\nConfirmes que vols continuar?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "te",
        "target" : "మీ Apple Watchను కంట్రోల్ చేయడానికి ఉపయోగించే జెశ్చర్స్‌ను టచ్ సంబంధిత సదుపాయాలు మారుస్తాయి.\nమీరు ఖచ్చితంగా కొనసాగించాలనుకుంటున్నారా?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "id",
        "target" : "Akomodasi Sentuh mengubah gerakan yang digunakan untuk mengontrol Apple Watch Anda.\nApakah Anda yakin ingin melanjutkan?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "sl",
        "target" : "Prilagoditve dotika spremenijo kretnje, ki se uporabljajo za upravljanje ure Apple Watch.\nSte prepričani, da želite nadaljevati?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "da",
        "target" : "Tilpasning af berøring ændrer de bevægelser, der bruges til at betjene dit Apple Watch.\nEr du sikker på, at du vil fortsætte?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "pa",
        "target" : "ਟੱਚ ਸੁਵਿਧਾਵਾਂ ਤੁਹਾਡੀ Apple Watch ਨੂੰ ਕੰਟਰੋਲ ਕਰਨ ਦੇ ਲਈ ਵਰਤੇ ਗਏ ਜੈਸਚਰ ਨੂੰ ਬਦਲਦੀਆਂ ਹਨ।\nਕੀ ਤੁਸੀਂ ਯਕੀਨੀ ਤੌਰ ‘ਤੇ ਜਾਰੀ ਰੱਖਣਾ ਚਾਹੁੰਦੇ ਹੋ?",
        "filename" : "TouchAccommodations.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "Touch Accommodations changes the gestures used to control your Apple Watch.\nAre you sure you want to continue?",
        "filename" : "TouchAccommodations.loctable"
