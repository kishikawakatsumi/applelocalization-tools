      },
      {
        "language" : "vi",
        "target" : "“%@” muốn thêm các bài tập vào Apple Watch. Ứng dụng cũng sẽ có thể đọc xem những bài tập này đã được hoàn thành hay chưa.",
        "filename" : "Localizable.loctable"
      },
      {
