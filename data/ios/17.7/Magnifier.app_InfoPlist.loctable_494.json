        "target" : "L’accesso alla fotocamera ti consente di utilizzarla per visualizzare e ingrandire oggetti.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Accesul la cameră vă permite să vizualizați pe ecran și să măriți lucrurile cu ajutorul camerei.",
        "language" : "ro"
      },
      {
        "language" : "nl",
        "target" : "Met toegang tot de camera kun je dingen bekijken en vergroten met de camera.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ja",
        "filename" : "InfoPlist.loctable",
