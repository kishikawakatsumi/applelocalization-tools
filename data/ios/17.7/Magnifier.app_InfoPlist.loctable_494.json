{
  "framework" : "Magnifier.app",
  "loctablePath" : "\/System\/Library\/AppPlaceholders\/Magnifier.app\/InfoPlist.loctable",
  "localizations" : {
    "NSRegulatoryPrivacyDisclosureCamera" : [
      {
        "target" : "Přístup k fotoaparátu vám umožňuje prohlížet si a zvětšovat různé věci pomocí fotoaparátu.",
