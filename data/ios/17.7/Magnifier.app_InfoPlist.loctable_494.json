    "NSRegulatoryPrivacyDisclosureSummary" : [
      {
        "language" : "cs",
        "target" : "Abyste mohli zobrazovat a zvětšovat obsah, bude aplikace Lupa využívat bezpečný přístup k datům a čidlům, například k fotkám a fotoaparátu.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Để cho phép bạn xem và phóng đại nội dung, Kính lúp sẽ truy cập bảo mật vào dữ liệu của bạn và các cảm biến như camera.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "pl",
        "target" : "Aby umożliwić Ci wyświetlanie i powiększanie obrazów, aplikacja Luba będzie w bezpieczny sposób uzyskiwać dostęp do danych i czujników, na przykład aparatu."
      },
      {
        "language" : "el",
        "target" : "Για προβολή και μεγέθυνση περιεχομένου, η Μεγέθυνση θα προσπελάζει με ασφάλεια τα δεδομένα και τους αισθητήρες σας, όπως η κάμερα.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "uk",
        "target" : "Щоб ви могли переглядати й наближати вміст, програма «Лупа» використовуватиме захищений доступ до ваших даних і датчиків, як‑от камери.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "To allow you to view and magnify content, Magnifier will securely access your data and sensors such as camera.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
