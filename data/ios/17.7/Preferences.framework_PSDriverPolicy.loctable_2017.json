    "FORM_DESCRIPTION" : [
      {
        "target" : "आपके डिवाइस की फ़ंक्शनैलिटी को विस्तारित करने के लिए ड्राइवर बैकग्राउंड में काम करते हैं। वे ऐप्स को बाहरी हार्डवेयर से संचार करने की सुविधा प्रदान करते हैं।",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "hi"
      },
      {
        "target" : "Els controladors treballen en segon pla per ampliar les funcionalitats del dispositiu. També permeten que les apps es comuniquin amb el maquinari extern.",
        "language" : "ca",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "language" : "en_GB",
        "filename" : "PSDriverPolicy.loctable",
        "target" : "Drivers work in the background to extend the functionality of your device. They allow apps to communicate with external hardware."
      },
      {
        "language" : "es_419",
        "filename" : "PSDriverPolicy.loctable",
        "target" : "Los drivers trabajan en segundo plano para extender la funcionalidad de tu dispositivo y permiten que las apps se comuniquen con hardware externo."
      },
      {
        "language" : "bg",
        "filename" : "PSDriverPolicy.loctable",
        "target" : "Драйверите работят във фонов режим, за да разширят функционалността на вашето устройство. Те позволяват на приложенията да комуникират с външен хардуер."
      },
      {
        "filename" : "PSDriverPolicy.loctable",
        "target" : "Driverele rulează în fundal pentru a extinde funcționalitatea dispozitivului dvs. Acestea permit aplicațiilor să comunice cu hardware‑ul extern.",
        "language" : "ro"
      },
      {
        "target" : "Os drivers operam em segundo plano para ampliar a funcionalidade do seu dispositivo. Eles permitem que os apps se comuniquem com o hardware externo.",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Treiber arbeiten im Hintergrund und erweitern die Funktionen deines Geräts. Apps können mit deren Hilfe mit externer Hardware kommunizieren.",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "de"
      },
      {
        "target" : "Los drivers se ejecutan en segundo plano para mejorar la funcionalidad de tu dispositivo y permiten que las apps se comuniquen con el hardware externo.",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "es"
      },
      {
        "language" : "uk",
        "target" : "Працюючи у фоновому режимі, драйвери розширюють функціональні можливості вашого пристрою. Програми використовують їх для звʼязку із зовнішнім обладнанням.",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "filename" : "PSDriverPolicy.loctable",
        "language" : "fr_CA",
        "target" : "Les pilotes fonctionnent en arrière-plan pour étendre la fonctionnalité de votre appareil. Ils permettent aux apps de communiquer avec des périphériques externes."
      },
      {
        "target" : "Drivrutiner körs i bakgrunden så att enhetens funktioner utökas. De gör att appar kan kommunicera med extern maskinvara.",
        "language" : "sv",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "language" : "id",
        "target" : "Driver bekerja di latar belakang untuk memperluas fungsionalitas perangkat Anda. Driver memungkinkan app untuk berkomunikasi dengan perangkat keras eksternal.",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "target" : "Sterowniki rozszerzają funkcjonalność urządzenia, działając w tle. Pozwalają aplikacjom komunikować się z urządzeniami zewnętrznymi.",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "pl"
      },
      {
        "target" : "Ovladače pracují na pozadí a rozšiřují funkčnost vašeho zařízení. Umožňují aplikacím komunikovat s externím hardwarem.",
        "language" : "cs",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "target" : "تعمل برامج التشغيل في الخلفية لتوسيع وظائف جهازك، فهي تسمح للتطبيقات بالاتصال بالأجهزة الخارجية.",
        "language" : "ar",
        "filename" : "PSDriverPolicy.loctable"
      },
      {
        "target" : "Sürücüler, aygıtınızın işlevselliğini genişletmek için arka planda çalışır ve uygulamaların harici donanımlarla iletişim kurmasına izin verir.",
        "filename" : "PSDriverPolicy.loctable",
        "language" : "tr"
