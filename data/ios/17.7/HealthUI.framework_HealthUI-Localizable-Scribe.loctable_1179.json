      },
      {
        "language" : "cs",
        "target" : "S vaším souhlasem bude Siri smět číst a zapisovat některá data aplikace Zdraví. Při zpracovávání vašich požadavků na Siri tato data neopouštějí vaše zařízení.",
        "filename" : "HealthUI-Localizable-Scribe.loctable"
      },
      {
        "filename" : "HealthUI-Localizable-Scribe.loctable",
        "language" : "es_419",
