    "j7xx.value" : [
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "zh_CN",
        "target" : "起伏又轮廓分明的表面上缀着色彩鲜艳的围挡结构，深色液态金属流淌其间。"
      },
      {
        "target" : "Metal líquido escuro, com frisos de cores vibrantes, flui sobre uma superfície marcada por curvas e contornos.",
        "language" : "pt_PT",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "language" : "he",
        "target" : "מתכת נוזלית כהה, ספוגה בקווים תוחמים עשירים ובוהקים, זורמת על משטח מעוקל וצורני.",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "target" : "Жарық толқындармен қанықтырылған күңгірт, сұйық металл иілген сызық және сызылған бет бойымен таралады.",
        "filename" : "Accessibility-J717.loctable",
        "language" : "kk"
      },
      {
        "language" : "yue_CN",
        "target" : "起伏又轮廓分明的表面上缀着色彩鲜艳的围挡结构，深色液态金属流淌其间。",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "language" : "pl",
        "filename" : "Accessibility-J717.loctable",
        "target" : "Ciemny, ciekły metal, układający się w jaskrawe kształty i opływający zakrzywioną, wyprofilowaną powierzchnię."
      },
      {
        "language" : "tr",
        "filename" : "Accessibility-J717.loctable",
        "target" : "Canlı setlerle dolu koyu, sıvı bir metal; eğimli ve konturlu bir yüzeyde akıyor."
      },
      {
        "target" : "Темный жидкий металл обтекает изогнутую рельефную поверхность по контуру с радужными разводами.",
        "language" : "ru",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "ko",
        "target" : "생동감 넘치는 윤곽으로 가득찬 어두운 색의 액체형 메탈이 둥글게 굴곡진 표면을 따라 흘러내립니다."
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "vi",
        "target" : "Kim loại lỏng tối màu, được bao quanh bởi các gờ nổi sống động, chảy trên một bề mặt cong và uốn lượn."
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "language" : "zh_TW",
        "target" : "深色的液態金屬填滿動態孔洞，在彎彎曲曲的表面上流動。"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "target" : "Mørkt, flydende metal med farverige forhøjninger flyder over en overflade med kurver og konturer.",
        "language" : "da"
      },
      {
        "language" : "nl",
        "target" : "Donker, vloeibaar metaal, omgeven door levendige randen, stroomt over een gebogen en gevormd oppervlak.",
        "filename" : "Accessibility-J717.loctable"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "target" : "Tamni tekući metal, prožet živopisnim bedemima, teče preko zakrivljene i konturirane površine.",
        "language" : "hr"
      },
      {
        "filename" : "Accessibility-J717.loctable",
        "target" : "Dark, liquid metal, imbued with vibrant ramparts, flows over a curved and contoured surface.",
        "language" : "en_IN"
      },
