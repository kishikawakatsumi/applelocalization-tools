    "BRIDGE_APP_VIEW_HEADER_TEXT" : [
      {
        "language" : "es_419",
        "target" : "Presiona la Digital Crown en tu Apple Watch para acceder a todas tus apps. Selecciona tu diseño preferido en las opciones de abajo.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "bg",
        "target" : "Натиснете коронката Digital Crown на вашия Apple Watch, за да влизате във всички ваши приложения. Изберете предпочитаната от вас подредба на приложенията от възможностите отдолу."
      },
      {
        "target" : "在Apple Watch上按下数码表冠访问所有App。从下方选择首选App布局。",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Stlačením korunky Digital Crown na vašich Apple Watch zobrazíte všetky apky. Nižšie môžete vybrať preferované rozloženie apiek.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "sk"
      },
      {
        "language" : "sv",
        "target" : "Tryck på Digital Crown på Apple Watch så kommer du åt alla dina appar. Välj önskad applayout bland alternativen nedan.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "hu",
        "target" : "Nyomja meg a Digital Crownt az Apple Watchon, ha hozzá szeretne férni az összes appjához. Válassza ki az alábbiak közül, hogy melyik appelrendezést részesíti előnyben."
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "target" : "Apăsați coroana Digital Crown de pe Apple Watch pentru a accesa toate aplicațiile. Selectați aranjamentul preferat pentru aplicații dintre opțiunile de mai jos.",
        "language" : "ro"
      },
      {
        "target" : "Tryk på Digital Crown på dit Apple Watch for at få adgang til alle dine apps. Vælg dit foretrukne applayout fra nedenstående muligheder.",
        "language" : "da",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "Appuyez sur la Digital Crown de votre Apple Watch pour accéder à toutes vos apps. Sélectionnez la disposition des apps que vous préférez parmi les choix ci-dessous.",
        "language" : "fr_CA",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "Trykk på Digital Crown på Apple Watch for å se alle appene dine. Velg den foretrukne appvisningen fra valgene nedenfor.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "no"
      },
      {
        "target" : "Πιέστε το Digital Crown στο Apple Watch για πρόσβαση σε όλες τις εφαρμογές σας. Επιλέξτε την προτιμώμενη διάταξη εφαρμογών παρακάτω.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "el"
      },
      {
        "target" : "Premi la Digital Crown su Apple Watch per accedere a tutte le tue app. Seleziona il tuo layout preferito per le app tra quelli disponibili qui sotto.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "it"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "ru",
        "target" : "Нажмите колесико Digital Crown на своих Apple Watch для доступа к приложениям. Выберите один из предложенных видов представления приложений."
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "target" : "Натисніть Digital Crown на Apple Watch, щоб отримати доступ до всіх своїх програм. Виберіть улюблену схему екрана зі списку нижче.",
        "language" : "uk"
      },
      {
        "target" : "Stisknutím korunky Digital Crown na Apple Watch přejdete na seznam všech aplikací. Níže můžete vybrat rozložení aplikací, kterému dáváte přednost.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "cs"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "pt_BR",
        "target" : "Pressione a Digital Crown no Apple Watch para acessar todos os apps. Selecione seu layout preferido nas opções abaixo."
      },
      {
        "language" : "de",
        "target" : "Drücke die Digital Crown auf deiner Apple Watch, um auf all deine Apps zuzugreifen. Wähle aus den Optionen unten dein bevorzugtes App-Layout aus.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "Paina Apple Watchin Digital Crownia, niin saat käyttöösi kaikki appisi. Valitse haluamasi appien asettelu alla olevista vaihtoehdoista.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "fi"
      },
