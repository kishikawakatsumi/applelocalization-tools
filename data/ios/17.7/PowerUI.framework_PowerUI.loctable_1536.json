    "FIRST_NOTIFY_BODY" : [
      {
        "language" : "ko",
        "filename" : "PowerUI.loctable",
        "target" : "저전력 모드에서는 메일 가져오기, 백그라운드 앱 새로 고침, 자동 다운로드 및 일부 시각적인 효과가 감소되거나 비활성화됩니다."
      },
      {
        "language" : "ms",
        "target" : "Ambil Mail, segar semula app latar belakang, muat turun automatik dan sesetengah kesan visual dikurangkan atau dinyahdayakan dalam Mod Kuasa Rendah.",
        "filename" : "PowerUI.loctable"
      },
      {
        "language" : "zh_TW",
        "target" : "「低耗電模式」會降低或停用郵件擷取、背景App重新整理、自動下載和部分視覺效果。",
        "filename" : "PowerUI.loctable"
      },
      {
        "target" : "Fetch Mail, penyegaran app latar belakang, pengunduhan otomatis, dan sebagian efek visual dikurangi atau dinonaktifkan di Mode Daya Rendah.",
        "language" : "id",
        "filename" : "PowerUI.loctable"
      },
      {
        "language" : "tr",
        "filename" : "PowerUI.loctable",
        "target" : "Düşük Güç Modu’nda e-postaları alma, arka planda uygulama yenileme, otomatik indirmeler ve bazı görsel efektler azaltılır veya etkisizleştirilir."
      },
      {
        "language" : "ar",
        "target" : "في نمط الطاقة المنخفضة، يتم تقليل أو تعطيل جلب البريد، وتحديث حالة التطبيقات في الخلفية، والتنزيلات التلقائية، وبعض التأثيرات البصرية.",
        "filename" : "PowerUI.loctable"
      },
      {
        "filename" : "PowerUI.loctable",
        "language" : "ca",
        "target" : "Amb el mode de baix consum, l’obtenció de correu, les actualitzacions d’apps en segon pla i alguns efectes visuals es redueixen o desactiven."
      },
      {
        "target" : "Mail fetch, background app refresh, automatic downloads and some visual effects are reduced or disabled in Low Power Mode.",
        "filename" : "PowerUI.loctable",
        "language" : "en_GB"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "A obtenção de dados de correio, a atualização de aplicações em segundo plano, as descargas automáticas e alguns efeitos visuais são reduzidos ou desativados no modo de baixo consumo.",
        "language" : "pt_PT"
      },
      {
        "target" : "En el modo de bajo consumo se reduce o se desactiva la comprobación automática del correo, la actualización de apps en segundo plano, las descargas automáticas y algunos efectos visuales.",
        "language" : "es",
        "filename" : "PowerUI.loctable"
      },
      {
        "target" : "Проверка почты, фоновое обновление приложений, автоматические загрузки и некоторые визуальные эффекты отключаются в режиме энергосбережения.",
        "filename" : "PowerUI.loctable",
        "language" : "ru"
      },
      {
        "target" : "निम्न पावर मोड में मेल फ़ेच होना, बैकग्राउंड ऐप रीफ़्रेश, ऑटोमैटिक डाउनलोड और कुछ दृश्यात्मक प्रभाव कम या अक्षम कर दिए जाते हैं।",
        "filename" : "PowerUI.loctable",
        "language" : "hi"
      },
      {
        "language" : "hr",
        "filename" : "PowerUI.loctable",
        "target" : "Dohvaćanje e-mail poruka, osvježavanje aplikacija u pozadini, automatska preuzimanja i neki vizualni efekti bit će smanjeni ili isključeni u Modu slabog napajanja."
      },
      {
        "target" : "Извличането на поща, обновяването на приложения във фонов режим, автоматичното изтегляне и някои визуални ефекти се ограничават или изключват при режим Пестене на енергия.",
        "filename" : "PowerUI.loctable",
        "language" : "bg"
      },
      {
        "language" : "sk",
        "filename" : "PowerUI.loctable",
        "target" : "V režime nízkej spotreby je obmedzené alebo vypnuté načítavanie emailov, osviežovanie apiek na pozadí, automatické sťahovanie a niektoré vizuálne efekty."
      },
      {
        "language" : "fi",
        "filename" : "PowerUI.loctable",
        "target" : "Alhaisen virran tilassa sähköpostien hakua, appien päivitystä taustalla, automaattisia latauksia ja eräitä visuaalisia tehosteita vähennetään tai ne poistetaan käytöstä."
      },
      {
        "target" : "Η μετάκληση email, η ανανέωση εφαρμογών στο παρασκήνιο, οι αυτόματες λήψεις, και κάποια οπτικά εφέ μειώνονται ή απενεργοποιούνται, όταν η συσκευή βρίσκεται σε Λειτουργία χαμηλής ισχύος.",
        "filename" : "PowerUI.loctable",
        "language" : "el"
      },
      {
        "target" : "Ahorrar batería reduce o desactiva obtener correos, actualizar apps en segundo plano y algunos efectos visuales.",
        "filename" : "PowerUI.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Mail fetch, background app refresh, automatic downloads, and some visual effects are reduced or disabled in Low Power Mode.",
        "filename" : "PowerUI.loctable",
        "language" : "en"
      },
