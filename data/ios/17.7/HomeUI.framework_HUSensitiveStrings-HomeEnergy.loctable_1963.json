    "HUNewFeaturesView_Description_HomeEnergy" : [
      {
        "language" : "zh_HK",
        "target" : "查看本地的潔淨電力時間表來協助你規劃家中的用電時間。",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "es",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "Consulta los horarios de suministro de energía limpia en tu zona para ayudarte a planificar el consumo eléctrico en tu casa."
      },
      {
        "language" : "tr",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "Evinizde ne zaman elektrik kullanacağınızı planlamanıza yardımcı olması için yerel temiz elektrik saatlerini görün."
      },
      {
        "target" : "Consultez les horaires de disponibilité d’énergie verte dans votre secteur pour vous aider à mieux prévoir votre utilisation de l’électricité dans votre domicile.",
        "language" : "fr",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "el",
        "target" : "Δείτε τα τοπικά προγράμματα παροχής καθαρής ηλεκτρικής ενέργειας για να σας βοηθήσουν να σχεδιάσετε πότε να χρησιμοποιήσετε το ρεύμα στην οικία σας."
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "hi",
        "target" : "आप अपने घर में बिजली का इस्तेमाल कब करें इसकी योजना बनाने के लिए स्थानीय स्वच्छ ऊर्जा इलेक्ट्रिसिटी टाइमलाइन देखें।"
      },
      {
        "target" : "Veja os horários da eletricidade limpa local para ajudar a planejar o uso da eletricidade na sua casa.",
        "language" : "pt_BR",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "target" : "See local clean electricity timelines to help you plan when to use electricity in your home.",
        "language" : "en_AU",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "ro",
        "target" : "Consultați programul local de furnizare a energiei verzi pentru a vă ajuta să planificați consumul de energie electrică în locuința dvs.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "uk",
        "target" : "Перегляньте графіки надання «чистої» електроенергії, щоб ефективніше планувати використання електроенергії в домі."
      },
      {
        "target" : "Lihat garis masa tenaga elektrik bersih tempatan untuk membantu anda merancang masa untuk menggunakan elektrik di rumah anda.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "ms"
      },
      {
        "language" : "it",
        "target" : "Visualizza gli orari locali per l’energia pulita per aiutarti a programmare l’uso dell’elettricità nell’abitazione.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "target" : "See local clean electricity timelines to help you plan when to use electricity in your home.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "en_IN"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "Časové osi miestnych zdrojov čistej energie vám pomôžu pri plánovaní používania elektriny v domácnosti.",
        "language" : "sk"
      },
      {
        "target" : "Brug de lokale tidsplaner for ren elektricitet som en hjælp til at planlægge, hvornår det er bedst at bruge elektricitet i hjemmet.",
        "language" : "da",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "Вижте местните графики за чисто електричество, за да ви помогне да планирате кога да използвате електричество в дома си.",
        "language" : "bg"
      },
      {
        "language" : "ko",
        "target" : "지역 청정 전력 타임라인을 확인하여 집에서 전력 사용 시점을 계획하는 데 도움을 받을 수 있습니다.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "target" : "Aby lepiej zaplanować, kiedy używać energii elektrycznej w domu, zapoznaj się z harmonogramem „czystej” energii Twojego dostawcy.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "pl"
      },
      {
        "language" : "ca",
        "target" : "Consulta la disponibilitat d’energia neta a la zona per ajudar‑te a planificar l’ús que en fas a casa teva.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "th",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "ดูไทม์ไลน์กระแสไฟฟ้าสะอาดภายในท้องถิ่นเพื่อช่วยให้คุณวางแผนเพื่อใช้กระแสไฟฟ้าในบ้านของคุณ"
      },
      {
        "language" : "fi",
        "target" : "Näe paikalliset puhtaan sähkön ajat, jotta voit suunnitella, milloin käytät sähköä kotona.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "en",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "See local clean electricity timelines to help you plan when to use electricity in your home."
      },
      {
        "language" : "id",
        "target" : "Lihat lini masa listrik bersih setempat untuk membantu Anda merencanakan kapan Anda menggunakan listrik di rumah.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "es_419",
        "target" : "Consulta los horarios locales de energía limpia para ayudarte a planear cuándo usar la electricidad en tu casa.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "language" : "kk",
        "target" : "Үйіңізде электр қуатын пайдалану уақытын жоспарлауға көмектесу үшін жергілікті таза электр қуатының уақыт кестесін қараңыз.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "ja",
        "target" : "地域のクリーンエネルギーのタイムラインを確認して、ホームで電気を使用するタイミングを計画するのに役立てることができます。"
      },
      {
        "target" : "查看當地的乾淨電力時間表來幫助你規劃家中的用電時間。",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "zh_TW"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "اطلع على الجداول الزمنية المحلية للكهرباء النظيفة لمساعدتك في التخطيط لوقت استخدام الكهرباء في منزلك.",
        "language" : "ar"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "sv",
        "target" : "Visa lokala tidslinjer för ren el så att du kan planera när du ska använda el i hemmet."
      },
      {
        "target" : "Xem các dòng thời gian điện sạch cục bộ để giúp bạn lên kế hoạch về thời điểm sẽ sử dụng điện trong nhà.",
        "language" : "vi",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "target" : "Se en tidsplan for lokal, ren energi så du kan planlegge når du vil bruke strøm i hjemmet.",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "language" : "no"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
        "target" : "Consultez les horaires d’électricité propre pour planifier votre consommation d’électricité.",
        "language" : "fr_CA"
      },
      {
        "target" : "Ознакомьтесь с местными графиками использования чистой электроэнергии, чтобы спланировать время потребления электричества в своем доме.",
        "language" : "ru",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
