    "BRIDGE_APP_VIEW_HEADER_TEXT" : [
      {
        "target" : "Trykk på Digital Crown på Apple Watch for å se alle appene dine. Velg den foretrukne appvisningen fra valgene nedenfor.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "no"
      },
      {
        "target" : "Appuyez sur la Digital Crown de votre Apple Watch pour accéder à toutes vos apps. Sélectionnez la disposition des apps que vous préférez parmi les choix ci-dessous.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "fr_CA"
      },
      {
        "language" : "da",
        "target" : "Tryk på Digital Crown på dit Apple Watch for at få adgang til alle dine apps. Vælg dit foretrukne applayout fra nedenstående muligheder.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "กด Digital Crown บน Apple Watch เพื่อเข้าถึงแอปทั้งหมดของคุณ เลือกเค้าโครงแอปที่คุณต้องการจากตัวเลือกด้านล่าง",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "th"
      },
      {
        "language" : "tr",
        "target" : "Apple Watch’unuzda Digital Crown’a basarak uygulamalarınızın tümüne erişin. Tercih ettiğiniz uygulama yerleşimini aşağıdaki seçeneklerden seçin.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "zh_CN",
        "target" : "在Apple Watch上按下数码表冠访问所有App。从下方选择首选App布局。"
      },
      {
        "language" : "he",
        "target" : "לחיצה על ה-Digital Crown ב-Apple Watch תציג את כל היישומים. אפשר לבחור את פריסת היישומים המועדפת מהאפשרויות למטה.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "filename" : "CarouselAppViewChoice.loctable",
        "target" : "Prem la Digital Crown de l’Apple Watch per accedir a totes les teves apps. Selecciona la teva disposició d’apps preferida a continuació.",
        "language" : "ca"
      },
      {
        "language" : "pl",
        "target" : "Aby wyświetlić wszystkie aplikacje zainstalowane na Apple Watch, naciśnij Digital Crown. Preferowany układ aplikacji możesz wybrać poniżej.",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "Nyomja meg a Digital Crownt az Apple Watchon, ha hozzá szeretne férni az összes appjához. Válassza ki az alábbiak közül, hogy melyik appelrendezést részesíti előnyben.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "hu"
      },
      {
        "target" : "Apple WatchのDigital Crownを押すと、すべてのアプリにアクセスできます。以下の選択肢からお好きなレイアウトを選んでください。",
        "language" : "ja",
        "filename" : "CarouselAppViewChoice.loctable"
      },
      {
        "target" : "Druk de Digital Crown op je Apple Watch in voor toegang tot al je apps. Selecteer hieronder de appweergave van je voorkeur.",
        "filename" : "CarouselAppViewChoice.loctable",
        "language" : "nl"
      },
      {
        "language" : "es_419",
        "filename" : "CarouselAppViewChoice.loctable",
