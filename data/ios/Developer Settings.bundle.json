    "LEARN_SECTION1_TEXT": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "Responsiveness measures the quality of your network while it is actively being used. You can experience this in regular use-cases when you are making a FaceTime call and you (or someone else on the same network) is transferring a large file or otherwise actively using the Internet connection.\n When the responsiveness is low, it means that your network has a low ability to do multiple things at the same time. You might experience a slow network when others are actively using the same Wi-Fi network as well.\nA high responsiveness means that your network very well supports serving multiple services at the same time. Like doing a FaceTime call and at the same time transferring large amounts of data."
      }
    ],
    "LEARN_SECTION1_TITLE": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "How does it affect me?"
      }
    ],
    "LEARN_SECTION2_TEXT": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "RPM is a measure of round-trips per minute, indicating how many transactions your device can do on the Internet within one minute. The higher the RPM-score is, the better your user-experience will be."
      }
    ],
    "LEARN_SECTION2_TITLE": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "What is RPM?"
      }
    ],
    "LEARN_SECTION3_TEXT": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "Responsiveness is a new way of measuring your network's quality, focusing primarily on the reactivity of your network during simultaneous use by multiple devices or multiple services. While other tests measure throughput or ping latency, responsiveness adds another dimension to enable you to evaluate the network quality."
      }
    ],
    "LEARN_SECTION3_TITLE": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "How does it compare to other tests?"
      }
    ],
    "LEARN_TITLE": [
      {
        "filename": "DTNetQualSettings.strings",
        "language": "en",
        "target": "About RPM"
      }
    ],
