        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "현지 날씨를 표시하기 위해 사용자의 위치가 사용됩니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Posisjonen din brukes for å vise været der du er."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A helyzete a helyi időjárás megjelenítéséhez lesz felhasználva."
