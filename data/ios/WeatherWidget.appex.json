        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "La tua posizione viene utilizzata per mostrare il meteo locale."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Vaša poloha slúži na zobrazenie miestneho počasia."
      },
