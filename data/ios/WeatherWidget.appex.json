    "NSLocationUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Dein Standort wird zur Anzeige des lokalen Wetters verwendet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "פרטי המיקום שלך משמשים להצגת מזג האוויר המקומי."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "يتم استخدام موقعك لعرض الطقس المحلي."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Η τοποθεσία σας χρησιμοποιείται για εμφάνιση του τοπικού καιρού."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "現在地の天気情報の表示に位置情報を使用します。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "yue_CN",
        "target": "您的位置信息将用于显示当地天气。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Ваша геопозиція використовується для показу місцевої погоди."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Tu ubicación se usa para mostrar el clima local."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "A sua localização serve de referência para mostrar o tempo local."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Tu ubicación se utilizará para mostrar el tiempo local."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Din lokalitet bruges til at vise lokalt vejr."
      },
