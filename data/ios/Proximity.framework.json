    "BAD_ROSE_ALERT_MESSAGE": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Dein iPhone kann Ultrabreitband erst verwenden, wenn es aktualisiert wurde."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "לא ניתן להשתמש בפס אולטרה-רחב ב-iPhone עד שהוא יעודכן."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "لا يمكن استخدام النطاق فائق العرض على الـ iPhone حتى يتم تحديثه."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Δεν είναι δυνατή η χρήση υπερευρείας ζώνης από το iPhone μέχρι να ενημερωθεί."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "超広帯域無線（UWB）をアップデートするまではiPhoneでUWBを使用できません。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "Your iPhone cannot use ultra wideband until it has been updated."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Ваш iPhone не може використовувати ультрашироку смугу, доки його не оновлено."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Tu iPhone no puede usar banda ultraancha sino hasta que se haya actualizado."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Para poder usar ultra banda larga, o iPhone tem de ser atualizado."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "El iPhone no puede usar la banda ultraancha hasta que se haya actualizado."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Din iPhone kan ikke bruge ultrabredbånd, før den er blevet opdateret."
