    "TITLE_CELL_SUBTITLE_IPAD": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Erlaube eine oder mehrere dieser Funktionen, um dein iPad zur optimalen Nutzung anzupassen."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "באפשרותך להפעיל מאפיין אחד או יותר כדי להתאים אישית את ה-iPad שלך עבור שימוש מיטבי."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "اشترك في واحدة أو أكثر من هذه الميزات لتخصيص الـ iPad بحيث تستمتع بتجربة الاستخدام المثلى."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Ενεργοποιήστε μία ή περισσότερες από αυτές τις δυνατότητες για να αξιοποιήσετε το iPad σας στο έπακρο."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "これらの機能を選択的に有効にして、お使いのiPadを使いやすいようにカスタマイズできます。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "Opt in to one or more of these features to customize your iPad for optimal use."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Оберіть одну з цих функцій, щоб пристосувати свій iPad для оптимального використання."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Opta por una o más de estas funciones para personalizar tu iPad y usarlo de manera óptima."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Opte por ativar uma ou mais destas funcionalidades para otimizar a utilização do iPad."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "Activa una o varias de estas funciones para optimizar el iPad."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Du kan vælge en eller flere af disse funktioner for at tilpasse din iPad til optimal brug."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Attiva una o più funzionalità disponibili per personalizzare il tuo iPad e sfruttare a pieno le sue potenzialità."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Aktivujte jednu alebo viac týchto funkcií a prispôsobte iPad svojim potrebám tak, aby ste ho mohli optimálne používať."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "选择一个或多个功能来自定iPad，以获得最佳使用体验。"
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Ikut serta kepada satu atau lebih daripada ciri ini untuk menyesuaikan iPad anda bagi penggunaan optimum."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Anpassa iPad för optimal användning genom att aktivera en eller flera av de här funktionerna."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "Opt into one or more of these features to customise your iPad for optimal use."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Zapněte jednu nebo více těchto funkcí a nastavte si iPad tak, abyste ho mohli optimálně využívat."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "이 기능 중에 하나 또는 일부를 선택하여 iPad를 사용자화하고 최적의 상태로 사용하십시오."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "Velg om du vil bruke én eller flere av funksjonene for å tilpasse iPaden for optimal bruk."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Kapcsoljon be egyet vagy többet ezekből a funkciókból az iPadje optimális használatának testreszabásához."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "iPad’inizi en iyi şekilde kullanmak için bu özelliklerin birini veya daha fazlasını seçip özelleştirin."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Aby dostosować działanie iPada, wybierz użycie jednej lub większej liczby tych funkcji."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "Activez une ou plusieurs de ces fonctionnalités pour personnaliser votre iPad et utiliser ce dernier de façon optimale."
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Lựa chọn sử dụng một hoặc nhiều tính năng này để tùy chỉnh iPad nhằm sử dụng một cách tối ưu."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Используйте одну или более из этих функций, чтобы настроить свой iPad для максимально удобного использования."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "Opt in to one or more of these features to customise your iPad for optimal use."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "Optez pour une ou plusieurs de ces fonctionnalités afin de personnaliser votre iPad pour une utilisation optimale."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Optimoi iPad ottamalla käyttöön yksi tai useampi näistä ominaisuuksista."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Aktifkan salah satu fitur ini atau lebih untuk menyesuaikan iPad Anda agar dapat digunakan secara optimal."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Schakel een of meer van deze functies in om je iPad aan te passen voor optimaal gebruik."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "เลือกคุณสมบัติเหล่านี้อย่างน้อยหนึ่งอย่างเพื่อกำหนดรูปแบบการใช้งานที่เหมาะสมของ iPad ของคุณ"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt",
        "target": "Escolha um ou mais destes recursos para personalizar o seu iPad e obter o uso ideal."
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Activați una sau mai multe dintre aceste funcționalități ca să vă personalizați iPad‑ul pentru utilizare optimă."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "加入一個或以上功能來自訂你的iPad以達到最佳使用體驗。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Odaberite jednu ili više ovih značajki za optimiziranje iPada."
