    "sJFLaunchBody": [
      {
        "filename": "JFStrings.strings",
        "language": "de",
        "target": "Sende animierte Nachrichten, die deine Stimmung ausdrücken. Erstelle dein eigenes Memoji mit der Memoji-App in „Nachrichten“."
      },
      {
        "filename": "JFStrings.strings",
        "language": "he",
        "target": "באפשרותך לשלוח הודעות מונפשות שמחקות את הבעות הפנים שלך על-ידי יצירת ה-Memoji האישי שלך ביישום Memoji ב״הודעות״."
      },
      {
        "filename": "JFStrings.strings",
        "language": "ar",
        "target": "أرسل رسائل متحركة تلتقط تعابير وجهك. أنشئ Memoji الخاص بك باستخدام تطبيق Memoji في الرسائل."
      },
      {
        "filename": "JFStrings.strings",
        "language": "el",
        "target": "Στείλτε κινούμενα μηνύματα που αποτυπώνουν τις εκφράσεις σας. Δημιουργήστε το δικό σας memoji μέσω της εφαρμογής Memoji στα Μηνύματα."
      },
      {
        "filename": "JFStrings.strings",
        "language": "ja",
        "target": "自分の表情をとらえたアニメーションのメッセージを送りましょう。“メッセージ”の“ミー文字” Appを使って自分だけのミー文字が作れます。"
      },
      {
        "filename": "JFStrings.strings",
        "language": "en",
        "target": "Send animated messages that capture your expressions. Create your very own Memoji using the Memoji app in Messages."
      },
      {
        "filename": "JFStrings.strings",
        "language": "uk",
        "target": "Надсилайте анімовані повідомлення з вашим виразом обличчя. Створіть власне Memoji в програмі Memoji в Повідомленнях."
      },
      {
        "filename": "JFStrings.strings",
        "language": "es_419",
        "target": "Envía mensajes animados que capturan tus expresiones. Crea tu propio Memoji usando la app Memoji en Mensajes."
      },
      {
        "filename": "JFStrings.strings",
        "language": "pt_PT",
        "target": "Envie mensagens animadas que captam as suas expressões faciais. Pode criar o seu próprio Memoji com a aplicação Memoji em Mensagens."
      },
      {
        "filename": "JFStrings.strings",
        "language": "es",
        "target": "Envía mensajes animados que capten tus gestos. Crea tu propio Memoji usando la app Memoji de Mensajes."
      },
      {
        "filename": "JFStrings.strings",
        "language": "da",
        "target": "Send animerede beskeder, der fanger dine ansigtsudtryk. Opret din helt egen Memoji vha. appen Memoji i Beskeder."
      },
      {
        "filename": "JFStrings.strings",
        "language": "it",
        "target": "Invia messaggi con animazioni che catturano le espressioni del volto. Crea una Memoji personalizzata usando l'app Memoji in Messaggi."
      },
      {
        "filename": "JFStrings.strings",
        "language": "sk",
        "target": "Posielajte animované správy, ktoré zachytávajú výraz vašej tváre. Svoje vlastné memoji si môžete vytvoriť v apke Memoji v Správach."
      },
      {
        "filename": "JFStrings.strings",
        "language": "zh_CN",
        "target": "发送捕捉您表情制成的动态信息。在“信息”中使用“拟我表情”App创建您的专属拟我表情。"
      },
      {
        "filename": "JFStrings.strings",
        "language": "ms",
        "target": "Hantar mesej beranimasi yang merakam ekspresi anda. Cipta Memoji anda sendiri menggunakan app Memoji dalam Mesej."
      },
      {
        "filename": "JFStrings.strings",
        "language": "sv",
        "target": "Skicka animerade meddelanden som fångar dina uttryck. Skapa din egen Memoji med Memoji-appen i Meddelanden."
      },
      {
        "filename": "JFStrings.strings",
        "language": "en_AU",
        "target": "Send animated messages that capture your expressions. Create your very own Memoji using the Memoji app in Messages."
      },
      {
        "filename": "JFStrings.strings",
        "language": "cs",
        "target": "Posílejte animované zprávy zachycující vaši mimiku. Pro vytvoření svého osobního memoji můžete použít aplikaci Memoji ve Zprávách."
      },
      {
        "filename": "JFStrings.strings",
        "language": "ko",
        "target": "사용자의 표정을 캡처하여 생생한 메시지를 보내보세요. 메시지에서 미모티콘 앱을 사용하여 나만의 미모티콘을 만들 수 있습니다."
      },
      {
        "filename": "JFStrings.strings",
        "language": "no",
        "target": "Send animerte meldinger som fanger opp ansiktsuttrykkene dine. Opprett din egen Memoji fra Memoji-appen i Meldinger."
      },
      {
        "filename": "JFStrings.strings",
        "language": "hu",
        "target": "Olyan üzeneteket küldhet, amelyekben rögzítve vannak az arckifejezései. Saját személyes Memojijának létrehozásához használja a Memoji appot az Üzenetekben."
      },
      {
        "filename": "JFStrings.strings",
        "language": "tr",
        "target": "Yüz ifadelerinizi yansıtan hareketli mesajlar gönderin. Mesajlar’da Memoji uygulamasını kullanarak kendi Memoji’nizi yaratın."
      },
      {
        "filename": "JFStrings.strings",
        "language": "pl",
        "target": "Wyślij animowane wiadomości, które oddają Twoją mimikę. Aby utworzyć własne Memoji, użyj aplikacji Memoji w Wiadomościach."
      },
      {
        "filename": "JFStrings.strings",
        "language": "fr_CA",
        "target": "Envoyez des messages animés qui imitent vos expressions. Créez votre propre Memoji avec l’app Memoji dans Messages."
      },
      {
        "filename": "JFStrings.strings",
        "language": "vi",
        "target": "Gửi tin nhắn sinh động ghi lại các biểu cảm của bạn. Tạo Memoji riêng của chính bạn bằng cách sử dụng ứng dụng Memoji trong Tin nhắn."
      },
      {
        "filename": "JFStrings.strings",
        "language": "ru",
        "target": "Отправляйте анимированные сообщения, которые точно передают Ваши выражения лица. Для создания личного Memoji используйте приложение Memoji в Сообщениях."
      },
      {
        "filename": "JFStrings.strings",
        "language": "en_GB",
        "target": "Send animated messages that capture your expressions. Create your very own Memoji using the Memoji app in Messages."
      },
      {
        "filename": "JFStrings.strings",
        "language": "fr",
        "target": "Envoyez des messages animés qui capturent vos expressions faciales. Créez votre propre Memoji en utilisant l’app Memoji dans Messages."
      },
      {
        "filename": "JFStrings.strings",
        "language": "fi",
        "target": "Lähetä animoituja viestejä, jotka toistavat ilmeesi. Luo ikioma Memojisi Memoji-apilla Viesteissä."
      },
      {
        "filename": "JFStrings.strings",
        "language": "id",
        "target": "Kirimkan animasi pesan yang merekam ekspresi Anda. Buat Memoji Anda sendiri menggunakan app Memoji di Pesan."
      },
      {
        "filename": "JFStrings.strings",
        "language": "nl",
        "target": "Verstuur bewegende berichten die je uitdrukkingen vastleggen. Maak je eigen memoji aan via de Memoji-app in Berichten."
      },
      {
        "filename": "JFStrings.strings",
        "language": "th",
        "target": "ส่งข้อความไปพร้อมกับการแสดงสีหน้าของคุณ สร้าง Memoji ที่เป็นตัวของคุณเองโดยใช้แอป Memoji ในข้อความ"
      },
      {
        "filename": "JFStrings.strings",
        "language": "pt",
        "target": "Envie mensagens animadas que capturam as suas expressões. Crie seu próprio Memoji usando o app Memoji em Mensagens."
      },
      {
        "filename": "JFStrings.strings",
        "language": "ro",
        "target": "Trimiteți mesaje animate care vă surprind expresiile. Creați propriul dvs. Memoji utilizând aplicația Memoji din Mesaje."
      },
      {
        "filename": "JFStrings.strings",
        "language": "zh_HK",
        "target": "傳送捕捉你表情的動畫訊息。在「訊息」中使用Memoji App來製作專屬於你的Memoji。"
      },
      {
        "filename": "JFStrings.strings",
        "language": "hr",
        "target": "Pošaljite animirane poruke koje odražavaju vaše izraze. Izradite vlastiti Memoji koristeći aplikaciju Memoji u Porukama."
      },
      {
        "filename": "JFStrings.strings",
        "language": "hi",
        "target": "अपने चेहरे के हाव-भावों को कैप्चर करने वाले ऐनिमेटेड संदेश भेजें। संदेश में Memoji ऐप का इस्तेमाल करके अपना ख़ुद का Memoji बनाएँ।"
      },
      {
        "filename": "JFStrings.strings",
        "language": "ca",
        "target": "Envia missatges animats que capturin les teves expressions. Crea els teu memojis personalitzats utilitzant l’app Memojis que trobaràs a l’app Missatges."
      },
      {
        "filename": "JFStrings.strings",
        "language": "zh_TW",
        "target": "傳送擷取您表情的動畫式訊息。使用「訊息」中的Memoji App製作專屬於您的Memoji。"
      }
    ],
