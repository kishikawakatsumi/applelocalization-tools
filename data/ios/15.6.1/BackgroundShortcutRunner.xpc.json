    "NSHealthShareUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "„Kurzbefehle“ benötigt Zugriff auf deine Gesundheitsdaten, um Aktionen ausführen zu können, die sich auf Gesundheit beziehen."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "״קיצורים״ זקוק לגישה לנתוני הבריאות שלך על-מנת להפעיל פעולות הקשורות בבריאות."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "يحتاج \"الاختصارات\" إمكانية الوصول إلى بياناتك الصحية لتشغيل الإجراءات المتعلقة بالصحة."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Οι Συντομεύσεις χρειάζονται πρόσβαση στα δεδομένα υγείας σας ώστε να εκτελούν ενέργειες σχετικές με υγεία."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "ヘルスケアに関連するアクションを実行するには、“ショートカット”からヘルスケアデータにアクセスできるようにする必要があります。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Shortcuts needs access to your health data in order to run health-related actions."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Швидким командам потрібен доступ до ваших медданих, щоб виконувати дії, повʼязані зі здоровʼям."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Atajos necesita acceso a tus datos de salud para ejecutar acciones relacionadas con la salud."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "Atalhos necessita de acesso aos dados de saúde para executar ações relacionadas com saúde."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Atajos necesita acceso a tus datos de salud para poder ejecutar acciones relacionadas con la salud."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Genveje skal have adgang til dine sundhedsdata for at afvikle handlinger i forbindelse med sundhed."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "Per eseguire un'azione, è necessario consentire all'app Comandi Rapidi l'accesso ai tuoi dati sanitari."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Apka Skratky potrebuje prístup k vašim zdravotným dátam, aby mohla spúšťať akcie súvisiace so zdravím."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "“快捷指令”需要访问健康数据以运行与健康相关的操作。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Pintasan memerlukan akses kepada data kesihatan anda untuk menjalankan tindakan yang berkaitan dengan kesihatan."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Genvägar behöver tillgång till dina hälsodata för att kunna köra hälsorelaterade åtgärder."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Shortcuts needs access to your health data in order to run health-related actions."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Aby mohla aplikace Zkratky provádět akce související se zdravím, potřebuje přístup k vašim zdravotním datům."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "건강 관련 동작을 실행하려면 단축어에 건강 데이터 접근 권한이 필요합니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Snarveier trenger tilgang til helsedataene dine for å kunne utføre helserelaterte handlinger."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A Parancsok hozzáférést igényel az Ön egészségi adataihoz, hogy egészséggel kapcsolatos műveleteket lehessen futtatni."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Kestirmeler’in sağlık ile ilgili işlemleri çalıştırması için sağlık verilerinize erişimi gereklidir."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Aplikacja Skróty wymaga dostępu do Twoich danych zdrowotnych, aby uruchamiać czynności związane ze zdrowiem."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Raccourcis doit accéder à vos données médicales afin d’exécuter les actions liées à la santé."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Phím tắt cần truy cập vào dữ liệu sức khỏe của bạn để chạy các tác vụ liên quan đến sức khỏe."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Чтобы запускать относящиеся к здоровью действия, приложению «Быстрые команды» необходим доступ к Вашим данным здоровья."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Shortcuts needs access to your health data in order to run health-related actions."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Raccourcis doit accéder à vos données de santé pour exécuter des actions liées à la santé."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Pikakomennot tarvitsee käyttöoikeuden terveystietoihisi, jotta terveyteen liittyviä toimintoja voidaan suorittaa."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Pintasan memerlukan akses ke data kesehatan Anda agar dapat menjalankan tindakan terkait kesehatan."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Opdrachten heeft toegang nodig tot je gezondheidsgegevens om gezondheidstaken uit te kunnen voeren."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "คำสั่งลัดต้องการเข้าถึงข้อมูลสุขภาพของคุณเพื่อให้สั่งการทำงานที่เกี่ยวข้องกับสุขภาพ"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt",
        "target": "O app Atalhos requer acesso aos dados de saúde para executar ações relacionadas a saúde."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Aplicația Scurtături necesită acces la datele dvs. de sănătate pentru a executa acțiuni legate de sănătate."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "「捷徑」需要取用你的健康資料，以便執行與健康相關的動作。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Aplikacija Prečaci treba pristup vašim zdravstvenim podacima za pokretanje postupaka povezanih sa zdravljem."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "सेहत से संबंधित क्रियाओं को चलाने के लिए शॉर्टकट को आपके सेहत डेटा का ऐक्सेस चाहिए होता है।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "Per poder executar accions relacionades amb la salut, l’app Dreceres necessita accedir a les teves dades de salut."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "「捷徑」需要取用您的健康資料，以便執行與健康相關的動作。"
      }
    ],
