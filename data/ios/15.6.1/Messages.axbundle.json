    "sticker.hint": [
      {
        "filename": "MessagesAccessibility.strings",
        "language": "de",
        "target": "Zum Einfügen in die aktuelle Nachricht doppeltippen, zum Einfügen in die aktuelle Konversation doppeltippen und an die Nachricht anhängen"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "he",
        "target": "יש להקיש פעמיים כדי להוסיף להודעה הנוכחית. יש להקיש פעמיים ולגרור כדי לצרף להודעה בשיחה הנוכחית"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "ar",
        "target": "اضغط مرتين لإدراجه في الرسالة الحالية، واضغط مرتين مع السحب لإضافته كمرفق بالرسالة في المحادثة الحالية"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "el",
        "target": "Αγγίξτε δύο φορές για εισαγωγή στο τρέχον μήνυμα, αγγίξτε δύο φορές και σύρετε για επισύναψη στο μήνυμα στην τρέχουσα συζήτηση"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "ja",
        "target": "現在のメッセージに挿入するには、ダブルタップします。現在のスレッド内のメッセージに添付するには、ダブルタップしてドラッグします"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "yue_CN",
        "target": "轻点两下以插入到当前信息，轻点两下并拖移以附到当前对话的信息中"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "en",
        "target": "Double tap to insert into current message, double tap and drag to attach to message in current conversation"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "uk",
        "target": "Торкніть двічі, щоб вставити у поточну звістку, торкніть двічі і потягніть, щоб вкласти у звістку із поточної бесіди"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "es_419",
        "target": "Toca dos veces para insertar en el mensaje actual, toca dos veces y arrastra para adjuntar al mensaje en la conversación actual"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "pt_PT",
        "target": "Dê dois toques para inserir na mensagem atual; dê dois toques e arraste para anexar à mensagem na conversa atual."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "es",
        "target": "Toca dos veces para insertarlo en el mensaje actual. Toca dos veces y arrastra para adjuntarlo a un mensaje de la conversación actual."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "da",
        "target": "Tryk to gange for at indsætte den aktuelle besked, tryk to gange og træk for at vedhæfte til beskeden i den aktuelle samtale"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "it",
        "target": "Tocca due volte per inserire l'adesivo in questo messaggio, toccalo due volte e trascinalo per inserirlo nel messaggio della conversazione attuale"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "sk",
        "target": "Dvojitým klepnutím vložíte nálepku do aktuálnej správy, dvojitým klepnutím a potiahnutím ju priložíte ku správe v aktuálnej konverzácii"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "zh_CN",
        "target": "轻点两下以插入到当前信息，轻点两下并拖移以附到当前对话的信息中"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "ms",
        "target": "Dwiketik untuk memasukkan ke dalam mesej semasa, dwiketik dan seret untuk melampirkan ke mesej dalam perbualan semasa"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "sv",
        "target": "Tryck snabbt två gånger för att infoga i aktuellt meddelande, tryck snabbt två gånger och dra för att bifoga i meddelande i aktuell konversation"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "en_AU",
        "target": "Double-tap to insert into current message, double-tap and drag to attach to message in current conversation"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "cs",
        "target": "Poklepáním vložíte nálepku do aktuální zprávy. Poklepáním a přetažením ji přidáte ke zprávě v aktuální konverzaci."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "ko",
        "target": "현재 메시지에 삽입하려면 이중 탭하고, 현재 대화의 메시지에 첨부하려면 이중 탭한 다음 드래그하십시오."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "no",
        "target": "Dobbelttrykk for å legge til i gjeldende melding, eller dobbelttrykk og dra for å feste til en annen melding i samtalen"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "hu",
        "target": "Koppintson duplán az aktuális üzenetbe való beszúráshoz, koppintson duplán és húzza az ujját az aktuális beszélgetés üzenetéhez való csatoláshoz"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "tr",
        "target": "Şu anki mesaja eklemek için çift dokunun, şu anki yazışmadaki mesaja eklemek için çift dokunup sürükleyin"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "pl",
        "target": "Stuknij dwukrotnie, aby wstawić w bieżącej wiadomości, stuknij dwukrotnie i przeciągnij, aby dołączyć do wiadomości w bieżącej rozmowie"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "fr_CA",
        "target": "Touchez deux fois pour l’insérer dans le message. Touchez deux fois et faites-la glisser pour la joindre au message de la conversation actuelle."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "vi",
        "target": "Chạm hai lần để chèn vào tin nhắn hiện tại, chạm hai lần và kéo để đính kèm vào tin nhắn trong cuộc hội thoại hiện tại"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "ru",
        "target": "Коснитесь дважды, чтобы вставить в текущее сообщение; коснитесь дважды и перетяните, чтобы прикрепить к сообщению текущего разговора."
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "en_GB",
        "target": "Double-tap to insert into current message, double-tap and drag to attach to message in current conversation"
      },
      {
        "filename": "MessagesAccessibility.strings",
        "language": "fr",
        "target": "Touchez deux fois pour l’insérer dans le message. Touchez deux fois et faites-le glisser pour le joindre au message de la conversation actuelle."
