    "NSLocationUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Sprachmemos werden nach dem Ort der Aufnahme benannt."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "לתזכורות קוליות יינתן שם לפי המיקום שבו הוקלטו."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "سيتم تسمية المذكرات الصوتية باسم مكان تسجيلها."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Τα φωνητικά μηνύματα θα ονομάζονται βάσει της τοποθεσίας εγγραφής τους."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "録音が行われた場所がボイスメモの名前につけられます。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Voice Memos will be named with the location where they are recorded."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Назви голосових нотаток даватимуться на основі місць, де їх записують."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Las notas de voz se nombrarán según la ubicación en donde se grabaron."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "O nome das gravações vai conter a localização onde foram gravadas."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "El nombre de las notas de voz será el de la ubicación donde se graben."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Memoer bliver navngivet efter den lokalitet, hvor de er optaget."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "Ai memo vocali verrà assegnato il nome del luogo in cui sono stati realizzati."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Nahrávky budú pomenované podľa miesta nahrávania."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "语音备忘录将使用录音时所在的地点命名。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Memo Suara akan dinamakan dengan lokasi tempat memo tersebut dirakam."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Röstmemon namnges efter platsen som de spelades in på."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Voice Memos will be named with the location where they are recorded."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Hlasové záznamy budou pojmenovány podle místa, kde byly pořízeny."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "음성 메모는 녹음된 위치로 이름이 지정됩니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Taleopptak vil bli navngitt med stedet der de ble tatt opp."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A hangjegyzetek a rögzítésük helye alapján lesznek elnevezve."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Sesli Notlar kaydedildikleri konum ile adlandırılırlar."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Nazwy notatek głosowych będą zawierać miejsce nagrania."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Les mémos vocaux seront nommés avec l’emplacement où ils ont été enregistrés."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Bản ghi âm sẽ được đặt tên theo vị trí mà chúng được ghi."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Голосовые записи будут названы по названию места, в котором они были записаны."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Voice Memos will be named with the location where they are recorded."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Les mémos vocaux seront nommés d’après le lieu où ils ont été enregistrés."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Sanelut nimetään niiden äänityspaikan perusteella."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Memo Suara akan dinamai sesuai dengan lokasi perekamannya."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Gesproken memo's krijgen de naam van de plaats waar ze zijn opgenomen."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "เสียงบันทึกจะถูกตั้งชื่อตามตำแหน่งที่ตั้งที่บันทึกเสียง"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt",
        "target": "As Gravações serão nomeadas com a localização de onde foram gravadas."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Memourile vocale vor fi numite în funcție de locul unde sunt înregistrate."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "錄音將根據錄製時的位置而命名。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Audio snimke imenovat će se prema lokaciji na kojoj su snimljene."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "वॉइस मेमो को उनके रिकॉर्ड किए जाने वाले स्थान के साथ नाम दिया जाएगा।"
      },
      {
