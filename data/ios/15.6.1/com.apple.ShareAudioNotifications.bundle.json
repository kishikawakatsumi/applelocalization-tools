    "SHARE_AUDIO_BODY_FORMAT": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Verbinde „%@“ vorübergehend mit diesem Apple TV, um die Audiowiedergabe zu teilen."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "ניתן לחבר את ״%@״ ל-Apple TV זה באופן זמני כדי לשתף שמע."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "وصّل \"%@\" مؤقتًا بهذا الـ Apple TV لمشاركة الصوت."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Συνδέστε προσωρινά τα %@ σε αυτό το Apple TV για κοινή χρήση ήχου."
