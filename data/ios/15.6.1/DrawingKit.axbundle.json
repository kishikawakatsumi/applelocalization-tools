    "writeboard.input.hint": [
      {
        "filename": "Accessibility.strings",
        "language": "de",
        "target": "Zum Aktivieren doppeltippen, dann mit dem Finger eine Nachricht schreiben"
      },
      {
        "filename": "Accessibility.strings",
        "language": "he",
        "target": "הקש/י פעמיים להפעלה, ואז כתוב/י הודעה בעזרת האצבע."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ar",
        "target": "اضغط مرتين للتنشيط، ثم استخدم إصبعك لكتابة الرسالة"
      },
      {
        "filename": "Accessibility.strings",
        "language": "el",
        "target": "Αγγίξτε δύο φορές για ενεργοποίηση και μετά χρησιμοποιήστε το δάχτυλό σας για να γράψετε ένα μήνυμα"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ja",
        "target": "ダブルタップしてアクティベートします。次に、指を使ってメッセージを書きます。"
      },
      {
        "filename": "Accessibility.strings",
        "language": "yue_CN",
        "target": "轻点两下以激活，再用手指书写信息"
      },
      {
        "filename": "Accessibility.strings",
        "language": "en",
        "target": "Double tap to activate, then use your finger to write a message"
      },
      {
        "filename": "Accessibility.strings",
        "language": "uk",
        "target": "Торкніть двічі, щоб активувати, потім пальцем пишіть повідомлення"
      },
      {
        "filename": "Accessibility.strings",
        "language": "es_419",
        "target": "Toca dos veces para activar y usa tu dedo para escribir un mensaje"
      },
      {
        "filename": "Accessibility.strings",
        "language": "pt_PT",
        "target": "Dê dois toques para ativar e, depois, escreva uma mensagem com o dedo."
      },
      {
        "filename": "Accessibility.strings",
        "language": "es",
        "target": "Toca dos veces para activar; luego usa un dedo para escribir el mensaje"
      },
      {
        "filename": "Accessibility.strings",
        "language": "da",
        "target": "Tryk to gange for at aktivere, brug derefter din finger til at skrive en besked"
      },
      {
        "filename": "Accessibility.strings",
        "language": "it",
        "target": "Tocca due volte per attivare l'opzione, quindi scrivi il messaggio con il dito"
      },
      {
        "filename": "Accessibility.strings",
        "language": "sk",
        "target": "Aktivujte dvojitým klepnutím a potom napíšte správu pomocou prsta"
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_CN",
        "target": "轻点两下以激活，再用手指书写信息"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ms",
        "target": "Dwiketik untuk mengaktifkan, kemudian gunakan jari anda untuk menulis mesej"
      },
      {
        "filename": "Accessibility.strings",
        "language": "sv",
        "target": "Aktivera genom att trycka snabbt två gånger. Skriv sedan ett meddelande med fingret"
      },
      {
        "filename": "Accessibility.strings",
        "language": "en_AU",
        "target": "Double-tap to activate, then use your finger to write a message"
      },
      {
        "filename": "Accessibility.strings",
        "language": "cs",
        "target": "Poklepáním aktivujte a pak prstem napište zprávu"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ko",
        "target": "이중 탭하여 활성화한 다음 손가락을 이용하여 메시지를 쓰십시오."
      },
      {
        "filename": "Accessibility.strings",
        "language": "no",
        "target": "Dobbelttrykk for å aktivere, og skriv en melding med fingeren"
      },
      {
        "filename": "Accessibility.strings",
        "language": "hu",
        "target": "Koppintson duplán az aktiváláshoz, majd használja az ujját üzenet írásához"
      },
      {
        "filename": "Accessibility.strings",
        "language": "tr",
        "target": "Etkinleştirmek için çift dokunun ve mesaj yazman için parmağınızı kullanın"
      },
      {
        "filename": "Accessibility.strings",
        "language": "pl",
        "target": "Stuknij dwukrotnie, aby aktywować. Następnie wpisz wiadomość, używając palca"
      },
      {
        "filename": "Accessibility.strings",
        "language": "fr_CA",
        "target": "Touchez deux fois pour activer, puis utilisez votre doigt pour écrire un message"
      },
      {
        "filename": "Accessibility.strings",
        "language": "vi",
        "target": "Chạm hai lần để kích hoạt, sau đó dùng ngón tay để viết tin nhắn"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ru",
        "target": "Коснитесь дважды, чтобы активировать. Затем напишите сообщение с помощью пальца."
      },
      {
        "filename": "Accessibility.strings",
        "language": "en_GB",
        "target": "Double-tap to activate, then use your finger to write a message"
      },
      {
        "filename": "Accessibility.strings",
        "language": "fr",
        "target": "Touchez deux fois pour activer, puis utilisez votre doigt pour écrire un message."
      },
      {
        "filename": "Accessibility.strings",
        "language": "fi",
        "target": "Aktivoi kaksoisnapauttamalla ja käytä sitten sormea viestin kirjoittamiseen"
      },
      {
        "filename": "Accessibility.strings",
        "language": "id",
        "target": "Ketuk dua kali untuk mengaktifkan, lalu gunakan jari Anda untuk menulis pesan"
      },
      {
        "filename": "Accessibility.strings",
        "language": "nl",
        "target": "Tik dubbel om te activeren en schrijf vervolgens met je vinger een bericht"
      },
      {
        "filename": "Accessibility.strings",
        "language": "th",
        "target": "แตะสองครั้งเพื่อเปิดใช้งาน แล้วใช้นิ้วของคุณเขียนข้อความ"
      },
      {
        "filename": "Accessibility.strings",
        "language": "pt",
        "target": "Toque duas vezes para ativar e use o dedo para escrever uma mensagem"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ro",
        "target": "Apăsați dublu pentru a activa, apoi utilizați degetul pentru a scrie un mesaj"
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_HK",
        "target": "點兩下啟用。然後手寫訊息"
      },
      {
        "filename": "Accessibility.strings",
        "language": "hr",
        "target": "Dodirnite dvaput za aktiviranje, zatim napišite poruku prstom"
      },
      {
        "filename": "Accessibility.strings",
        "language": "hi",
        "target": "सक्रिय करने के लिए डबल टैप करें फिर संदेश लिखने हेतु अपनी उँगली का उपयोग करें"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ca",
        "target": "Fes dos tocs per activar l’àrea d’escriptura a mà i escriu un missatge amb el dit"
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_TW",
        "target": "點兩下來啟用，然後手寫訊息"
      }
