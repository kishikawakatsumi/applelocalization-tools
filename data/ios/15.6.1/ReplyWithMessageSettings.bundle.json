{
  "bundlePath": "/System/Library/PreferenceBundles/ReplyWithMessageSettings.bundle",
  "framework": "ReplyWithMessageSettings.bundle",
  "localizations": {
    "CUSTOM_REPLY_HELP": [
      {
        "filename": "Reply With Message.strings",
        "language": "de",
        "target": "Diese Antworten stehen zur Verfügung, wenn ein eingehender Anruf schnell mit einer Nachricht beantwortet werden soll. Sie können beliebig angepasst werden."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "he",
        "target": "לרשותך יעמדו שלוש תשובות קצרות כדי להגיב לשיחה נכנסת בכתב. את התשובות ניתן לערוך ככל העולה על רוחך."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ar",
        "target": "ستكون هذه الاستجابات السريعة متوفرة عند الرد على مكالمة واردة باستخدام نص. قم بتغييرهم إلى أي شيء تريد قوله."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "el",
        "target": "Αυτές οι γρήγορες απαντήσεις θα είναι διαθέσιμες όταν απαντάτε σε μια εισερχόμενη κλήση με μήνυμα κειμένου. Μπορείτε να τις αλλάξετε όπως επιθυμείτε."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ja",
        "target": "電話の着信時に上の文章から選択してテキストメッセージで返信できます。文章は好きな内容に変更できます。"
      },
      {
        "filename": "Reply With Message.strings",
        "language": "en",
        "target": "These quick responses will be available when you respond to an incoming call with a text. Change them to say anything you like."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "uk",
        "target": "Ці миттєві відповіді доступні, коли ви відповідаєте на виклик текстовим повідомленням. Змініть їх на щось, що потрібно вам."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "es_419",
        "target": "Las respuestas rápidas estarán disponibles al contestar llamadas entrantes por medio de un mensaje de texto. Modifícalas para decir lo que quieras."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "pt_PT",
        "target": "Estas respostas rápidas estão disponíveis quando responde a uma chamada com uma mensagem. Pode alterá‑las e escrever um texto personalizado."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "es",
        "target": "Estas respuestas rápidas estarán disponibles cuando respondas a una llamada con un mensaje de texto. Puedes cambiarlas como quieras."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "da",
        "target": "Disse hurtige svar er tilgængelige, når du svarer et opkald med en besked. Du kan ændre dem efter behov."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "it",
        "target": "Queste risposte veloci saranno disponibili quando vorrai rispondere a una chiamata con un messaggio. Modificale come preferisci."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "sk",
        "target": "Rýchle odpovede budú dostupné pri odpovedaní na prichádzajúci hovor textovou správou. Tieto správy si môžete ľubovolne prispôsobiť."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "zh_CN",
        "target": "您可以用上面的短信来快速回复来电，也可以把它们改写成其他内容。"
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ms",
        "target": "Respons cepat ini akan tersedia apabila anda membalas panggilan masuk dengan teks. Tukar kepada sebarang mesej yang anda inginkan."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "sv",
        "target": "De här snabba svaren finns tillgängliga när du svarar på ett inkommande samtal med ett SMS. Du kan ändra dem till vad du vill."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "en_AU",
        "target": "These quick responses will be available when you respond to an incoming call with a text. Change them to say anything you like."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "cs",
        "target": "Tyto rychlé odpovědi budou k dispozici, když budete odpovídat na příchozí hovor textovou zprávou. Podle potřeby je můžete změnit."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ko",
        "target": "걸려오는 전화를 메시지로 빠르게 응답할 수 있습니다. 원하는 메시지로 변경하십시오."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "no",
        "target": "Disse raske svarene blir tilgjengelige når du velger å svare med tekstmelding på et innkommende anrop. Endre standardsvarene som du vil."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "hu",
        "target": "Ezek a gyors válaszok akkor lesznek elérhetők, amikor egy bejövő hívásra válaszol szöveges üzenettel. Az üzeneteket tetszés szerint módosíthatja."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "tr",
        "target": "Bu hızlı yanıtlar, gelen bir aramayı mesajla cevaplarken kullanılabilecektir. Bunları istediğiniz şekilde değiştirin."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "pl",
        "target": "Te opcje umożliwiają szybkie odpowiadanie wiadomością na połączenia przychodzące. Podane odpowiedzi możesz zmienić na własne."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "fr_CA",
        "target": "Ces réponses brèves sont disponibles lorsque vous répondez à un appel par un message. Modifiez-les comme bon vous semble."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "vi",
        "target": "Những trả lời nhanh này sẽ có sẵn khi bạn trả lời cuộc gọi đến bằng tin nhắn. Thay đổi chúng để nói bất kỳ điều gì bạn muốn."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ru",
        "target": "Эти быстрые ответы будут доступны, когда требуется ответить на входящий вызов текстовым сообщением. Вы можете изменить содержание этих ответов по своему усмотрению."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "en_GB",
        "target": "These quick responses will be available when you respond to an incoming call with a text. Change them to say anything you like."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "fr",
        "target": "Ces réponses brèves sont disponibles lorsque vous répondez à un appel par un message. Modifiez-les comme bon vous semble."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "fi",
        "target": "Nämä nopeat vastaukset ovat käytettävissä, kun vastaat viestillä tulevaan puheluun. Voit halutessasi muokata niitä."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "id",
        "target": "Respons cepat ini akan tersedia saat Anda merespons panggilan masuk dengan teks. Ubah teks sesuai dengan kehendak Anda."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "nl",
        "target": "Deze snelle reacties zijn beschikbaar als je op een inkomend gesprek reageert met een tekstbericht. Je kunt ze naar wens wijzigen."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "th",
        "target": "การตอบกลับอย่างเร็วเหล่านี้จะใช้เมื่อคุณตอบกลับสายโทรเข้าเป็นข้อความ เปลี่ยนข้อความตามที่คุณต้องการ"
      },
      {
        "filename": "Reply With Message.strings",
        "language": "pt",
        "target": "As respostas rápidas ficarão disponíveis quando você responder a uma ligação com uma mensagem de texto. Você pode personalizá-las como quiser."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ro",
        "target": "Aceste răspunsuri rapide vor fi disponibile atunci când răspundeți printr‑un mesaj unui apel recepționat. Schimbați‑le pentru a spune orice doriți."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "zh_HK",
        "target": "當你不方便接電話時，你可使用上列訊息快速回應來電，文字內容可隨意更改。"
      },
      {
        "filename": "Reply With Message.strings",
        "language": "hr",
        "target": "Ovi brzi odgovori bit će dostupni kad odaberete odgovoriti porukom na dolazni poziv. Možete ih promijeniti u što god želite."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "hi",
        "target": "जब आप संदेश के ज़रिए किसी इनकमिंग कॉल का उत्तर देंगे तो ये त्वरित प्रतिक्रिया उपलब्ध होंगे। अपनी इच्छानुसार कुछ और कहने के लिए इन्हें बदलें।"
      },
      {
        "filename": "Reply With Message.strings",
        "language": "ca",
        "target": "Aquestes respostes ràpides estaran disponibles quan responguis amb text a una trucada entrant. Canvia-les per dir el que vulguis."
      },
      {
        "filename": "Reply With Message.strings",
        "language": "zh_TW",
        "target": "您可使用上列訊息來快速回覆來電，文字內容可隨意更改。"
      }
    ],
