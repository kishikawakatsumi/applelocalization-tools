{
  "bundlePath": "/System/Library/Health/FeedItemPlugins/ResearchApp.healthplugin",
  "framework": "ResearchApp.healthplugin",
  "localizations": {
    "PROMO_BODY": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Du kannst die Wissenschaft voranbringen und Apple helfen, die nächste Technologiegeneration zu entwickeln, indem du an Forschungsstudien teilnimmst."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "באפשרותך לקדם את המדע ולעזור ל-Apple ליצור את הדור הבא של הטכנולוגיה על-ידי השתתפות במחקרים."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "يمكنك أن تدعم تقدم العلوم وتساعد Apple في تصميم الجيل القادم من التكنولوجيا عبر مشاركتك في الدراسات."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Μπορείτε να συμβάλλετε στην προαγωγή της επιστήμης και να βοηθήσετε την Apple στη δημιουργία της επόμενης γενιάς τεχνολογίας, μέσω της συμμετοχής σας σε μελέτες."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "調査に参加することにより、科学の進歩およびAppleによる次世代テクノロジーの開発にご協力いただけます。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "You can advance science and help Apple create the next generation of technology by participating in studies."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Робіть свій внесок у розвиток науки й допомагайте Apple створювати пристрої наступного покоління, долучаючись до дослідів."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Puedes impulsar a la ciencia y ayudar a que Apple cree la siguiente generación de tecnología al participar en estudios."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Ao participar em estudos, pode contribuir para o progresso da ciência assim como ajudar a Apple a criar a tecnologia da próxima geração."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "Puedes contribuir a los avances de la ciencia y ayudar a Apple a crear la próxima generación de tecnología participando en estudios."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Du kan bidrage til forskning og hjælpe Apple med at udvikle den næste generation af teknologi ved at deltage i undersøgelser."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Partecipando agli studi di ricerca, puoi contribuire al progresso scientifico e aiutare Apple a progettare le tecnologie di prossima generazione."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Účasťou na štúdiách môžete prispieť k vedeckým pokrokom a pomôcť spoločnosti Apple vytvoriť novú generáciu technológií."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "通过参与研究，您可以促进科学发展并协助Apple研发下一代技术。"
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Anda boleh mengembangkan sains dan membantu Apple mencipta teknologi generasi akan datang dengan mengambil bahagian dalam kajian."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Du kan bidra till forskning och hjälpa Apple att skapa nästa generations teknik genom att delta i studier."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "You can advance science and help Apple create the next generation of technology by participating in studies."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Když se zúčastníte studií, můžete se podílet na rozvoji vědy a pomoct společnosti Apple s vývojem nové generace technologií."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "연구에 참여하여 과학 기술을 발전시키고 Apple의 차세대 기기를 만드는 데 기여할 수 있습니다."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "Gi ditt forskningsbidrag og hjelp Apple i den teknologiske utviklingen ved å delta i forskningsstudier."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Hozzájárulhat a tudomány fejlődéséhez, és segíthet az Apple-nek a következő generációs technológia létrehozásában, ha részt vesz a kutatásokban."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "Apple Sağlık araştırma çalışmalarına katılarak bilimin ilerlemesine ve Apple’ın yeni nesil teknoloji yaratmasına yardımcı olabilirsiniz."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Możesz wspierać badania naukowe i pomóc Apple w tworzeniu następnej generacji rozwiązań technologicznych, uczestnicząc w badaniach."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "Vous pouvez faire progresser la science et aider Apple à créer des technologies de nouvelle génération en participant à des études de recherche."
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Bạn có thể thúc đẩy tiến bộ khoa học và giúp Apple tạo ra thế hệ công nghệ tiếp theo bằng cách tham gia vào các khảo sát."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Вы можете внести вклад в развитие науки и помочь Apple в создании технологии следующего поколения, приняв участие в исследованиях."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "You can advance science and help Apple create the next generation of technology by participating in studies."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "Vous pouvez faire avancer la science et aider Apple à créer des technologies de nouvelle génération en participant à des études."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Voit edistää tiedettä ja auttaa Applea luomaan seuraavan sukupolven teknologiaa osallistumalla tutkimuksiin."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Anda dapat mengembangkan sains dan membantu Apple membuat teknologi generasi berikutnya dengan berpartisipasi dalam kajian."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Je kunt de wetenschap bevorderen en Apple helpen bij het creëren van een nieuwe generatie technologie door mee te doen aan studies."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "คุณสามารถพัฒนาวิทยาศาสตร์และช่วยให้ Apple สร้างเทคโนโลยีรุ่นต่อไปได้โดยเข้าร่วมในการศึกษา"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt",
        "target": "Você pode participar dos estudos para avançar a ciência e ajudar a Apple a criar a próxima geração de tecnologia."
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Puteți să contribuiți la progresul științei și să ajutați Apple să creeze următoarea generație tehnologică prin participarea la studiile de cercetare."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "透過參與研究，你可以促進科學發展並協助Apple研發下一代科技。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Sudjelovanjem u studijama možete pomoći u razvoju znanosti i Appleu u izradi sljedeće generacije tehnologije."
      },
      {
        "filename": "Localizable.strings",
        "language": "hi",
        "target": "अध्ययन में भाग लेकर आप विज्ञान की प्रगति में योगदान दे सकते हैं और प्रौद्योगिकी विकास को अगले स्तर तक ले जाने में Apple की सहायता कर सकते हैं।"
      },
      {
        "filename": "Localizable.strings",
        "language": "ca",
        "target": "Pots contribuir als avenços de la ciència i ajudar Apple a crear la pròxima generació de productes tecnològics participant en estudis."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_TW",
        "target": "透過參與研究，您可以促進科學發展並協助Apple研發下一代技術。"
      }
    ],
