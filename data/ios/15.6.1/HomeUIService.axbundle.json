    "camera.scan.setupcode.hint": [
      {
        "filename": "Accessibility.strings",
        "language": "de",
        "target": "Platziere die rückseitige Kamera auf der Mitte des HomeKit-Konfigurationscodes und ziehe das Gerät dann langsam zurück."
      },
      {
        "filename": "Accessibility.strings",
        "language": "he",
        "target": "יש להניח את המצלמה האחורית על מרכז קוד ההגדרה של HomeKit. לאחר מכן, להרחיק את המכשיר בהדרגה."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ar",
        "target": "ركز الكاميرا الخلفية على منتصف كود إعداد HomeKit، ثم اسحب الجهاز للخلف ببطء."
      },
      {
        "filename": "Accessibility.strings",
        "language": "el",
        "target": "Τοποθετήστε την πίσω κάμερα στο κέντρο του κωδικού διαμόρφωσης HomeKit. Μετά, τραβήξτε αργά τη συσκευή προς τα πίσω."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ja",
        "target": "背面カメラをHomeKitの設定コードの中央に置いてから、デバイスをゆっくりとカードから離してください。"
      },
      {
        "filename": "Accessibility.strings",
        "language": "yue_CN",
        "target": "将后置相机对准HomeKit设置码中央。然后慢慢往后拉动相机。"
      },
      {
        "filename": "Accessibility.strings",
        "language": "en",
        "target": "Place your back-facing camera on the center of the HomeKit setup code. Then, slowly pull the device back."
      },
      {
        "filename": "Accessibility.strings",
        "language": "uk",
        "target": "Покладіть пристрій на центр коду налаштування HomeKit передньою камерою. Потім повільно підведіть пристрій."
      },
      {
        "filename": "Accessibility.strings",
        "language": "es_419",
        "target": "Apunta al código de configuración de HomeKit con la cámara posterior y luego desplaza lentamente hacia atrás el dispositivo."
      },
      {
        "filename": "Accessibility.strings",
        "language": "pt_PT",
        "target": "Coloque a câmara traseira no centro do código de configuração do HomeKit. Depois, lentamente, afaste o dispositivo."
      },
      {
        "filename": "Accessibility.strings",
        "language": "es",
        "target": "Coloca la cámara trasera en el centro del código de configuración de HomeKit y ve alejando el dispositivo lentamente."
      },
      {
        "filename": "Accessibility.strings",
        "language": "da",
        "target": "Anbring kameraet på bagsiden midt på HomeKit-indstillingskoden. Træk derefter enheden langsomt væk."
      },
      {
        "filename": "Accessibility.strings",
        "language": "it",
        "target": "Posiziona la fotocamera orientata posteriormente inquadrando il codice di configurazione di HomeKit e allontana lentamente il dispositivo."
      },
      {
        "filename": "Accessibility.strings",
        "language": "sk",
        "target": "Položte zadnú kameru na stred nastavovacieho kódu HomeKitu. Potom pomaly dvíhajte svoje zariadenie."
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_CN",
        "target": "将后置相机对准HomeKit设置码中央。然后慢慢往后拉动相机。"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ms",
        "target": "Halakan kamera pandang belakang anda pada bahagian tengah kod persediaan HomeKit. Kemudian, tarik peranti dengan perlahan."
      },
      {
        "filename": "Accessibility.strings",
        "language": "sv",
        "target": "Placera den bakre kameran på mitten av HomeKit-inställningskoden. Dra sedan enheten långsamt bakåt."
      },
      {
        "filename": "Accessibility.strings",
        "language": "en_AU",
        "target": "Place your back-facing camera on the centre of the HomeKit set-up code. Then, slowly pull the device back."
      },
      {
        "filename": "Accessibility.strings",
        "language": "cs",
        "target": "Umístěte zadní fotoaparát na střed kódu nastavení HomeKitu a pomalu zařízení oddalujte."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ko",
        "target": "후면 카메라를 HomeKit 설정 코드의 중앙에 위치한 다음 기기를 천천히 뒤로 움직이십시오."
      },
      {
        "filename": "Accessibility.strings",
        "language": "no",
        "target": "Plasser kameraet på baksiden av enheten midt på HomeKit-konfigureringskoden. Deretter trekker du enheten sakte tilbake."
      },
      {
        "filename": "Accessibility.strings",
        "language": "hu",
        "target": "Helyezze a hátsó kamerát a HomeKit-beállítási kód közepére, majd lassan emelje fel az eszközt."
      },
      {
        "filename": "Accessibility.strings",
        "language": "tr",
        "target": "Arka yüzdeki kamerayı HomeKit ayarlama kodunun ortasına yerleştirin, sonra aygıtı yavaşça geriye doğru çekin."
      },
      {
        "filename": "Accessibility.strings",
        "language": "pl",
        "target": "Umieść tylny aparat nad środkiem kodu konfiguracji HomeKit. Następnie powoli odsuń urządzenie od kodu."
      },
      {
        "filename": "Accessibility.strings",
        "language": "fr_CA",
        "target": "Placez la caméra arrière sur le centre du code de configuration HomeKit. Puis, retirez lentement l’appareil."
      },
      {
        "filename": "Accessibility.strings",
        "language": "vi",
        "target": "Hướng camera sau vào trung tâm của mã thiết lập HomeKit. Sau đó, từ từ kéo thiết bị lại."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ru",
        "target": "Наведите камеру задней панели на центр кода настройки HomeKit, затем медленно отведите устройство назад."
      },
      {
        "filename": "Accessibility.strings",
        "language": "en_GB",
        "target": "Place your back-facing camera on the centre of the HomeKit setup code. Then slowly pull the device back."
      },
      {
        "filename": "Accessibility.strings",
        "language": "fr",
        "target": "Placez votre caméra arrière au centre de votre code de configuration HomeKit. Puis, éloignez lentement l’appareil."
      },
      {
        "filename": "Accessibility.strings",
        "language": "fi",
        "target": "Aseta takakamera HomeKit-käyttöönottokoodin keskelle. Vedä laitetta sen jälkeen hitaasti taaksepäin."
      },
      {
        "filename": "Accessibility.strings",
        "language": "id",
        "target": "Letakkan kamera yang menghadap ke belakang di bagian tengah kode pengaturan HomeKit. Lalu, tarik perangkat secara perlahan."
      },
      {
        "filename": "Accessibility.strings",
        "language": "nl",
        "target": "Richt de camera aan de achterkant van het apparaat op het midden van de HomeKit-configuratiecode en beweeg het apparaat vervolgens langzaam naar je toe."
      },
      {
        "filename": "Accessibility.strings",
        "language": "th",
        "target": "วางกล้องด้านหลังของคุณตรงกึ่งกลางของรหัสการตั้งค่า HomeKit จากนั้นดึงอุปกรณ์ถอยหลังช้าๆ"
      },
      {
        "filename": "Accessibility.strings",
        "language": "pt",
        "target": "Posicione a câmera traseira no centro do código de configuração do HomeKit e lentamente afaste o dispositivo do cartão."
      },
      {
        "filename": "Accessibility.strings",
        "language": "ro",
        "target": "Plasați camera poziționată pe spatele dispozitivului în centrul codului de configurare HomeKit. Apoi, trageți încet dispozitivul înapoi."
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_HK",
        "target": "將後置鏡頭對準HomeKit設定碼嘅中央位置。然後將部機慢慢拉後。"
      },
      {
        "filename": "Accessibility.strings",
        "language": "hr",
        "target": "Postavite stražnju kameru na središte HomeKit koda za podešavanje. Zatim polagano povucite uređaj unatrag."
      },
      {
        "filename": "Accessibility.strings",
        "language": "hi",
        "target": "अपने बैक फ़ेसिंग कैमरे को HomeKit सेटअप कोड के बीच में रखें। फिर धीरे से डिवाइस पीछे खींचें।"
      },
      {
        "filename": "Accessibility.strings",
        "language": "ca",
        "target": "Situa la càmera posterior al centre del codi de configuració del HomeKit. A continuació, retira lentament el dispositiu."
      },
      {
        "filename": "Accessibility.strings",
        "language": "zh_TW",
        "target": "將後置相機放在HomeKit設定代碼中間，然後將裝置慢慢往回拉。"
      }
    ],
