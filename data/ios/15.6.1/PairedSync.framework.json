{
  "bundlePath": "/System/Library/PrivateFrameworks/PairedSync.framework",
  "framework": "PairedSync.framework",
  "localizations": {
    "SIMULATOR_CLOSED_DURING_SYNC_ALERT_BUTTON": [
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "OK"
      }
    ],
    "SIMULATOR_CLOSED_DURING_SYNC_ALERT_HEADER": [
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Simulator Sync Stalled"
      }
    ],
    "SIMULATOR_CLOSED_DURING_SYNC_ALERT_MESSAGE": [
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "The Apple Watch simulator quit while syncing with the paired iPhone simulator. To complete syncing, re-open the Apple Watch simulator now to avoid timing out and losing unsynced data."
      }
    ]
  }
}
