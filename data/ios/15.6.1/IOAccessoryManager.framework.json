    "WETMSG_DIALOG_BODY_LOCKSCREEN": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Laden ist nicht möglich, da im Lightning Connector Flüssigkeit entdeckt wurde. Trenne das Kabel, damit der Connector trocknen kann."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "לא ניתן לטעון כרגע מכיוון שזוהה נוזל בתוך מחבר ה-Lightning. יש לנתק את המחבר כדי לאפשר לו להתייבש."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "لا يمكن الشحن لأنه قد تم اكتشاف سائل في موصل Lightning. افصل الكبل حتى يجف الموصل."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Δεν είναι διαθέσιμη η φόρτιση διότι ανιχνεύτηκε υγρό στην υποδοχή Lightning. Αποσυνδέστε το βύσμα για να στεγνώσει η υποδοχή."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "Lightningコネクタで液体が検出されたため充電はできません。コネクタを乾かすために接続を外してください。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "Charging is not available because liquid has been detected in the Lightning connector. Disconnect to allow the connector to dry."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Заряджання недоступне, бо у конекторі Lightning виявлено рідину. Відʼєднайте, щоб дати конектору висохнути."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "No se puede recargar porque se detectó líquido en el conector Lightning; desconéctalo para permitir que se seque."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Não é possível carregar porque foi detetado líquido no conector Lightning. Desligue o cabo para permitir ao conector secar."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "No se puede cargar porque se ha detectado líquido dentro del conector Lightning. Desconecta el dispositivo para que el conector se seque."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Det er ikke muligt at oplade, fordi der er fundet væske i Lightning-stikket. Tag stikket ud, og lad det tørre."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Non è possibile mettere in carica il tuo dispositivo perché sono stati rilevati liquidi all'interno del connettore Lightning. Scollega il cavo e attendi che sia asciutto."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Nabíjanie nie je možné, pretože v Lightning konektore bola detegovaná tekutina. Odpojte kábel, aby sa konektor mohol vysušiť."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "无法充电，因为闪电接口检测到液体。请断开连接以晾干接口。"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_BR",
        "target": "Não é possível carregar porque líquido foi detectado no conector Lightning. Desconecte para permitir que o conector seque."
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Pengecasan tidak tersedia kerana cecair telah dikesan dalam penyambung Lightning. Tanggalkan untuk membolehkan penyambung kering."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Laddning har stängts av eftersom vätska har upptäckts i Lightning-kontakten. Koppla från så att kontakten kan torka."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "Charging is not available because liquid has been detected in the Lightning connector. Disconnect to allow the connector to dry."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Nabíjení není k dispozici, protože v Lightning konektoru byla zjištěna tekutina. Odpojte kabel, aby mohl konektor vyschnout."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "Lightning 커넥터에 액체가 감지되었기 때문에 충전할 수 없습니다. 커넥터를 연결 해제하고 건조하십시오."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "Det er registrert væske i Lightning-kontakten og lading er ikke tilgjengelig. Koble fra laderen og la kontakten tørke."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Az eszköz nem tölthető, mert folyadék észlelhető a Lightning-csatlakozóban. Bontsa a kapcsolatot, hogy a csatlakozó ki tudjon száradni."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "Lightning bağlayıcısında sıvı algılandığı için şarj edilemiyor. Bağlayıcının kurumasına izin vermek için bağlantıyı kesin."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Ładowanie nie jest możliwe, ponieważ wewnątrz złącza Lightning wykryta została ciecz. Odłącz kabel, aby złącze mogło wyschnąć."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "La recharge n’est pas possible, car du liquide a été détecté dans le connecteur Lightning. Débranchez le connecteur et laissez-le sécher."
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Chức năng sạc không có sẵn vì đã phát hiện thấy chất lỏng trong đầu nối Lightning. Ngắt kết nối để cho phép đầu nối khô."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Зарядка недоступна, так как в разъеме Lightning обнаружена жидкость. Отсоедините устройство, чтобы дать разъему просохнуть."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "Charging is not available because liquid has been detected in the Lightning connector. Disconnect to allow the connector to dry."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "La recharge n’est pas disponible car du liquide a été détecté dans le connecteur Lightning. Débranchez le connecteur et laissez-le sécher."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Lataaminen ei ole käytettävissä, koska Lightning-liittimessä on havaittu nestettä. Anna liittimen kuivua irrottamalla se."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Pengisian daya tidak tersedia karena cairan telah terdeteksi di konektor Lightning. Cabut agar konektor dapat mengering."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Opladen is niet mogelijk omdat er vloeistof is aangetroffen in de Lightning-connector. Koppel de kabel los om de connector te laten drogen."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "ไม่สามารถชาร์จได้เนื่องจากพบของเหลวในช่องต่อ Lightning โปรดถอดสายเพื่อรอให้แห้งก่อน"
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Încărcarea nu este disponibilă, deoarece a fost detectat lichid în conectorul Lightning. Deconectați pentru a permite uscarea conectorului."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "在Lightning接頭中偵測到液體，無法充電。中斷連接以讓接頭完全乾透。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Punjenje nije moguće jer je detektirana tekućina u Lightning priključnici. Odspojite kabel i ostavite priključnicu da se osuši."
      },
      {
        "filename": "Localizable.strings",
        "language": "hi",
        "target": "चार्जिंग उपलब्ध नहीं है क्योंकि आपके Lightning कनेक्टर में तरल पदार्थ पाया गया है। कनेक्टर को सुखाने के लिए डिस्कनेक्ट करें।"
      },
      {
        "filename": "Localizable.strings",
        "language": "ca",
        "target": "La càrrega no està disponible perquè s’ha detectat líquid al connector Lightning. Desconnecta el connector per deixar que s’assequi."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_TW",
        "target": "在Lightning連接器中偵測到進水，無法充電。中斷連接來讓連接器完全乾透。"
      }
    ],
