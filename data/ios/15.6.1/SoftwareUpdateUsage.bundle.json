    "DELETE_UPDATE_CONFIRMATION_DESCRIPTION": [
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "de",
        "target": "Dieses Update kann später in den Einstellungen unter „Softwareupdate“ erneut geladen werden."
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "he",
        "target": "ניתן להוריד עדכון זה מחדש בכל עת מהגדרות ״עדכוני תוכנה״."
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "ar",
        "target": "يمكنك إعادة تنزيل هذا التحديث لاحقًا في إعدادات تحديث البرامج."
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "el",
        "target": "Μπορείτε να πραγματοποιήσετε νέα λήψη αυτής της ενημέρωσης αργότερα στην Ενημέρωση λογισμικού."
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "ja",
        "target": "あとで“ソフトウェア・アップデート”設定からこのアップデートを再ダウンロードできます。"
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
        "language": "en",
        "target": "You can re-download this update later in Software Update settings."
      },
      {
        "filename": "SoftwareUpdateUsageBundle.strings",
