    "NSPhotoLibraryUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Die Lupe kann aufgenommene Bilder in deiner Fotomediathek speichern."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "״זכוכית מגדלת״ יכול לאחסן צילומים בספריית התמונות שלך."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "يمكن للمكبر تخزين الصور الملتقطة في مكتبة الصور."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Η Μεγέθυνση μπορεί να αποθηκεύει καταγραμμένες εικόνες στη Βιβλιοθήκη φωτογραφιών σας."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "“拡大鏡”で撮影した画像を写真ライブラリに保存することができます。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "Magnifier can store captured images in your Photo Library."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Лупа може зберігати зроблені знімки у вашій Фототеці."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "La lupa puede almacenar imágenes capturadas en tu fototeca."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "A Lupa pode armazenar imagens capturadas na fototeca."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "La lupa puede guardar las imágenes capturadas en tu fototeca."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Forstørrelsesglas kan gemme billeder, du tager, i dit fotobibliotek."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "L'opzione “Lente d'ingrandimento” ti consente di salvare le immagini acquisite nella libreria di foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Lupa môže ukladať zachytené obrázky do vašej knižnice fotiek."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "“放大器”可将拍摄的图像储存在“照片图库”中。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_BR",
        "target": "A Lupa pode armazenar imagens capturadas na sua Fototeca."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Kanta pembesar boleh menyimpan imej yang ditangkap dalam Pustaka Foto anda."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Förstorare kan lagra tagna bilder i bildbiblioteket."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "Magnifier can store captured images in your Photo Library."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Lupa může ukládat zachycené snímky do knihovny fotek."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "확대기가 캡처한 이미지를 사용자의 사진 보관함에 보관할 수 있습니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Lupe kan lagre bildene dine i bildebiblioteket."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "A Nagyító képes eltárolni a rögzített képeket a Fotókönyvtárában."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Büyüteç, çekilen görüntüleri Fotoğraf Arşivi’nizde saklayabilir."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Lupa może przechowywać przechwycone obrazki w bibliotece Zdjęć."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "La loupe peut stocker des images capturées dans votre photothèque."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Kính lúp có thể lưu trữ các hình ảnh đã chụp trong Thư viện ảnh của bạn."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Лупа может хранить захваченные изображения в Вашей медиатеке приложения «Фото»."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "Magnifier can store captured images in your Photo Library."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "La loupe peut conserver les images capturées dans votre photothèque."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Suurennuslasi voi tallentaa otetut kuvat Kuvakirjastoon."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Gambar yang diambil dapat disimpan Pembesar di Perpustakaan Foto Anda."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "'Vergrootglas' kan vastgelegde afbeeldingen in je fotobibliotheek opslaan."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "แว่นขยายสามารถจัดเก็บภาพที่ถ่ายได้ในคลังรูปภาพของคุณ"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Funcționalitatea Lupă poate stoca imaginile capturate în biblioteca foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "「放大鏡」可以將截取的影像儲存在「相片圖庫」中。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Povećalo može pohraniti snimljene slike u vašu medijateku fotografija."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "आवर्धक कैप्चर की गई इमेज को आपकी तस्वीर लाइब्रेरी में संग्रहित कर सकता है।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "La lupa pot desar les captures d’imatge a la fototeca."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "「放大鏡」可以將擷取的影像儲存在「照片圖庫」中。"
      }
