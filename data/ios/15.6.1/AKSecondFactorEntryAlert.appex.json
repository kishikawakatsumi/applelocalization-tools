    "ENTER_VERIFICATION_CODE": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Eine Nachricht mit einem Bestätigungscode wurde an deine anderen Geräte mit iOS 9 oder OS X El Capitan oder neuer gesendet. Zum Fortfahren den Code eingeben."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "הודעה המכילה קוד אימות נשלחה אל המכשירים האחרים שלך שבהם פועל iOS 9 או OS X El Capitan ומעלה. יש להזין את הקוד כדי להמשיך."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "تم إرسال رسالة تتضمن رمز التحقق إلى أجهزتك الأخرى التي تعمل بنظام iOS 9 أو OS X El Capitan أو أحدث. الرجاء إدخال الرمز للمتابعة."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Στάλθηκε μήνυμα με έναν κωδικό επαλήθευσης στις άλλες συσκευές σας που χρησιμοποιούν iOS 9 ή OS X El Capitan ή μεταγενέστερη έκδοση. Εισαγάγετε τον κωδικό για να συνεχίσετε."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "iOS 9以降またはOS X El Capitan以降を実行しているほかのデバイスに、確認コードを記載したメッセージが送信されました。続けるには、そのコードを入力してください。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "A message with a verification code has been sent to your other devices running iOS 9 or OS X El Capitan or later. Enter the code to continue."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Звістку з кодом перевірки надіслано на ваш інший пристрій з iOS 9 або OS X El Capitan чи їхніми пізнішими версіями. Щоб продовжити, введіть код."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Se envió un código de verificación a tus otros dispositivos con iOS 9, OS X El Capitan o versiones posteriores. Ingrésalo para continuar."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Uma mensagem com um código de confirmação foi enviada aos seus outros dispositivos com iOS 9 ou OS X El Capitan (ou versões posteriores). Para continuar, introduza o código."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "Se ha enviado un mensaje con un código de verificación a tus otros dispositivos con iOS 9 u OS X El Capitan o posterior. Introduce el código para continuar."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Der er sendt en besked med en bekræftelseskode til de andre enheder, som bruger iOS 9 eller OS X El Capitan eller en nyere version. Skriv koden for at fortsætte."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Un messaggio contenente il codice di verifica è stato inviato agli altri dispositivi con iOS 9, OS X El Capitan o versioni successive. Inserisci il codice per continuare."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Správa s overovacím kódom bola odoslaná na vaše ostatné zariadenia so systémami iOS 9 alebo OS X El Capitan, prípadne novšími. Ak chcete pokračovať, zadajte kód."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "短信验证码已发送至您其他运行iOS 9或OS X El Capitan（或更高版本）的设备。请输入验证码以继续。"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_BR",
        "target": "Uma mensagem com o código de verificação foi enviada para seus outros dispositivos que com o iOS 9 ou o OS X El Capitan (ou versão posterior). Digite o código para continuar."
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Mesej dengan kod pengesahan telah dihantar ke peranti lain anda yang menjalankan iOS 9 atau OS X El Capitan atau lebih baharu. Masukkan kod untuk meneruskan."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Ett meddelande med en bekräftelsekod har skickats till dina andra enheter med iOS 9 eller OS X El Capitan eller senare. Ange koden när du vill fortsätta."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "A message with a verification code has been sent to your other devices running iOS 9 or OS X El Capitan or later. Enter the code to continue."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Na vaše ostatní zařízení se systémy iOS 9 a OS X El Capitan nebo novějšími byla zaslána zpráva s ověřovacím kódem. Před pokračováním tento kód zadejte."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "확인 코드를 포함한 메시지가 iOS 9 또는 OS X El Capitan 이상이 설치된 사용자의 다른 기기로 전송되었습니다. 계속하려면 해당 코드를 입력하십시오."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "En verifiseringskode ble sendt med tekstmelding til de andre enhetene dine som har iOS 9 eller OS X El Capitan eller nyere. Oppgi koden for å fortsette."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Az ellenőrző kódot tartalmazó üzenetet elküldtük az iOS 9, illetve OS X El Capitan vagy újabb rendszert futtató egyéb eszközeire. A folytatáshoz adja meg a kódot."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "iOS 9 ya da OS X El Capitan veya daha yenisini çalıştıran diğer aygıtlarınıza doğrulama kodunu içeren bir mesaj gönderildi. Sürdürmek için kodu girin."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Wysłano kod weryfikacyjny na Twoje urządzenia z systemem iOS 9 lub OS X El Capitan (lub nowszym). Wpisz go, aby kontynuować."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "Un message contenant un code de validation a été envoyé vers vos autres appareils dotés d’iOS 9, OS X El Capitan ou ultérieur. Entrez le code pour continuer."
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Một tin nhắn có mã xác minh đã được gửi đến các thiết bị khác của bạn đang chạy iOS 9 hoặc OS X El Capitan trở lên. Nhập mã để tiếp tục."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Сообщение с кодом проверки отправлено на Ваши другие устройства, работающие под управлением iOS 9 либо OS X El Capitan или новее. Чтобы продолжить, введите код."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "A message with a verification code has been sent to your other devices running iOS 9 or OS X El Capitan or later. Enter the code to continue."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "Un message avec un code de validation a été envoyé à vos autres appareils exécutant iOS 9 ou OS X El Capitan ou ultérieur. Saisissez le code pour continuer."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Vahvistuskoodin sisältävä viesti on lähetetty muihin laitteisiisi, joissa on iOS 9, OS X El Capitan tai uudempi. Jatka syöttämällä koodi."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Pesan dengan kode verifikasi telah dikirimkan ke perangkat Anda lainnya yang menjalankan iOS 9 atau OS X El Capitan atau lebih baru. Masukkan kode untuk melanjutkan."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Er is een bericht met een verificatiecode gestuurd naar je andere apparaten met iOS 9 of OS X El Capitan of hoger. Voer de code in om verder te gaan."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "ข้อความที่มีรหัสการตรวจสอบยืนยันถูกส่งไปที่อุปกรณ์อื่นที่ใช้งาน iOS 9 หรือ OS X El Capitan ขึ้นไปของคุณแล้ว โปรดป้อนรหัสเพื่อดำเนินการต่อ"
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Un mesaj cu un cod de verificare a fost trimis către celelalte dispozitive ale dvs. care rulează iOS 9 sau OS X El Capitan (sau versiuni ulterioare). Introduceți codul pentru a continua."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "驗證碼已透過訊息傳送至其他正在執行iOS 9或OS X El Capitan或以上版本的裝置。請輸入驗證碼以繼續。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Poruka s verifikacijskim kodom poslana je na vaše druge uređaje sa sustavom iOS 9 ili OS X El Capitan ili novijim. Unesite kôd za nastavak."
      },
      {
        "filename": "Localizable.strings",
        "language": "hi",
        "target": "सत्यापन कोड के साथ संदेश iOS 9 या OS X El Capitan या बाद के संस्करण वाले आपके अन्य डिवाइस पर भेजा गया है। जारी रखने के लिए कोड दर्ज करें।"
      },
      {
        "filename": "Localizable.strings",
        "language": "ca",
        "target": "S’ha enviat un missatge amb un codi de verificació als altres dispositius amb l’iOS 9 o l’OS X El Capitan o posteriors. Introdueix el codi per continuar."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_TW",
        "target": "已傳送一則附有驗證碼的訊息至您其他執行iOS 9或OS X El Capitan或以上版本的裝置上。請輸入驗證碼來繼續執行。"
      }
    ],
