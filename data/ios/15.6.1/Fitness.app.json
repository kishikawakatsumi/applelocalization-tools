    "NSContactsUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Wenn du den Zugriff erlaubst, kann „Fitness“ deine Kontakte verwenden, um das Teilen von Aktivitäten zu konfigurieren und dein Benutzererlebnis mit deinem Namen und Bild zu personalisieren."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "אם בחרת לאפשר את הגישה, היישום ״כושר״ יוכל להשתמש באנשי הקשר שלך כדי להגדיר שיתוף פעילות וכדי להתאים את החוויה שלך באופן אישי באמצעות השם והתמונה שלך."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "في حالة السماح بالوصول، يمكن أن يستخدم تطبيق اللياقة جهات اتصالك لإعداد مشاركة النشاط وتخصيص تجربتك باسمك وصورتك."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Σε περίπτωση εκχώρησης πρόσβασης, η Άθληση μπορεί να χρησιμοποιήσει τις επαφές σας για διαμόρφωση της Κοινοποίησης δραστηριότητας και εξατομίκευση της εμπειρίας σας με το όνομα και τη φωτογραφία σας."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "アクセスを許可すると、アクティビティ共有を設定して、名前や写真などで体験をパーソナライズするために、“フィットネス”では連絡先が使用されます。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "If you allow access, Fitness can use your contacts to set up activity sharing and personalize your experience with your name and picture."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Якщо дозволити доступ, то програма «Фітнес» зможе налаштувати поширення даних активності на основі ваших контактів і показувати ваше імʼя й зображення."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Si permites el acceso, Fitness puede usar tus contactos para configurar las opciones de compartir actividad y para personalizar tu experiencia con tu nombre y foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "Se permitir o acesso, a aplicação Fitness pode usar os seus contactos para configurar a partilha de atividade e personalizar a sua experiência com o seu nome e imagem."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Si permites el acceso, la app Fitness podrá usar tus contactos para configurar las actividades que compartes y personalizar tu experiencia con tu nombre y foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Hvis du giver adgang til det, kan Fitness bruge dine kontakter til at indstille aktivitetsdeling og tilpasse din oplevelse med dit navn og billede."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "Se consenti l'accesso, Fitness può utilizzare i tuoi contatti per configurare la condivisione delle attività e personalizzare l'esperienza con il tuo nome e la tua immagine."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Ak povolíte prístup, apka Kondícia bude môcť používať vaše kontakty na nastavenie zdieľania aktivít a prispôsobenie rozhrania pomocou vášho mena a obrázka."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "若允许访问，“健身”将可使用您的联系人信息设置活动共享，并个性化您的姓名和头像体验。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_BR",
        "target": "Se você autorizar o acesso, o app Fitness poderá usar seus contatos para configurar o compartilhamento de atividades e personalizar sua experiência com seu nome e foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Jika anda membenarkan akses, Kecergasan boleh menggunakan kenalan anda untuk menyediakan perkongsian aktiviti dan memperibadikan pengalaman anda dengan nama serta gambar anda."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Om du tillåter åtkomst kan Fitness använda dina kontakter till att ställa in aktivitetsdelning och personanpassa din upplevelse med ditt namn och din bild."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "If you allow access, Fitness can use your contacts to set up activity sharing and personalise your experience with your name and picture."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Pokud přístup povolíte, aplikace Kondice může využít údaje o kontaktech k nastavení sdílení aktivit a přizpůsobení rozhraní s použitím vašeho jména a obrázku."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "사용자가 접근을 허용하면, 피트니스 앱은 활동 공유를 설정하고 이름 및 사진을 바탕으로 개인 맞춤형 사용자 경험을 제공하기 위해 연락처를 사용할 수 있습니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Hvis du gir tilgang, kan Mosjon bruke kontaktene dine til å konfigurere aktivitetsdeling og tilpasse opplevelsen ved å bruke navnet og bildet ditt."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "Ha engedélyezi a hozzáférést, a Fitnesz app felhasználhatja az Ön kontaktjait a tevékenységmegosztás beállításához, valamint ahhoz, hogy személyre szabott élményt nyújtson Önnek az Ön nevének és képének megjelenítésével."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Fitness, erişime izin verirseniz adınız ve resminiz ile deneyiminizi kişiselleştirmek ve aktivite paylaşmayı ayarlamak için kişilerinizi kullanabilir."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Jeśli dasz aplikacji Fitness dostęp do kontaktów, będzie ona mogła użyć ich do skonfigurowania funkcji udostępniania danych, a także do personalizowania działania tej funkcji, wyświetlając Twoją nazwę użytkownika i zdjęcie."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Si vous autorisez l’accès, l’app En forme pourra utiliser vos contacts pour configurer le partage d’activité et personnaliser votre expérience d’utilisation en incluant votre nom et votre image."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Nếu bạn cho phép truy cập, Thể dục có thể sử dụng danh bạ của bạn để thiết lập tính năng chia sẻ hoạt động và cá nhân hóa trải nghiệm của bạn với tên và hình ảnh."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Если разрешить доступ, приложение «Фитнес» сможет с помощью Ваших контактов настроить общий доступ к данным Активности и персонализировать функции путем использования Вашего имени и изображения."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "If you allow access, Fitness can use your contacts to set up activity sharing and personalise your experience with your name and picture."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Si vous autorisez l’accès, l’app Forme peut utiliser vos contacts pour configurer le partage d’activité et personnaliser votre expérience en ajoutant votre nom et votre photo."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Jos annat käyttöoikeuden, Kuntoilu voi käyttää yhteystietojasi aktiivisuusjaon käyttöönottoon ja sen räätälöintiin nimesi ja kuvasi avulla."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Jika Anda mengizinkan akses, Kebugaran akan menggunakan kontak Anda untuk mengatur berbagi aktivitas dan mempersonalisasi pengalaman dengan nama dan gambar Anda."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Als je toegang geeft, kan Conditie je contacten gebruiken om Activiteit-deling te configureren en je ervaring te personaliseren met je naam en foto."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "ถ้าคุณอนุญาตให้เข้าถึง ฟิตเนสสามารถใช้รายชื่อของคุณเพื่อตั้งค่าการแชร์กิจกรรมและให้ประสบการณ์สำหรับคุณโดยเฉพาะด้วยชื่อและรูปภาพ"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Dacă permiteți accesul, aplicația Fitness poate utiliza contactele dvs. pentru a configura partajarea datelor Activitate și pentru a vă personaliza experiența cu numele și imaginea dvs."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "如你允許取用，「健身」可以使用你的聯絡人以設定「健身記錄分享」，並且透過你的姓名和圖片將你的體驗個人化。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Ako dozvolite pristup, aplikacija Fitness može koristiti vaše kontakte za podešavanje dijeljenja aktivnosti i personaliziranje vašeg iskustva pomoću vašeg imena i slike."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "अगर आप ऐक्सेस की अनुमति देते हैं, तो फ़िटनेस ऐक्टिविटी शेयरिंग सेटअप करने और आपके नाम और आपकी तस्वीर के साथ आपके अनुभव को वैयक्तिकृत करने के लिए आपके संपर्कों का इस्तेमाल कर सकता है।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "Si hi permets l’accés, l’app Fitnes podrà fer servir els contactes per configurar l’ús compartit de l’activitat i personalitzar l’experiència amb el teu nom i una imatge."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "若允許取用，「健身」可以使用您的聯絡人來設定「活動記錄分享」並透過您的名稱和圖片來個人化您的體驗。"
      }
    ],
