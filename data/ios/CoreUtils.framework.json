    "PIN_DIALOG_MESSAGE_MAC": [
      {
        "filename": "Localizable.strings",
        "language": "de",
        "target": "Zum Einrichten des Apple TV gib diesen Code auf dem Mac ein.\nDrücke „Menu“ auf der Fernbedienung, um zurückzugehen."
      },
      {
        "filename": "Localizable.strings",
        "language": "he",
        "target": "הזן/י קוד זה ב-Mac כדי להגדיר את ה-Apple TV.\nכדי לחזור אחורה, לחץ/י על הכפתור Menu בשלט."
      },
      {
        "filename": "Localizable.strings",
        "language": "ar",
        "target": "أدخل هذا الرمز على الـ Mac لإعداد هذا الـ Apple TV.\nللرجوع، اضغط على زر Menu على جهاز التحكم."
      },
      {
        "filename": "Localizable.strings",
        "language": "el",
        "target": "Εισαγάγετε αυτόν τον κωδικό στο Mac για να διαμορφώσετε αυτό το Apple TV.\nΓια να επιστρέψετε, πατήστε το κουμπί Menu στο τηλεχειριστήριο."
      },
      {
        "filename": "Localizable.strings",
        "language": "ja",
        "target": "このApple TVを設定するには、このコードをMacに入力してください。\n戻るには、リモコンのMENUボタンを押してください。"
      },
      {
        "filename": "Localizable.strings",
        "language": "en",
        "target": "Enter this code on your Mac to set up this Apple TV.\nTo go back, press the Menu button on the remote."
      },
      {
        "filename": "Localizable.strings",
        "language": "uk",
        "target": "Введіть цей код на своєму Mac, щоб налаштувати цей Apple TV.\nЩоб повернутись, тисніть кнопку Menu на пульті."
      },
      {
        "filename": "Localizable.strings",
        "language": "es_419",
        "target": "Ingresa este código en tu Mac para configurar este Apple TV.\nPara regresar, presiona el botón Menú del control remoto."
      },
      {
        "filename": "Localizable.strings",
        "language": "pt_PT",
        "target": "Digite este código no Mac para configurar esta Apple TV.\nPara voltar, carregue no botão Menu no comando à distância."
      },
      {
        "filename": "Localizable.strings",
        "language": "es",
        "target": "Introduce este código en el Mac para configurar este Apple TV.\nPara volver, pulsa el botón Menú en el mando a distancia."
      },
      {
        "filename": "Localizable.strings",
        "language": "da",
        "target": "Skriv denne kode på din Mac for at indstille dette Apple TV.\nTryk på menuknappen på fjernbetjeningen for at gå tilbage."
      },
      {
        "filename": "Localizable.strings",
        "language": "it",
        "target": "Inserisci il codice sul Mac per configurare Apple TV.\nPer annullare, premi il tasto Menu sul telecomando."
      },
      {
        "filename": "Localizable.strings",
        "language": "sk",
        "target": "Ak chcete nastaviť toto Apple TV, zadajte tento kód na svojom Macu.\nStlačením tlačidla Menu na diaľkovom ovládači sa vrátite späť."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_CN",
        "target": "在Mac上输入此认证码以设置这台Apple TV。\n若要返回，按下遥控器上的Menu（菜单）按钮。"
      },
      {
        "filename": "Localizable.strings",
        "language": "ms",
        "target": "Masukkan kod ini pada Mac anda untuk menyediakan Apple TV ini.\nUntuk kembali, tekan butang Menu pada kawalan jauh."
      },
      {
        "filename": "Localizable.strings",
        "language": "sv",
        "target": "Ställ in denna Apple TV genom att ange den här koden på datorn.\nGå tillbaka genom trycka på fjärrkontrollens menyknapp."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_AU",
        "target": "Enter this code on your Mac to set up this Apple TV.\nTo go back, press the Menu button on the remote."
      },
      {
        "filename": "Localizable.strings",
        "language": "cs",
        "target": "Chcete-li Apple TV nastavit, zadejte tento kód na Macu.\n\nVrátit se můžete stisknutím tlačítka Menu na ovladači."
      },
      {
        "filename": "Localizable.strings",
        "language": "ko",
        "target": "이 Apple TV를 설정하려면 이 코드를 Mac에 입력하십시오.\n뒤로 이동하려면 리모컨에서 Menu 버튼을 누르십시오."
      },
      {
        "filename": "Localizable.strings",
        "language": "no",
        "target": "Oppgi denne koden på Macen din for å konfigurere Apple TV.\nTrykk på MENU-knappen på fjernkontrollen for å gå tilbake."
      },
      {
        "filename": "Localizable.strings",
        "language": "hu",
        "target": "Adja meg ezt a kódot a Mac gépén az Apple TV beállításához.\nA visszalépéshez nyomja meg a Menu gombot a távirányítón."
      },
      {
        "filename": "Localizable.strings",
        "language": "tr",
        "target": "Bu Apple TV’yi ayarlamak için bu kodu Mac’inizde girin.\nGeri gitmek için kumandadaki MENU düğmesine basın."
      },
      {
        "filename": "Localizable.strings",
        "language": "pl",
        "target": "Aby skonfigurować Apple TV, podaj ten kod na Macu.\nAby powrócić, naciśnij przycisk Menu na pilocie."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr_CA",
        "target": "Entrez ce code sur votre Mac pour configurer cette Apple TV.\nPour revenir en arrière, appuyez sur le bouton Menu de la télécommande."
      },
      {
        "filename": "Localizable.strings",
        "language": "vi",
        "target": "Nhập mã này trên máy Mac của bạn để thiết lập Apple TV này.\nĐể quay lại, hãy nhấn nút Menu trên điều khiển từ xa."
      },
      {
        "filename": "Localizable.strings",
        "language": "ru",
        "target": "Для настройки этого Apple TV введите этот код на своем компьютере Mac.\nЧтобы вернуться назад, нажмите кнопку MENU на пульте."
      },
      {
        "filename": "Localizable.strings",
        "language": "en_GB",
        "target": "Enter this code on your Mac to set up this Apple TV.\nTo go back, press the Menu button on the remote."
      },
      {
        "filename": "Localizable.strings",
        "language": "fr",
        "target": "Saisissez ce code sur votre Mac pour configurer cette Apple TV.\nPour revenir en arrière, appuyez sur le bouton Menu de la télécommande."
      },
      {
        "filename": "Localizable.strings",
        "language": "fi",
        "target": "Ota Apple TV käyttöön syöttämällä tämä koodi Macissasi.\nPalaa edelliseen painamalla kaukosäätimen Menu-painiketta."
      },
      {
        "filename": "Localizable.strings",
        "language": "id",
        "target": "Masukkan kode ini di Mac Anda untuk mengatur Apple TV ini.\nUntuk kembali, tekan tombol Menu di remote."
      },
      {
        "filename": "Localizable.strings",
        "language": "nl",
        "target": "Voer deze code in op je Mac om deze Apple TV in te stellen.\nOm terug te gaan, druk je op de menuknop op de afstandsbediening."
      },
      {
        "filename": "Localizable.strings",
        "language": "th",
        "target": "ป้อนรหัสนี้บนเครื่อง Mac ของคุณเพื่อตั้งค่า Apple TV เครื่องนี้\nในการย้อนกลับ ให้กดปุ่ม Menu บนรีโมท"
      },
      {
        "filename": "Localizable.strings",
        "language": "pt",
        "target": "Digite este código no seu Mac para configurar esta Apple TV.\nPara voltar, pressione o botão Menu no controle remoto."
      },
      {
        "filename": "Localizable.strings",
        "language": "ro",
        "target": "Introduceți acest cod pe Mac‑ul dvs. pentru a configura acest Apple TV.\nPentru a reveni, apăsați butonul Meniu de pe telecomandă."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_HK",
        "target": "在Mac上輸入此代碼以設定此Apple TV。\n如要返回，請按下遙控器上的Menu（選單）按鈕。"
      },
      {
        "filename": "Localizable.strings",
        "language": "hr",
        "target": "Unesite ovaj kôd na svoj Mac kako biste podesili Apple TV.\nZa povratak pritisnite tipku Menu na daljinskom upravljaču."
      },
      {
        "filename": "Localizable.strings",
        "language": "hi",
        "target": "अपने Mac पर इस Apple TV के सेटअप के लिए यह कोड दर्ज करें।\nवापस जाने के लिए रिमोट पर मेनू बटन दबाएँ।"
      },
      {
        "filename": "Localizable.strings",
        "language": "ca",
        "target": "Introdueix aquest codi al Mac per configurar l’Apple TV.\nPer retrocedir, prem el botó Menú del comandament."
      },
      {
        "filename": "Localizable.strings",
        "language": "zh_TW",
        "target": "在Mac上輸入此代碼來設定此Apple TV。\n若要返回，請按下遙控器上的Menu（選單）按鈕。"
      }
