    "DELETE_HEALTH_DATA_MESSAGE_IPHONE" : [
      {
        "target" : "Hiermit werden alle Health- und Aktivitätsdaten endgültig gelöscht und alle Health-Einstellungen auf diesem iPhone zurückgesetzt.",
        "filename" : "Localizable.strings",
        "language" : "de"
      },
      {
        "target" : "פעולה זו תמחק לצמיתות את כל נתוני ״בריאות״ ו״פעילות״, ותאפס את ההגדרות של ״בריאות״ ב-iPhone זה.",
        "filename" : "Localizable.strings",
        "language" : "he"
      },
      {
        "target" : "سيؤدي ذلك إلى حذف البيانات الصحية وبيانات النشاط نهائيًا وإعادة تعيين إعدادات \"صحتي\" على هذا الـ iPhone.",
        "filename" : "Localizable.strings",
        "language" : "ar"
      },
      {
        "target" : "Αυτό θα διαγράψει οριστικά όλα τα δεδομένα Υγείας και Δραστηριότητας και θα επαναφερθούν οι ρυθμίσεις Υγείας σε αυτό το iPhone.",
        "filename" : "Localizable.strings",
        "language" : "el"
      },
      {
        "target" : "このiPhone上のヘルスケアとアクティビティのデータをすべて削除し、“ヘルスケア”の設定をリセットします。",
        "filename" : "Localizable.strings",
        "language" : "ja"
      },
      {
        "target" : "This will permanently delete all Health and Activity data and reset Health settings on this iPhone.",
        "filename" : "Localizable.strings",
        "language" : "en"
      },
      {
        "target" : "Це назавжди видалить усі дані Здоровʼя й Активності та скине параметри Здоровʼя на цьому iPhone.",
        "filename" : "Localizable.strings",
        "language" : "uk"
      },
      {
        "target" : "Esto eliminará de forma permanente todos los datos de Salud y Actividad, y restablecerá la configuración de Salud de este iPhone.",
        "filename" : "Localizable.strings",
        "language" : "es_419"
      },
      {
        "target" : "Todos os dados das aplicações Saúde e Atividade serão permanentemente apagados deste iPhone; as definições da aplicação Saúde serão repostas.",
        "filename" : "Localizable.strings",
        "language" : "pt_PT"
      },
      {
        "target" : "Se eliminarán definitivamente todos los datos de salud y actividad, y se restablecerán los ajustes de salud en este iPhone.",
        "filename" : "Localizable.strings",
        "language" : "es"
      },
      {
        "target" : "Dette sletter alle data om sundhed og aktivitet permanent og nulstiller indstillinger i Sundhed på denne iPhone.",
        "filename" : "Localizable.strings",
        "language" : "da"
      },
      {
        "target" : "L’operazione eliminerà definitivamente tutti i dati di Salute e Attività e ripristinerà le impostazioni di Salute su iPhone.",
        "filename" : "Localizable.strings",
        "language" : "it"
      },
      {
        "target" : "Týmto natrvalo vymažete všetky dáta týkajúce sa zdravia a aktivít a resetujete nastavenia aplikácie Zdravie na tomto iPhone.",
        "filename" : "Localizable.strings",
        "language" : "sk"
      },
      {
        "target" : "这将永久删除此iPhone上的所有“健康”和“健身记录”数据，并还原“健康”设置。",
        "filename" : "Localizable.strings",
        "language" : "zh_CN"
      },
      {
        "target" : "Ini akan memadamkan semua data Kesihatan dan Aktiviti secara kekal dan mereset seting Kesihatan pada iPhone ini.",
        "filename" : "Localizable.strings",
        "language" : "ms"
      },
      {
        "target" : "Detta kommer att radera alla hälso- och aktivitetsdata och nollställa alla hälsoinställningar på denna iPhone.",
        "filename" : "Localizable.strings",
        "language" : "sv"
      },
      {
        "target" : "This will permanently delete all Health and Activity data and reset Health settings on this iPhone.",
        "filename" : "Localizable.strings",
        "language" : "en_AU"
      },
      {
        "target" : "Dojde k trvalému smazání všech dat Zdraví a Aktivity a k resetu nastavení Zdraví na iPhonu.",
        "filename" : "Localizable.strings",
        "language" : "cs"
      },
      {
        "target" : "모든 건강 및 활동 데이터가 영구적으로 삭제되고 이 iPhone의 건강 설정이 초기화됩니다.",
        "filename" : "Localizable.strings",
        "language" : "ko"
      },
      {
        "target" : "Alle helse- og aktivitetsdata blir permanent slettet og Helse-innstillingene nullstilles på iPhonen.",
        "filename" : "Localizable.strings",
        "language" : "no"
      },
      {
        "target" : "Ez véglegesen törölni fogja az összes Egészség- és Tevékenység-adatot, valamint alaphelyzetbe állítja az Egészség beállításait ezen az iPhone-on.",
        "filename" : "Localizable.strings",
        "language" : "hu"
      },
      {
        "target" : "Bu işlem, tüm Sağlık ve Aktivite verilerini kalıcı olarak silecek ve bu iPhone’daki Sağlık ayarlarını sıfırlayacaktır.",
        "filename" : "Localizable.strings",
        "language" : "tr"
      },
      {
        "target" : "Usunie to trwale wszystkie dane zdrowotne i dotyczące aktywności oraz wyzeruje ustawienia aplikacji Zdrowie na tym iPhonie.",
        "filename" : "Localizable.strings",
        "language" : "pl"
      },
      {
        "target" : "Toutes les données de Santé et d’Activité seront définitivement supprimées, et les réglages de Santé seront réinitialisés sur cet iPhone.",
        "filename" : "Localizable.strings",
        "language" : "fr_CA"
      },
      {
        "target" : "Việc này sẽ xóa vĩnh viễn tất cả dữ liệu Sức khỏe và Hoạt động, đồng thời đặt lại cài đặt Sức khỏe trên iPhone này.",
        "filename" : "Localizable.strings",
        "language" : "vi"
      },
      {
        "target" : "При этом будут необратимо удалены все данные Здоровья и Активности, а настройки «Здоровья» сброшены на этом iPhone.",
        "filename" : "Localizable.strings",
        "language" : "ru"
      },
      {
        "target" : "This will permanently delete all Health and Activity data and reset Health settings on this iPhone.",
        "filename" : "Localizable.strings",
        "language" : "en_GB"
      },
      {
        "target" : "Toutes les données Santé et Activité seront définitivement effacées et les réglages Santé seront réinitialisés sur cet iPhone.",
        "filename" : "Localizable.strings",
        "language" : "fr"
      },
      {
        "target" : "Tämä poistaa pysyvästi kaikki terveys- ja aktiivisuustiedot ja nollaa iPhonen Terveys-asetukset.",
        "filename" : "Localizable.strings",
        "language" : "fi"
      },
      {
        "target" : "Ini akan menghapus semua data Kesehatan dan Aktivitas secara permanen dan mengatur ulang pengaturan Kesehatan di iPhone ini.",
        "filename" : "Localizable.strings",
        "language" : "id"
      },
      {
        "target" : "Hiermee wis je alle gezondheids- en activiteitsgegevens definitief en stel je de gezondheidsinstellingen op deze iPhone opnieuw in.",
        "filename" : "Localizable.strings",
        "language" : "nl"
      },
      {
        "target" : "การกระทำนี้จะลบข้อมูลสุขภาพและกิจกรรมทั้งหมดอย่างถาวรและรีเซ็ตการตั้งค่าสุขภาพบน iPhone เครื่องนี้",
        "filename" : "Localizable.strings",
        "language" : "th"
      },
      {
        "target" : "Isso apagará permanentemente todos os dados de Saúde e Atividade e redefinirá os ajustes de Saúde neste iPhone.",
        "filename" : "Localizable.strings",
        "language" : "pt"
      },
      {
        "target" : "Toate datele aplicațiilor Sănătate și Activitate vor fi șterse definitiv de pe acest iPhone, iar configurările aplicației Sănătate vor fi resetate.",
        "filename" : "Localizable.strings",
        "language" : "ro"
      },
      {
        "target" : "這將會永久刪除所有「健康」和「健身記錄」資料，以及重設此iPhone上的「健康」設定。",
        "filename" : "Localizable.strings",
        "language" : "zh_HK"
      },
      {
        "target" : "Ovime će se trajno obrisati svi podaci aplikacija Zdravlje i Aktivnost te resetirati postavke aplikacije Zdravlje na ovom iPhoneu.",
        "filename" : "Localizable.strings",
        "language" : "hr"
      },
      {
        "target" : "यह इस iPhone पर स्थायी रूप से सभी सेहत और ऐक्टिविटी डेटा डिलीट और सेहत सेटिंग्ज़ रीसेट कर देगा।",
        "filename" : "Localizable.strings",
        "language" : "hi"
      },
      {
        "target" : "Aquesta acció eliminarà permanentment totes les dades de salut i activitat, i restablirà la configuració de salut a l’iPhone.",
