{
  "localizations" : {
    "NSLocationWhenInUseUsageDescription" : [
      {
        "target" : "Dein Standort wird zur Anzeige deines Standorts und zur Berechnung des geografischen Nordens verwendet.",
        "filename" : "InfoPlist.strings",
        "language" : "de"
      },
      {
        "target" : "המיקום שלך משמש להצגת מיקומך ולחישוב הצפון האמיתי.",
        "filename" : "InfoPlist.strings",
        "language" : "he"
      },
      {
        "target" : "يتم استخدام موقعك لإظهار موقعك ولحساب الشَمال الحقيقي.",
        "filename" : "InfoPlist.strings",
        "language" : "ar"
      },
      {
        "target" : "Η τοποθεσία σας χρησιμοποιείται για εμφάνιση της τοποθεσίας σας και υπολογισμό του πραγματικού βορρά.",
        "filename" : "InfoPlist.strings",
        "language" : "el"
      },
      {
        "target" : "現在地の表示、および真北の計算に位置情報を使用します。",
        "filename" : "InfoPlist.strings",
        "language" : "ja"
      },
      {
        "target" : "Your location is used to show your location and to calculate true north.",
        "filename" : "InfoPlist.strings",
        "language" : "en"
      },
      {
        "target" : "Ваша геопозиція використовується для показу вашого місцезнаходження та підрахунку географічної півночі.",
        "filename" : "InfoPlist.strings",
        "language" : "uk"
      },
      {
        "target" : "Tu ubicación se utliza para calcular el norte verdadero y mostrar tu ubicación.",
        "filename" : "InfoPlist.strings",
        "language" : "es_419"
      },
      {
        "target" : "A sua localização serve de referência para mostrar a localização e para determinar o Norte geográfico.",
        "filename" : "InfoPlist.strings",
        "language" : "pt_PT"
      },
      {
        "target" : "Se utiliza tu ubicación para mostrar dónde te encuentras y calcular el norte verdadero.",
        "filename" : "InfoPlist.strings",
        "language" : "es"
      },
      {
        "target" : "Din lokalitet bruges til at vise din placering og til at beregne sand nord.",
        "filename" : "InfoPlist.strings",
        "language" : "da"
      },
      {
        "target" : "La tua posizione viene usata per mostrare la posizione stessa e per calcolare il nord geografico.",
        "filename" : "InfoPlist.strings",
        "language" : "it"
      },
      {
        "target" : "Vaša poloha slúži na zobrazenie vašej polohy a vypočítanie skutočného severu.",
        "filename" : "InfoPlist.strings",
        "language" : "sk"
      },
      {
        "target" : "您的位置会用于显示您所在位置及计算真北。",
        "filename" : "InfoPlist.strings",
        "language" : "zh_CN"
      },
      {
        "target" : "Sua localização é usada para mostrar a sua localização e para calcular o norte verdadeiro.",
        "filename" : "InfoPlist.strings",
        "language" : "pt_BR"
      },
      {
        "target" : "Lokasi anda digunakan untuk menunjukkan lokasi anda dan mengira utara benar.",
        "filename" : "InfoPlist.strings",
        "language" : "ms"
      },
      {
        "target" : "Din platsinformation används till att visa din plats och till att hitta geografisk nord.",
        "filename" : "InfoPlist.strings",
        "language" : "sv"
      },
      {
        "target" : "Your location is used to show your location and to calculate true north.",
        "filename" : "InfoPlist.strings",
        "language" : "en_AU"
      },
      {
        "target" : "Vaše poloha se používá k zobrazování místa, kde se nacházíte, a k určování geografického severu.",
        "filename" : "InfoPlist.strings",
        "language" : "cs"
      },
      {
        "target" : "위치를 표시하고 진북을 계산하기 위해 사용자의 위치가 사용됩니다.",
        "filename" : "InfoPlist.strings",
        "language" : "ko"
      },
      {
        "target" : "Posisjonen din brukes for å vise hvor du befinner deg, og til å regne ut geografisk nord.",
        "filename" : "InfoPlist.strings",
        "language" : "no"
      },
      {
        "target" : "A helyzete a helyzetének megjelenítéséhez, illetve a valódi észak kiszámításához van felhasználva.",
        "filename" : "InfoPlist.strings",
        "language" : "hu"
      },
      {
        "target" : "Konumunuzu göstermek ve coğrafi kuzeyi hesaplamak için konumunuz kullanılır.",
        "filename" : "InfoPlist.strings",
        "language" : "tr"
      },
      {
        "target" : "Dane lokalizacji są używane do wyświetlania Twojego położenia i ustalania północy geograficznej.",
        "filename" : "InfoPlist.strings",
        "language" : "pl"
      },
      {
        "target" : "Votre position est utilisée pour afficher votre emplacement et pour calculer le nord géographique.",
        "filename" : "InfoPlist.strings",
        "language" : "fr_CA"
      },
      {
        "target" : "Vị trí của bạn được sử dụng để hiển thị vị trí và tính toán hướng bắc thực.",
        "filename" : "InfoPlist.strings",
        "language" : "vi"
      },
      {
        "target" : "Ваша геопозиция используется для показа Вашего местоположения и расчета истинного севера.",
        "filename" : "InfoPlist.strings",
        "language" : "ru"
      },
      {
        "target" : "Your location is used to show your location and to calculate true north.",
        "filename" : "InfoPlist.strings",
        "language" : "en_GB"
      },
      {
        "target" : "Votre position est utilisée pour afficher votre position et calculer le nord géographique.",
        "filename" : "InfoPlist.strings",
        "language" : "fr"
      },
      {
        "target" : "Sijaintiasi käytetään sijainnin näyttämiseen ja maantieteellisen pohjoisen laskemiseen.",
        "filename" : "InfoPlist.strings",
        "language" : "fi"
      },
      {
        "target" : "Lokasi Anda digunakan untuk menampilkan lokasi Anda dan mengalkulasi utara sesungguhnya.",
        "filename" : "InfoPlist.strings",
        "language" : "id"
      },
      {
        "target" : "Je locatie wordt gebruikt om je locatie weer te geven en het geografische noorden te berekenen.",
        "filename" : "InfoPlist.strings",
        "language" : "nl"
      },
      {
        "target" : "ตำแหน่งที่ตั้งของคุณถูกใช้เพื่อแสดงตำแหน่งที่ตั้งของคุณและคำนวณหาทิศเหนือจริง",
        "filename" : "InfoPlist.strings",
        "language" : "th"
      },
      {
        "target" : "Localizarea dvs. este utilizată pentru a afișa locul unde vă aflați și pentru a calcula nordul geografic.",
        "filename" : "InfoPlist.strings",
        "language" : "ro"
      },
      {
        "target" : "你的位置會用作顯示你的所在位置並計算正北。",
        "filename" : "InfoPlist.strings",
        "language" : "zh_HK"
      },
      {
        "target" : "Vaša lokacija koristi se za prikazivanje vaše lokacije i za izračunavanje pravog sjevera.",
        "filename" : "InfoPlist.strings",
        "language" : "hr"
      },
      {
        "target" : "आपके स्थान का उपयोग आपका स्थान दिखाने और वास्तविक उत्तर की गणना करने के लिए किया जाता है।",
        "filename" : "InfoPlist.strings",
        "language" : "hi"
      },
      {
        "target" : "La ubicació es fa servir per mostrar on ets i calcular el nord vertader.",
        "filename" : "InfoPlist.strings",
        "language" : "ca"
      },
      {
        "target" : "您的位置會用來顯示所在位置並計算正北。",
        "filename" : "InfoPlist.strings",
        "language" : "zh_TW"
      }
    ],
