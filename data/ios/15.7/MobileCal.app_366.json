        "language" : "de"
      },
      {
        "target" : "היישום ״לוח שנה״ משתמש באנשי הקשר שלך כדי להזמין אנשים לאירועים, להציג ימי הולדת ולשפר חיפושים מבוססי-מיקום.",
        "filename" : "InfoPlist.strings",
