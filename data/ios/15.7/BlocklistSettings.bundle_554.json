    "BLOCKLIST_HELP" : [
      {
        "target" : "Von den blockierten Personen wirst du keine Anrufe, E-Mails, Nach­richten, E-Mails oder FaceTime-Anrufe erhalten.",
        "filename" : "BlocklistSettings.strings",
        "language" : "de"
      },
      {
        "target" : "לא יתקבלו הודעות, דוא״ל, שיחות טלפון או שיחות FaceTime ממספרים ברשימת המספרים החסומים.",
        "filename" : "BlocklistSettings.strings",
        "language" : "he"
      },
      {
        "target" : "لن تستلم مكالمات هاتفية أو رسائل أو رسائل بريد إلكتروني أو FaceTime من الأشخاص الموجودين في القائمة المحظورة.",
        "filename" : "BlocklistSettings.strings",
        "language" : "ar"
      },
      {
        "target" : "Δεν θα λαμβάνετε τηλεφωνικές κλήσεις, μηνύματα, email, ή κλήσεις FaceTime από άτομα που βρίσκονται στη λίστα αποκλεισμένων.",
        "filename" : "BlocklistSettings.strings",
        "language" : "el"
      },
      {
        "target" : "着信拒否設定リストに登録した人からの電話、メッセージ、メール、FaceTimeは着信しません。",
        "filename" : "BlocklistSettings.strings",
        "language" : "ja"
      },
      {
        "target" : "You will not receive phone calls, messages, email, or FaceTime from people on the block list.",
        "filename" : "BlocklistSettings.strings",
        "language" : "en"
      },
      {
        "target" : "Ви не отримуватимете телефонні виклики, повідомлення, е‑листи або виклики FaceTime від абонентів зі списку блокованих.",
        "filename" : "BlocklistSettings.strings",
        "language" : "uk"
      },
      {
        "target" : "No recibirás llamadas telefónicas, mensajes, correos o llamadas de FaceTime de los números bloqueados.",
        "filename" : "BlocklistSettings.strings",
        "language" : "es_419"
      },
      {
        "target" : "Não receberá chamadas, mensagens, e‑mails nem chamadas FaceTime de pessoas na lista de contactos bloqueados.",
        "filename" : "BlocklistSettings.strings",
        "language" : "pt_PT"
      },
      {
        "target" : "No recibirás llamadas de teléfono, mensajes, correos electrónicos ni comunicaciones de FaceTime de las personas que se encuentren en la lista de bloqueo.",
        "filename" : "BlocklistSettings.strings",
        "language" : "es"
      },
      {
        "target" : "Du vil ikke modtage telefonopkald, beskeder, e-mails eller FaceTime-opkald fra blokerede personer.",
        "filename" : "BlocklistSettings.strings",
        "language" : "da"
      },
      {
        "target" : "Non riceverai telefonate, messaggi, e-mail né chiamate FaceTime dalle persone presenti nell'elenco dei contatti bloccati.",
        "filename" : "BlocklistSettings.strings",
        "language" : "it"
      },
      {
        "target" : "Od ľudí v zozname blokovaných nebudete prijímať telefonické hovory, správy, emaily ani FaceTime hovory.",
        "filename" : "BlocklistSettings.strings",
        "language" : "sk"
      },
      {
        "target" : "您不会收到黑名单中联系人的来电、信息、电子邮件或FaceTime通话。",
        "filename" : "BlocklistSettings.strings",
        "language" : "zh_CN"
      },
      {
        "target" : "Anda tidak akan menerima panggilan telefon, mesej, e-mel atau FaceTime daripada orang pada senarai sekat.",
        "filename" : "BlocklistSettings.strings",
        "language" : "ms"
      },
      {
        "target" : "Du kommer inte att få samtal, meddelanden, mejl eller FaceTime-samtal från personer på blockeringslistan.",
        "filename" : "BlocklistSettings.strings",
        "language" : "sv"
      },
      {
        "target" : "You will not receive phone calls, messages, email or FaceTime from people on the block list.",
        "filename" : "BlocklistSettings.strings",
        "language" : "en_AU"
      },
      {
        "target" : "Od lidí v seznamu zablokovaných uživatelů nebudete přijímat hovory, zprávy, e‑maily ani komunikaci přes FaceTime.",
        "filename" : "BlocklistSettings.strings",
        "language" : "cs"
      },
      {
        "target" : "차단 목록에 있는 사용자로부터 전화, 메시지, 이메일 또는 FaceTime을 받을 수 없게 됩니다.",
        "filename" : "BlocklistSettings.strings",
        "language" : "ko"
      },
      {
        "target" : "Du vil ikke motta samtaler, meldinger, e‑post eller FaceTime-anrop fra personer på listen over blokkerte numre.",
        "filename" : "BlocklistSettings.strings",
        "language" : "no"
      },
      {
        "target" : "A letiltott listán szereplő emberektől nem fog telefonhívásokat, üzeneteket, e-maileket vagy FaceTime-hívásokat kapni.",
