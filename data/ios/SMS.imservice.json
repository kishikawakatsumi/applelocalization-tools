    "Enter the code shown on your %@ to allow iPhone text messages to also be sent and received on \\U201C%@\\U201D.": [
      {
        "filename": "SMSLocalizable.strings",
        "language": "de",
        "target": "Gib den Code ein, der auf deinem Gerät (%@) angezeigt wird, damit iPhone-Nachrichten auch mit „%@“ gesendet und empfangen werden dürfen."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "he",
        "target": "כדי לאפשר שליחה וקבלה של ההודעות ב-iPhone שלך גם ב-״%2$@״, יש להזין את הקוד המוצג על-גבי ה-%1$@."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ar",
        "target": "قم بإدخال الرمز الذي يظهر على الـ %@ ليسمح للرسائل النصية للـ iPhone بإرسالها واستقبالها على الـ \"%@\"."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "el",
        "target": "Εισαγάγετε τον κωδικό που εμφανίζεται στο %@ σας για να επιτρέπεται επίσης η αποστολή και η λήψη γραπτών μηνυμάτων iPhone στο «%@»."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ja",
        "target": "“%2$@”でもiPhoneのSMS/MMSを送受信できるようにするには、%1$@に表示されているコードを入力してください。"
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "en",
        "target": "Enter the code shown on your %@ to allow iPhone text messages to also be sent and received on “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "uk",
        "target": "Введіть код, показаний на вашому %@, щоб дозволити надсилання і отримання текстових повідомлень з iPhone також на «%@»."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "es_419",
        "target": "Ingresa el código mostrado en tu %@ para permitir que se puedan enviar y recibir mensajes de texto del iPhone en “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "pt_PT",
        "target": "Digite o código que aparece no %@ “%@” para permitir que este também possa receber e enviar as mensagens SMS do iPhone."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "es",
        "target": "Introduce el código que se muestra en el %@ para poder enviar y recibir mensajes de texto del iPhone desde “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "da",
        "target": "Skriv den kode, der vises på %@, for at tillade, at beskeder fra iPhone også kan sendes fra og modtages på “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "it",
        "target": "Inserisci il codice mostrato sul tuo %@ per fare in modo che i messaggi di testo di iPhone vengano inviati e ricevuti anche su “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "sk",
        "target": "Zadajte kód zobrazený na zariadení %@, aby sa dali textové správy z iPhonu odosielať a prijímať aj na zariadení „%@“."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "zh_CN",
        "target": "请输入您%@收到的验证码以允许“%@”接收和发送iPhone短信。"
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ms",
        "target": "Masukkan kod yang ditunjukkan pada %@ anda untuk membenarkan mesej teks iPhone turut dihantar dan diterima pada “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "sv",
        "target": "Ange koden som visas på din %@ för att tillåta att ”%@” kan skicka och ta emot din iPhones SMS-meddelanden."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "en_AU",
        "target": "Enter the code shown on your %@ to allow iPhone text messages to also be sent and received on “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "cs",
        "target": "Chcete-li přeposílat textové zprávy mezi iPhonem a „%2$@“ zadejte kód zobrazený na vašem zařízení %1$@."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ko",
        "target": "iPhone 문자 메시지를 ‘%2$@’에서 주고 받을 수 있도록 허용하려면 사용자의 %1$@에 표시된 코드를 입력하십시오."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "no",
        "target": "Skriv koden som vises på %@, for å tillate at iPhone-tekstmeldinger også kan sendes og mottas på «%@»."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "hu",
        "target": "Adja meg a(z) %@ eszközön megjelenő kódot, az iPhone szöveges üzenetek „%@” eszközön történő küldésének és fogadásának engedélyezéséhez."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "tr",
        "target": "iPhone mesajlarının “%2$@” üzerinde de gönderilip alınmasına izin vermek için %1$@ üzerinde gösterilen kodu girin."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "pl",
        "target": "Podaj kod, który wyświetla %@, aby pozwolić na odbieranie i wysyłanie wiadomości tekstowych z iPhone'a na „%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "fr_CA",
        "target": "Entrez le code affiché sur votre %@ pour permettre aux SMS de l’iPhone d’être aussi envoyés et reçus sur « %@ »."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "vi",
        "target": "Nhập mã được hiển thị trên %@ của bạn để cũng cho phép gửi và nhận tin nhắn văn bản của iPhone trên “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ru",
        "target": "Введите код, указанный на %@, чтобы разрешить отправку и получение текстовых сообщений iPhone на устройстве «%@»."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "en_GB",
        "target": "Enter the code shown on your %@ to allow iPhone text messages to also be sent and received on “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "fr",
        "target": "Saisissez le code qui s’affiche sur votre %@ pour que les SMS de votre iPhone puissent également être envoyés et reçus sur « %@ »."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "fi",
        "target": "Myös %2$@ saa lähettää ja vastaanottaa iPhone-tekstiviestejä, kun syötät koodin, jonka %1$@ näyttää."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "id",
        "target": "Masukkan kode yang ditampilkan di %@ Anda agar pesan teks iPhone ikut dikirim dan diterima di “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "nl",
        "target": "Typ de code die op je %@ wordt weergegeven om toe te staan dat sms-berichten van je iPhone ook op '%@' worden gestuurd en ontvangen."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "th",
        "target": "ป้อนรหัสที่แสดงบน %@ ของคุณเพื่ออนุญาตให้ส่งและรับข้อความตัวอักษรของ iPhone บน “%@” ได้ด้วย"
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "pt",
        "target": "Digite o código mostrado em seu %@ para permitir que as mensagens de texto do iPhone também sejam enviadas e recebidas em “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ro",
        "target": "Introduceți codul afișat pe %@‑ul dvs. pentru a permite ca mesajele text ale iPhone‑ului să poate fi trimise și recepționate și cu “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "zh_HK",
        "target": "請輸入%@上顯示的代碼，以允許「%@」也能傳送及接收iPhone的短訊。"
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "hr",
        "target": "Unesite kôd prikazan na vašem %@ uređaju kako biste dozvolili slanje i primanje tekstualnih poruka s vašeg iPhonea putem “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "hi",
        "target": "आपके %1$@ पर प्रदर्शित कोड को दर्ज करें ताकि iPhone को “%2$@” पर भी SMS को भेजने और प्राप्त करने की अनुमति मिल सके।"
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "ca",
        "target": "Introdueix el codi que es mostra al teu %@ per permetre que els missatges de text de l’iPhone també s’enviïn i es rebin a “%@”."
      },
      {
        "filename": "SMSLocalizable.strings",
        "language": "zh_TW",
        "target": "輸入%@上顯示的代碼來允許在「%@」上發送和接收iPhone訊息。"
      }
    ],
