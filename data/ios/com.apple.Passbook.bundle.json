    "NSUserNotificationsUsageDescription": [
      {
        "filename": "InfoPlist.strings",
        "language": "de",
        "target": "Du erhältst Neuigkeiten über deine Karten und wirst über neue Wallet-Funktionen benachrichtigt."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "he",
        "target": "יישלחו אליך עדכונים בנוגע לכרטיסים שלך והודעות לגבי מאפיינים חדשים ב-Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ar",
        "target": "ستحصل على تحديثات حول بطاقاتك وسيتم إعلامك بالميزات الجديدة في Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "el",
        "target": "Θα λαμβάνετε ενημερώσεις για τις κάρτες σας και θα ειδοποιείστε για νέες δυνατότητες του Πορτοφολιού."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ja",
        "target": "カードに関するアップデートと新しいウォレットの機能に関する通知を受信します。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en",
        "target": "You’ll get updates about your cards and be notified about new Wallet features."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "uk",
        "target": "Ви отримуватимете актуальні відомості щодо ваших карток і сповіщення про нові функції Гаманця."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es_419",
        "target": "Recibirás actualizaciones de tus tarjetas y notificaciones sobre las nuevas funciones de Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_PT",
        "target": "Receberá atualizações sobre os seus cartões e notificações de novas funcionalidades na Carteira."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "es",
        "target": "Recibirás actualizaciones de tus tarjetas y notificaciones sobre nuevas funciones de la app Cartera."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "da",
        "target": "Du får opdateringer om dine kort og besked om nye funktioner i Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "it",
        "target": "Riceverai aggiornamenti sulle carte e notifiche sulle nuove funzionalità di Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sk",
        "target": "Budete dostávať aktualizácie o svojich kartách a upozornenia na nové funkcie Peňaženky."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_CN",
        "target": "您将获得卡片相关更新并在“钱包”推出新功能时收到通知。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pt_BR",
        "target": "Você receberá atualizações sobre seus cartões e notificações sobre novos recursos do app Carteira."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ms",
        "target": "Anda akan mendapat kemas kini tentang kad anda dan dimaklumkan tentang ciri Wallet baharu."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "sv",
        "target": "Du får uppdateringar om dina kort och notiser om nya funktioner i Plånbok."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_AU",
        "target": "You’ll get updates about your cards and be notified about new Wallet features."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "cs",
        "target": "Budete dostávat oznámení o svých kartách a nových funkcích v Peněžence."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ko",
        "target": "카드에 관한 업데이트 및 지갑 앱의 새로운 기능에 관해 알림을 받게 됩니다."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "no",
        "target": "Du vil få oppdateringer om kort og varslinger om nye Lommebok-funksjoner."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hu",
        "target": "Értesítéseket kap a kártyáiról, valamint a Tárca új funkcióiról."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "tr",
        "target": "Kartlarınız hakkında güncellemeler ve yeni Wallet özellikleri hakkında bildirimler alırsınız."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "pl",
        "target": "Będziesz otrzymywać powiadomienia dotyczące swoich kart oraz nowych funkcji Portfela."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr_CA",
        "target": "Vous recevrez des nouvelles sur vos cartes et des notifications sur les nouvelles fonctionnalités de l’app Portefeuille."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "vi",
        "target": "Bạn sẽ nhận được các cập nhật về thẻ của mình và được thông báo về các tính năng mới của Ví."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ru",
        "target": "Вы будете получать оповещения о своих картах и уведомления о новых функциях Wallet."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "en_GB",
        "target": "You’ll get updates about your cards and be notified about new Wallet features."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fr",
        "target": "Vous recevrez des alertes concernant vos cartes et les nouvelles fonctionnalités de l’app Cartes."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "fi",
        "target": "Saat korttiisi liittyviä tiedotteita ja sinulle ilmoitetaan Lompakon uusista ominaisuuksista."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "id",
        "target": "Anda akan mendapatkan pembaruan mengenai kartu Anda dan fitur Dompet baru."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "nl",
        "target": "Je ontvangt updates over je kaarten en je kunt een melding ontvangen over nieuwe Wallet-functies."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "th",
        "target": "คุณจะได้รับการอัปเดตเกี่ยวกับบัตรของคุณและได้รับการแจ้งเตือนเกี่ยวกับคุณสมบัติใหม่ของกระเป๋าสตางค์"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ro",
        "target": "Veți primi actualizări despre cardurile dvs. și notificări despre noile funcționalități Portofel."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_HK",
        "target": "你會取得卡的更新，並在「銀包」推出新功能時收到通知。"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hr",
        "target": "Primit ćete ažuriranja o svojim karticama i dobit ćete obavijesti o novim značajkama aplikacije Novčanik."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "hi",
        "target": "आपको अपने कार्ड के संबंध में अपडेट और वॉलेट के नए फ़ीचर के बारे में सूचनाएँ प्राप्त होंगी।"
      },
      {
        "filename": "InfoPlist.strings",
        "language": "ca",
        "target": "Rebràs actualitzacions sobre les targetes i notificacions sobre les funcions noves de l’app Cartera."
      },
      {
        "filename": "InfoPlist.strings",
        "language": "zh_TW",
        "target": "您會收到卡片更新及「錢包」新功能的相關通知。"
      }
    ]
  }
