      },
      {
        "filename" : "PageMultidiskSelection.loctable",
        "language" : "hr",
        "target" : "Vaše računalo sadrži više od jednog unutrašnjeg diska. Odaberite disk za prikaz dostupnih opcija:"
      },
      {
        "filename" : "PageMultidiskSelection.loctable",
        "target" : "Komputer memiliki lebih dari satu disk internal. Pilih disk untuk melihat pilihan yang tersedia:",
