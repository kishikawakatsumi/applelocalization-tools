    "AMDOptions" : [
      {
        "filename" : "InfoPlist.loctable",
        "language" : "no",
        "target" : "Det nye volumet får standardnavnet «Diskfil», og navnet på den nye diskfilen blir standardnavnet «Diskfil.dmg»."
      },
      {
        "target" : "新的卷宗名稱預設為「磁碟映像檔」，而新的磁碟映像檔名稱預設為「磁碟映像檔.dmg」。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Стандартне імʼя нового тому – «Образ диска», а стандартне імʼя нового образу диска – «Образ диска.dmg».",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "language" : "sv",
        "target" : "Den nya volymens förvalda namn blir ”Skivavbild” och den nya skivavbildens namn blir som förval ”Skivavbild.dmg”.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "de",
        "target" : "Der neue Volumename lautet standardmäßig „Image“ und der neue Image-Name lautet standardmäßig „Image.dmg“.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "De naam van het nieuwe volume is standaard 'Schijfkopie' en de naam van de nieuwe schijfkopie 'Schijfkopie.dmg.'",
        "filename" : "InfoPlist.loctable",
        "language" : "nl"
      },
      {
        "language" : "tr",
        "filename" : "InfoPlist.loctable",
        "target" : "Yeni disk bölümünün saptanmış adı “Disk Görüntüsü”, yeni disk görüntüsünün saptanmış adı “Disk Görüntüsü.dmg.” olacaktır."
      },
      {
        "target" : "Tên ổ đĩa mới được đặt mặc định thành “Ảnh Đĩa” và tên ảnh đĩa mới được đặt mặc định thành “Ảnh Đĩa.dmg”.",
        "language" : "vi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "hu",
        "target" : "Az új kötet alapértelmezett neve „Lemezkép”, az új lemezkép alapértelmezett neve pedig „Lemezkép.dmg”."
      },
      {
        "language" : "sk",
        "target" : "Predvolený názov nového oddielu je „Obraz disku“ a predvolený názov nového obrazu disku je „Obraz disku.dmg“.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "it",
        "target" : "Il nome di default di un nuovo volume è “Immagine disco” e quello di una nuova immagine disco è “Disk Image.dmg”.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ms",
        "target" : "Nama volum baharu dilalaikan kepada “Imej Cakera” dan nama imej cakera baharu dilalaikan kepada “Imej Cakera.dmg”."
      },
      {
        "language" : "id",
        "target" : "Nama volume baru secara default adalah “Image Disk”, dan nama image disk baru secara default adalah “Disk Image.dmg.”",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "pt_BR",
        "filename" : "InfoPlist.loctable",
        "target" : "O nome do novo volume é ajustado para “Imagem de Disco” por padrão, assim como o nome da nova imagem de disco também é ajustado por padrão para “Imagem de Disco.dmg”."
      },
      {
        "language" : "ar",
        "filename" : "InfoPlist.loctable",
        "target" : "الإعداد الافتراضي لاسم وحدة التخزين الجديدة هو \"صورة القرص\"، والإعداد الافتراضي لاسم صورة القرص الجديد هو \"صورة القرص.dmg\"."
      },
      {
        "target" : "新規ボリュームの名前はデフォルトで“ディスクイメージ”になり、新規ディスクイメージの名前はデフォルトで“ディスクイメージ.dmg”になります。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "th",
        "target" : "ชื่อดิสก์โวลุ่มใหม่เริ่มต้นเป็นชื่อ “ภาพดิสก์” และชื่อภาพดิสก์ใหม่เริ่มต้นเป็นชื่อ “ภาพดิสก์.dmg”"
      },
      {
        "target" : "新宗卷的名称默认为“磁盘映像”，而新磁盘映像的名称默认为“磁盘映像.dmg”。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN"
      },
      {
        "language" : "fi",
        "target" : "Uuden taltion oletusarvoinen nimi on ”Levytiedosto” ja uuden levytiedoston oletusarvoinen nimi on ”Levytiedosto.dmg”.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "hi",
        "target" : "नया वॉल्यूम नाम \"डिस्क इमेज\" के लिए डिफ़ॉल्ट है और नया डिस्क इमेज नाम “Disk Image.dmg” के लिए डिफ़ॉल्ट है।"
      },
      {
        "target" : "Ime nove jedinice standardizirano je u “Slika diska”, a novi naziv slike diska standardiziran je u “Slika diska.dmg”.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
