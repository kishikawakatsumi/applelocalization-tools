      {
        "language" : "pl",
        "target" : "Grupy okien automatycznie odtwarzają połączenia zdalne i polecenia uznane za bezpieczne do wykonania bez potwierdzania. Zaznacz tę opcję, aby otwarcie tej grupy odtwarzało wszystkie polecenia.",
        "filename" : "TTWorkspaceSaveAccessory.loctable"
