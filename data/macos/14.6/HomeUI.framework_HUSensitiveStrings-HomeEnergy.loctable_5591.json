      },
      {
        "target" : "Pogledajte lokalne rasporede zelene energije kako biste lakše isplanirali vrijeme uporabe električne energije u domu.",
        "language" : "hr",
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable"
      },
      {
        "filename" : "HUSensitiveStrings-HomeEnergy.loctable",
