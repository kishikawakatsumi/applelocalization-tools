        "filename" : "GuestLogOut.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "You are logged in as a guest user. Logging out deletes all files and information in the guest user home folder. These files cannot be recovered.",
        "filename" : "GuestLogOut.loctable"
      },
      {
        "language" : "fr_CA",
