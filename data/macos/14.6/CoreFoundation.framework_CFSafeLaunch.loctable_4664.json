      },
      {
        "filename" : "CFSafeLaunch.loctable",
        "target" : "Bạn đã tạo tùy chọn mới cho %@. Bạn có muốn sử dụng những cài đặt này từ bây giờ không?",
        "language" : "vi"
      },
      {
        "filename" : "CFSafeLaunch.loctable",
