    "CFSafeRelaunchDialogTextString" : [
      {
        "language" : "es_419",
        "filename" : "CFSafeLaunch.loctable",
        "target" : "Creaste nuevas preferencias para %@. ¿Quieres usar esta configuración a partir de ahora?"
      },
      {
        "target" : "Hai creato nuove preferenze per %@. Desideri utilizzare queste impostazioni da adesso?",
        "language" : "it",
        "filename" : "CFSafeLaunch.loctable"
      },
      {
        "filename" : "CFSafeLaunch.loctable",
        "target" : "Você criou novas preferências para %@. Deseja usar esses ajustes de agora em diante?",
        "language" : "pt_BR"
      },
      {
        "target" : "你已为%@创建了新偏好设置。你希望现在就开始使用这些设置吗？",
        "filename" : "CFSafeLaunch.loctable",
        "language" : "zh_CN"
      },
      {
        "language" : "ro",
        "target" : "Ați creat preferințe noi pentru %@. Doriți să utilizați aceste configurări de acum înainte?",
        "filename" : "CFSafeLaunch.loctable"
      },
      {
        "target" : "Vous avez créé de nouveaux réglages pour %@. Voulez-vous les utiliser à partir de maintenant ?",
        "language" : "fr",
        "filename" : "CFSafeLaunch.loctable"
      },
      {
        "language" : "ja",
        "target" : "%@の新しい環境設定を作成しました。これ以降はこれらの設定を使用しますか?",
