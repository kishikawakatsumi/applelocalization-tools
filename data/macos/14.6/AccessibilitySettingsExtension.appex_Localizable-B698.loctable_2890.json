  "framework" : "AccessibilitySettingsExtension.appex",
  "loctablePath" : "\/System\/Library\/ExtensionKit\/Extensions\/AccessibilitySettingsExtension.appex\/Contents\/Resources\/Localizable-B698.loctable",
