  "localizations" : {
    "audio.volumeSwipeDuration.desc" : [
      {
        "target" : "Щоб запобігти небажаним перемиканням гучності, виберіть час очікування між спробами.",
        "language" : "uk",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "target" : "Untuk mencegah penyesuaian volume yang tidak disengaja, pilih waktu tunggu yang Anda inginkan di antara gesekan.",
        "language" : "id",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "zh_CN",
        "target" : "为避免意外调整音量，请选择轻扫间的首选等候时间。",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "sk",
        "target" : "Ak chcete zabrániť neželaným úpravám hlasitosti, nastavte preferovaný interval čakania medzi potiahnutiami."
      },
      {
        "language" : "da",
        "target" : "Vælg et foretrukket interval mellem stryg for at forhindre utilsigtede lydstyrkejusteringer.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "hi",
        "target" : "अनचाहे वॉल्यूम ऐडजस्टमेंट से बचने के लिए स्वाइप के बीच इच्छित प्रतीक्षा समय चुनें।",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "hu",
        "filename" : "Localizable-B698.loctable",
        "target" : "A nem szándékos hangerő-módosítások megelőzése érdekében válassza ki, hogy mennyi várakozási időnek kell eltelnie a legyintések között."
      },
      {
        "language" : "zh_HK",
        "filename" : "Localizable-B698.loctable",
        "target" : "為了避免意外調整音量，請選擇在每次輕掃之間偏好的等候時間。"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "target" : "Du kan förhindra oönskade volymjusteringar genom att välja en önskad väntetid mellan svep.",
        "language" : "sv"
      },
      {
        "target" : "כדי למנוע התאמות לא מכוונות של עוצמת השמע, יש לבחור זמן השהיה מועדף בין החלקות.",
        "filename" : "Localizable-B698.loctable",
        "language" : "he"
      },
      {
        "target" : "Velg foretrukket ventetid mellom sveipene for å unngå uønskede volumjusteringer.",
        "filename" : "Localizable-B698.loctable",
        "language" : "no"
      },
      {
        "target" : "Pour éviter les ajustements involontaires du volume, sélectionnez la durée d’attente souhaitée entre les gestes de balayage.",
        "language" : "fr_CA",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "To prevent unintended volume adjustments, select preferred waiting time between swipes.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "de",
        "target" : "Um nicht beabsichtigte Änderungen der Lautstärke zu vermeiden, kann eine gewünschte Wartezeit zwischen den Streichgesten ausgewählt werden.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "en",
        "target" : "To prevent unintended volume adjustments, select preferred wait time between swipes."
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "ca",
        "target" : "Per evitar canviar el volum sense voler, selecciona el temps d’espera que vulguis entre lliscada i lliscada."
      },
      {
        "target" : "若要避免意外調整音量，請選取每次滑動之間偏好的等待時間。",
        "filename" : "Localizable-B698.loctable",
        "language" : "zh_TW"
      },
      {
        "language" : "ru",
        "target" : "Чтобы предотвратить случайное изменение громкости, выберите время ожидания между жестами смахивания.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "fr",
        "target" : "Pour éviter l’ajustement involontaire du volume, sélectionnez le temps d’attente désiré entre chaque balayage.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "language" : "ko",
        "target" : "의도치 않게 볼륨이 조절되는 것을 방지하려면 쓸어올리거나 내리는 제스처 사이에 적용할 대기 시간을 선택하십시오.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "target" : "Za sprječavanje neželjenih promjena glasnoće odaberite željeno vrijeme čekanja između poteza.",
        "language" : "hr"
      },
      {
        "target" : "Pentru a preveni ajustarea neintenționată a volumului, selectați timpul de așteptare preferat între glisări.",
        "filename" : "Localizable-B698.loctable",
        "language" : "ro"
      },
      {
        "target" : "ในการป้องกันการปรับระดับเสียงที่ไม่ได้ตั้งใจ ให้เลือกระยะเวลารอที่ต้องการในระหว่างการปัด",
        "filename" : "Localizable-B698.loctable",
        "language" : "th"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "target" : "Aby zapobiegać niezamierzonym zmianom głośności, wybierz preferowany czas oczekiwania między gestami.",
        "language" : "pl"
      },
      {
        "language" : "ja",
        "target" : "意図せずに音量が調整されないようにするために、スワイプとスワイプの間の待ち時間を選んでください。",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "nl",
        "target" : "Om onbedoelde volumeaanpassingen te voorkomen, selecteer je een voorkeurswachttijd tussen veegbewegingen."
      },
      {
        "target" : "Para impedir ajustes de volume indesejados, selecione o tempo de espera da sua preferência entre os ajustes.",
        "filename" : "Localizable-B698.loctable",
        "language" : "pt"
      },
      {
        "language" : "el",
        "target" : "Για αποτροπή ακούσιων προσαρμογών έντασης ήχου, επιλέξτε τον προτιμώμενο χρόνο αναμονής μεταξύ των σαρώσεων.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "ar",
        "target" : "لمنع الضبط غير المقصود لمستوى الصوت، يمكنك تحديد مدة الانتظار المفضلة بين السحبات."
      },
      {
        "target" : "Para evitar que se ajuste el volumen sin querer, selecciona el tiempo de espera que debe pasar entre deslizamientos.",
        "filename" : "Localizable-B698.loctable",
        "language" : "es"
      },
      {
        "target" : "Nastavením preferované prodlevy mezi přejetími můžete zabránit nechtěným změnám hlasitosti.",
        "filename" : "Localizable-B698.loctable",
        "language" : "cs"
      },
      {
        "language" : "it",
        "target" : "Per evitare regolazioni indesiderate del volume, seleziona il tempo di attesa preferito tra uno scorrimento e l’altro.",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "target" : "Para evitar ajustar o volume acidentalmente, selecione o tempo de espera pretendido entre gestos.",
        "filename" : "Localizable-B698.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Selecciona el tiempo que deseas esperar cada vez que deslizas para evitar que el volumen se ajuste involuntariamente.",
        "language" : "es_419",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "target" : "Untuk mengelakkan pelarasan kelantangan yang tidak disengajakan, pilih masa menunggu pilihan antara leretan.",
        "language" : "ms",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "en_AU",
        "target" : "To prevent unintended volume adjustments, select preferred waiting time between swipes."
      },
      {
        "target" : "İstenmeyen ses yüksekliği ayarlamalarını önlemek için kaydırmalar arasında tercih ettiğiniz bekleme süresini seçin.",
        "language" : "tr",
        "filename" : "Localizable-B698.loctable"
      },
      {
        "target" : "Để ngăn việc điều chỉnh âm lượng ngoài ý muốn, hãy chọn thời gian đợi được ưu tiên giữa các lần vuốt.",
        "filename" : "Localizable-B698.loctable",
        "language" : "vi"
      },
      {
        "filename" : "Localizable-B698.loctable",
        "language" : "fi",
        "target" : "Estä tahaton äänenvoimakkuuden säätö valitsemalla haluamasi pyyhkäisyjen välinen odotusaika."
      }
