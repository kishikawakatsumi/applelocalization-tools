      },
      {
        "filename" : "Localizable.loctable",
        "language" : "no",
        "target" : "«%@» vil ha tilgang til, endre og gjøre opptak av systemlyden."
      },
      {
        "target" : "„%@” chce uzyskać dostęp do dźwięku systemowego oraz modyfikować i nagrywać go.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "language" : "ms",
        "target" : "“%@” mahu mengakses, mengubah suai dan merakam audio sistem anda.",
        "filename" : "Localizable.loctable"
      },
      {
        "target" : "״%@״ מבקש לגשת לשמע המערכת שלך, לשנות אותו ולהקליט אותו",
        "language" : "he",
        "filename" : "Localizable.loctable"
      },
      {
        "filename" : "Localizable.loctable",
        "target" : "“%@” muốn truy cập, sửa đổi và ghi âm thanh hệ thống của bạn.",
        "language" : "vi"
      },
      {
        "language" : "en",
        "target" : "“%@” would like to access, modify and record your system audio.",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "hr",
        "target" : "“%@” želi pristupiti, promijeniti i snimiti zvuk sustava.",
        "filename" : "Localizable.loctable"
      },
      {
        "language" : "tr",
        "filename" : "Localizable.loctable",
        "target" : "“%@”, sistem sesinize erişmek, onu değiştirmek ve kaydetmek istiyor."
      },
      {
        "target" : "%@ haluaa käyttää, muokata ja tallentaa järjestelmän ääntä.",
