    "5.title" : [
      {
        "target" : "Možete resetirati lozinku vašeg računa uporabom vaših Apple ID vjerodajnica.",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "hr"
      },
      {
        "target" : "你可以使用Apple ID憑證來重置帳號密碼。",
        "language" : "zh_TW",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "Je kunt je accountwachtwoord opnieuw instellen met je Apple ID-gegevens.",
        "language" : "nl",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "ko",
        "target" : "Apple ID 자격 증명을 사용하여 계정 암호를 재설정할 수 있습니다.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "uk",
        "target" : "Пароль облікового запису можна скинути за допомогою облікових даних Apple ID.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "Apple kimliği bilgilerinizi kullanarak hesap parolanızı sıfırlayabilirsiniz.",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "tr"
      },
      {
        "language" : "pt_BR",
        "target" : "Você pode redefinir a senha da sua conta usando suas credenciais do ID Apple.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "Heslo účtu můžete obnovit pomocí svého Apple ID.",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "cs"
      },
      {
        "target" : "你可以使用Apple ID凭证来重设你的账户密码。",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Apple IDの資格情報を使用してアカウントのパスワードをリセットすることができます。",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "ja"
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "ru",
        "target" : "Сбросить пароль своей учетной записи можно с помощью учетных данных Apple ID."
      },
      {
        "language" : "zh_HK",
        "target" : "你可以使用Apple ID憑證來重置帳户密碼。",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "target" : "Anda dapat mengatur ulang kata sandi menggunakan informasi pengesahan ID Apple Anda.",
        "language" : "id"
      },
      {
        "language" : "hi",
        "target" : "आप अपने Apple ID क्रेडेंशियल का उपयोग करके अपना खाता पासवर्ड रीसेट कर सकते हैं।",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "Bạn có thể đặt lại mật khẩu tài khoản bằng thông tin đăng nhập ID Apple của bạn.",
        "language" : "vi",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "You can reset your account password using your Apple ID credentials.",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Du kan nulstille din kontoadgangskode med dine Apple-id-brugeroplysninger.",
        "language" : "da",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "es",
        "target" : "Puedes restablecer la contraseña de tu cuenta mediante tu ID de Apple.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "target" : "Pode repor a palavra‑passe da conta através do ID Apple.",
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "pt_PT"
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "fi",
        "target" : "Voit nollata tilin salasanan Apple ID -tunnistetietojen avulla."
      },
      {
        "target" : "Du kan nullstille kontopassordet med Apple-ID-akkreditivene dine.",
        "language" : "no",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "sv",
        "filename" : "LUIAppleIDPopover.loctable",
        "target" : "Du kan skapa ett nytt kontolösenord genom att logga in med ditt Apple-ID."
      },
      {
        "language" : "it",
        "target" : "Puoi reimpostare la password del tuo account utilizzando le credenziali del tuo ID Apple.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "sk",
        "filename" : "LUIAppleIDPopover.loctable",
        "target" : "Heslo vášho účtu môžete resetovať pomocou prihlasovacích údajov svojho Apple ID."
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "th",
        "target" : "คุณสามารถรีเซ็ตรหัสผ่านบัญชีของคุณได้โดยใช้ข้อมูลประจำตัวของ Apple ID ของคุณ"
      },
      {
        "language" : "el",
        "target" : "Μπορείτε να επαναφέρετε το συνθηματικό λογαριασμού σας αν χρησιμοποιήσετε τα διαπιστευτήρια Apple ID σας.",
        "filename" : "LUIAppleIDPopover.loctable"
      },
      {
        "language" : "es_419",
        "filename" : "LUIAppleIDPopover.loctable",
        "target" : "Puedes cambiar la contraseña de tu cuenta usando tu Apple ID."
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "pl",
        "target" : "Możesz wyzerować hasło, podając swój Apple ID."
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "language" : "fr_CA",
        "target" : "Vous pouvez réinitialiser le mot de passe de votre compte en utilisant les autorisations de votre identifiant Apple."
      },
      {
        "filename" : "LUIAppleIDPopover.loctable",
        "target" : "ניתן לאפס את סיסמת החשבון בעזרת פרטי ה-Apple ID שלך.",
        "language" : "he"
      },
      {
        "language" : "de",
        "target" : "Du kannst dein Accountpasswort mithilfe deiner Apple-ID-Anmeldedaten zurücksetzen.",
