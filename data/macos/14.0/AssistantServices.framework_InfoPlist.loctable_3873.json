    "NSLocationWhenInUseUsageDescription" : [
      {
        "filename" : "InfoPlist.loctable",
        "language" : "tr",
        "target" : "Siri, soruları yanıtlamak ve yakınınızdakiler hakkında önerilerde bulunmak gibi konularda konumunuzu kullanır."
      },
      {
        "language" : "sk",
        "target" : "Siri využíva vašu polohu napríklad na odpovedanie na otázky a ponúkanie návrhov súvisiacich s vaším okolím.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "en_GB",
        "target" : "Siri uses your location for things like answering questions and offering suggestions about what’s nearby.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Siri会使用你的位置来回答与附近地点相关的问题，并提供地点建议。",
        "language" : "zh_CN",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "sv",
        "target" : "Siri använder din platsinformation till sådant som att svara på frågor och ge förslag på saker i närheten.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Siri bruker posisjonen din for å for eksempel svare på spørsmål om og gi forslag til steder i nærheten.",
        "language" : "no"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "hi",
        "target" : "Siri सवालों के जवाब देने और आस-पास की चीज़ों का सुझाव देने के लिए आपके स्थान का उपयोग करता है।"
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Siri會使用你的位置來回答有關附近地點的問題並提供建議。",
        "language" : "zh_TW"
      },
      {
        "language" : "uk",
        "filename" : "InfoPlist.loctable",
        "target" : "Siri використовує інформацію про ваше розташування, щоб надавати відповіді на запитання та рекомендації щодо місць поблизу."
      },
      {
        "target" : "Siri utiliza tu ubicación para cosas como responder preguntas u ofrecer sugerencias sobre lo que hay cerca.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "de",
        "target" : "Siri verwendet deinen Standort, um z. B. Fragen zu beantworten und lokale Vorschläge anzubieten."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU",
        "target" : "Siri uses your location for things like answering questions and offering suggestions about what’s nearby."
      },
      {
        "target" : "Siri uses your location for things like answering questions and offering suggestions about what’s nearby.",
        "filename" : "InfoPlist.loctable",
        "language" : "en"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ko",
        "target" : "Siri는 질문에 대한 대답 및 사용자 근처의 추천 정보 제공 등을 위해 사용자의 위치를 사용합니다."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "el",
        "target" : "Το Siri χρησιμοποιεί την τοποθεσία σας για ενέργειες, όπως π.χ. να απαντά σε ερωτήσεις και να παρέχει προτάσεις σχετικά με κοντινές επιλογές."
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Siri koristi vašu lokaciju za odgovaranje na pitanja i prijedloge o tome što je dostupno u blizini.",
        "language" : "hr"
      },
      {
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable",
        "target" : "Siri使用你的位置以回應你的問題，又或者向你建議附近的景點。"
      },
      {
        "language" : "es_419",
        "target" : "Siri usa tu ubicación para cosas como responder preguntas y ofrecer sugerencias sobre lugares cercanos.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "pl",
        "filename" : "InfoPlist.loctable",
        "target" : "Siri używa Twojego położenia, aby na przykład odpowiadać na pytania i podawać informacje dotyczące Twojego otoczenia."
      },
      {
        "target" : "Siri ใช้ตำแหน่งที่ตั้งของคุณสำหรับตอบคำถามและเสนอคำแนะนำเกี่ยวกับบริเวณที่อยู่ใกล้เคียง",
        "language" : "th",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "A Siri usa sua localização para coisas como responder a perguntas e oferecer sugestões sobre o que há por perto.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_BR"
      },
      {
        "language" : "nl",
        "target" : "Siri gebruikt je locatie onder andere om te antwoorden en suggesties te doen als je naar iets in de buurt vraagt.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Siri usa a sua localização para, por exemplo, responder a perguntas e fazer sugestões acerca do que há à sua volta.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "language" : "ms",
        "target" : "Siri menggunakan lokasi anda untuk perkara seperti menjawab soalan dan menawarkan cadangan tempat berdekatan.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "fr",
        "target" : "Siri utilise votre position pour répondre à des questions et suggérer des lieux à proximité.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "id",
        "target" : "Siri menggunakan lokasi Anda untuk melakukan hal seperti menjawab pertanyaan dan memberikan saran mengenai apa yang ada di sekitar."
      },
      {
        "language" : "da",
        "target" : "Siri bruger din lokalitet til f.eks. at svare på spørgsmål og komme med forslag til, hvad der findes i nærheden.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "it",
        "target" : "Siri usa la posizione per rispondere alle tue domande e fornirti suggerimenti riguardo a quello che puoi trovare intorno a te."
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Siri käyttää sijaintiasi esimerkiksi kysymysten vastaamiseen ja tarjoaa lähistöön liittyviä ehdotuksia.",
        "language" : "fi"
      },
      {
        "language" : "fr_CA",
        "filename" : "InfoPlist.loctable",
        "target" : "Siri utilise votre position pour répondre à vos questions et vous faire des suggestions sur ce qui vous entoure."
      },
      {
        "target" : "Siri utilizează poziția dvs., printre altele, pentru a răspunde la întrebări și a oferi sugestii despre ce se află în apropiere.",
        "language" : "ro",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "cs",
        "target" : "Siri využívá vaši polohu například k odpovědím na otázky a návrhům založeným na tom, co se nachází ve vašem okolí.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ja",
        "target" : "Siriは周辺情報に関する質問に答えたり提案したりするために位置情報を使用します。",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Siri использует Вашу геопозицию, например, чтобы отвечать на вопросы и рекомендовать то, что находится рядом.",
        "language" : "ru",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
