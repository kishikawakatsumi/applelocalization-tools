    "AMDSummary" : [
      {
        "language" : "ca",
        "target" : "Aquesta acció extreurà les pàgines parelles o les senars del document PDF proporcionat i les utilitzarà per crear un document PDF nou.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Esta acción extraerá las páginas pares o impares del documento PDF y las utilizará para crear un documento PDF nuevo.",
