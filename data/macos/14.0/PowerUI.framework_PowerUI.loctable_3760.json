    "FIRST_NOTIFY_BODY" : [
      {
        "language" : "en_AU",
        "target" : "Mail fetch, background app refresh, automatic downloads and some visual effects are reduced or disabled in Low Power Mode.",
        "filename" : "PowerUI.loctable"
      },
      {
        "target" : "Bei Verwendung des Stromsparmodus werden das Abrufen von E-Mails, die Hintergrundaktualisierung von Apps, automatische Downloads und einige visuelle Effekte reduziert oder deaktiviert.",
        "filename" : "PowerUI.loctable",
        "language" : "de"
      },
      {
        "target" : "Tìm nạp thư, làm mới ứng dụng trong nền, tự động tải về và một số hiệu ứng hình ảnh được giảm xuống hoặc tắt trong Chế độ nguồn điện thấp.",
        "filename" : "PowerUI.loctable",
        "language" : "vi"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "Fetch Mail, penyegaran app latar belakang, pengunduhan otomatis, dan sebagian efek visual dikurangi atau dinonaktifkan di Mode Daya Rendah.",
        "language" : "id"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "A levelek letöltése, a háttérben történő appfrissítés, az automatikus letöltések és néhány vizuális effekt csökkentve van vagy le van tiltva az Alacsony töltöttségű módban.",
        "language" : "hu"
      },
      {
        "target" : "निम्न पावर मोड में मेल फ़ेच होना, बैकग्राउंड ऐप रीफ़्रेश, ऑटोमैटिक डाउनलोड और कुछ दृश्यात्मक प्रभाव कम या अक्षम कर दिए जाते हैं।",
        "filename" : "PowerUI.loctable",
        "language" : "hi"
      },
      {
        "filename" : "PowerUI.loctable",
        "language" : "ro",
        "target" : "În modul Consum redus, preluarea mesajelor de e‑mail, reîmprospătarea aplicațiilor în fundal, descărcările automate și unele efecte vizuale sunt reduse sau dezactivate."
      },
      {
        "target" : "En el modo de bajo consumo se reduce o se desactiva la comprobación automática del correo, la actualización de apps en segundo plano, las descargas automáticas y algunos efectos visuales.",
        "language" : "es",
        "filename" : "PowerUI.loctable"
      },
      {
        "language" : "tr",
        "filename" : "PowerUI.loctable",
        "target" : "Düşük Güç Modu’nda e-postaları alma, arka planda uygulama yenileme, otomatik indirmeler ve bazı görsel efektler azaltılır veya etkisizleştirilir."
      },
      {
        "target" : "低电量模式下，邮件抓取、后台App刷新、自动下载以及部分视觉效果将减弱或停用。",
        "filename" : "PowerUI.loctable",
        "language" : "zh_CN"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "Overførsel af e-mail, opdatering af apps i baggrunden og automatiske overførsler samt visse visuelle effekter er begrænset eller slået fra ved Energibesparende funktion.",
        "language" : "da"
      },
      {
        "target" : "La ricezione automatica di messaggi di posta, l’aggiornamento delle app in background, i download automatici e alcuni effetti visivi vengono disabilitati o limitati.",
        "language" : "it",
        "filename" : "PowerUI.loctable"
      },
      {
        "language" : "hr",
        "target" : "Dohvaćanje e-mail poruka, osvježavanje aplikacija u pozadini, automatska preuzimanja i neki vizualni efekti bit će smanjeni ili isključeni u Modu slabog napajanja.",
        "filename" : "PowerUI.loctable"
      },
      {
        "filename" : "PowerUI.loctable",
        "language" : "ja",
        "target" : "メールの取得、アプリのバックグラウンド更新、自動ダウンロード、および一部のビジュアルエフェクトは、“低電力モード”では低減されるか無効になります。"
      },
      {
        "target" : "Витягування пошти, фонове оновлювання програм, автовикачування і деякі візуальні ефекти обмежуються або вимикаються в режимі економії заряду.",
        "language" : "uk",
        "filename" : "PowerUI.loctable"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "Amb el mode de baix consum, l’obtenció de correu, les actualitzacions d’apps en segon pla i alguns efectes visuals es redueixen o desactiven.",
        "language" : "ca"
      },
      {
        "target" : "כאשר ״מצב סוללה חלשה״ פעיל, מאפיינים כגון טעינת דואר, רענון יישומים ברקע, הורדות אוטומטיות ואפקטים חזותיים מסוימים מופחתים או אינם פעילים.",
        "filename" : "PowerUI.loctable",
        "language" : "he"
      },
      {
        "filename" : "PowerUI.loctable",
        "target" : "Mail fetch, background app refresh, automatic downloads and some visual effects are reduced or disabled in Low Power Mode.",
        "language" : "en_GB"
      },
      {
        "language" : "zh_TW",
        "target" : "「低耗電模式」會降低或停用郵件擷取、背景App重新整理、自動下載和部分視覺效果。",
        "filename" : "PowerUI.loctable"
      },
      {
        "filename" : "PowerUI.loctable",
        "language" : "fr",
        "target" : "La récupération des e-mails, l’actualisation des apps en arrière-plan, les téléchargements automatiques et certains effets visuels sont limités ou désactivés en mode économie d’énergie."
      },
      {
        "language" : "sk",
        "target" : "V režime nízkej spotreby je obmedzené alebo vypnuté načítavanie emailov, osviežovanie apiek na pozadí, automatické sťahovanie a niektoré vizuálne efekty.",
        "filename" : "PowerUI.loctable"
      },
      {
        "language" : "cs",
        "target" : "V režimu nízké spotřeby jsou vypnuté nebo omezené funkce vyzvedávání pošty, aktualizace aplikací na pozadí, automatická stahování a některé vizuální efekty.",
        "filename" : "PowerUI.loctable"
