    "9.title" : [
      {
        "language" : "fr",
        "filename" : "ReorderableTableSheet.loctable",
        "target" : "Cochez une case pour activer ou désactiver l’élément correspondant. Pour réorganiser les éléments répertoriés, utilisez ⌘↑ et ⌘↓."
      },
      {
        "language" : "el",
        "target" : "Επιλέξτε ένα πλαίσιο επιλογής για ενεργοποίηση ή απενεργοποίηση ενός στοιχείου. Για να αναδιατάξετε τα στοιχεία, χρησιμοποιήστε ⌘↑ και ⌘↓.",
        "filename" : "ReorderableTableSheet.loctable"
      },
      {
        "filename" : "ReorderableTableSheet.loctable",
        "language" : "en_AU",
        "target" : "Select a tick box to enable or disable an item. To reorder the items, use ⌘↑ and ⌘↓."
      },
      {
        "filename" : "ReorderableTableSheet.loctable",
        "target" : "Wähle ein Markierungsfeld aus, um ein Objekt zu aktivieren oder zu deaktivieren. Um die Objekte neu anzuordnen, verwende ⌘↑ und ⌘↓.",
        "language" : "de"
      },
      {
        "filename" : "ReorderableTableSheet.loctable",
        "language" : "pt_PT",
        "target" : "Assinale uma opção para ativar ou desativar um elemento. Para reordenar os elementos, utilize ⌘↑ e ⌘↓."
      },
