    "w1n-Mh-Ulf.title" : [
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "es_419",
        "target" : "VoiceOver está configurado para usar Bloqueo de Mayúsculas como la tecla modificadora. ¿Quieres usar las teclas Control y Opción en su lugar?"
      },
      {
        "target" : "VoiceOver est configuré de telle sorte que la touche Verr. Maj. est la touche de modification VoiceOver. Voulez-vous utiliser les touches Contrôle et Option à la place ?",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "fr"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "pt",
        "target" : "O VoiceOver está configurado para usar a tecla Caps Lock como modificador do VoiceOver. Deseja usar Control e Option ao invés?"
      },
      {
        "language" : "sk",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "VoiceOver je nastavený na používanie klávesu Caps Lock ako modifikátora pre VoiceOver. Chcete namiesto toho používať klávesy Control a Option?"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "ro",
        "target" : "Funcționalitatea VoiceOver este configurată pentru a utiliza tasta Blocare majuscule ca modificator VoiceOver. Doriți să utilizați în schimb tastele Control și Opțiune?"
      },
      {
        "target" : "VoiceOver er konfigureret til at bruge Skiftelås som VoiceOver-kombitasten. Vil du bruge ctrl og Alternativ i stedet?",
        "language" : "da",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable"
      },
      {
        "target" : "Το VoiceOver είναι διαμορφωμένο για χρήση του Caps Lock ως τροποποιητικού πλήκτρου VoiceOver. Θέλετε να χρησιμοποιηθεί ο συνδυασμός Control και Option αντί γι’ αυτό;",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "el"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "VoiceOver ist so konfiguriert, dass die Feststelltaste als VoiceOver-Sondertaste verwendet wird. Möchtest du stattdessen Control- und Option-Taste verwenden?",
        "language" : "de"
      },
      {
        "target" : "VoiceOver is configured to use Caps Lock as the VoiceOver modifier. Do you want to use Control and Option instead?",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "en_GB"
      },
      {
        "language" : "zh_CN",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "“旁白”已配置为将大写锁定键用作旁白修饰键。你要将Control和Option用作修饰键吗？"
      },
      {
        "target" : "El VoiceOver està configurat per utilitzar la tecla de bloqueig de majúscules com a tecla de modificació. Vols utilitzar les tecles de control i d’opció en comptes de la de bloqueig de majúscules?",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "ca"
      },
      {
        "target" : "VoiceOver è configurato per utilizzare il blocco maiuscole come tasto modificatore di VoiceOver. Preferisci utilizzare Ctrl e Opzione?",
        "language" : "it",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "ko",
        "target" : "VoiceOver에서 Caps Lock키가 VoiceOver 보조 키로 구성되었습니다. Caps Lock 대신 Control 및 Option을 사용하겠습니까?"
      },
      {
        "language" : "sv",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "VoiceOver har ställts in på att använda skiftlås som specialtangent för VoiceOver. Vill du använda kontroll och alternativ istället?"
      },
      {
        "target" : "VoiceOver ถูกกำหนดค่าไว้ให้ใช้ Caps Lock เป็นปุ่มปรับค่า VoiceOver คุณต้องการใช้ปุ่ม Control และ Option แทนหรือไม่",
        "language" : "th",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable"
      },
      {
        "target" : "VoiceOver maakt gebruik van Caps Lock als speciale toets. Wil je in plaats daarvan Control en Option gebruiken?",
