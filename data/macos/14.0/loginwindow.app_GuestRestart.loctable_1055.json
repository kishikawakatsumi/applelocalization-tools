    "100221.title" : [
      {
        "target" : "방문 사용자로 로그인했습니다. 재시동하면 방문 사용자 홈 폴더에 있는 모든 파일 및 정보가 삭제됩니다. 이 파일들은 복구할 수 없습니다.",
        "language" : "ko",
        "filename" : "GuestRestart.loctable"
      },
      {
        "target" : "Anda masuk sebagai pengguna tamu. Mulai Ulang akan menghapus semua file dan informasi di folder utama pengguna tamu. File tersebut tidak dapat dipulihkan.",
        "language" : "id",
        "filename" : "GuestRestart.loctable"
      },
      {
        "target" : "Hai effettuato il login come utente ospite. Il riavvio eliminerà tutti i file e le informazioni presenti nella cartella Inizio dell’utente ospite. Questi file non potranno essere recuperati.",
        "filename" : "GuestRestart.loctable",
        "language" : "it"
      },
      {
        "language" : "th",
