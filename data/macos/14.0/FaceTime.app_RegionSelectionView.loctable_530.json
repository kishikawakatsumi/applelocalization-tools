      },
      {
        "language" : "es_419",
        "target" : "Selecciona un país o una región para que FaceTime pueda marcar los números locales encontrados en Contactos.",
        "filename" : "RegionSelectionView.loctable"
      },
      {
        "language" : "sk",
        "filename" : "RegionSelectionView.loctable",
        "target" : "Vyberte krajinu alebo región a umožnite tak aplikácii FaceTime vytáčať miestne čísla z aplikácie Kontakty."
      },
      {
        "language" : "ru",
        "filename" : "RegionSelectionView.loctable",
