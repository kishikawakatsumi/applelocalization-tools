      },
      {
        "language" : "fr",
        "target" : "Sélectionnez un pays ou une région pour permettre à FaceTime de composer des numéros locaux trouvés dans Contacts.",
        "filename" : "RegionSelectionView.loctable"
      },
      {
        "filename" : "RegionSelectionView.loctable",
        "target" : "בחר\/י מדינה כדי לאפשר ל-FaceTime לחייג מספרים מקומיים הנמצאים ב״אנשי קשר״.",
        "language" : "he"
      },
      {
        "filename" : "RegionSelectionView.loctable",
