      },
      {
        "language" : "hr",
        "target" : "Odaberite državu ili regiju kako biste aplikaciji FaceTime dopustili biranje lokalnih brojeva koji se nalaze u kontaktima.",
        "filename" : "RegionSelectionView.loctable"
      },
      {
        "target" : "Vyberte zemi nebo region. To umožní funkci FaceTime volat na místní čísla v Kontaktech.",
        "language" : "cs",
        "filename" : "RegionSelectionView.loctable"
      },
      {
        "filename" : "RegionSelectionView.loctable",
