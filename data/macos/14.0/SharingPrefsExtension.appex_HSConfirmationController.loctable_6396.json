    "41G-dT-WPA.placeholderString" : [
      {
        "target" : "Diğer bilgisayarlarınız ve aygıtlarınız için Ev Paylaşımı’nı açarken aynı \n“%S” Apple kimliğini kullanın.",
        "language" : "tr",
        "filename" : "HSConfirmationController.loctable"
      },
      {
        "target" : "ほかのマシンやデバイスでホームシェアリングを使用するには、同じApple ID “%S”を\n使用してください。",
        "filename" : "HSConfirmationController.loctable",
        "language" : "ja"
      },
      {
        "target" : "Utilisez le même identifiant Apple « %S » pour activer le partage à domicile pour vos autres \nordinateurs et appareils.",
        "language" : "fr",
        "filename" : "HSConfirmationController.loctable"
      },
      {
        "target" : "Gunakan Apple ID “%S” yang sama apabila mengaktifkan Perkongsian Rumah untuk \nkomputer dan peranti lain anda.",
        "filename" : "HSConfirmationController.loctable",
        "language" : "ms"
      },
      {
        "filename" : "HSConfirmationController.loctable",
        "language" : "en_AU",
        "target" : "Use the same Apple ID “%S” when turning on Home Sharing for your other \ncomputers and devices."
      },
      {
        "language" : "vi",
        "target" : "Sử dụng cùng ID Apple “%S” khi bật Home Sharing cho \ncác máy tính và thiết bị khác của bạn.",
        "filename" : "HSConfirmationController.loctable"
      },
      {
        "filename" : "HSConfirmationController.loctable",
        "language" : "pt_PT",
        "target" : "Quando ativar a partilha doméstica nos seus outros \ncomputadores e dispositivos, use o mesmo ID Apple (“%S”)."
      },
      {
        "language" : "ru",
        "target" : "Использовать один и тот же Apple ID «%S» при включении Домашней коллекции\nна других Ваших компьютерах и устройствах.",
        "filename" : "HSConfirmationController.loctable"
      },
      {
        "filename" : "HSConfirmationController.loctable",
        "language" : "hr",
