{
  "localizations" : {
    "id.scanner.hint" : [
      {
        "target" : "Platziere die rückseitige Kamera auf der Mitte deines Ausweisdokuments und ziehe dein iPhone dann langsam zurück.",
        "filename" : "Accessibility.strings",
        "language" : "de"
      },
      {
        "target" : "יש להניח את המצלמה האחורית על מרכז תעודת הזהות שלך. לאחר מכן, יש להרחיק את ה-iPhone באיטיות.",
        "filename" : "Accessibility.strings",
        "language" : "he"
      },
      {
        "target" : "Place your back-facing camera on the centre of your identification card. Then, slowly pull your iPhone back.",
        "filename" : "Accessibility.strings",
        "language" : "en_AU"
      },
      {
        "target" : "ركز الكاميرا الخلفية على منتصف بطاقة الهوية، ثم اسحب iPhone للخلف ببطء.",
        "filename" : "Accessibility.strings",
        "language" : "ar"
      },
      {
        "target" : "Τοποθετήστε την πίσω κάμερα στο κέντρο της ταυτότητας. Μετά, τραβήξτε αργά το iPhone προς τα πίσω.",
        "filename" : "Accessibility.strings",
        "language" : "el"
      },
      {
        "target" : "背面カメラを身分証明書カードの中央に置いてから、iPhoneをゆっくりとカードから離してください。",
        "filename" : "Accessibility.strings",
        "language" : "ja"
      },
      {
        "target" : "Place your back-facing camera on the center of your identification card. Then, slowly pull your iPhone back.",
        "filename" : "Accessibility.strings",
        "language" : "en"
      },
      {
        "target" : "Прикладіть задню камеру до центра свого посвідчення, а потім повільно відведіть iPhone назад.",
        "filename" : "Accessibility.strings",
        "language" : "uk"
      },
      {
        "target" : "Apunta al centro de tu identificación con la cámara posterior y luego desplaza lentamente hacia atrás tu iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "es_419"
      },
      {
        "target" : "将后置相机对准身份证中央。然后慢慢往后拉动iPhone。",
        "filename" : "Accessibility.strings",
        "language" : "zh_CN"
      },
      {
        "target" : "Coloca la cámara trasera en el centro de tu documento de identidad y ve alejando el iPhone lentamente.",
        "filename" : "Accessibility.strings",
        "language" : "es"
      },
      {
        "target" : "Anbring kameraet på bagsiden midt på id-kortet. Træk derefter din iPhone langsomt væk.",
        "filename" : "Accessibility.strings",
        "language" : "da"
      },
      {
        "target" : "Posiziona la fotocamera posteriore al centro della carta d'identità e allontana lentamente iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "it"
      },
      {
        "target" : "Поставете лицето на задната камера в центъра на личната карта. След това бавно издърпайте вашия iPhone назад.",
        "filename" : "Accessibility.strings",
        "language" : "bg"
      },
      {
        "target" : "Položte zadnú kameru na stred preukazu totožnosti. Potom pomaly dvíhajte iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "sk"
      },
      {
        "target" : "Артқы камераны жеке куәлігіңіздің ортасына орналастырыңыз. Содан кейін iPhone құрылғыңызды ақырын артқа жылжытыңыз.",
        "filename" : "Accessibility.strings",
        "language" : "kk"
      },
      {
        "target" : "Coloque a câmara traseira no centro do cartão de identificação. Depois, lentamente, afaste o iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "pt_PT"
      },
      {
        "target" : "Letakkan kamera pandang belakang anda pada bahagian tengah kad pengenalan anda. Kemudian, tarik iPhone anda dengan perlahan-lahan.",
        "filename" : "Accessibility.strings",
        "language" : "ms"
      },
      {
        "target" : "Placera den bakre kameran på mitten av ID-kortet. Dra sedan iPhone långsamt bakåt.",
        "filename" : "Accessibility.strings",
        "language" : "sv"
      },
      {
        "target" : "Umístěte zadní fotoaparát na střed průkazu a pomalu iPhone oddalujte.",
        "filename" : "Accessibility.strings",
        "language" : "cs"
      },
      {
        "target" : "후면 카메라를 신분증의 중앙에 맞춘 다음 iPhone을 천천히 뒤로 움직이십시오.",
        "filename" : "Accessibility.strings",
        "language" : "ko"
      },
      {
        "target" : "将后置相机对准身份证中央。然后慢慢往后拉动iPhone。",
        "filename" : "Accessibility.strings",
        "language" : "yue_CN"
      },
      {
        "target" : "Plasser kameraet på baksiden av enheten midt på ID-kortet. Deretter trekker du iPhonen sakte tilbake.",
        "filename" : "Accessibility.strings",
        "language" : "no"
      },
      {
        "target" : "Helyezze a hátsó kamerát a személyazonosító kártyája közepére, majd lassan emelje fel az iPhone-ját.",
        "filename" : "Accessibility.strings",
        "language" : "hu"
      },
      {
        "target" : "將後置鏡頭對準身分證的中央位置。然後將iPhone慢慢拉後。",
        "filename" : "Accessibility.strings",
        "language" : "zh_HK"
      },
      {
        "target" : "Arka yüzdeki kamerayı kimlik kartınızın ortasına yerleştirin, sonra iPhone’unuzu yavaşça geriye doğru çekin.",
        "filename" : "Accessibility.strings",
        "language" : "tr"
      },
      {
        "target" : "Umieść tylny aparat nad środkiem dowodu tożsamości. Następnie powoli odsuń iPhone'a od niego.",
        "filename" : "Accessibility.strings",
        "language" : "pl"
      },
      {
        "target" : "將後置相機放在你的身分證件中間，然後將iPhone慢慢往回拉。",
        "filename" : "Accessibility.strings",
        "language" : "zh_TW"
      },
      {
        "target" : "Place your back-facing camera on the centre of your identification card. Then slowly pull your iPhone back.",
        "filename" : "Accessibility.strings",
        "language" : "en_GB"
      },
      {
        "target" : "Hướng camera phía sau vào giữa thẻ nhận dạng của bạn. Sau đó, từ từ kéo iPhone của bạn về phía sau.",
        "filename" : "Accessibility.strings",
        "language" : "vi"
      },
      {
        "target" : "Наведите заднюю камеру на центр удостоверения личности, затем медленно отведите iPhone назад.",
        "filename" : "Accessibility.strings",
        "language" : "ru"
      },
      {
        "target" : "Placez la caméra arrière sur le centre de la carte d’identité, puis éloignez lentement l’iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "fr_CA"
      },
      {
        "target" : "Placez votre caméra arrière au centre de la pièce d’identité. Éloignez ensuite lentement votre iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "fr"
      },
      {
        "target" : "Aseta takakamera henkilökortin keskelle. Vedä iPhonea sen jälkeen hitaasti taaksepäin.",
        "filename" : "Accessibility.strings",
        "language" : "fi"
      },
      {
        "target" : "Posisikan kamera belakang di bagian tengah kartu identitas Anda. Lalu, jauhkan iPhone secara perlahan.",
        "filename" : "Accessibility.strings",
        "language" : "id"
      },
      {
        "target" : "Richt de camera aan de achterkant van het apparaat op het midden van je identiteits­kaart en beweeg je iPhone vervolgens langzaam naar je toe.",
        "filename" : "Accessibility.strings",
        "language" : "nl"
      },
      {
        "target" : "วางกล้องด้านหลังตรงกึ่งกลางบัตรประจำตัวประชาชนของคุณ จากนั้นดึง iPhone ของคุณถอยหลังช้าๆ",
        "filename" : "Accessibility.strings",
        "language" : "th"
      },
      {
        "target" : "Posicione a câmera traseira no centro do cartão de identidade e lentamente afaste o iPhone do cartão.",
        "filename" : "Accessibility.strings",
        "language" : "pt"
      },
      {
        "target" : "Puneți camera din spate pe centrul cărții de identitate. Apoi, trageți încet iPhone‑ul înapoi.",
        "filename" : "Accessibility.strings",
        "language" : "ro"
      },
      {
        "target" : "Postavite stražnju kameru na središte osobne iskaznice. Zatim polagano povucite iPhone unatrag.",
        "filename" : "Accessibility.strings",
        "language" : "hr"
      },
      {
        "target" : "अपने बैक फ़ेसिंग कैमरा को अपने पहचान कार्ड के बीच में रखें। फिर धीरे से अपने iPhone को पीछे खींचें।",
        "filename" : "Accessibility.strings",
        "language" : "hi"
      },
      {
        "target" : "Situa la càmera posterior al centre del document d’identitat. Llavors, enretira l’iPhone a poc a poc.",
        "filename" : "Accessibility.strings",
        "language" : "ca"
      }
    ],
