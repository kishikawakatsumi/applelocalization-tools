      {
        "target" : "Para gestionar archivos y escanear y guardar documentos, la app Archivos puede acceder a la cámara.",
        "filename" : "InfoPlist.strings",
        "language" : "es"
      },
      {
        "target" : "Arkiver bruger muligvis adgang til kameraet til at administrere arkiver, scanne og gemme dokumenter.",
        "filename" : "InfoPlist.strings",
        "language" : "da"
      },
      {
        "target" : "Per consentirti di gestire i file e di scansionare e salvare i documenti, File potrebbe accedere alla fotocamera.",
        "filename" : "InfoPlist.strings",
