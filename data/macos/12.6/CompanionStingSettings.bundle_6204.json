    "GESTURE_PANE_WORKOUT_OPEN" : [
      {
        "target" : "Presiona una vez para abrir “%@”. Presiona de nuevo cuando hayas empezado el entrenamiento para controlarlo. Las acciones de los entrenamientos pueden cambiar dependiendo de la app.",
