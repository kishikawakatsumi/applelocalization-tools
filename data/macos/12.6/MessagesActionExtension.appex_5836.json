    "CONVERSATION_LIST_FOCUS_FILTER_ACTION_DESCRIPTION" : [
      {
        "target" : "Zeige nur die Nachrichten an, die du sehen möchtest. Zum Beispiel kannst du ausschließlich Konversationen mit Personen anzeigen, die dir Mitteilungen während der Arbeit senden dürfen.",
