    "H4f-Te-TZU.title" : [
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "cs",
        "target" : "Chcete-li ukládat své soubory na iCloud a přistupovat k nim kdykoli a ze všech svých zařízení, zapněte iCloud Drive."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "es_419",
        "target" : "Activa iCloud Drive para almacenar archivos en iCloud y acceder a ellos en cualquier momento en todos tus dispositivos."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "el",
        "target" : "Ενεργοποιήστε το iCloud Drive για να αποθηκεύσετε τα αρχεία σας στο iCloud και να έχετε πρόσβαση σε αυτά ανά πάσα στιγμή από όλες τις συσκευές σας."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "da",
        "target" : "Slå iCloud Drive til for at opbevare dine arkiver i iCloud og få adgang til dem når som helst på alle dine enheder."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "no",
        "target" : "Slå på iCloud Drive for å oppbevare filene dine i iCloud og ha tilgang til dem hele tiden på alle enheter."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "fr_CA",
        "target" : "Activez iCloud Drive pour stocker vos fichiers sur iCloud et y accéder à tout moment sur tous vos appareils."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "ro",
        "target" : "Activați iCloud Drive pentru a vă stoca fișierele pe iCloud și pentru a le accesa oricând de pe toate dispozitivele dvs."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "hu",
        "target" : "Az iCloud Drive bekapcsolásával a fájljait az iCloudban tárolhatja, és bármikor elérheti azokat minden eszközén."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "sl",
        "target" : "Vklopite iCloud Drive, da boste lahko datoteke shranili v storitev iCloud in do njih kadarkoli dostopali prek vseh svojih naprav."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "zh_HK",
        "target" : "開啟iCloud雲碟來在iCloud中儲存檔案，並隨時隨地在所有裝置上取用檔案。"
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "ca",
        "target" : "Activa l’iCloud Drive per emmagatzemar els arxius a l’iCloud i accedir-hi sempre que vulguis des de tots els dispositius."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "en_GB",
        "target" : "Turn on iCloud Drive to store your files in iCloud and access them anytime on all your devices."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "id",
        "target" : "Nyalakan iCloud Drive untuk menyimpan file Anda di iCloud dan mengakses file tersebut setiap saat di semua perangkat Anda."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "it",
        "target" : "Attiva iCloud Drive per archiviare i file in iCloud e accedervi in qualsiasi momento da tutti i tuoi dispositivi."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "ko",
        "target" : "iCloud에 파일을 저장하고 사용자의 모든 기기에서 언제든지 접근할 수 있도록 하려면 iCloud Drive를 켜십시오."
      },
      {
        "filename" : "ICloudUpgradeView.loctable",
        "language" : "ja",
