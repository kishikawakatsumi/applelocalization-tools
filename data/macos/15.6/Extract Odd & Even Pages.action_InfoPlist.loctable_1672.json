        "language" : "zh_TW"
      },
      {
        "target" : "Tindakan ini akan mengekstrak sama ada halaman genap atau ganjil daripada dokumen PDF yang diberikan dan menggunakan halaman untuk mencipta dokumen PDF baharu.",
        "filename" : "InfoPlist.loctable",
        "language" : "ms"
      },
      {
        "target" : "此操作将从给定的PDF文稿中提取偶数页或奇数页，并使用这些页面创建新的PDF文稿。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN"
