    "Zi2-YK-EIS.title" : [
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Wenn du nicht abwartest, bis die Synchronisierung abgeschlossen ist, gehen möglicherweise Daten verloren.",
        "language" : "de"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Als je niet wacht tot de synchronisatie is voltooid, kun je gegevens verliezen.",
        "language" : "nl"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Si no esperas hasta que se haya completado la sincronización, podrían perderse datos.",
        "language" : "es"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "If you don't wait until the syncing completes, you may lose data.",
        "language" : "en_GB"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "यदि आप सिंक करना पूरा होने तक प्रतीक्षा नहीं करते हैं, तो आपका डेटा अनुपलब्ध हो सकता है।",
        "language" : "hi"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "إذا لم تنتظر حتى اكتمال المزامنة، فقد تفقد بيانات.",
        "language" : "ar"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Si no esperas a que finalice la sincronización, se podrían perder datos.",
        "language" : "es_419"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Ako ne pričekate da se sinkroniziranje dovrši, možda ćete izgubiti podatke.",
        "language" : "hr"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Вы можете потерять данные, если не дождетесь окончания синхронизации.",
        "language" : "ru"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Dacă nu doriți să așteptați până la finalizarea sincronizării, este posibil să pierdeți date.",
        "language" : "ro"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Jos et odota synkronoinnin päättymistä, saatat menettää tietoja.",
        "language" : "fi"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Jeśli nie poczekasz na zakończenie synchronizowania, możesz utracić dane.",
        "language" : "pl"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "동기화가 완료될 때까지 기다리지 않으면 데이터가 유실될 수 있습니다.",
        "language" : "ko"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Ha nem várja meg a szinkronizálás befejeződését, elképzelhető, hogy bizonyos adatok elvesznek.",
        "language" : "hu"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "If you don't wait until the syncing completes, you may lose data.",
        "language" : "en_AU"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Če ne počakate, da se sinhronizacija dokonča, lahko izgubite podatke.",
        "language" : "sl"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "אם אין ברצונך להמתין עד להשלמת הסנכרון, הדבר עלול להוביל לאובדן הנתונים שלך.",
        "language" : "he"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "É possível que perca dados se não aguardar pelo fim da sincronização.",
        "language" : "pt_PT"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Якщо ви не зачекаєте на завершення синхронізації, ви можете втратити дані.",
        "language" : "uk"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Ak nepočkáte na dokončenie synchronizácie, môžete prísť o dáta.",
        "language" : "sk"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Se non attendi il completamento della sincronizzazione, potresti perdere dei dati.",
        "language" : "it"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Jika tidak menunggu hingga penyelarasan selesai, Anda dapat kehilangan data.",
        "language" : "id"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Hvis du ikke venter, indtil synkroniseringen er udført, kan du muligvis miste data.",
        "language" : "da"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Si vous n’attendez pas la fin de la synchronisation, vous risquez de perdre des données.",
        "language" : "fr"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Si no esperes que es completi la sincronització, pots perdre dades.",
        "language" : "ca"
      },
      {
        "filename" : "DKSignOutDataSyncWindowController.loctable",
        "target" : "Eşzamanlama tamamlanana kadar beklemezseniz verileriniz kaybolabilir.",
        "language" : "tr"
      },
      {
