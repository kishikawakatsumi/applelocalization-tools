      },
      {
        "language" : "sk",
        "target" : "Táto akcia otvorí okno Findera, v ktorom budú označené špecifikované položky.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "he",
        "target" : "פעולה זו פותחת חלונות ב-Finder כאשר פריטי Finder שצוינו נבחרים.",
