      },
      {
        "language" : "pt_BR",
        "target" : "Esta ação abre janelas no Finder com os itens específicos do Finder selecionados.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "es_419",
        "target" : "Esta acción abre ventanas en el Finder con los elementos especificados del Finder seleccionados.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ko",
        "target" : "이 동작은 선택된 지정 Finder 항목을 Finder의 윈도우에서 엽니다.",
