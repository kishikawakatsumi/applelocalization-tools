      },
      {
        "language" : "ca",
        "target" : "Aquesta acció obre les finestres del Finder amb els ítems del Finder especificats seleccionats.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "hi",
        "target" : "यह क्रिया चयनित निर्दिष्ट Finder आइटमों के साथ Finder में विंडो खोलती है।",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "pl",
        "target" : "Ta czynność otwiera okna Findera z określonymi zaznaczonymi rzeczami Findera.",
        "filename" : "InfoPlist.loctable"
      },
      {
