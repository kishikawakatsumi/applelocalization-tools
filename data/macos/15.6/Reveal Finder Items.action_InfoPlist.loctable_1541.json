    "AMDSummary" : [
      {
        "language" : "pt_PT",
        "target" : "Esta ação abre janelas no Finder, com os elementos especificados selecionados.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "zh_HK",
        "target" : "此動作會在Finder開啟所選指定Finder項目的視窗。",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "cs",
        "target" : "Tato akce otevře okna ve Finderu, ve kterých budou vybrány zadané položky.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "uk",
        "target" : "Ця дія відкриває вікна Finder із заданими вибраними елементами Finder.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ru",
        "target" : "Это действие открывает окна в Finder с определенными выбранными объектами Finder.",
