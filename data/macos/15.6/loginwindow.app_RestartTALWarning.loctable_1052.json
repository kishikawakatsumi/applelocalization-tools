    "10.title" : [
      {
        "target" : "Hvis du ikke gjør noe, vil maskinen fortsette påloggingen om 1 minutt.",
        "filename" : "RestartTALWarning.loctable",
        "language" : "no"
      },
      {
        "target" : "Če ne storite ničesar, bo računalnik nadaljeval prijavo čez 1 minuto.",
        "filename" : "RestartTALWarning.loctable",
