      },
      {
        "target" : "ถ้าคุณไม่ดำเนินการใดๆ คอมพิวเตอร์จะเข้าสู่ระบบต่อไปใน 1 นาที",
        "filename" : "RestartTALWarning.loctable",
        "language" : "th"
      },
      {
        "target" : "Hiçbir şey yapmazsanız bilgisayar 1 dakika içinde oturum açmayı sürdürecektir.",
        "filename" : "RestartTALWarning.loctable",
        "language" : "tr"
      },
      {
        "target" : "Jeśli nie wykonasz żadnej czynności, komputer będzie kontynuował logowanie za 1 min.",
        "filename" : "RestartTALWarning.loctable",
        "language" : "pl"
      },
      {
        "target" : "If you do nothing, the computer will continue the login in 1 minute.",
        "filename" : "RestartTALWarning.loctable",
