    "BOBBLE_ONBOARDING_SUBTITLE" : [
      {
        "language" : "en_GB",
        "filename" : "Localizable.loctable",
        "target" : "When wearing AirPods, you can move your head up and down or side to side to respond to Siri."
      },
      {
        "language" : "zh_CN",
        "filename" : "Localizable.loctable",
        "target" : "佩戴AirPods时，你可以点头或摇头回应Siri。"
      },
      {
        "language" : "th",
        "filename" : "Localizable.loctable",
        "target" : "เมื่อใส่ AirPods คุณสามารถเคลื่อนศีรษะของคุณขึ้นและลง หรือหันจากข้างหนึ่งไปอีกข้างหนึ่งเพื่อตอบ Siri ได้"
      },
      {
        "language" : "ca",
        "filename" : "Localizable.loctable",
        "target" : "Si duus els AirPods posats, pots moure el cap amunt i avall o d’un costat a l’altre per respondre a Siri."
      },
      {
        "language" : "nl",
        "filename" : "Localizable.loctable",
        "target" : "Wanneer je AirPods draagt, kun je je hoofd op en neer of heen en weer bewegen om te reageren op Siri."
      },
      {
        "language" : "it",
        "filename" : "Localizable.loctable",
        "target" : "Quando indossi gli AirPods, puoi muovere la testa su e giù o da un lato all’altro per rispondere a Siri."
      },
      {
        "language" : "fr_CA",
        "filename" : "Localizable.loctable",
        "target" : "Quand vous portez vos AirPods, vous pouvez bouger votre tête de haut en bas ou d’un côté à l’autre pour répondre à Siri."
      },
      {
        "language" : "hi",
        "filename" : "Localizable.loctable",
        "target" : "जब आपने AirPods लगाया होता है, तो आप Siri को जवाब देने के लिए अपना सिर ऊपर-नीचे या दाएँ-बाएँ घुमा सकते हैं।"
      },
      {
        "language" : "fi",
        "filename" : "Localizable.loctable",
        "target" : "Kun AirPods-kuulokkeet ovat korvissasi, voit vastata Sirille liikuttamalla päätäsi ylös ja alas tai puolelta toiselle."
      },
      {
        "language" : "da",
        "filename" : "Localizable.loctable",
        "target" : "Når du har AirPods i ørerne, kan du bevæge dit hoved op og ned eller fra side til side for at svare Siri."
      },
      {
        "language" : "pt_BR",
        "filename" : "Localizable.loctable",
        "target" : "Quando estiver usando AirPods, mova a cabeça para cima e para baixo ou de lado a lado para responder à Siri."
      },
      {
        "language" : "sv",
        "filename" : "Localizable.loctable",
        "target" : "När du bär AirPods kan du nicka eller skaka på huvudet för att svara på Siri."
      },
      {
        "language" : "el",
        "filename" : "Localizable.loctable",
        "target" : "Μπορείτε να κουνήσετε το κεφάλι σας πάνω-κάτω ή δεξιά-αριστερά για να απαντήσετε στο Siri όταν φοράτε τα AirPods."
      },
      {
        "language" : "en",
        "filename" : "Localizable.loctable",
        "target" : "When wearing AirPods, you can move your head up and down or side to side to respond to Siri."
      },
      {
        "language" : "es_419",
        "filename" : "Localizable.loctable",
        "target" : "Al tener los AirPods puestos, puedes mover la cabeza hacia arriba y abajo o de un lado al otro para responderle a Siri."
      },
      {
        "language" : "ar",
        "filename" : "Localizable.loctable",
        "target" : "أثناء ارتداء AirPods، يمكنك تحريك رأسك إلى الأعلى والأسفل أو من جانب إلى آخر للرد على Siri."
      },
      {
        "language" : "es_US",
        "filename" : "Localizable.loctable",
        "target" : "Al tener los AirPods puestos, puedes mover la cabeza hacia arriba y abajo o de un lado al otro para responderle a Siri."
      },
      {
        "language" : "ms",
        "filename" : "Localizable.loctable",
        "target" : "Apabila memakai AirPods, anda boleh menggerakkan kepala anda ke atas dan bawah atau sisi ke sisi untuk membalas Siri."
      },
      {
        "language" : "ja",
        "filename" : "Localizable.loctable",
        "target" : "Siriに応答するには、AirPodsを装着しているときに頭を上下にまたは左右に動かします。"
      },
      {
        "language" : "he",
        "filename" : "Localizable.loctable",
        "target" : "בעת השימוש ב-AirPods, באפשרותך להזיז את הראש שלך למעלה ולמטה או מצד לצד כדי להגיב ל-Siri."
      },
      {
        "language" : "zh_HK",
        "filename" : "Localizable.loctable",
        "target" : "戴着AirPods時，你可以點頭或搖頭來回應Siri。"
      },
      {
        "language" : "pt_PT",
        "filename" : "Localizable.loctable",
        "target" : "Ao usar os AirPods, pode mover a cabeça para cima e para baixo ou de um lado para o outro para responder a Siri."
      },
      {
        "language" : "hr",
        "filename" : "Localizable.loctable",
        "target" : "Kad nosite slušalice AirPods, možete pomaknuti glavu prema gore i dolje ili s jedne u drugu stranu za odgovaranje Siri."
      },
      {
        "language" : "fr",
        "filename" : "Localizable.loctable",
        "target" : "Lorsque vous portez des AirPods, vous pouvez hocher la tête verticalement ou horizontalement pour répondre à Siri."
      },
      {
        "language" : "vi",
        "filename" : "Localizable.loctable",
        "target" : "Khi đeo AirPods, bạn có thể di chuyển đầu lên xuống hoặc sang bên để phản hồi Siri."
      },
      {
        "language" : "en_AU",
        "filename" : "Localizable.loctable",
        "target" : "When wearing AirPods, you can move your head up and down or side to side to respond to Siri."
      },
      {
        "language" : "cs",
        "filename" : "Localizable.loctable",
        "target" : "Když máte nasazené AirPody, můžete se Siri komunikovat pohybováním hlavou nahoru a dolů nebo ze strany na stranu."
      },
      {
        "language" : "hu",
        "filename" : "Localizable.loctable",
        "target" : "AirPods viselésekor a feje felfelé és lefelé, illetve oldalsó irányban történő mozgatásával válaszolhat Sirinek."
      },
      {
        "language" : "ru",
        "filename" : "Localizable.loctable",
        "target" : "Когда Вы используете AirPods, для ответа на вопрос от Siri достаточно просто кивнуть или покачать головой."
      },
      {
        "language" : "ko",
        "filename" : "Localizable.loctable",
        "target" : "AirPods을 착용했을 때 머리를 위아래 또는 양옆으로 움직여서 Siri에 응답할 수 있습니다."
      },
      {
        "language" : "no",
        "filename" : "Localizable.loctable",
        "target" : "Når AirPods sitter i ørene, kan du bevege hodet opp og ned eller fra side til side for å svare Siri."
      },
      {
        "language" : "uk",
        "filename" : "Localizable.loctable",
        "target" : "Якщо ви використовуєте AirPods, рухайте головою вгору-вниз або з боку в бік, щоб відповідати Siri."
      },
      {
        "language" : "sl",
        "filename" : "Localizable.loctable",
        "target" : "Ko nosite slušalke AirPods, lahko Siri odgovorite z gibi glave gor in dol ali levo in desno."
      },
      {
        "language" : "de",
        "filename" : "Localizable.loctable",
        "target" : "Wenn du die AirPods trägst, kannst du nicken oder den Kopf schütteln, um Siri zu antworten."
      },
      {
        "language" : "sk",
        "filename" : "Localizable.loctable",
        "target" : "Keď máte nasadené AirPody, pohybmi hlavy nahor a nadol alebo do strán môžete komunikovať so Siri."
      },
      {
        "language" : "id",
        "filename" : "Localizable.loctable",
        "target" : "Saat mengenakan AirPods, Anda dapat menggerakkan kepala Anda ke atas dan bawah atau sisi ke sisi untuk merespons Siri."
      },
      {
        "language" : "pl",
        "filename" : "Localizable.loctable",
        "target" : "Gdy używasz AirPods, możesz odpowiadać Siri, poruszając głową w górę i w dół lub na boki."
      },
      {
        "language" : "es",
        "filename" : "Localizable.loctable",
        "target" : "Cuando lleves los AirPods puestos, puedes mover la cabeza haciendo el gesto de asentir o de negar para responder a Siri."
      },
      {
        "language" : "zh_TW",
        "filename" : "Localizable.loctable",
        "target" : "佩戴AirPods時，你可以上下點頭或左右搖頭來回應Siri。"
      },
      {
        "language" : "tr",
        "filename" : "Localizable.loctable",
        "target" : "AirPods takılıyken Siri’ye yanıt vermek için kafanızı yukarı aşağı ya da sağa sola hareket ettirebilirsiniz."
      },
