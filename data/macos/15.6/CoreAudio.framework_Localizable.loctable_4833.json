    "REQUEST_ACCESS_SERVICE_AudioCapture" : [
      {
        "language" : "hr",
        "filename" : "Localizable.loctable",
        "target" : "“%@” želi pristupiti, promijeniti i snimiti zvuk sustava."
      },
      {
        "language" : "vi",
        "filename" : "Localizable.loctable",
        "target" : "“%@” muốn truy cập, sửa đổi và ghi âm thanh hệ thống của bạn."
      },
      {
        "language" : "zh_CN",
        "filename" : "Localizable.loctable",
        "target" : "“%@”想要访问、修改和录制系统音频。"
      },
      {
        "language" : "uk",
        "filename" : "Localizable.loctable",
        "target" : "«%@» хоче отримувати доступ до системного звуку, а також записувати та змінювати його."
      },
      {
        "language" : "zh_TW",
        "filename" : "Localizable.loctable",
        "target" : "「%@」想要取用、修改和錄製你的系統音訊。"
      },
      {
        "language" : "en",
        "filename" : "Localizable.loctable",
        "target" : "“%@” would like to access, modify and record your system audio."
      },
      {
        "language" : "ja",
        "filename" : "Localizable.loctable",
        "target" : "“%@”からシステムオーディオにアクセス、変更、および録音しようとしています。"
      },
      {
        "language" : "zh_HK",
        "filename" : "Localizable.loctable",
        "target" : "「%@」想取用、修改和記錄你的系統音訊。"
      },
      {
        "language" : "pt_BR",
        "filename" : "Localizable.loctable",
        "target" : "“%@” deseja acessar, modificar e gravar o áudio do sistema."
      },
      {
        "language" : "fi",
        "filename" : "Localizable.loctable",
        "target" : "%@ haluaa käyttää, muokata ja tallentaa järjestelmän ääntä."
      },
      {
        "language" : "pt_PT",
        "filename" : "Localizable.loctable",
        "target" : "“%@” gostaria de aceder, modificar e gravar o áudio do sistema."
      },
      {
        "language" : "hi",
        "filename" : "Localizable.loctable",
        "target" : "“%@” आपके सिस्टम ऑडियो को ऐक्सेस, संशोधित और रिकॉर्ड करना चाहता है।"
      },
      {
        "language" : "ar",
        "filename" : "Localizable.loctable",
        "target" : "يرغب \"%@\" في الوصول إلى صوت النظام وتعديله وتسجيله."
      },
      {
        "language" : "ro",
        "filename" : "Localizable.loctable",
        "target" : "„%@” ar dori să acceseze, modifice și înregistreze sunetul sistemului."
      },
      {
        "language" : "ms",
        "filename" : "Localizable.loctable",
        "target" : "“%@” mahu mengakses, mengubah suai dan merakam audio sistem anda."
      },
      {
        "language" : "es",
        "filename" : "Localizable.loctable",
        "target" : "%@ quiere acceder a tu sistema de audio, modificarlo y grabarlo."
      },
      {
        "language" : "sl",
        "filename" : "Localizable.loctable",
        "target" : "»%@« želi dostopati do sistemskega zvoka za namene urejanja in snemanja."
      },
      {
        "language" : "id",
        "filename" : "Localizable.loctable",
        "target" : "“%@” ingin mengakses, memodifikasi, dan merekam audio sistem Anda."
      },
      {
        "language" : "nl",
        "filename" : "Localizable.loctable",
        "target" : "%@ wil toegang tot je systeemaudio en deze bewerken en vastleggen."
      },
      {
        "language" : "da",
        "filename" : "Localizable.loctable",
        "target" : "“%@” vil bruge, redigere og optage lyd i dit system."
      },
      {
        "language" : "no",
        "filename" : "Localizable.loctable",
        "target" : "«%@» vil ha tilgang til, endre og gjøre opptak av systemlyden."
      },
      {
        "language" : "hu",
        "filename" : "Localizable.loctable",
        "target" : "A(z) „%@” el szeretné érni, módosítani szeretné és rögzíteni szeretné az Ön rendszerhangjait."
      },
      {
        "language" : "de",
        "filename" : "Localizable.loctable",
        "target" : "„%@“ möchte auf dein Systemaudio zugreifen und es verändern und aufnehmen."
      },
      {
        "language" : "ko",
        "filename" : "Localizable.loctable",
        "target" : "‘%@’이(가) 시스템 오디오에 접근하고, 수정하고, 녹음하려고 합니다."
      },
      {
        "language" : "he",
        "filename" : "Localizable.loctable",
        "target" : "״%@״ מבקש לגשת לשמע המערכת שלך, לשנות אותו ולהקליט אותו"
      },
      {
        "language" : "ru",
        "filename" : "Localizable.loctable",
        "target" : "«%@» запрашивает доступ к системному аудио, его изменению и записи."
      },
      {
        "language" : "sv",
        "filename" : "Localizable.loctable",
        "target" : "”%@” vill få tillgång till, modifiera och spela in systemljudet."
      },
      {
        "language" : "tr",
        "filename" : "Localizable.loctable",
        "target" : "“%@”, sistem sesinize erişmek, onu değiştirmek ve kaydetmek istiyor."
      },
      {
        "language" : "cs",
        "filename" : "Localizable.loctable",
        "target" : "Aplikace %@ žádá o povolení k přístupu k systémovému zvuku, jeho úpravám a nahrávání."
      },
      {
        "language" : "fr_CA",
        "filename" : "Localizable.loctable",
        "target" : "« %@ » souhaite accéder à l’audio système, le modifier et l’enregistrer."
