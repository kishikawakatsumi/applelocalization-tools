  "localizations" : {
    "NSLocationWhenInUseUsageDescription" : [
      {
        "language" : "pt_PT",
        "filename" : "InfoPlist.loctable",
        "target" : "A sua localização serve de referência para mostrar o nome da cidade local e posição global, na aplicação Relógio no Apple Watch."
      },
      {
        "language" : "ko",
        "filename" : "InfoPlist.loctable",
        "target" : "Apple Watch의 세계 시계 앱에서 현지 도시 이름 및 지구상의 위치를 표시하는 데 사용자의 위치가 사용됩니다."
      },
      {
        "language" : "ro",
        "filename" : "InfoPlist.loctable",
        "target" : "Localizarea dvs. este utilizată pentru a afișa numele orașului local și poziția globală în aplicația Ceas global de pe Apple Watch."
      },
      {
        "language" : "ar",
        "filename" : "InfoPlist.loctable",
        "target" : "يتم استخدام موقعك لإظهار اسم المدينة المحلية والموضع العالمي في تطبيق الساعة العالمية على Apple Watch."
      },
      {
        "language" : "it",
        "filename" : "InfoPlist.loctable",
        "target" : "La tua posizione viene usata per mostrare il nome della città in cui ti trovi e la posizione nell’app “Ore locali” su Apple Watch."
      },
      {
        "language" : "pl",
        "filename" : "InfoPlist.loctable",
        "target" : "Twoje położenie służy do wyświetlania nazwy miasta, w którym się znajdujesz, oraz Twoich współrzędnych w aplikacji Zegary świata na Apple Watch."
      },
      {
        "language" : "hr",
        "filename" : "InfoPlist.loctable",
        "target" : "Vaša lokacija koristi se za prikazivanje lokalnog naziva grada i globalnog položaja u aplikaciji Svjetsko vrijeme na Apple Watchu."
      },
      {
        "language" : "sv",
        "filename" : "InfoPlist.loctable",
        "target" : "Din platsinfo används till att visa det lokala stadsnamnet och den globala positionen i appen Världsklocka på Apple Watch."
      },
      {
        "language" : "th",
        "filename" : "InfoPlist.loctable",
        "target" : "ตำแหน่งที่ตั้งของคุณถูกใช้เพื่อแสดงชื่อเมืองในพื้นที่ของคุณและตำแหน่งต่างๆ รอบโลกในแอปนาฬิกาโลกบน Apple Watch ของคุณ"
      },
      {
        "language" : "fi",
        "filename" : "InfoPlist.loctable",
        "target" : "Sijaintiasi käytetään paikallisen kaupungin nimen ja sijainnin näyttämiseen Apple Watchin Maailmankello-apissa."
      },
      {
        "language" : "ru",
        "filename" : "InfoPlist.loctable",
        "target" : "Ваша геопозиция используется для показа названия города и глобальной позиции в приложении «Мировые часы» на Apple Watch."
      },
      {
        "language" : "tr",
        "filename" : "InfoPlist.loctable",
        "target" : "Konumunuz, Apple Watch’unuzdaki Dünya Saati uygulamasında yerel şehir adını ve global konumu göstermek için kullanılır."
      },
      {
        "language" : "el",
        "filename" : "InfoPlist.loctable",
        "target" : "Η τοποθεσία σας χρησιμοποιείται για εμφάνιση του ονόματος της τοπικής πόλης και της παγκόσμιας θέσης στην εφαρμογή «Παγκόσμια ώρα» του Apple Watch σας."
      },
      {
        "language" : "ja",
        "filename" : "InfoPlist.loctable",
        "target" : "Apple Watchの世界時計アプリで地域の都市名とグローバルポジションの表示に位置情報を使用します。"
      },
      {
        "language" : "hi",
        "filename" : "InfoPlist.loctable",
        "target" : "आपके स्थान का उपयोग आपकी Apple Watch पर विश्व घड़ी ऐप में स्थानीय शहर का नाम और वैश्विक अवस्थिति दिखाने के लिए किया जाता है।"
      },
      {
        "language" : "ms",
        "filename" : "InfoPlist.loctable",
        "target" : "Lokasi anda digunakan untuk menunjukkan nama bandar tempatan dan kedudukan global dalam app Jam Dunia pada Apple Watch anda."
      },
      {
        "language" : "en_AU",
        "filename" : "InfoPlist.loctable",
        "target" : "Your location is used to show the local city name and global position in the World Clock app on your Apple Watch."
      },
      {
        "language" : "en",
        "filename" : "InfoPlist.loctable",
        "target" : "Your location is used to show the local city name and global position in the World Clock app on your Apple Watch."
      },
      {
        "language" : "uk",
        "filename" : "InfoPlist.loctable",
        "target" : "Ваша геопозиція використовується для показу назви поточного міста й розташування на світовій мапі в програмі «Час у світі» на Apple Watch."
      },
      {
        "language" : "es_US",
        "filename" : "InfoPlist.loctable",
        "target" : "Se utiliza tu ubicación para mostrar la ciudad local y la posición global en la app Reloj Mundial en tu Apple Watch."
      },
      {
        "language" : "pt_BR",
        "filename" : "InfoPlist.loctable",
        "target" : "Sua localização é usada para mostrar o nome da cidade local e a posição global no app Relógio no Apple Watch."
      },
      {
        "language" : "zh_TW",
        "filename" : "InfoPlist.loctable",
        "target" : "你的位置會用來在Apple Watch上的「世界時鐘」App中顯示本地城市名稱和其全球位置。"
      },
      {
        "language" : "ca",
        "filename" : "InfoPlist.loctable",
        "target" : "La teva ubicació s’utilitza per mostrar el nom de la ciutat local i la posició global a l’app Rellotge Mundial de l’Apple Watch."
      },
      {
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable",
        "target" : "你的位置會用來在Apple Watch上的「世界時鐘」App中顯示當地城市名稱和全球定位。"
      },
      {
        "language" : "no",
        "filename" : "InfoPlist.loctable",
        "target" : "Posisjonen din brukes til å vise navnet på stedet der du befinner deg, samt hvor på kloden det er, i Verdensklokke-appen på Apple Watch."
      },
      {
        "language" : "id",
        "filename" : "InfoPlist.loctable",
        "target" : "Lokasi Anda digunakan untuk menampilkan nama lokal dan posisi global kota di app Jam Dunia di Apple Watch Anda."
      },
      {
        "language" : "es",
        "filename" : "InfoPlist.loctable",
        "target" : "Tu ubicación se utilizará para mostrar el nombre local de la ciudad y la posición global en la app Reloj Mundial de tu Apple Watch."
      },
      {
        "language" : "sl",
        "filename" : "InfoPlist.loctable",
        "target" : "Vaša lokacija se uporablja za prikaz imena lokalnega mesta in globalnega položaja v aplikaciji Svetovna ura v uri Apple Watch."
      },
      {
        "language" : "en_GB",
        "filename" : "InfoPlist.loctable",
        "target" : "Your location is used to show the local city name and global position in the World Clock app on your Apple Watch."
      },
      {
        "language" : "fr",
        "filename" : "InfoPlist.loctable",
        "target" : "Vos données de localisation sont utilisées pour afficher votre position et la ville dans laquelle vous vous trouvez dans l’app Fuseaux de votre Apple Watch."
      },
      {
        "language" : "nl",
        "filename" : "InfoPlist.loctable",
        "target" : "Je locatie wordt gebruikt om de lokale stadsnaam en de geografische positie weer te geven in de Wereldklok-app op je Apple Watch."
      },
      {
        "language" : "he",
        "filename" : "InfoPlist.loctable",
        "target" : "פרטי המיקום שלך משמשים להצגת שם העיר והמיקום שלך בעולם ביישום ״שעון עולמי״ ב-Apple Watch."
      },
      {
        "language" : "cs",
        "filename" : "InfoPlist.loctable",
        "target" : "Vaše poloha se používá k zobrazení názvu města a GPS souřadnic v aplikaci Světový čas na Apple Watch."
      },
      {
        "language" : "es_419",
        "filename" : "InfoPlist.loctable",
        "target" : "Se utiliza tu ubicación para mostrar la ciudad local y la posición global en la app Reloj Mundial en tu Apple Watch."
      },
      {
        "language" : "de",
        "filename" : "InfoPlist.loctable",
        "target" : "Dein Standort wird verwendet, um den lokalen Ortsnamen und die globale Position in der App „Weltuhr“ auf deiner Apple Watch anzuzeigen."
      },
      {
        "language" : "vi",
        "filename" : "InfoPlist.loctable",
        "target" : "Vị trí của bạn được sử dụng để hiển thị tên thành phố tại địa phương và vị trí toàn cầu trong ứng dụng Giờ quốc tế trên Apple Watch."
      },
      {
        "language" : "da",
        "filename" : "InfoPlist.loctable",
        "target" : "Din lokalitet bruges til at vise det lokale bynavn og din globale lokalitet i appen Verdensur på dit Apple Watch."
      },
      {
        "language" : "fr_CA",
        "filename" : "InfoPlist.loctable",
        "target" : "Votre position est utilisée pour afficher le nom de la ville ainsi que votre position globale dans l’app Horloges de votre Apple Watch."
      },
      {
        "language" : "sk",
        "filename" : "InfoPlist.loctable",
        "target" : "Vaša poloha slúži na zobrazenie názvu aktuálneho mesta a vašej polohy v apke Svetový čas na Apple Watch."
      },
      {
        "language" : "hu",
        "filename" : "InfoPlist.loctable",
        "target" : "A helyzete a helyi városnév és a globális pozíció megjelenítéséhez lesz felhasználva az Apple Watcha Világóra appjában."
      },
      {
        "language" : "zh_CN",
        "filename" : "InfoPlist.loctable",
        "target" : "你的位置会用于在Apple Watch的“世界时钟”App中显示本地城市名称和在全球的位置。"
