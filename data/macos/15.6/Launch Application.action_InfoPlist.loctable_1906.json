    "AMDSummary" : [
      {
        "language" : "ko",
        "filename" : "InfoPlist.loctable",
        "target" : "이 동작은 선택된 응용 프로그램을 실행합니다. 응용 프로그램이 이미 실행 중인 경우, 활성화시킵니다."
      },
      {
        "language" : "pt_PT",
        "filename" : "InfoPlist.loctable",
        "target" : "Esta ação inicia a aplicação selecionada. Se a aplicação já estiver em execução, torna‑se ativa."
      },
      {
        "language" : "hi",
        "filename" : "InfoPlist.loctable",
        "target" : "यह क्रिया चुने गए ऐप्लिकेशन लॉन्च करती है। यदि ऐप्लिकेशन पहले से ही चल रहा है, तो वह सक्रिय हो जाता है।"
      },
      {
        "language" : "en_AU",
        "filename" : "InfoPlist.loctable",
        "target" : "This action launches the chosen application. If the application is already running, it becomes active."
      },
      {
        "language" : "hr",
        "filename" : "InfoPlist.loctable",
        "target" : "Ovaj postupak pokreće odabranu aplikaciju. Ako je aplikacija već pokrenuta, postaje aktivna."
      },
      {
        "language" : "ja",
        "filename" : "InfoPlist.loctable",
        "target" : "選択したアプリケーションを起動します。アプリケーションがすでに実行中の場合は、アクティブになります。"
      },
      {
        "language" : "cs",
        "filename" : "InfoPlist.loctable",
        "target" : "Tato akce spustí vybranou aplikaci. Pokud je aplikace již spuštěna, bude aktivována."
      },
      {
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable",
        "target" : "此動作啟動所選應用程式，如果應用程式已執行，則該程式會成為現用中的應用程式。"
      },
      {
        "language" : "he",
        "filename" : "InfoPlist.loctable",
        "target" : "פעולה זו מפעילה את היישום הנבחר. אם היישום כבר פועל, הוא נעשה פעיל."
      },
      {
        "language" : "fr",
        "filename" : "InfoPlist.loctable",
        "target" : "Cette action lance l’application indiquée. Si cette dernière est déjà en cours d’exécution, elle est ramenée au premier plan."
      },
      {
        "language" : "nl",
        "filename" : "InfoPlist.loctable",
        "target" : "Met deze taak open je de gekozen app. Als de app al geopend is, wordt de app actief."
      },
      {
        "language" : "ru",
        "filename" : "InfoPlist.loctable",
        "target" : "Данное действие запускает выбранную программу. Если программа уже открыта, она становится активной."
      },
      {
        "language" : "sv",
        "filename" : "InfoPlist.loctable",
        "target" : "Åtgärden startar den valda appen. Om appen redan är igång aktiveras den."
