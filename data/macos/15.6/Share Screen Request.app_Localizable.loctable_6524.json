    "observeRequestUnknown" : [
      {
        "target" : "Un utente ospite, in collegamento da %@, chiede il permesso di osservare il tuo schermo.\r\rFai clic su “Condividi schermo” solo se puoi confermare l’identità di questa persona.",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Một người dùng khách kết nối từ địa chỉ %@ đang yêu cầu quyền quan sát màn hình của bạn.\r\rChỉ bấm Chia sẻ màn hình nếu bạn chắc chắn biết người này.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Un usuario invitado que se está conectando desde la dirección %@ solicita permiso para observar tu pantalla.\n\nHaz clic en “Compartir pantalla” solo si tienes la certeza de que conoces a esta persona.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "En gästanvändare på adressen %@ ber om tillstånd att observera din skärm.\r\rKlicka inte på Dela skärm om du inte är säker på att du vet vem den här personen är.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "A guest user connecting from address %@ is requesting permission to observe your screen.\r\rClick Share Screen only if you are sure you know this person.",
        "filename" : "Localizable.loctable",
