    "5.title" : [
      {
        "language" : "fi",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Voit nollata tilin salasanan Apple-tilin tunnistetietojen avulla."
      },
      {
        "language" : "es",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Puedes restablecer la contraseña de tu cuenta con las credenciales de tu cuenta de Apple."
      },
      {
        "language" : "zh_TW",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "你可以使用「Apple帳號」憑證來重置帳號密碼。"
      },
      {
        "language" : "fr_CA",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Vous pouvez réinitialiser le mot de passe de votre compte en utilisant les informations d’identification de votre compte Apple."
      },
      {
        "language" : "es_419",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Puedes restablecer la contraseña de tu cuenta con las credenciales de tu cuenta de Apple."
      },
      {
        "language" : "el",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Μπορείτε να επαναφέρετε το συνθηματικό λογαριασμού σας αν χρησιμοποιήσετε τα διαπιστευτήρια του λογαριασμού Apple σας."
      },
      {
        "language" : "da",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Du kan nulstille din kontoadgangskode med brugeroplysningerne til din Apple‑konto."
      },
      {
        "language" : "en_GB",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "You can reset your account password using your Apple Account credentials."
      },
      {
        "language" : "id",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Anda dapat mengatur ulang kata sandi menggunakan kredensial Akun Apple Anda."
      },
      {
        "language" : "zh_HK",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "你可以使用Apple帳户憑證來重設帳户密碼。"
      },
      {
        "language" : "ru",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Вы можете сбросить пароль своей учетной записи с помощью данных, которые Вы используете для входа в Аккаунт Apple."
      },
      {
        "language" : "he",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "באפשרותך לאפס את סיסמת החשבון באמצעות פרטי חשבון ה-Apple שלך."
      },
      {
        "language" : "nl",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Je kunt je accountwachtwoord opnieuw instellen met je Apple Account-gegevens."
      },
      {
        "language" : "tr",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Apple Hesabı bilgilerinizi kullanarak hesap parolanızı sıfırlayabilirsiniz."
      },
      {
        "language" : "de",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Du kannst dein Accountpasswort mithilfe deiner Apple Account-Anmeldedaten zurücksetzen."
      },
      {
        "language" : "ko",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Apple 계정 자격 증명을 사용하여 계정 암호를 재설정할 수 있습니다."
      },
      {
        "language" : "vi",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Bạn có thể đặt lại mật khẩu tài khoản bằng thông tin đăng nhập Tài khoản Apple của mình."
      },
      {
        "language" : "cs",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Heslo k účtu můžete obnovit pomocí přihlašovacích údajů ke svému účtu Apple."
      },
      {
        "language" : "zh_CN",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "你可以使用Apple账户凭证重设账户密码。"
      },
      {
        "language" : "ca",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "target" : "Pots restablir la contrasenya amb les credencials del compte d’Apple."
      },
      {
        "language" : "pl",
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
