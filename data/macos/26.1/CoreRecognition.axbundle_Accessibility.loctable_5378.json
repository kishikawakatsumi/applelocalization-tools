    "camera.scan.card.hint" : [
      {
        "filename" : "Accessibility.loctable",
        "language" : "th",
        "target" : "วางกล้องด้านหลังตรงกึ่งกลางบัตรของคุณ จากนั้นดึง iPhone ของคุณถอยหลังช้าๆ"
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "en_AU",
        "target" : "Place your back-facing camera on the centre of your card. Then, slowly pull your iPhone back."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "hi",
        "target" : "अपने बैक फ़ेसिंग कैमरा को अपने कार्ड के बीच में रखें। फिर धीरे से अपने iPhone को पीछे खींचें।"
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "fr",
        "target" : "Placez votre caméra arrière au centre de la carte. Éloignez ensuite lentement votre iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "sk",
        "target" : "Položte zadnú kameru na stred karty. Potom pomaly dvíhajte iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "he",
        "target" : "יש להניח את המצלמה האחורית על מרכז הכרטיס שלך. לאחר מכן, יש להרחיק את ה-iPhone באיטיות."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "ar",
        "target" : "ركز الكاميرا الخلفية على منتصف البطاقة، ثم اسحب iPhone للخلف ببطء."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "vi",
        "target" : "Hướng camera phía sau vào giữa thẻ của bạn. Sau đó, từ từ kéo iPhone của bạn về phía sau."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "it",
        "target" : "Posiziona la fotocamera posteriore al centro della carta e allontana lentamente iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "es",
        "target" : "Coloca la cámara trasera en el centro de la tarjeta y ve alejando el iPhone lentamente."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "sl",
        "target" : "Zadnjo kamero usmerite proti sredini svoje kartice. Nato počasi odmikajte iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "de",
        "target" : "Platziere die rückseitige Kamera auf der Mitte deiner Karte und ziehe dein iPhone dann langsam zurück."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "uk",
        "target" : "Прикладіть задню камеру до центра своєї картки, а потім повільно відведіть iPhone назад."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "zh_HK",
        "target" : "將後置鏡頭對準卡的中央位置。然後將iPhone慢慢拉後。"
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "fr_CA",
        "target" : "Placez la caméra arrière sur le centre de la carte, puis éloignez lentement l’iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "ja",
        "target" : "背面カメラをカードの中央に置いてから、iPhoneをゆっくりとカードから離してください。"
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "es_419",
        "target" : "Apunta al centro de la tarjeta con la cámara posterior y luego desplaza lentamente hacia atrás tu iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "pt_PT",
        "target" : "Coloque a câmara de trás no centro do cartão. Depois, lentamente, afaste o iPhone."
      },
      {
        "filename" : "Accessibility.loctable",
        "language" : "ms",
