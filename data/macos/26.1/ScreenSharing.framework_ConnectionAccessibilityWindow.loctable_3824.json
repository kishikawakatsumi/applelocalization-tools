    "private" : [
      {
        "language" : "th",
        "filename" : "ConnectionAccessibilityWindow.loctable",
        "target" : "%@: ไม่สามารถดูหรือฟังได้โดยใครก็ตามที่อยู่ด้านหน้าของหน้าจอ Mac ระยะไกล"
      },
      {
        "language" : "en_AU",
        "filename" : "ConnectionAccessibilityWindow.loctable",
        "target" : "%@: will not be seen or heard by anyone in front of the remote Mac."
      },
      {
        "language" : "hi",
        "filename" : "ConnectionAccessibilityWindow.loctable",
        "target" : "%@: रिमोट Mac के सामने किसी भी व्यक्ति द्वारा देखा या सुना नहीं जाएगा।"
      },
      {
        "language" : "fr",
        "filename" : "ConnectionAccessibilityWindow.loctable",
        "target" : "%@ : la ou les personnes se trouvant devant le Mac distant ne pourront ni voir ni entendre ce que vous faites."
      },
      {
        "language" : "sk",
        "filename" : "ConnectionAccessibilityWindow.loctable",
        "target" : "%@: nebude vidieť ani počuť nikto pred vzdialeným Macom."
