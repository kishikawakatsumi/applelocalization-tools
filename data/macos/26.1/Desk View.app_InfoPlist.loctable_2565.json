    "NSCameraUsageDescription" : [
      {
        "target" : "มุมมองด้านหน้าโต๊ะต้องการเข้าถึงกล้องเท่านั้นเพื่อดู",
        "language" : "th",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Desk View only needs to access the camera for viewing.",
        "language" : "en_AU",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "डेस्क व्यू कैमरे का इस्तेमाल केवल देखने के लिए करता है।",
        "language" : "hi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Desk View n’accède à la caméra qu’à des fins d’affichage.",
        "language" : "fr",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Apka Pohľad na stôl potrebuje prístup ku kamere len na zobrazovanie.",
        "language" : "sk",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "הגישה למצלמה שלך נדרשת רק לצורך תצוגה באמצעות המאפיין ״תצוגת שולחן״.",
        "language" : "he",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Desk View chỉ cần truy cập vào camera để xem.",
        "language" : "vi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "يحتاج العرض الرأسي إلى الوصول إلى الكاميرا للعرض فقط.",
        "language" : "ar",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Panoramica Scrivania richiede solo l’accesso alla fotocamera per la visualizzazione.",
        "language" : "it",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Para usar la app Vista Cenital, solo se necesita acceso a la cámara.",
        "language" : "es",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Pogled pisalne mize za ogledovanje zahteva le dostop do kamere.",
        "language" : "sl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "„Schreibtischansicht“ benötigt nur zum Anzeigen des Bildes Zugriff auf die Kamera.",
        "language" : "de",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Функції «Вид на стіл» потрібен доступ до камери для перегляду.",
        "language" : "uk",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "「桌上視角」只需取用相機來檢視。",
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "« Vue du bureau » accède à la caméra uniquement à des fins d’affichage.",
        "language" : "fr_CA",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "デスクビューを表示するにはカメラにアクセスするだけ十分です。",
        "language" : "ja",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Vista del Escritorio sólo requiere acceso a la cámara para visualizar.",
        "language" : "es_419",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "A Vista de Secretária só precisa de acesso à câmara para visualização.",
        "language" : "pt_PT",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Pandangan Meja hanya perlu mengakses kamera untuk pemaparan.",
        "language" : "ms",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Bureauweergave heeft alleen voor het weergeven toegang nodig tot de camera.",
        "language" : "nl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Työpöytänäkymä tarvitsee vain kameran käyttöoikeuden kuvan näyttämistä varten.",
        "language" : "fi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Značajka Prikaz radnog stola treba pristupiti kameri samo radi gledanja.",
        "language" : "hr",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Bordsvisning behöver bara få tillgång till visning av kameran.",
        "language" : "sv",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Desk View only needs to access the camera for viewing.",
        "language" : "en",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "A Visualização da Mesa só precisa acessar a câmera para visualização.",
        "language" : "pt",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Masa Görüntüsü’nün yalnızca görüntüleme amacıyla kameraya erişmesi gerekir.",
        "language" : "tr",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Aplikace Pohled na stůl potřebuje přístup k fotoaparátu jen pro účely zobrazení.",
        "language" : "cs",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Aplicația „Vizualizare birou” necesită acces la cameră exclusiv pentru vizualizare.",
        "language" : "ro",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "L’app Vista de l’Escriptori només necessita accés a la càmera.",
        "language" : "ca",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Aplikacja Widok blatu wymaga dostępu do kamery.",
        "language" : "pl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "데스크뷰 보기를 실행하려면 오직 카메라 접근 권한만이 필요합니다.",
        "language" : "ko",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Η Προβολή γραφείου χρειάζεται μόνο πρόσβαση στην κάμερα για προβολή.",
        "language" : "el",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "「桌上視角」只需要取用相機以供檢視。",
        "language" : "zh_TW",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Visning af skrivebord kræver kun adgang til kameraet til visning.",
        "language" : "da",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Функции «Обзор стола» необходимо получить доступ к камере только для просмотра.",
        "language" : "ru",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Bordvisning trenger kun tilgang til kameraet for å vise.",
        "language" : "no",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Desk View only needs to access the camera for viewing.",
        "language" : "en_GB",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Az Íróasztal nézetnek csak a megtekintéshez van szüksége a kamerához való hozzáférésre.",
        "language" : "hu",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "“桌上视角”只需访问相机来提供视角。",
        "language" : "zh_CN",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Tampilan Meja hanya perlu mengakses kamera untuk melihat.",
        "language" : "id",
        "filename" : "InfoPlist.loctable"
      }
