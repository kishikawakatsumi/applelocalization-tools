    "NSBluetoothAlwaysUsageDescription" : [
      {
        "filename" : "InfoPlist.loctable",
        "language" : "th",
        "target" : "การตั้งค่าการช่วยการเข้าถึงใช้บลูทูธเพื่อเชื่อมต่อกับอุปกรณ์เสริม"
