    "audio.caseTonesEnabled.desc" : [
      {
        "target" : "อนุญาตเอฟเฟ็กต์เสียงทั้งหมดเมื่อ Beats อยู่ในเคสชาร์จ",
        "language" : "th",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Allow all sound effects when Beats are in the charging case.",
        "language" : "en_AU",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats के चार्जिंग केस में होने पर सभी ध्वनि प्रभावों को अनुमति दें।",
        "language" : "hi",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Autorisez tous les effets sonores lorsque les Beats se trouvent dans le boîtier de recharge.",
        "language" : "fr",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Zapne všetky zvuky, keď sú slúchadlá Beats vložené v nabíjacom puzdre.",
        "language" : "sk",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "ניתן לאפשר השמעה של כל האפקטים הקוליים כאשר אוזניות ה-Beats נמצאות במארז הטעינה.",
        "language" : "he",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "السماح بجميع المؤثرات الصوتية عندما تكون Beats في علبة الشحن.",
        "language" : "ar",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Cho phép tất cả các hiệu ứng âm thanh khi Beats ở trong hộp sạc.",
        "language" : "vi",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Consenti tutti gli effetti sonori quando i Beats si trovano nella custodia di ricarica.",
        "language" : "it",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Cuando esta opción está activada, se permiten todos los efectos de sonido cuando los Beats se encuentran en el estuche de carga.",
        "language" : "es",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Dovolite vse zvočne učinke, kadar so slušalke Beats v škatlici za polnjenje.",
        "language" : "sl",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Erlaube alle Toneffekte, wenn sich die Beats im Ladecase befinden.",
        "language" : "de",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Дозволити всі аудіоефекти, коли навушники Beats перебувають у зарядному футлярі.",
        "language" : "uk",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats在充電盒中時允許所有音效。",
        "language" : "zh_HK",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Autorisez tous les effets sonores lorsque les Beats sont dans leur étui de recharge.",
        "language" : "fr_CA",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beatsが充電ケースに入っているときのすべてのサウンドエフェクトを許可します。",
        "language" : "ja",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permite todos los efectos de sonido cuando los Beats están en el estuche de carga.",
        "language" : "es_419",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permitir todos os efeitos sonoros quando os Beats estiverem na caixa de carregamento.",
        "language" : "pt_PT",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Benarkan semua kesan bunyi apabila Beats berada di dalam bekas pengecasan.",
        "language" : "ms",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Sta alle geluidseffecten toe wanneer Beats zich in de oplaadcase bevinden.",
        "language" : "nl",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Salli äänitehosteet, kun Beats-kuulokkeet ovat latauskotelossa.",
        "language" : "fi",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Dozvolite sve zvučne efekte kad se slušalice Beats nalaze u kutijici za punjenje.",
        "language" : "hr",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Tillåt alla ljudeffekter när Beats är placerade i laddningsetuiet.",
        "language" : "sv",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permite todos los efectos de sonido cuando los Beats están en el estuche de carga.",
        "language" : "es_US",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Allow all sound effects when Beats are in the charging case.",
        "language" : "en",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permita todos os efeitos sonoros quando os Beats estiverem no estojo de carregamento.",
        "language" : "pt",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats şarj kutusundayken tüm ses efektlerine izin verir.",
        "language" : "tr",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Zapíná přehrávání zvuků, když jsou sluchátka Beats uložená v nabíjecím pouzdře.",
        "language" : "cs",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permiteți toate efectele sonore cât timp căștile Beats sunt în caseta de încărcare.",
        "language" : "ro",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Permet tots els sons quan els Beats són a l’estoig de càrrega.",
        "language" : "ca",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Επιτρέπονται όλα τα ηχητικά εφέ όταν τα Beats βρίσκονται στη θήκη φόρτισης.",
        "language" : "el",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats가 충전 케이스에 들어 있을 때의 사운드 효과를 모두 허용합니다.",
        "language" : "ko",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Включить все звуковые эффекты, когда наушники Beats находятся в зарядном футляре.",
        "language" : "ru",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "允許Beats在充電盒中時的所有音效。",
        "language" : "zh_TW",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Tillad alle lydeffekter, når Beats er i opladningsetuiet.",
        "language" : "da",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Wszystkie efekty dźwiękowe będą odtwarzane, gdy słuchawki Beats znajdują się w etui.",
        "language" : "pl",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Tillat alle lydeffekter når Beats er i ladeetuiet.",
        "language" : "no",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Allow all sound effects when Beats are in the charging case.",
        "language" : "en_GB",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Összes hangeffektus engedélyezése, amikor a Beats fülhallgatók a töltőtokban vannak.",
        "language" : "hu",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats置于充电盒中时，允许所有声音效果。",
        "language" : "zh_CN",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Izinkan semua efek bunyi saat Beats berada di casing pengisi daya.",
        "language" : "id",
        "filename" : "Localizable-B463.loctable"
      }
    ],
    "audio.caseTonesVolume.desc" : [
      {
        "target" : "ปรับระดับเสียงเมื่ออยู่ในเคสของเอฟเฟ็กต์เสียงที่เล่นโดย Beats",
        "language" : "th",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Adjust the case tones volume of sound effects played by Beats.",
        "language" : "en_AU",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Beats द्वारा चलाए जाने वाले ध्वनि प्रभावों के केस टोन वॉल्यूम ऐडजस्ट करें।",
        "language" : "hi",
        "filename" : "Localizable-B463.loctable"
      },
      {
        "target" : "Ajustez le volume des effets sonores émis par le boîtier des Beats.",
        "language" : "fr",
        "filename" : "Localizable-B463.loctable"
