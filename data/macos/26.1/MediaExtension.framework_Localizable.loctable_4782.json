    "ME_NOTIFICATION_MESSAGE_1" : [
      {
        "target" : "“%@” เพิ่มส่วนขยายสื่อใหม่ไปยังระบบของคุณแล้ว ในการเปิดใช้งาน ให้เปิดส่วนขยายสื่อในรายการเข้าสู่ระบบและส่วนขยาย",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "“%@” added a new media extension to your system. To enable it, open Media Extensions in Login Items and Extensions.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "“%@” ने आपके सिस्टम में एक नया मीडिया एक्सटेंशन जोड़ा। इसे सक्षम करने के लिए लॉगइन आइटम और एक्सटेंशन में मीडिया एक्सटेंशन खोलें।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "« %@ » a ajouté une nouvelle extension multimédia à votre système. Pour l’activer, ouvrez « Extensions multimédias » dans « Ouverture et extensions ».",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Apka %@ pridala do systému nové rozšírenie médií. Ak ho chcete zapnúť, otvorte časť Rozšírenia médií v nastaveniach Položky a rozšírenia spúšťané pri prihlásení.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "הרחבת מדיה חדשה נוספה למערכת שלך על ידי ״⁨%@⁩״. כדי להפעיל אותה, יש לפתוח את ״הרחבות מדיה״ ב״פריטי התחברות והרחבות״.",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "أضاف \"%@\" ملحق وسائط جديدًا إلى النظام. لتمكينه، افتح ملحقات الوسائط في عناصر الدخول والملحقات.",
        "filename" : "Localizable.loctable",
        "language" : "ar"
