  "framework" : "MediaExtension.framework",
  "bundlePath" : "\/System\/Library\/Frameworks\/MediaExtension.framework",
  "loctablePath" : "\/System\/Library\/Frameworks\/MediaExtension.framework\/Versions\/A\/Resources\/Localizable.loctable",
  "localizations" : {
    "ME_NOTIFICATION_MESSAGE_N" : [
      {
        "target" : "“%@” เพิ่มส่วนขยายสื่อใหม่ไปยังระบบของคุณแล้ว ในการเปิดใช้งาน ให้เปิดส่วนขยายสื่อในรายการเข้าสู่ระบบและส่วนขยาย",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "“%@” added new media extensions to your system. To enable them, open Media Extensions in Login Items and Extensions.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "“%@” ने आपके सिस्टम में नए मीडिया एक्सटेंशन जोड़े। इन्हें सक्षम करने के लिए लॉगइन आइटम और एक्सटेंशन में मीडिया एक्सटेंशन खोलें।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "« %@ » a ajouté de nouvelles extensions multimédias à votre système. Pour les activer, ouvrez « Extensions multimédias » dans « Ouverture et extensions ».",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Apka %@ pridala do systému nové rozšírenia médií. Ak ich chcete zapnúť, otvorte časť Rozšírenia médií v nastaveniach Položky a rozšírenia spúšťané pri prihlásení.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "הרחבות מדיה חדשות נוספו למערכת שלך על ידי ״⁨%@⁩״. כדי להפעיל אותן, יש לפתוח את ״הרחבות מדיה״ ב״פריטי התחברות והרחבות״.",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "أضاف \"%@\" ملحقات وسائط جديدة إلى النظام. لتمكينها، افتح ملحقات الوسائط في عناصر الدخول والملحقات.",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "“%@” đã thêm các phần mở rộng phương tiện mới vào hệ thống của bạn. Để bật những phần mở rộng này, hãy mở Phần mở rộng phương tiện trong Mục đăng nhập & Phần mở rộng.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "%@ ha aggiunto nuove estensioni per contenuti multimediali al sistema. Per abilitarle, apri “Estensioni contenuti multimediali” in “Elementi login ed estensioni”.",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "%@ ha añadido nuevas extensiones multimedia a tu sistema. Para activarlas, abre “Extensiones multimedia” en “Ítems de inicio y extensiones”.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "Aplikacija »%@« je sistemu dodala nove razširitve predstavnostne vsebine. Če jih želite omogočiti, v razdelku Elementi prijave in razširitve odprite Razširitve predstavnostne vsebine.",
        "filename" : "Localizable.loctable",
        "language" : "sl"
      },
      {
        "target" : "„%@“ hat neue Medienerweiterungen zum System hinzugefügt. Um sie zu aktivieren, öffne „Medienerweiterungen“ in „Anmeldeobjekte & Erweiterungen“.",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "«%@» додає нові розширення для медіафайлів до вашої системи. Щоб увімкнути їх, відкрийте розділ «Медіарозширення» в параметрах Автозапуску й розширень.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "「%@」已將新的媒體延伸功能加至你的系統。如要啟用，請在「登入項目與延伸功能」中開啟「媒體延伸功能」。",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "« %@ » a ajouté de nouvelles extensions multimédias à votre système. Pour les activer, ouvrez « Extensions multimédias » dans « Éléments d’ouverture et extensions ».",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "“%@”により新しいメディア機能拡張がシステムに追加されました。これらの機能拡張を有効にするには、“ログイン項目と機能拡張”の“メディア機能拡張”を開いてください。",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "“%@” agregó nuevas extensiones multimedia a tu sistema, las cuales puedes activar en la configuración de Elementos de inicio y extensiones.",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "“%@” adicionou novas extensões de multimédia ao sistema. Para ativá‑las, abra o painel Extensões de multimédia, nas definições de início de sessão e extensões.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "“%@” menambahkan sambungan media baharu ke sistem anda. Untuk mendayakannya, buka Sambungan Media dalam Item Log Masuk & Sambungan.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "'%@' heeft nieuwe media-extensies toegevoegd aan je systeem. Om deze in te schakelen, open je 'Media-extensies' in 'Inlogonderdelen en extensies'.",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "%@ lisäsi järjestelmään uusia medialaajennuksia. Jos haluat ottaa ne käyttöön, avaa Kirjautumiskohteet ja laajennukset > Medialaajennukset.",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "“%@” dodaje nove ekstenzije medija u vaš sustav. Kako biste ih omogućili, otvorite Ekstenzije medija u postavkama Stavke za prijavu i ekstenzije.",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "”%@” lade till nya medietillägg i systemet. Aktivera dem genom att öppna Medietillägg i Startobjekt och tillägg.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "“%@” added new media extensions to your system. To enable them, open Media Extensions in Login Items & Extensions.",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "O app %@ adicionou extensões de mídia nova ao sistema. Para ativá‑las, abra Extensões de Mídia em Itens de Início de Sessão e Extensões.",
        "filename" : "Localizable.loctable",
        "language" : "pt"
      },
      {
        "target" : "“%@”, sisteminize yeni ortam genişletmeleri ekledi. Bunları etkinleştirmek için Oturum Açma Öğeleri ve Genişletmeler’de Ortam Genişletmeleri’ni açın.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "Aplikace %@ přidala do systému nová rozšíření pro média. Chcete‑li je zapnout, otevřete oddíl Rozšíření médií v nastavení Aktivace položek a rozšíření při přihlášení.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "„%@” a adăugat noi extensii multimedia în sistemul dvs. Pentru a le activa, deschideți secțiunea „Extensii multimedia” din configurările „Lansare la login și Extensii”.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "L’app %@ ha afegit diverses extensions multimèdia noves al sistema. Per activar‑les, ves a Ítems d’inici de sessió i extensions > Extensions multimèdia.",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "Προστέθηκαν νέες επεκτάσεις πολυμέσων στο σύστημά σας από «%@». Για να τις ενεργοποιήσετε, ανοίξτε τις Επεκτάσεις πολυμέσων στο τμήμα «Στοιχεία εισόδου και επεκτάσεις».",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "‘%@’이(가) 시스템에 새로운 미디어 확장 프로그램을 추가했습니다. 활성화하려면 로그인 항목 및 확장 프로그램에서 미디어 확장 프로그램을 여십시오.",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Приложение «%@» добавило в систему новые медиарасширения. Чтобы включить их, перейдите в раздел «Медиарасширения» панели настроек «Объекты входа и расширения».",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "「%@」已將新的媒體延伸功能加入你的系統。若要啟用，請打開「登入項目與延伸功能」中的「媒體延伸功能」。",
        "filename" : "Localizable.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "“%@” tilføjede nye medieudvidelser til systemet. Hvis du vil slå disse udvidelser til, skal du åbne Medieudvidelser i Loginemner & udvidelser.",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "„%@” dodaje do systemu nowe rozszerzenia multimediów. Aby je włączyć, otwórz Rozszerzenia multimediów w panelu Rzeczy i rozszerzenia otwierane podczas logowania.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "«%@» la til nye medieutvidelser i systemet. De kan aktiveres under Medieutvidelser i Påloggingsobjekter og utvidelser.",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "“%@” added new media extensions to your system. To enable them, open Media Extensions in Login Items and Extensions.",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "“%@”已将新媒体扩展添加到系统。若要启用，请在“登录项与扩展”中打开“媒体扩展”。",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "A(z) „%@” új médiabővítményeket adott hozzá az Ön rendszeréhez. Az engedélyezésükhöz nyissa meg a Médiabővítmények menüpontot az Indítóelemek és bővítmények szakaszban.",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "“%@” menambahkan ekstensi media baru ke sistem Anda. Untuk mengaktifkannya, buka Ekstensi Media di Item Masuk & Ekstensi.",
        "filename" : "Localizable.loctable",
        "language" : "id"
      }
    ],
