    "A remote user is connected. That prevents system sleep." : [
      {
        "filename" : "Localizable.loctable",
        "language" : "th",
        "target" : "ผู้ใช้ระยะไกลเชื่อมต่ออยู่ ซึ่งป้องกันไม่ให้เข้าสู่สถานะพักเครื่อง"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "en_AU",
        "target" : "A remote user is connected. This prevents system sleep."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "hi",
        "target" : "रिमोट यूज़र कनेक्टेड है। यह सिस्टम को स्लीप मोड में जाने से रोकता है।"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "fr",
        "target" : "Un utilisateur distant est connecté, ce qui empêche le système de se mettre en veille."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "sk",
        "target" : "Je pripojený vzdialený užívateľ. Systém sa nemôže prepnúť do režimu spánku. "
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "he",
        "target" : "משתמש מרוחק מחובר. הדבר מונע העברת המערכת למצב שינה."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "vi",
        "target" : "Có người dùng từ xa đang kết nối. Việc này khiến hệ thống không thể chuyển sang chế độ ngủ."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "ar",
        "target" : "يوجد مستخدم بعيد متصل. يمنع ذلك إسبات النظام."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "it",
        "target" : "È connesso un utente remoto. Ciò impedisce la sospensione del sistema."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "es",
        "target" : "Hay un usuario remoto conectado, por lo que el sistema no puede entrar en reposo."
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "sl",
        "target" : "Oddaljeni uporabnik je povezan. To preprečuje spanje sistema."
      },
      {
        "filename" : "Localizable.loctable",
