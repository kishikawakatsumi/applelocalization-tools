    "SRd-UI-bAB.title" : [
      {
        "target" : "ป้อนที่อยู่ iMessage ที่จะปิดกั้นไว้ในรายการด้านล่าง:",
        "language" : "th",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Enter iMessage addresses to block in the list below:",
        "language" : "en_AU",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "नीचे सूची में ब्लॉक किए जाने वाले iMessage पते दर्ज करें :",
        "language" : "hi",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Saisir dans la liste ci-dessous les adresses iMessage à bloquer :",
        "language" : "fr",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Do zoznamu nižšie zadajte adresy iMessage, ktoré chcete blokovať:",
        "language" : "sk",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "יש להזין את כתובות ה-iMessage שברצונך לחסום ברשימה שלהלן:",
        "language" : "he",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Nhập địa chỉ iMessage để chặn trong danh sách bên dưới:",
        "language" : "vi",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "أدخل في القائمة أدناه عناوين iMessage المراد حظرها:",
        "language" : "ar",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Inserisci gli indirizzi iMessage da bloccare nell’elenco qui sotto:",
        "language" : "it",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Introduce las direcciones de iMessage que quieres bloquear en la lista siguiente:",
        "language" : "es",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Vnesite naslove iMessage za blokiranje na spodnjem seznamu:",
        "language" : "sl",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "iMessage-Adressen, die blockiert werden sollen, in die Liste eingeben:",
        "language" : "de",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Введіть адреси iMessage, які потрібно заблокувати, у цьому списку:",
        "language" : "uk",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "在下方名單中加入要封鎖的iMessage地址：",
        "language" : "zh_HK",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Saisir dans la liste ci-dessous les adresses iMessage à bloquer :",
        "language" : "fr_CA",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "下のリストにブロックするiMessageアドレスを入力してください:",
        "language" : "ja",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Ingresa en la lista de abajo las direcciones de iMessage que quieres bloquear:",
        "language" : "es_419",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
