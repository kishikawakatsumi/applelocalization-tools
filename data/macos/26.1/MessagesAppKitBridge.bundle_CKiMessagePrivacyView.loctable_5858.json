        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Insira abaixo os endereços de iMessage que deseja bloquear:",
        "language" : "pt",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Do seznamu níže zadejte iMessage adresy, které chcete zablokovat:",
