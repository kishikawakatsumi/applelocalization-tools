        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "请在下面的列表中输入要屏蔽的iMessage信息地址：",
        "language" : "zh_CN",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Oppgi iMessage-adressene du vil blokkere, i listen nedenfor:",
