        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Engellenecek iMessage adreslerini aşağıdaki listeye girin:",
        "language" : "tr",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Introduceți adresele iMessage de blocat în lista de mai jos:",
        "language" : "ro",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Afegeix a la llista següent les adreces de l’iMessage que vulguis bloquejar:",
        "language" : "ca",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Podaj poniżej adresy iMessage do zablokowania:",
        "language" : "pl",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Εισαγάγετε διευθύνσεις iMessage προς αποκλεισμό στην παρακάτω λίστα:",
        "language" : "el",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Введите адреса iMessage для блокировки в расположенный ниже список:",
