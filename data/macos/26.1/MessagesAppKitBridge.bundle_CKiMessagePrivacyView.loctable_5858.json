        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
        "target" : "Voeg hier de iMessage-adressen toe die je wilt blokkeren:",
        "language" : "nl",
        "filename" : "CKiMessagePrivacyView.loctable"
      },
      {
