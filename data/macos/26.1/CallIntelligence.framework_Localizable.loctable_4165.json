  "bundlePath" : "\/System\/Library\/PrivateFrameworks\/CallIntelligence.framework",
  "loctablePath" : "\/System\/Library\/PrivateFrameworks\/CallIntelligence.framework\/Versions\/A\/Resources\/Localizable.loctable",
  "localizations" : {
    "HOLD_ASSIST_REMOTE_DISCLOSURE" : [
      {
        "target" : "ข้อความนี้ถูกถอดเสียงแล้ว โปรดรอสักครู่ในระหว่างที่ฉันแจ้งเตือนผู้โทร…",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "This message has been transcribed. One moment while I notify the caller…",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "इस संदेश को ट्रांसक्राइब किया गया है। एक पल ठहरिए, कॉलर को सूचित किया जा रहा है…",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "Ce message a été transcrit. Un instant, je préviens le correspondant…",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Táto správa bola prepísaná. Chvíľu počkajte, kým upozorním volajúceho…",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "הודעה זו תומללה. נא להמתין מספר רגעים בזמן שאעדכן את האדם שהתקשר…",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "Lời nhắn này đã được chép lại. Vui lòng đợi giây lát trong khi tôi thông báo cho người gọi…",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "تم إنشاء نسخة نصية من هذه الرسالة. انتظر لحظة واحدة أثناء إعلام المتصل…",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "Il messaggio è stato trascritto. Attendi un attimo mentre avviso la persona che ha chiamato…",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Este mensaje se ha transcrito. Espera un momento mientras aviso a quien te ha llamado…",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "To sporočilo je bilo prepisano. Počakajte trenutek, da obvestim klicatelja …",
        "filename" : "Localizable.loctable",
        "language" : "sl"
      },
      {
        "target" : "Diese Nachricht wurde transkribiert. Einen Moment, die anrufende Person wird benachrichtigt …",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "Створено стенограму цього повідомлення. Зачекайте, поки я повідомлю абоненту…",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "此訊息已經轉寫。請稍候，我正在通知來電者⋯",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Ce message a été transcrit. Veuillez patienter le temps de prévenir l’appelant…",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "このメッセージは文字起こしされました。発信者に通知を送信中です。お待ちください…",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "Se transcribió este mensaje. Espera un momento mientras aviso a quien te llamó…",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Esta mensagem foi transcrita. Aguarde um momento enquanto notifico a pessoa que lhe ligou…",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Mesej ini telah ditranskripsikan. Tunggu sebentar sambil saya memaklumkan pemanggil…",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Dit bericht is getranscribeerd. Even geduld terwijl ik de beller informeer…",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "Tämä viesti on muunnettu tekstiksi. Odota hetki, kun soittajalle ilmoitetaan…",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "Ova je poruka transkribirana. Pričekajte trenutak dok obavijestim pozivatelja…",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "Det här meddelandet har transkriberats. Vänta lite medan jag meddelar uppringaren…",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "Esta mensagem foi transcrita. Um momento enquanto aviso a pessoa que ligou…",
        "filename" : "Localizable.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "This message has been transcribed. One moment while I notify the caller…",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "Ze zprávy byl vytvořen přepis. Okamžik počkejte, volající dostává oznámení…",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "Bu mesaj yazıya çevrildi. Arayan kişi bilgilendirilirken biraz bekleyin…",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "Acest mesaj a fost transcris. Așteptați un moment, anunț apelantul…",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "S’ha transcrit el missatge. Espera un moment mentre aviso l’altra persona…",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "Dostępna jest transkrypcja tej wiadomości. Powiadamiam dzwoniącego. Poczekaj chwilę…",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "이 메시지의 전사문이 생성되었습니다. 발신자에게 통지할 때까지 잠시만 기다려 주세요.",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Это сообщение расшифровано. Ожидайте, я уведомлю абонента, который Вас вызывал…",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "已轉錄此訊息。請稍等我通知來電人⋯",
        "filename" : "Localizable.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Denne besked blev transskriberet. Vent et øjeblik, mens jeg underretter personen, der ringede op…",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "Αυτό το μήνυμα έχει απομαγνητοφωνηθεί. Αποστολή γνωστοποίησης στον καλούντα…",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "Denne beskjeden er skrevet av. Et øyeblikk mens jeg varsler personen som ringer…",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "This message has been transcribed. One moment while I notify the caller…",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Erről az üzenetről átirat készült. Egy pillanat türelmét kérem, amíg értesítem a hívót…",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "此信息已转写。稍等，我通知来电者…",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Pesan ini telah ditranskripsi. Saya beri tahu dulu peneleponnya…",
        "filename" : "Localizable.loctable",
        "language" : "id"
      }
    ],
