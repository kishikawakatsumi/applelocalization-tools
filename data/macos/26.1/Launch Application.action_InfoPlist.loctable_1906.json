      },
      {
        "language" : "en_AU",
        "target" : "This action launches the chosen application. If the application is already running, it becomes active.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "hi",
        "target" : "यह क्रिया चुने गए ऐप्लिकेशन लॉन्च करती है। यदि ऐप्लिकेशन पहले से ही चल रहा है, तो वह सक्रिय हो जाता है।",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "fr",
        "target" : "Cette action lance l’application indiquée. Si cette dernière est déjà en cours d’exécution, elle est ramenée au premier plan.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "sk",
        "target" : "Táto akcia spustí vybranú aplikáciu. Ak je aplikácia spustená, stane sa aktívnou.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "he",
        "target" : "פעולה זו מפעילה את היישום הנבחר. אם היישום כבר פועל, הוא נעשה פעיל.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "vi",
        "target" : "Tác vụ này khởi chạy ứng dụng được chọn. Nếu ứng dụng đang chạy, ứng dụng sẽ trở thành đang hoạt động.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ar",
        "target" : "يقوم هذا الإجراء بتشغيل التطبيق الذي تم اختياره. إذا كان التطبيق قيد التشغيل بالفعل، فإنه يصبح نشطًا.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "it",
        "target" : "Questa azione avvia l’applicazione scelta. Se è già in esecuzione, diventa attiva.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "es",
        "target" : "Esta acción abre la aplicación seleccionada. Si dicha aplicación ya está abierta, pasará a estar activa.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "sl",
        "target" : "S tem dejanjem zaženete izbrano aplikacijo. Če se aplikacija že izvaja, postane aktivna.",
        "filename" : "InfoPlist.loctable"
      },
