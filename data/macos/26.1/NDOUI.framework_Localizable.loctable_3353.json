      {
        "language" : "en_AU",
        "filename" : "Localizable.loctable",
        "target" : "Go to Settings and sign in with your Apple Account to view eligibility of your devices."
      },
      {
        "language" : "hi",
        "filename" : "Localizable.loctable",
        "target" : "अपने डिवाइस की योग्यता देखने के लिए सेटिंग में जाएँ और अपने Apple खाते से साइन इन करें।"
      },
      {
        "language" : "fr",
        "filename" : "Localizable.loctable",
        "target" : "Accédez à Réglages et connectez-vous avec votre compte Apple pour vérifier l’éligibilité de vos appareils."
      },
      {
        "language" : "sk",
        "filename" : "Localizable.loctable",
        "target" : "Ak chcete zistiť, či vaše zariadenia majú nárok na krytie, prejdite do apky Nastavenia a prihláste sa použitím svojho Apple účtu."
      },
      {
        "language" : "he",
        "filename" : "Localizable.loctable",
        "target" : "יש לעבור ל״הגדרות״ ולהתחבר לחשבון ה-Apple כדי לבדוק את זכאות המכשירים שלך."
      },
      {
        "language" : "ar",
        "filename" : "Localizable.loctable",
        "target" : "انتقل إلى الإعدادات وسجِّل الدخول باستخدام حساب Apple لعرض أهلية أجهزتك."
      },
      {
        "language" : "vi",
        "filename" : "Localizable.loctable",
        "target" : "Đi tới Cài đặt và đăng nhập bằng Tài khoản Apple của bạn để xem khả năng đủ điều kiện của các thiết bị của bạn."
      },
      {
        "language" : "it",
        "filename" : "Localizable.loctable",
