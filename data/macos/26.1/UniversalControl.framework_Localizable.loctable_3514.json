      },
      {
        "language" : "ar",
        "filename" : "Localizable.loctable",
        "target" : "يرجى التأكد من وجود جهازك في مكان قريب ومن تشغيل Bluetooth و Wi‑Fi عليه."
      },
      {
        "language" : "vi",
        "filename" : "Localizable.loctable",
        "target" : "Đảm bảo thiết bị của bạn ở gần và đã được bật cả Bluetooth và Wi‑Fi."
