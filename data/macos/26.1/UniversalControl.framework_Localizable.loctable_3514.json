      {
        "language" : "en_AU",
        "filename" : "Localizable.loctable",
        "target" : "Ensure your device is nearby and has both Bluetooth and Wi‑Fi turned on."
      },
      {
        "language" : "hi",
        "filename" : "Localizable.loctable",
        "target" : "सुनिश्चित करें कि आपका डिवाइस आस-पास हो और उस पर Bluetooth और वाई‑फ़ाई दोनों चालू हो।"
      },
      {
