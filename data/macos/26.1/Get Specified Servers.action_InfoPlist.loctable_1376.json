      },
      {
        "target" : "This action passes the specified servers into the next action.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "यह क्रिया निर्दिष्ट सर्वरों को अगली क्रिया की ओर पास करती है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Cette action transmet les serveurs indiqués à l’action suivante.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "Táto akcia posunie špecifikované servery do nasledujúcej akcie.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "פעולה זו מעבירה את השרתים שצוינו לפעולה הבאה.",
        "filename" : "InfoPlist.loctable",
        "language" : "he"
      },
      {
        "target" : "يقوم هذا الإجراء بتمرير الخوادم التي تم اختيارها إلى الإجراء التالي.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Tác vụ này chuyển các máy chủ được chỉ định vào tác vụ tiếp theo.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Questa azione passa i server specificati all’azione successiva.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Esta acción deriva los servidores especificados a la siguiente acción.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "S tem dejanjem posredujete navedene strežnike v naslednje dejanje.",
        "filename" : "InfoPlist.loctable",
        "language" : "sl"
      },
      {
        "target" : "Bei dieser Aktion werden die angegebenen Server an die nächste Aktion übergeben.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "Ця дія передає зазначені сервери наступній дії.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "此動作會將指定的伺服器傳遞到下一個動作。",
