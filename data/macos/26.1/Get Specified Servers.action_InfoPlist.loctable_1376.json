        "language" : "zh_HK"
      },
      {
        "target" : "Cette action transmet les serveurs indiqués à l’action suivante.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "指定したサーバを次のアクションに渡します。",
