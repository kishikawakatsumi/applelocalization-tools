      },
      {
        "filename" : "GreenfieldMac.loctable",
        "target" : "You can add this Apple Watch face to your My Faces gallery on your iPhone.",
        "language" : "en_AU"
      },
      {
        "filename" : "GreenfieldMac.loctable",
        "target" : "आप अपने iPhone पर अपनी “मेरे फ़ेस” गैलरी में यह Apple Watch फ़ेस जोड़ सकते हैं।",
        "language" : "hi"
      },
      {
        "filename" : "GreenfieldMac.loctable",
