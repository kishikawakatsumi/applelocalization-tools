      },
      {
        "filename" : "GreenfieldMac.loctable",
        "target" : "Tento ciferník pre Apple Watch môžete pridať do galérie Moje ciferníky na iPhone.",
        "language" : "sk"
      },
      {
        "filename" : "GreenfieldMac.loctable",
