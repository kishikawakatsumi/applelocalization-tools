    "AMDSummary" : [
      {
        "target" : "การทำงานนี้ส่งต่อข้อความ RTFD ที่ระบุไปยังการทำงานถัดไป",
        "language" : "th",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "This action passes the specified RTFD text into the next action.",
        "language" : "en_AU",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "यह क्रिया RTFD टेक्स्ट को अगली क्रिया की ओर पास करती है।",
        "language" : "hi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Cette action transmet à l’action suivante le texte RTFD indiqué.",
        "language" : "fr",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Táto akcia posunie špecifikovaný RTFD text do nasledujúcej akcie.",
        "language" : "sk",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "פעולה זו מעבירה את מלל ה-RTFD שצוין לפעולה הבאה.",
        "language" : "he",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "يقوم هذا الإجراء بتمرير نص RTFD الذي تم اختياره إلى الإجراء التالي.",
        "language" : "ar",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Tác vụ này chuyển văn bản RTFD được chỉ định vào tác vụ tiếp theo.",
        "language" : "vi",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Questa azione passa il testo RTFD specificato all’azione successiva.",
        "language" : "it",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Esta acción deriva el texto RTFD especificado a la siguiente acción.",
        "language" : "es",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "S tem dejanjem posredujete navedeno besedilo RTFD v naslednje dejanje.",
        "language" : "sl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Bei dieser Aktion wird der angegebene RTFD-Text an die nächste Aktion übergeben.",
        "language" : "de",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Ця дія передає наданий текст RTFD наступній дії.",
        "language" : "uk",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "此動作會將指定的RTFD文字傳遞到下一個動作中。",
        "language" : "zh_HK",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Cette action transmet à l’action suivante le texte RTFD indiqué.",
