    "DCQ-sm-WuW.title" : [
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "การกำหนดไทม์โซนพร้อมแล้วที่จะอัปเดตและจะติดตั้งในครั้งถัดไปเมื่อเริ่มการทำงานเครื่องใหม่",
        "language" : "th"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Updated time zone definitions are available and will be installed at the next restart.",
        "language" : "en_AU"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "अपडेटेड समय क्षेत्र परिभाषाएँ उपलब्ध हैं और अगली बार रीस्टार्ट होने पर ये इंस्टॉल हो जाएँगी।",
        "language" : "hi"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "De nouvelles définitions de fuseaux horaires sont disponibles et seront installées au prochain redémarrage.",
        "language" : "fr"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Aktualizované definície časového pásma sú dostupné a budú nainštalované po najbližšom reštarte.",
        "language" : "sk"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "יש עדכון זמין עבור שעונים מקומיים. הוא יותקן בהפעלה מחדש הבאה.",
        "language" : "he"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "تعريفات المنطقة الزمنية المُحدّثة متوفرة، وسيتم تثبيتها عند إعادة التشغيل في المرة القادمة.",
        "language" : "ar"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Định nghĩa múi giờ đã cập nhật có sẵn và sẽ được cài đặt trong lần khởi động lại tiếp theo.",
        "language" : "vi"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Sono disponibili delle definizioni di fuso orario aggiornate e verranno installate al prossimo riavvio.",
        "language" : "it"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Hay actualizaciones de las definiciones de las zonas horarias que se instalarán durante el siguiente reinicio.",
        "language" : "es"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Posodobljene definicije časovnih pasov so na voljo in bodo nameščene pri naslednjem ponovnem zagonu.",
        "language" : "sl"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Die Zeitzonendefinitionen wurden aktualisiert und werden nach dem nächsten Neustart installiert.",
        "language" : "de"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Доступні оновлені значення часових поясів. Їх буде інстальовано після наступного перезапуску.",
        "language" : "uk"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "有更新的時區定義可用，將於下次重新開機時安裝。",
        "language" : "zh_HK"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "De nouvelles définitions de fuseaux horaires sont disponibles et seront installées au prochain redémarrage.",
        "language" : "fr_CA"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "時間帯の定義がアップデートされています。次に再起動するときにインストールされます。",
        "language" : "ja"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Las definiciones actualizadas de zona horaria están disponibles y se instalarán la próxima vez que se reinicie.",
        "language" : "es_419"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "As definições atualizadas do fuso horário serão instaladas da próxima vez que reiniciar o computador.",
        "language" : "pt_PT"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Definisi zon waktu yang dikemas kini tersedia dan akan dipasang pada mula semula kali seterusnya.",
        "language" : "ms"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Er zijn bijgewerkte tijdzonedefinities beschikbaar die bij de volgende herstart worden geïnstalleerd.",
        "language" : "nl"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Päivitetyt aikavyöhykemääritykset ovat saatavilla ja ne asennetaan, kun seuraavan kerran käynnistetään uudelleen.",
        "language" : "fi"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Dostupne su nove definicije vremenske zone i instalirat će se na sljedećem uključivanju.",
        "language" : "hr"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Det finns uppdaterade tidszonsdefinitioner som kommer att installeras nästa gång du startar om.",
        "language" : "sv"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Definições de fuso horário atualizadas estão disponíveis e serão instaladas no próximo reinício.",
        "language" : "pt_BR"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Jsou k dispozici aktualizované definice časového pásma. Budou nainstalovány při nejbližším restartu.",
        "language" : "cs"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Güncellenmiş saat dilimi tanımları var ve bunlar yeniden başlatıldıktan sonra yüklenir.",
        "language" : "tr"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Sunt disponibile definiții actualizate de fus orar, care vor fi instalate la următoarea repornire.",
        "language" : "ro"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Hi ha actualitzacions disponibles de les definicions de les zones horàries, que s’instal·laran la propera vegada que reiniciïs.",
        "language" : "ca"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Διατίθενται ενημερωμένοι ορισμοί ζώνης ώρας και θα εγκατασταθούν στην επόμενη επανεκκίνηση.",
        "language" : "el"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Dostępne są uaktualnione definicje stref czasowych. Zostaną zainstalowane przy ponownym uruchomieniu.",
        "language" : "pl"
      },
      {
        "filename" : "TimeZonePref.loctable",
        "target" : "Доступны обновленные данные часовых поясов. Они будут установлены при следующей перезагрузке.",
