    "69.title" : [
      {
        "target" : "เคล็ดลับ: ใช้ปุ่ม Control หรือปุ่มเมาส์ด้านขวาเพื่อวาดเส้นโค้ง",
        "language" : "th",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Hint: use the Control key or right mouse button to draw a curve.",
        "language" : "en_AU",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "संकेत : वक्र ड्रॉ करने के लिए कंट्रोल-की या माउस के राइट बटन का उपयोग करें।",
        "language" : "hi",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Astuce : utilisez la touche Contrôle ou le bouton droit de la souris pour dessiner une courbe.",
        "language" : "fr",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Pomôcka: Pomocou klávesu Control alebo pravého tlačidla myši môžete kresliť krivku.",
        "language" : "sk",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "רמז: יש להשתמש במקש Control או בכפתור העכבר הימני כדי לצייר עקומה.",
        "language" : "he",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "تلميح: استخدم مفتاح Control أو زر الماوس الأيمن لرسم منحنى.",
        "language" : "ar",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Gợi ý: Sử dụng phím Control hoặc nút chuột phải để vẽ đường cong.",
        "language" : "vi",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Suggerimento: usa il tasto ctrl o il pulsante destro del mouse per disegnare una curva.",
        "language" : "it",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Indicación: Usa la tecla Control o el botón derecho del ratón para trazar una curva.",
        "language" : "es",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Namig: za izris krivulje uporabite tipko Control ali desni gumb miške.",
        "language" : "sl",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Hinweis: Zum Zeichnen einer Kurve die Control-Taste oder die rechte Maustaste verwenden.",
        "language" : "de",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Підказка: скористайтеся клавішею Control або правою кнопкою миші, щоб рисувати криву.",
        "language" : "uk",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "提示：使用Control鍵或右側滑鼠按鈕來繪製弧線。",
        "language" : "zh_HK",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "Astuce : Utilisez la touche Ctrl ou le clic droit pour dessiner une courbe.",
        "language" : "fr_CA",
        "filename" : "AppleGraphicEQ.loctable"
      },
      {
        "target" : "ヒント: カーブを描くように設定するには、Controlキーかマウスの右ボタンを使います。",
