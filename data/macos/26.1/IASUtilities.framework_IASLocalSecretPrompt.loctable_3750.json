    "adM-VM-fDq.title" : [
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "th",
        "target" : "iCloud ต้องการเปลี่ยนแปลงบัญชีของคุณ ป้อนรหัสผ่านของคุณเพื่ออนุญาต"
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "en_AU",
        "target" : "iCloud wants to make changes to your account. Type your password to allow this."
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "hi",
        "target" : "iCloud आपके खाते में परिवर्तन करना चाहता है। इसकी अनुमति देने के लिए अपना पासवर्ड दर्ज करें।"
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "fr",
        "target" : "iCloud veut apporter des modifications à votre compte. Saisissez votre mot de passe pour autoriser cette opération."
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "sk",
        "target" : "iCloud chce vykonať zmeny vo vašom účte. Ak to chcete povoliť, zadajte svoje heslo."
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "he",
        "target" : "‏iCloud מעוניין לבצע שינויים בחשבון שלך. יש להקליד את הסיסמה כדי לאפשר זאת."
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "ar",
