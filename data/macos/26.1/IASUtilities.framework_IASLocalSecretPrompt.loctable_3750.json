      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
        "language" : "vi",
        "target" : "iCloud muốn thực hiện thay đổi đối với tài khoản của bạn. Hãy nhập mật khẩu của bạn để cho phép việc này."
      },
      {
        "filename" : "IASLocalSecretPrompt.loctable",
