    "aZV-VI-hFG.title" : [
      {
        "target" : "ต้องใช้แทร็คแพดหรือกล้องเพื่อสร้างลายเซ็น",
        "language" : "th",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "A trackpad or camera is required to create a signature.",
        "language" : "en_AU",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "हस्ताक्षर बनाने के लिए ट्रैकपैड या कैमरा चाहिए।",
        "language" : "hi",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Un trackpad ou une caméra sont requis pour créer une signature.",
        "language" : "fr",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Na vytvorenie podpisu sa vyžaduje trackpad alebo kamera.",
        "language" : "sk",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "כדי ליצור חתימה, יש צורך במשטח מגע או במצלמה.",
        "language" : "he",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "مطلوب لوحة تعقب أو كاميرا لإنشاء التوقيع.",
        "language" : "ar",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Cần có bàn di chuột hoặc camera để tạo chữ ký.",
        "language" : "vi",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Per creare una firma, è necessario un trackpad o una fotocamera.",
        "language" : "it",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Para crear una firma, se necesita un trackpad o una cámara.",
        "language" : "es",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Za ustvarjanje podpisa je zahtevana sledilna ploščica ali kamera.",
        "language" : "sl",
        "filename" : "AKSignaturesView.loctable"
      },
      {
        "target" : "Zum Erstellen einer Unterschrift ist ein Trackpad oder eine Kamera erforderlich.",
        "language" : "de",
        "filename" : "AKSignaturesView.loctable"
      },
