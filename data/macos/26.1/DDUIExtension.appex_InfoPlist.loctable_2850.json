  "localizations" : {
    "NSContactsUsageDescription" : [
      {
        "filename" : "InfoPlist.loctable",
        "language" : "th",
        "target" : "ใช้รูปภาพของรายชื่อของคุณเพื่อแสดงไอคอนสำหรับผู้คนที่อยู่ใกล้เคียง"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU",
        "target" : "Uses your contact images in order to display icons for people who are nearby"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "hi",
        "target" : "आसपास मौजूद लोगों के लिए आइकॉन प्रदर्शित करने के लिए आपकी संपर्क इमेज का इस्तेमाल करता है"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "fr",
        "target" : "Utilise les photos de vos contacts pour afficher des icônes correspondant aux personnes à proximité."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sk",
        "target" : "Obrázky vašich kontaktov sa používajú na zobrazovanie ikon ľudí vo vašom okolí"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "he",
        "target" : "הגדרה זו משתמשת בתמונות אנשי הקשר שלך כדי להציג אייקונים של אנשים שנמצאים בסביבה"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "vi",
        "target" : "Sử dụng hình ảnh liên hệ của bạn để hiển thị biểu tượng cho những người ở gần"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ar",
        "target" : "استخدام صور جهات الاتصال لديك لعرض أيقونات للأشخاص القريبين"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "it",
        "target" : "Usa le immagini dei tuoi contatti per visualizzare le icone delle persone nelle vicinanze."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "es",
        "target" : "Usa las imágenes de tus contactos para ver los iconos de las personas que están cerca."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sl",
        "target" : "Uporablja slike vaših stikov, da bi se prikazale ikone za osebe, ki so v bližini"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "de",
        "target" : "Verwendet deine Kontaktbilder, um Symbole für Personen in der Nähe anzuzeigen."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "uk",
        "target" : "Ваші зображення контактів використовуються для іконок людей, що перебувають поблизу"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK",
        "target" : "使用你的聯絡人影像來顯示附近人物的圖像"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA",
        "target" : "Utilisez les images de vos contacts pour afficher les icônes des personnes qui se trouvent à proximité."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ja",
        "target" : "近くの人のアイコンを表示するために、連絡先の画像を使用します"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "es_419",
        "target" : "Usa las imágenes de tus contactos para mostrar íconos de las personas que están cerca."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT",
        "target" : "Usa as imagens dos seus contactos para mostrar ícones das pessoas que se encontram por perto."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ms",
        "target" : "Menggunakan imej kenalan anda untuk memaparkan ikon bagi orang yang berada berdekatan"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "nl",
        "target" : "Gebruikt je contactafbeeldingen om symbolen weer te geven van personen in de buurt"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "fi",
        "target" : "Näyttää yhteystietojen kuvien avulla kuvakkeet henkilöistä, jotka ovat lähellä"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "hr",
        "target" : "Koristi vaše slike kontakta za prikazivanje ikona osobama u blizini"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sv",
        "target" : "Använder dina kontaktbilder till att visa symboler för personer som är i närheten"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "es_US",
        "target" : "Usa las imágenes de tus contactos para mostrar íconos de las personas que están cerca."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "pt_BR",
        "target" : "Usa suas imagens de contato para exibir ícones para as pessoas que estão por perto"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "cs",
        "target" : "Využívá obrázky kontaktů pro zobrazování ikon lidí, kteří se nacházejí poblíž"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "tr",
        "target" : "Yakındaki kişilerin simgelerini görüntülemek için kişilerinizin görüntülerini kullanır"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ro",
        "target" : "Utilizează imaginile contactelor pentru a afișa pictograme pentru persoanele care se află în apropiere"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ca",
        "target" : "Utilitza les imatges dels contactes per mostrar icones de les persones que són a prop."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "el",
        "target" : "Χρησιμοποιεί τις εικόνες των επαφών σας για εμφάνιση εικονιδίων των ατόμων που βρίσκονται κοντά"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ko",
        "target" : "근처에 있는 사람들의 아이콘을 표시하기 위해 사용자의 연락처 이미지를 사용합니다."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ru",
        "target" : "Использует изображения контактов, чтобы отображать значки людей, находящихся рядом"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "zh_TW",
        "target" : "使用你的聯絡人影像來顯示附近聯絡人的圖像"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "da",
        "target" : "Bruger dine kontaktbilleder til at vise symboler for personer, der er i nærheden"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "pl",
        "target" : "Zdjęcia Twoich kontaktów są używane do wyświetlania ikon pobliskich osób"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN",
