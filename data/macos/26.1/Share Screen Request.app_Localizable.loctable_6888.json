{
  "bundlePath" : "\/System\/Library\/CoreServices\/RemoteManagement\/AppleVNCServer.bundle\/Contents\/Support\/Share Screen Request.app",
  "framework" : "Share Screen Request.app",
  "loctablePath" : "\/System\/Library\/CoreServices\/RemoteManagement\/AppleVNCServer.bundle\/Contents\/Support\/Share Screen Request.app\/Contents\/Resources\/Localizable.loctable",
  "localizations" : {
    "observeRequestUnknown" : [
      {
        "target" : "ผู้ใช้ทั่วไปที่เชื่อมต่อจากที่อยู่ %@ กำลังขออนุญาตสังเกตการณ์หน้าจอของคุณ\r\rคลิกแชร์หน้าจอต่อเมื่อคุณแน่ใจว่าคุณรู้จักคนนี้",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "A guest user connecting from address %@ is requesting permission to observe your screen.\r\rClick Share Screen only if you are sure you know this person.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "%@ पते से जुड़ा गेस्ट यूज़र आपकी स्क्रीन देखने की अनुमति माँग रहा है।\n\n\"स्क्रीन शेयर करें\" पर केवल तभी क्लिक करें जब आप निश्चित हों कि आप इस व्यक्ति को जानते हैं।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "Un utilisateur invité se connectant avec l’adresse « %@ » demande l’autorisation d’observer votre écran.\r\rNe cliquez sur Partage d’écran que si vous connaissez cette personne.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Hosťovský užívateľ, ktorý sa pripája z adresy %@, žiada o povolenie pozorovať vašu obrazovku.\r\rNa položku Zdieľať obrazovku kliknite, len ak ste si istí, že daného užívateľa poznáte.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "משתמש אורח שמתחבר מהכתובת %@ מבקש הרשאה לצפות במסך שלך.\n\nיש ללחוץ על ״שיתוף המסך״ רק אם אין לך ספק כי אדם זה מוכר לך.",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "يطلب مستخدم ضيف متصل من العنوان %@ الإذن بمراقبة شاشتك.\r\rلا تنقر على مشاركة الشاشة إلا إذا كنت متأكدًا من معرفتك لهذا الشخص.",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "Một người dùng khách kết nối từ địa chỉ %@ đang yêu cầu quyền quan sát màn hình của bạn.\r\rChỉ bấm Chia sẻ màn hình nếu bạn chắc chắn biết người này.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Un utente ospite, in collegamento da %@, chiede il permesso di osservare il tuo schermo.\r\rFai clic su “Condividi schermo” solo se puoi confermare l’identità di questa persona.",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Un usuario invitado que se está conectando desde la dirección %@ solicita permiso para observar tu pantalla.\n\nHaz clic en “Compartir pantalla” solo si tienes la certeza de que conoces a esta persona.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "Gostujoči uporabnik, ki se povezuje z naslova %@, zahteva dovoljenje za opazovanje vašega zaslona.\n\nGumb Deli zaslon kliknite samo, če zagotovo poznate to osebo.",
        "filename" : "Localizable.loctable",
        "language" : "sl"
      },
      {
        "target" : "Ein Gast mit der Adresse %@ bittet um Erlaubnis, deinen Bildschirm zu beobachten.\r\rKlicke nur dann auf „Bildschirmfreigabe“, wenn du sicher bist, dass du diese Person kennst.",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "Гість за адресою %@ просить дозволу спостерігати за вашим екраном.\r\rНатисніть «Надати доступ», якщо ви знаєте цю людину.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "從「%@」地址連線的訪客用户要求權限來監看你的螢幕。\r\r只有在確定對方身份的情況下才可按下「共享螢幕」。",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Un utilisateur invité se connectant avec l’adresse « %@ » demande l’autorisation d’observer votre écran.\r\rNe cliquez sur Partage d’écran que si vous connaissez cette personne.",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "アドレス%@から接続しているゲストユーザが、あなたの画面を監視する権限を要求しています。\r\rこのユーザを知っている場合にのみ、“画面を共有”をクリックしてください。",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "Un usuario invitado conectado desde la dirección %@ está solicitando permiso para ver tu pantalla.\n\nHaz clic en Compartir pantalla sólo si conoces a esta persona.",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Um utilizador convidado, que está a estabelecer ligação a partir do endereço %@, pediu autorização para ver o seu ecrã.\r\rSó deve clicar em Partilhar ecrã se conhecer este utilizador.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Pengguna tetamu yang bersambung dari alamat %@ meminta keizinan untuk memerhatikan skrin anda.\r\rKlik Kongsi Skrin hanya jika anda pasti mengenali orang ini.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Een gastgebruiker die verbinding maakt vanaf het adres %@ vraagt toestemming om je scherm te observeren.\r\rKlik alleen op 'Deel scherm' als je zeker weet dat je deze persoon kent.",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "Osoitteesta %@ vieraileva käyttäjä pyytää lupaa tarkkailla näyttöäsi.\r\rKlikkaa ”Jaa näyttö” vain, jos olet varma, että tunnet tämän henkilön.",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "Korisnik gost koji se spaja s adrese %@ traži dopuštenje za gledanje vašeg zaslona.\r\rKliknite na Dijeli zaslon samo ako ste sigurni da poznajete ovu osobu.",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "En gästanvändare på adressen %@ ber om tillstånd att observera din skärm.\r\rKlicka inte på Dela skärm om du inte är säker på att du vet vem den här personen är.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "A guest user connecting from address %@ is requesting permission to observe your screen.\r\rClick Share Screen only if you are sure you know this person.",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "Um usuário convidado, conectando a partir do endereço %@, está solicitando permissão para observar a sua tela.\r\rClique em Compartilhar Tela apenas se tiver certeza de que conhece essa pessoa.",
        "filename" : "Localizable.loctable",
        "language" : "pt"
      },
      {
        "target" : "Host připojující se z adresy %@ žádá o povolení ke sledování vaší obrazovky.\r\rNa volbu Sdílet obrazovku klikněte pouze v případě, že tuto osobu znáte.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "%@ adresinden bağlanan konuk kullanıcı ekranınızı izleme izni istiyor.\r\rYalnızca bu kişiyi tanıdığınızdan eminseniz Ekranı Paylaş’ı tıklayın.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "Un utilizator vizitator care se conectează de la adresa %@ solicită permisiunea să observe ecranul dvs.&#13;&#13;Faceți clic pe Partajați ecranul doar în cazul în care cunoașteți cu certitudine această persoană.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Un usuari convidat connectat des de l’adreça %@ està demanant permís per observar la teva pantalla.&#13;&#13;Fes clic a “Comparteix la pantalla” només si saps qui és.",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "Κάποιος επισκέπτης-χρήστης που είναι συνδεδεμένος από τη διεύθυνση %@ ζητά άδεια για παρατήρηση της οθόνης σας.\n\nΚάντε κλικ στην επιλογή «Κοινή χρήση οθόνης» μόνο αν γνωρίζετε σίγουρα αυτό το άτομο.",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "%@ 주소에서 연결 중인 방문 사용자가 사용자의 화면을 볼 수 있는 권한을 요청했습니다.\r\r이 사람이 누구인지 아는 경우에만 화면 공유를 클릭하십시오.",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Użytkownik-gość używający adresu %@ prosi o pozwolenie na oglądanie Twojego ekranu.\r\rKliknij w Udostępnij ekran, jeśli na pewno znasz tę osobę.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "從位址%@連線的訪客使用者要求權限來監看你的螢幕。\n\n只有在確定對方身分的情況下才可按下「共享螢幕」。",
        "filename" : "Localizable.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Гость с адресом %@ запрашивает разрешение на просмотр Вашего экрана.&#13;&#13;Нажмите «Общий экран», только если Вы знаете этого человека.",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "En gæst fra adressen %@ beder om tilladelse til at observere din skærm.\r\rKlik kun på Del skærm, hvis du er sikker på, at du kender personen.",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "En gjestebruker som er koblet til fra adressen %@, ber om tillatelse til å se på skjermen din.\r\rKlikk på Del skjerm kun hvis du er sikker på at du kjenner denne personen.",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "A guest user connecting from address %@ is requesting permission to observe your screen.\r\rClick Share Screen only if you are sure you know this person.",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "从地址“%@”连接的客人用户正请求权限来观察你的屏幕。\n\n只有在你认识此人的情况下，才点按“共享屏幕”。",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "A(z) %@ címről csatlakozó vendégfelhasználó engedélyt kér, hogy megfigyelhesse az Ön képernyőjét.\r\rCsak akkor kattintson a Képernyő megosztása gombra, ha biztosan ismeri ezt a személyt.",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "Pengguna tamu yang terhubung dari alamat %@ meminta izin untuk mengamati layar Anda.\r\rKlik Berbagi Layar hanya jika Anda yakin Anda mengenal orang ini.",
        "filename" : "Localizable.loctable",
        "language" : "id"
      }
    ],
