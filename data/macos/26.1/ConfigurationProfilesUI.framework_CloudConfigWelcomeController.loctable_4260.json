    "iZf-ag-EU5.title" : [
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "ต้องใช้การจัดการอุปกรณ์ซึ่งจะช่วยให้องค์กรนี้สามารถตั้งค่าบัญชีอีเมลและเครือข่าย ติดตั้งและกำหนดค่าแอป และจัดการการตั้งค่าของ Mac เครื่องนี้ได้",
        "language" : "th"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Device management is required and will allow this organisation to set up email and network accounts, install and configure apps, and manage the settings of this Mac.",
        "language" : "en_AU"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "डिवाइस प्रबंधन आवश्यक है और इस संगठन को ईमेल और नेटवर्क खाते सेटअप करने, ऐप्स इंस्टॉल और कॉन्फ़िगर करने और इस Mac की सेटिंग प्रबंधित करने की अनुमति देता है।",
        "language" : "hi"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "La gestion de l’appareil est requise et permettra à cette organisation de configurer des comptes de messagerie et de réseau, d’installer et de configurer des apps, et de gérer les réglages de ce Mac.",
        "language" : "fr"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Vyžaduje sa správa zariadenia, ktorá tejto organizácii umožní nastaviť emailové a sieťové účty, inštalovať a konfigurovať apky a spravovať nastavenia tohto Macu.",
        "language" : "sk"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "נדרש רישום ל״ניהול מכשירים״, שיאפשר לארגון זה להגדיר את חשבונות הדוא״ל והרשת, להתקין ולהגדיר יישומים ולנהל את ההגדרות של Mac זה.",
        "language" : "he"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "مطلوب إدارة الأجهزة حيث تسمح لهذه المؤسسة بإعداد حسابات البريد الإلكتروني والشبكة، وتثبيت التطبيقات وتكوينها، وإدارة إعدادات هذا الـ Mac.",
        "language" : "ar"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Quản lý thiết bị là bắt buộc và sẽ cho phép tổ chức này thiết lập các tài khoản email và tài khoản mạng, cài đặt và định cấu hình các ứng dụng, cũng như quản lý các cài đặt của máy Mac này.",
        "language" : "vi"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "La gestione dei dispositivi è richiesta e consentirà all’organizzazione di configurare gli account di posta elettronica e di rete, di installare e configurare le app e di gestire le impostazioni del Mac.",
        "language" : "it"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Se requiere la gestión de dispositivos para que esta organización pueda configurar cuentas de correo electrónico y de red, instalar y configurar apps, y gestionar los ajustes de este Mac.",
        "language" : "es"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Zahtevano je upravljanje naprave. Z njim bo ta organizacija lahko nastavila e-poštne in omrežne račune, namestila in konfigurirala aplikacije ter upravljala nastavitve tega Maca.",
        "language" : "sl"
      },
      {
        "filename" : "CloudConfigWelcomeController.loctable",
        "target" : "Die Geräteverwaltung ist erforderlich und erlaubt es dieser Organisation, E‑Mail- und Netzwerkaccounts zu konfigurieren, Apps zu installieren und zu konfigurieren sowie die Einstellungen dieses Mac zu verwalten.",
        "language" : "de"
      },
