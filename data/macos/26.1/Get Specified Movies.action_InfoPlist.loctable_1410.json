  "localizations" : {
    "AMDSummary" : [
      {
        "target" : "การทำงานนี้ส่งต่อภาพยนตร์ที่ระบุไปยังการทำงานถัดไป",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "target" : "This action passes the specified movies into the next action.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "यह क्रिया निर्दिष्ट फ़िल्मों को अगली क्रिया की ओर पास करती है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Cette action transmet les séquences indiquées à l’action suivante.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "Táto akcia posunie špecifikované filmy do nasledujúcej akcie.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "פעולה זו מעבירה את הסרטים שצוינו לפעולה הבאה.",
        "filename" : "InfoPlist.loctable",
        "language" : "he"
      },
      {
        "target" : "يقوم هذا الإجراء بتمرير الأفلام التي تم اختيارها إلى الإجراء التالي.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Tác vụ này chuyển các phim được chỉ định vào tác vụ tiếp theo.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Questa azione passa i filmati specificati all’azione successiva.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Esta acción deriva los vídeos especificados a la siguiente acción.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "S tem dejanjem posredujete navedene filme v naslednje dejanje.",
        "filename" : "InfoPlist.loctable",
        "language" : "sl"
      },
      {
        "target" : "Bei dieser Aktion werden die angegebenen Filme an die nächste Aktion übergeben.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "Ця дія передає зазначені фільми наступній дії.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "此動作會將指定的影片傳遞到下一個動作。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Cette action transmet les vidéos indiquées à l’action suivante.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "指定したムービーを次のアクションに渡します。",
