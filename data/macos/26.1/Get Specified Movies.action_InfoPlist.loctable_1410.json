      },
      {
        "target" : "Aquesta acció transfereix els vídeos especificats a l’acció següent.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "Με αυτήν την ενέργεια, διαβιβάζονται οι καθορισμένες ταινίες στην επόμενη ενέργεια.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "이 동작은 지정된 동영상을 다음 동작으로 보냅니다.",
