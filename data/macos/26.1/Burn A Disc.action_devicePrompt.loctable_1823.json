    "100007.title" : [
      {
        "filename" : "devicePrompt.loctable",
        "language" : "th",
        "target" : "อุปกรณ์ที่คุณเลือกหาไม่พบ โปรดเลือกอุปกรณ์อื่น:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "en_AU",
        "target" : "The device you selected cannot be found, please choose another device:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "hi",
        "target" : "आपके द्वारा चयनित डिवाइस नहीं मिल सकता है, कृपया अन्य डिवाइस चुनें :"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "fr",
        "target" : "Le périphérique sélectionné est introuvable, veuillez en choisir un autre :"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "sk",
        "target" : "Vybrané zariadenie sa nenašlo. Vyberte iné zariadenie:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "he",
        "target" : "המכשיר שבחרת לא נמצא. נא לבחור מכשיר אחר:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "ar",
        "target" : "يتعذر العثور على الجهاز الذي قمت بتحديده، الرجاء اختيار جهاز آخر:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "vi",
        "target" : "Không tìm thấy thiết bị bạn đã chọn, hãy chọn thiết bị khác:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "it",
        "target" : "Non trovo il dispositivo selezionato, scegli un altro dispositivo:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "es",
        "target" : "No se ha podido encontrar el dispositivo seleccionado. Selecciona otro:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "sl",
        "target" : "Naprave, ki ste jo izbrali, ni mogoče najti. Izberite drugo napravo:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "de",
        "target" : "Das von dir ausgewählte Gerät wurde nicht gefunden. Bitte wähle ein anderes Gerät:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "uk",
        "target" : "Вибраний пристрій не вдалося знайти, виберіть інший пристрій:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "zh_HK",
        "target" : "無法找到你選擇的裝置，請選擇其他裝置："
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "fr_CA",
        "target" : "L’appareil sélectionné est introuvable, veuillez en choisir un autre :"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "ja",
        "target" : "選択した装置が見つかりませんでした。別の装置を選択してください:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "es_419",
        "target" : "No se pudo encontrar el dispositivo seleccionado. Selecciona otro:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "pt_PT",
        "target" : "O dispositivo selecionado não foi localizado. Selecione outro dispositivo:"
