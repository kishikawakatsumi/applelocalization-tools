      {
        "filename" : "devicePrompt.loctable",
        "language" : "ca",
        "target" : "No s’ha trobat el dispositiu que has seleccionat, selecciona’n un altre:"
      },
      {
        "filename" : "devicePrompt.loctable",
        "language" : "el",
        "target" : "Δεν βρέθηκε η συσκευή που επιλέξατε, επιλέξτε άλλη συσκευή:"
