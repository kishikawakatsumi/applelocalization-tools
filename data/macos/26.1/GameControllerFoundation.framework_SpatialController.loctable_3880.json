    "NOTIFY_SPATIAL_CONTROLLER_HS_MESSAGE" : [
      {
        "target" : "ตรวจสอบให้แน่ใจว่าพื้นที่ของคุณไม่มีสิ่งกีดขวาง และระวังคนหรือสัตว์เลี้ยงอื่นๆ ในระหว่างใช้อุปกรณ์ควบคุม",
        "filename" : "SpatialController.loctable",
        "language" : "th"
      },
      {
        "target" : "Ensure your space is clear of any obstacles, and be aware of any other people or pets while using controllers.",
        "filename" : "SpatialController.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "सुनिश्चित करें कि आपकी जगह में कोई बाधा नहीं है और कंट्रोलर का इस्तेमाल करते समय अन्य लोगों या पालतू जानवरों के बारे में सावधान रहें।",
        "filename" : "SpatialController.loctable",
        "language" : "hi"
      },
      {
        "target" : "Assurez-vous que votre espace est dégagé de tout obstacle, et faites attention aux autres personnes et aux animaux domestiques lorsque vous utilisez les manettes.",
        "filename" : "SpatialController.loctable",
        "language" : "fr"
      },
      {
        "target" : "Počas používania ovládača sa uistite, že v priestore okolo vás nie sú žiadne prekážky, a dávajte pozor na ostatných ľudí a zvieratá.",
        "filename" : "SpatialController.loctable",
        "language" : "sk"
      },
      {
        "target" : "יש לוודא שלא קיימים מכשולים בחלל שמסביבך ולהקפיד לשמור על מרחק מאנשים אחרים או מחיות מחמד בעת השימוש בשלטים.",
        "filename" : "SpatialController.loctable",
        "language" : "he"
      },
      {
        "target" : "تأكد أن مساحتك خالية من أي عوائق، وخذ حذرك من أي أشخاص آخرين أو حيوانات أليفة أثناء استخدام أجهزة التحكم.",
        "filename" : "SpatialController.loctable",
        "language" : "ar"
      },
      {
        "target" : "Đảm bảo rằng không gian của bạn không có chướng ngại vật, cũng như để ý đến người khác hoặc thú cưng khi sử dụng bộ điều khiển.",
        "filename" : "SpatialController.loctable",
        "language" : "vi"
      },
      {
        "target" : "Assicurati che lo spazio circostante sia libero da ostacoli e fai attenzione a persone o animali domestici mentre usi i controller.",
        "filename" : "SpatialController.loctable",
        "language" : "it"
      },
      {
        "target" : "Asegúrate de que no haya obstáculos a tu alrededor y ten cuidado si usas los mandos en compañía de otras personas o mascotas.",
        "filename" : "SpatialController.loctable",
        "language" : "es"
      },
      {
        "target" : "Prepričajte se, da okoli vas ni nobenih ovir, in pri uporabi kontrolerjev pazite na druge osebe ali hišne ljubljenčke.",
        "filename" : "SpatialController.loctable",
        "language" : "sl"
      },
      {
        "target" : "Stelle sicher, dass sich in deinem Raum keine Hindernisse befinden, und achte während der Benutzung der Controller auf Personen und Haustiere.",
        "filename" : "SpatialController.loctable",
        "language" : "de"
      },
      {
        "target" : "Перевіряйте, чи немає навколо перешкод, і звертайте увагу на появу інших людей і тварин під час використання контролерів.",
        "filename" : "SpatialController.loctable",
        "language" : "uk"
      },
      {
        "target" : "確保你的空間沒有障礙物，並在使用控制器時注意其他人或寵物的存在。",
        "filename" : "SpatialController.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Assurez-vous que votre espace est dégagé de tout obstacle et soyez attentif aux autres personnes ou animaux domestiques lorsque vous utilisez les manettes.",
        "filename" : "SpatialController.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "コントローラ使用中は、周囲に障害物がないことを確認して、ほかの人やペットに注意してください。",
        "filename" : "SpatialController.loctable",
        "language" : "ja"
      },
      {
        "target" : "Asegúrate de que no tengas obstáculos en tu espacio y ten cuidado con otras personas o mascotas al usar controles.",
        "filename" : "SpatialController.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Certifique‑se de que não há obstáculos e esteja ciente de outras pessoas ou animais de estimação ao usar os controlos.",
        "filename" : "SpatialController.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Pastikan ruang anda tidak mempunyai sebarang halangan dan sedar tentang orang lain atau haiwan peliharaan semasa menggunakan pengawal.",
        "filename" : "SpatialController.loctable",
        "language" : "ms"
      },
      {
        "target" : "Zorg dat de ruimte om je heen vrij is van obstakels en houd rekening met andere mensen of huisdieren terwijl je de controllers gebruikt.",
        "filename" : "SpatialController.loctable",
        "language" : "nl"
      },
      {
        "target" : "Varmista, että tilassa ei ole esteitä, ja huomioi muut ihmiset tai lemmikit ohjaimien käytön aikana.",
        "filename" : "SpatialController.loctable",
        "language" : "fi"
      },
      {
        "target" : "Provjerite da u prostoru nema nikakvih prepreka i ostanite svjesni drugih osoba ili kućnih ljubimaca dok koristite kontrolere.",
        "filename" : "SpatialController.loctable",
        "language" : "hr"
      },
      {
        "target" : "Se till att utrymmet är fritt från hinder och var uppmärksam på andra personer eller på husdjur när du använder reglagen.",
        "filename" : "SpatialController.loctable",
        "language" : "sv"
      },
      {
        "target" : "Verifique se não há obstáculos no espaço e tenha cuidado com outras pessoas ou pets enquanto você usa os controles.",
        "filename" : "SpatialController.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Ensure your space is clear of any obstacles, and be aware of any other people or pets while using controllers.",
        "filename" : "SpatialController.loctable",
        "language" : "en"
      },
      {
        "target" : "Při používání ovladače se ujistěte, že v prostoru kolem vás nejsou žádné překážky, a dávejte pozor na ostatní lidi a zvířata.",
        "filename" : "SpatialController.loctable",
        "language" : "cs"
      },
      {
        "target" : "Bulunduğunuz alanda herhangi bir engel olmadığından emin olup denetleyicileri kullanırken diğer kişilerin veya evcil hayvanların farkında olun.",
        "filename" : "SpatialController.loctable",
        "language" : "tr"
      },
      {
        "target" : "Asigurați‑vă că ați înlăturat orice obstacole din jurul dvs. și acordați atenție altor persoane sau animale de companie atunci când utilizați controllerele.",
        "filename" : "SpatialController.loctable",
        "language" : "ro"
      },
      {
        "target" : "Comprova que no hi hagi obstacles al voltant ni persones ni mascotes a prop mentre utilitzes els comandaments.",
        "filename" : "SpatialController.loctable",
        "language" : "ca"
      },
      {
        "target" : "Κατά τη χρήση χειριστηρίων, βεβαιωθείτε ότι δεν υπάρχουν εμπόδια στον περιβάλλοντα χώρο, και φροντίστε να έχετε επίγνωση της παρουσίας άλλων ατόμων ή κατοικιδίων.",
        "filename" : "SpatialController.loctable",
        "language" : "el"
      },
      {
        "target" : "주변에 장애물이 없는지 확인하고, 컨트롤러를 사용하는 동안 다른 사람이나 반려동물에 주의하십시오.",
        "filename" : "SpatialController.loctable",
        "language" : "ko"
      },
      {
        "target" : "Podczas używania kontrolerów upewnij się, że przestrzeń wokół Ciebie jest wolna od przeszkód i uważaj na inne osoby lub zwierzęta.",
        "filename" : "SpatialController.loctable",
        "language" : "pl"
      },
      {
        "target" : "Sørg for, at der ikke er nogen forhindringer i nærheden, og vær opmærksom på andre personer eller kæledyr, når du bruger controllere.",
        "filename" : "SpatialController.loctable",
        "language" : "da"
      },
      {
        "target" : "請確保所在空間沒有障礙物，且在使用控制器時留意其他人或寵物。",
        "filename" : "SpatialController.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Убедитесь, что вокруг Вас нет препятствий, и обращайте внимание на появление других людей и животных при использовании контроллеров.",
        "filename" : "SpatialController.loctable",
        "language" : "ru"
      },
      {
        "target" : "Sjekk at det ikke er noen hindringer i nærheten, og vær oppmerksom på personer og kjæledyr rundt deg mens du bruker kontrollene.",
        "filename" : "SpatialController.loctable",
        "language" : "no"
      },
      {
        "target" : "Ensure your space is clear of any obstacles, and be aware of any other people or pets while using controllers.",
        "filename" : "SpatialController.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "A vezérlők használata közben gondoskodjon arról, hogy ne legyenek Ön körül akadályok, és ügyeljen másokra és a háziállatokra.",
        "filename" : "SpatialController.loctable",
        "language" : "hu"
      },
      {
        "target" : "使用控制器时，请确保周围没有障碍物，并当心他人或宠物。",
        "filename" : "SpatialController.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Pastikan tidak ada yang menghalangi di ruangan Anda dan waspadai orang lain atau peliharaan saat menggunakan pengontrol.",
        "filename" : "SpatialController.loctable",
        "language" : "id"
      }
