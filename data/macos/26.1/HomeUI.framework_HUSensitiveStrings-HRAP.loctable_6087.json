      },
      {
        "language" : "id",
        "target" : "[Engineering UI] Aksesori ini mendukung fungsi infrastruktur jaringan sensitif, termasuk manajemen kredensial untuk perangkat lain di jaringan Anda, dan pembagian kredensial di antara layanan yang terhubung.",
        "filename" : "HUSensitiveStrings-HRAP.loctable"
      }
