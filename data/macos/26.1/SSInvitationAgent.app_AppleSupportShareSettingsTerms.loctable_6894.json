    "X7R-XY-Pfc.title" : [
      {
        "target" : "เซสชั่นนี้จะถูกบันทึกเพื่อวัตถุประสงค์ด้านคุณภาพและบริการ และจะถูกจัดเก็บไว้ไม่เกินสองปีบนระบบของเราในลักษณะที่อาจมีการเชื่อมโยงกับตัวคุณ คลิกยอมรับเพื่อยอมรับข้อกำหนดที่ให้มา <<HYPERLINK>>",
        "language" : "th",
        "filename" : "AppleSupportShareSettingsTerms.loctable"
