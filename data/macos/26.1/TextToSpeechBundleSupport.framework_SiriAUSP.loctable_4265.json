    "speechStyleFooter" : [
      {
        "language" : "th",
        "target" : "ค่าเสียงที่ตั้งไว้จะเปลี่ยนลักษณะการพูดโดยรวมของเสียง ค่าเสียงที่ตั้งไว้สามารถกำหนดค่าเพิ่มเติมได้อีกด้วยการตั้งค่าเสียงเฉพาะ",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "en_AU",
        "target" : "Voice presets change the overall speaking style of a voice. They can be further customised with specific voice settings.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "hi",
        "target" : "वॉइस प्रीसेट किसी आवाज़ की समग्र बोलने की शैली को बदल देते हैं। उन्हें विशिष्ट वॉइस सेटिंग के साथ और भी कस्टमाइज़ किया जा सकता है।",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "fr",
        "target" : "Les préréglages de la voix modifient le style d’élocution général d’une voix. Ils peuvent être davantage personnalisés grâce à des réglages de la voix spécifiques.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "sk",
        "target" : "Predvoľby hlasu slúžia na celkovú zmenu štýlu rozprávania. Môžete si ich ďalej prispôsobiť pomocou konkrétnych nastavení hlasu.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "he",
        "target" : "תצורות קול משנות את סגנון הדיבור הכללי של הקול. ניתן לבצע בהן התאמות נוספות באמצעות הגדרות של קול מסוים.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ar",
        "target" : "تعمل الإعدادات المسبقة للصوت على تغيير نمط التحدث العام للصوت. ويمكن تخصيصها بشكل أكبر بإعدادات صوتية محددة.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "vi",
        "target" : "Các giá trị đặt trước giọng nói sẽ thay đổi cách nói tổng thể của giọng nói. Bạn có thể tùy chỉnh thêm bằng các cài đặt giọng nói cụ thể.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "it",
        "target" : "Questi preset modificano lo stile generale di una voce. Puoi personalizzarli ulteriormente con impostazioni specifiche per la voce.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "es",
        "target" : "Los preajustes de voz permiten cambiar el estilo de habla de una voz y se pueden personalizar aún más con ajustes específicos.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "sl",
        "target" : "Glasovne prednastavitve spremenijo celoten slog govorjenja za glas. S posamičnimi glasovnimi nastavitvami jih lahko še podrobneje prilagodite.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "de",
        "target" : "In den Stimmvoreinstellungen kannst du den generellen Sprechstil einer Stimme ändern. Über spezielle Stimmeinstellungen kannst du sie noch weiter anpassen.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "uk",
        "target" : "Набори параметрів задають загальний стиль голосу. Можна додатково підлаштувати окремі параметри голосу.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "zh_HK",
        "target" : "聲音預設組會改變聲音的整體説話風格。其可以透過指定的聲音設定來進一步自訂。",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "fr_CA",
        "target" : "Les préréglages modifient le style global d’une voix. Des réglages vocaux précis permettent de les personnaliser davantage.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ja",
        "target" : "声のプリセットによって、声の全体的な読み上げスタイルが変更されます。プリセットは、特定の声の設定を使用してさらにカスタマイズできます。",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "es_419",
        "target" : "Las preconfiguraciones de voz cambian el estilo general de una voz. Pueden personalizarse más mediante la configuración específica de voz.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "pt_PT",
        "target" : "As predefinições de voz mudam o estilo geral de uma voz e podem ser personalizadas com definições específicas.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ms",
        "target" : "Praset suara menukar gaya percakapan keseluruhan untuk suara. Ia boleh disesuaikan selanjutnya dengan seting suara khusus.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "nl",
        "target" : "Stemvoorinstellingen veranderen de algehele spreekstijl van een stem. Ze kunnen verder worden aangepast met specifieke steminstellingen.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "fi",
        "target" : "Puheäänen esiasetukset muuttavat puheäänen yleistä tyyliä. Niitä voidaan muokata vielä lisää tietyillä puheäänen asetuksilla.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "hr",
        "target" : "Programirana podešenja glasa mijenjaju ukupni stil govorenja glasa. Mogu se dodatno prilagoditi određenim glasovnim postavkama.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "sv",
        "target" : "Röstförinställningar kan ändra rösters övergripande talstil. De kan anpassas ytterligare med specifika röstinställningar.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "en",
        "target" : "Voice presets change the overall speaking style of a voice. They can be further customized with specific voice settings.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "pt",
        "target" : "Os pré‑ajustes de voz mudam o estilo de fala de uma voz. Você pode personalizá‑los mais com ajustes específicos.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "cs",
        "target" : "Hlasové předvolby mění u vybraného hlasu celkový styl mluvení. Lze u nich dále přizpůsobit konkrétní parametry hlasu.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "tr",
        "target" : "Ses ön ayarları, sesin genel konuşma stilini değiştirir. Bunlar, belirli ses ayarlarıyla daha da özelleştirilebilir.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ro",
        "target" : "Preconfigurările de voce schimbă stilul general de enunțare a unei voci. Aceste preconfigurări pot fi personalizate suplimentar cu opțiuni specifice pentru voce.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ca",
        "target" : "Les preconfiguracions canvien l’estil general d’una veu. Es poden personalitzar encara més amb opcions específiques.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "el",
        "target" : "Οι Προεπιλογές φωνής αλλάζουν το γενικό στιλ εκφώνησης μιας φωνής. Μπορούν να προσαρμοστούν περαιτέρω μέσω συγκεκριμένων ρυθμίσεων φωνής.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ko",
        "target" : "음성 프리셋은 음성의 말하기 스타일을 전체적으로 변경합니다. 프리셋은 특정 음성 설정에 맞춰 추가로 사용자화할 수 있습니다.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "pl",
        "target" : "Ustawienia wstępne głosu zmieniają ogólny styl mowy. Można je następnie spersonalizować, zmieniając określone ustawienia głosu.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "da",
        "target" : "Forindstillinger af stemme ændrer stemmens overordnede talestil. De kan tilpasses yderligere med bestemte stemmeindstillinger.",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "zh_TW",
        "target" : "聲音預設組會更改聲音的整體說話風格。聲音預設組可以透過特定聲音設定進一步自訂。",
        "filename" : "SiriAUSP.loctable"
      },
      {
        "language" : "ru",
        "target" : "С помощью наборов голосовых настроек можно изменить общий стиль речи. Эти наборы можно настроить дополнительно, задав особые параметры голоса.",
        "filename" : "SiriAUSP.loctable"
      },
      {
