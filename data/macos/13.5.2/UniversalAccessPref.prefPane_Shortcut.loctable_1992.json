    "t9l-nh-Awl.title" : [
      {
        "target" : "Tryck på kommando-alternativ-F5 för att växla kortkommandon för hjälpmedel.",
        "filename" : "Shortcut.loctable",
        "language" : "sv"
      },
      {
        "target" : "Pritisnite Command-Option-F5 za prebacivanje prečaca pristupačnosti.",
        "filename" : "Shortcut.loctable",
        "language" : "hr"
      },
      {
        "target" : "Tekan Command-Option-F5 untuk menogol pintasan kebolehcapaian.",
        "filename" : "Shortcut.loctable",
        "language" : "ms"
      },
      {
        "target" : "Nyomja meg a Command-Alt-F5 billentyűkombinációt a kisegítő lehetőségek billentyűparancsai közötti váltáshoz.",
        "filename" : "Shortcut.loctable",
        "language" : "hu"
      },
      {
        "target" : "Command-Option-F5를 눌러 손쉬운 사용 단축키를 토글하십시오.",
        "filename" : "Shortcut.loctable",
        "language" : "ko"
      },
      {
        "target" : "Naciśnij Command-Option-F5, aby przełączyć skróty dostępności.",
        "filename" : "Shortcut.loctable",
        "language" : "pl"
      },
      {
        "target" : "Tryk på Kommanda-Alternativ-F5 for at slå genveje til tilgængelighed til\/fra.",
        "filename" : "Shortcut.loctable",
        "language" : "da"
      },
      {
        "target" : "Drücke Command-Option-F5, um die Bedienungshilfen-Kurzbefehle zu (de)aktivieren.",
        "filename" : "Shortcut.loctable",
        "language" : "de"
      },
      {
        "target" : "Apăsați Comandă-Opțiune-F5 pentru a comuta scurtăturile de accesibilitate.",
        "filename" : "Shortcut.loctable",
        "language" : "ro"
      },
      {
        "target" : "Premi Comando-Opzione-F5 per attivare o disattivare le abbreviazioni di accessibilità.",
        "filename" : "Shortcut.loctable",
        "language" : "it"
      },
      {
        "target" : "Druk op Command + Option + F5 om snelle opties voor toegankelijkheid in en uit te schakelen.",
        "filename" : "Shortcut.loctable",
        "language" : "nl"
      },
      {
        "target" : "按下Command + Option + F5來切換輔助使用快捷鍵。",
        "filename" : "Shortcut.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Prima Comando+Opção+F5 para ativar\/desativar os atalhos de acessibilidade.",
        "filename" : "Shortcut.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "לחץ\/י על Command-Option-F5 כדי להפעיל או לבטל קיצורי דרך למאפייני נגישות.",
        "filename" : "Shortcut.loctable",
        "language" : "he"
      },
      {
        "target" : "Erişilebilirlik kestirmelerini açıp kapatmak için Komut-Option-F5 tuşlarına basın.",
        "filename" : "Shortcut.loctable",
        "language" : "tr"
      },
      {
        "target" : "Appuyez sur Commande-Option-F5 pour activer\/désactiver les raccourcis d’accessibilité.",
        "filename" : "Shortcut.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Trykk på Kommando-Tilvalg-F5 for å slå av og på tilgjengelighetssnarveier.",
        "filename" : "Shortcut.loctable",
        "language" : "no"
      },
      {
        "target" : "Pulsa Comando + Opción + F5 para activar\/desactivar las funciones rápidas de accesibilidad.",
        "filename" : "Shortcut.loctable",
        "language" : "es"
      },
      {
        "target" : "Pressione Comando + Opção + F5 para ativar ou desativar os atalhos de acessibilidade.",
        "filename" : "Shortcut.loctable",
        "language" : "pt"
      },
      {
        "target" : "Press Command-Option-F5 to toggle accessibility shortcuts.",
        "filename" : "Shortcut.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Prem Ordre + Opció + F5 per activar o desactivar les dreceres d’accessibilitat.",
        "filename" : "Shortcut.loctable",
        "language" : "ca"
      },
      {
        "target" : "اضغط على ⁨command-option-F5⁩ لتبديل اختصارات تسهيلات الاستخدام.",
        "filename" : "Shortcut.loctable",
        "language" : "ar"
      },
      {
        "target" : "Nhấn Command-Option-F5 để bật\/tắt phím tắt trợ năng.",
        "filename" : "Shortcut.loctable",
        "language" : "vi"
      },
      {
        "target" : "Zkratky zpřístupnění zapnete nebo vypnete stisknutím Cmd-Alt-F5.",
        "filename" : "Shortcut.loctable",
        "language" : "cs"
      },
      {
        "target" : "按下Command + Option + F5來切換輔助使用快速鍵。",
        "filename" : "Shortcut.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Appuyez sur Commande-Option-F5 pour activer\/désactiver les raccourcis d’accessibilité.",
        "filename" : "Shortcut.loctable",
        "language" : "fr"
      },
      {
        "target" : "กด Command-Option-F5 เพื่อสลับเปิดปิดปุ่มลัดการช่วยการเข้าถึง",
        "filename" : "Shortcut.loctable",
        "language" : "th"
      },
      {
        "target" : "アクセシビリティのショートカットを切り替えるには、Command+Option+F5キーを押します。",
        "filename" : "Shortcut.loctable",
        "language" : "ja"
      },
      {
        "target" : "Натисніть Command+Option+F5, щоб перемкнути спеціальне спрощення.",
        "filename" : "Shortcut.loctable",
        "language" : "uk"
      },
      {
        "target" : "按下Command-Option-F5以开关辅助功能快捷键。",
        "filename" : "Shortcut.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "ऐक्सेसिबिलिटी के शॉर्टकट टॉगल करने के लिए कमांड-ऑप्शन-F5 दबाएँ।",
        "filename" : "Shortcut.loctable",
        "language" : "hi"
      },
      {
        "target" : "Нажмите Command-Option-F5, чтобы включить или выключить сочетания клавиш Универсального доступа.",
        "filename" : "Shortcut.loctable",
        "language" : "ru"
      },
      {
        "target" : "Πατήστε Command-Option-F5 για ενεργοποίηση\/απενεργοποίηση των συντομεύσεων προσβασιμότητας.",
        "filename" : "Shortcut.loctable",
        "language" : "el"
      },
      {
        "target" : "Laita käyttöavun oikotiet päälle tai pois painamalla komento-optio-F5.",
        "filename" : "Shortcut.loctable",
        "language" : "fi"
      },
      {
        "target" : "Tekan Command-Option-F5 untuk mengubah pintasan aksesibilitas.",
        "filename" : "Shortcut.loctable",
        "language" : "id"
      },
      {
        "target" : "Presiona Comando + Opción + F5 para activar o desactivar las funciones rápidas de accesibilidad.",
        "filename" : "Shortcut.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Stlačením klávesov Command-Option-F5 prepnete skratky prístupnosti.",
        "filename" : "Shortcut.loctable",
        "language" : "sk"
      },
      {
        "target" : "Press Command-Option-F5 to toggle accessibility shortcuts.",
        "filename" : "Shortcut.loctable",
        "language" : "en_GB"
      }
    ],
