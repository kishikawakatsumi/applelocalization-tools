    "P6r-Xx-BJE.title" : [
      {
        "target" : "El teu ID d’Apple s’està fent servir per iniciar sessió a un dispositiu nou.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "ca"
      },
      {
        "target" : "O seu ID Apple está a ser usado para iniciar sessão num dispositivo novo.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Deine Apple-ID wird verwendet, um sich auf einem neuen Gerät anzumelden.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "de"
      },
      {
        "target" : "你的Apple ID正用于登录一台新设备。",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "ID Apple của bạn đang được sử dụng để đăng nhập vào một thiết bị mới.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "vi"
      },
      {
        "target" : "Din Apple-ID brukes for å logge på en ny enhet.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "no"
      },
      {
        "target" : "Votre identifiant Apple est utilisé sur un nouvel appareil.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "ID‑ul dvs. Apple este utilizat pentru autentificarea pe un dispozitiv nou.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "ro"
      },
      {
        "target" : "你的Apple ID正被用來登入新的裝置。",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Votre identifiant Apple est utilisé pour une connexion sur un nouvel appareil.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "fr"
      },
      {
        "target" : "Twój Apple ID jest używany do zalogowania się na nowym urządzeniu.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "pl"
      },
      {
        "target" : "Dit Apple-id bruges til at logge ind på en ny enhed.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "da"
      },
      {
        "target" : "Je Apple ID is gebruikt om in te loggen op een nieuw apparaat.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "nl"
      },
      {
        "target" : "Apple ID:täsi käytetään sisäänkirjautumiseen uudessa laitteessa.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "fi"
      },
      {
        "target" : "Seu ID Apple está sendo usado para iniciar a sessão em um novo dispositivo.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Vaše Apple ID je právě používáno pro přihlášení k novému zařízení.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "cs"
      },
      {
        "target" : "Ваш Apple ID було використано для входу на новому пристрої.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "uk"
      },
      {
        "target" : "आपके Apple ID का उपयोग एक नए डिवाइस में साइन इन करने के लिए किया जा रहा है।",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "hi"
      },
      {
        "target" : "Vaš Apple ID koristi se za prijavljivanje na novi uređaj.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "hr"
      },
      {
        "target" : "Ditt Apple-ID används till att logga in på en ny enhet.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "sv"
      },
      {
        "target" : "Your Apple ID is being used to sign into a new device.",
        "filename" : "FLUIBasicNotificationWindow.loctable",
