      },
      {
        "target" : "คุณกำลังใช้ Apple ID ของคุณเพื่อลงชื่อเข้าอุปกรณ์เครื่องใหม่",
        "filename" : "FLUIBasicNotificationWindow.loctable",
        "language" : "th"
