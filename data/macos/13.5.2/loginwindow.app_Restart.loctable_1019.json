    "100212.title" : [
      {
        "target" : "Hvis du ikke foretager dig noget, starter computeren automatisk igen om 60 sekunder.",
        "filename" : "Restart.loctable",
        "language" : "da"
      },
      {
        "target" : "Nếu bạn không thực hiện hành động nào, máy tính sẽ tự động khởi động lại trong 60 giây nữa.",
        "filename" : "Restart.loctable",
        "language" : "vi"
      },
      {
        "target" : "Wenn du keine Auswahl triffst, wird der Computer in 60 Sekunden automatisch neu gestartet.",
        "filename" : "Restart.loctable",
        "language" : "de"
      },
      {
        "target" : "Hiçbir şey yapmazsanız bilgisayar 60 saniye içinde otomatik olarak yeniden başlayacaktır.",
        "filename" : "Restart.loctable",
        "language" : "tr"
      },
      {
        "target" : "Hvis du ikke gjør noe, vil maskinen starte på nytt automatisk om 60 sekunder.",
        "filename" : "Restart.loctable",
        "language" : "no"
      },
      {
        "target" : "If you do nothing, the computer will restart automatically in 60 seconds.",
        "filename" : "Restart.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "何も操作をしないと、コンピュータは60秒で自動的に再起動します。",
        "filename" : "Restart.loctable",
        "language" : "ja"
      },
      {
        "target" : "如果你不执行任何操作，电脑将在60秒钟后自动重新启动。",
        "filename" : "Restart.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Si vous ne faites rien, l’ordinateur redémarrera automatiquement dans 60 secondes.",
        "filename" : "Restart.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Ako ništa ne učinite, računalo će se automatski ponovno uključiti za 60 sekundi.",
        "filename" : "Restart.loctable",
        "language" : "hr"
      },
      {
        "target" : "Jika Anda tidak melakukan apa pun, komputer akan mulai ulang secara otomatis dalam 60 detik.",
