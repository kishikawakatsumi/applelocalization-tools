    "MESSAGE_EN" : [
      {
        "target" : "\nPara configurarlas, usa los ajustes de red.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "\nChcete‑li tato rozhraní nakonfigurovat, použijte nastavení Síť.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "\nये इंटरफ़ेस सेटअप करने के लिए नेटवर्क सेटिंग्ज़ का उपयोग करें।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "\nPentru a configura aceste interfețe, utilizați configurările Rețea.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "\nPara configurar estas interfaces, usa el panel de configuración Red.",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "\nPara configurar estas interfaces, use os Ajustes de Rede.",
        "filename" : "Localizable.loctable",
        "language" : "pt"
      },
      {
        "target" : "\nЦі інтерфейси можна налаштувати на панелі «Мережа» в Системних параметрах.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "\nĐể thiết lập các giao diện này, hãy sử dụng Cài đặt mạng.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "\nConfigure estas interfaces nas definições de Rede.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "\nStäll in gränssnitten i Nätverksinställningar.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "\nTo set up these interfaces, use Network Settings.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "\nBu arabirimleri ayarlamak için Ağ Ayarları’nı kullanın.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "\nUntuk menyediakan antara muka ini, gunakan Seting Rangkaian.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "\nEzen interfészek beállításához használja a Hálózat beállításait.",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "\n如要設定這些介面，請使用「網絡設定」。",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
