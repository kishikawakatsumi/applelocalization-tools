    "IPXGeneralPreferencesHDRDescriptionText" : [
      {
        "target" : "يعدل الشاشة تلقائيًا لعرض النطاق الديناميكي الكامل للصور.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "ar"
      },
      {
        "target" : "ปรับการแสดงผลอัตโนมัติเพื่อแสดงช่วงแสงกว้างแบบเต็มของรูปภาพ",
        "filename" : "GeneralPreferences.loctable",
        "language" : "th"
      },
      {
        "target" : "Automatikusan úgy állíthatja be a kijelzőt, hogy a fotók teljes dinamikatartománya látható legyen.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "hu"
      },
      {
        "target" : "Automatski podesite zaslon za prikaz potpunog dinamičkog raspona fotografija.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "hr"
      },
      {
        "target" : "Ajuste automatiquement l’écran de façon à ce qu’il affiche l’ensemble de la plage dynamique de photos.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "fr"
      },
      {
        "target" : "Возможность автоматически настраивать дисплей для показа полного динамического диапазона фотографий.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "ru"
      },
      {
        "target" : "自動調整顯示器以顯示完整的動態範圍照片。",
        "filename" : "GeneralPreferences.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Säädä näyttöä automaattisesti näyttämään kuvien koko dynaaminen alue (HDR).",
        "filename" : "GeneralPreferences.loctable",
        "language" : "fi"
      },
      {
        "target" : "Pas de weergave automatisch aan om het volledige dynamische bereik van HDR-foto's weer te geven.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "nl"
      },
      {
        "target" : "Passe das Display automatisch an, um den gesamten dynamischen Bereich von Fotos anzuzeigen.",
        "filename" : "GeneralPreferences.loctable",
        "language" : "de"
      },
      {
        "target" : "तस्वीरों की संपूर्ण डाइनैमिक रेंज दिखाने के लिए डिस्प्ले ऑटोमैटिकली ऐडजस्ट करें।",
        "filename" : "GeneralPreferences.loctable",
        "language" : "hi"
      },
      {
        "target" : "Justera automatiskt skärmen så att hela det dynamiska omfånget visas för bilder.",
        "filename" : "GeneralPreferences.loctable",
