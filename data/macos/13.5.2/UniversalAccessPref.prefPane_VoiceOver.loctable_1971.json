{
  "loctablePath" : "\/System\/Library\/PreferencePanes\/UniversalAccessPref.prefPane\/Contents\/Resources\/VoiceOver.loctable",
  "bundlePath" : "\/System\/Library\/PreferencePanes\/UniversalAccessPref.prefPane",
  "framework" : "UniversalAccessPref.prefPane",
  "localizations" : {
    "34.title" : [
      {
        "target" : "「旁白」能提供電腦螢幕項目的語音和點字描述，並能讓你使用鍵盤來控制電腦。",
        "filename" : "VoiceOver.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "VoiceOver menyediakan deskripsi item dalam bentuk lisan dan braille pada layar komputer dan memberikan kendali atas komputer lewat penggunaan papan ketik.",
        "filename" : "VoiceOver.loctable",
        "language" : "id"
      },
      {
        "target" : "VoiceOver beskriver objekter på datamaskinen med tale og punktskrift og gjør det mulig å styre maskinen ved hjelp av tastaturet.",
        "filename" : "VoiceOver.loctable",
        "language" : "no"
      },
      {
        "target" : "VoiceOver를 사용하면 음성 및 점자를 통해 컴퓨터 화면에 있는 항목을 설명해 주며 키보드를 사용하여 컴퓨터를 제어할 수 있습니다.",
        "filename" : "VoiceOver.loctable",
        "language" : "ko"
      },
      {
        "target" : "VoiceOver proporciona descripcions orals i en braille dels ítems que hi ha a la pantalla de l’ordinador i permet controlar l’ordinador mitjançant el teclat.",
        "filename" : "VoiceOver.loctable",
        "language" : "ca"
      },
      {
        "target" : "VoiceOver enunță și exprimă prin Braille descrierile articolelor de pe ecranul computerului și furnizează control asupra computerului prin utilizarea tastaturii.",
        "filename" : "VoiceOver.loctable",
        "language" : "ro"
      },
      {
        "target" : "O VoiceOver fornece descrições faladas e por braille de itens na tela do computador, e permite controlar o computador através do teclado.",
        "filename" : "VoiceOver.loctable",
        "language" : "pt"
      },
      {
        "target" : "يوفر التعليق الصوتي وصف منطوق وعلى طريقة برايل للعناصر الموجودة على شاشة الكمبيوتر ويوفر التحكم في الكمبيوتر من خلال استخدام لوحة المفاتيح.",
        "filename" : "VoiceOver.loctable",
        "language" : "ar"
      },
      {
        "target" : "VoiceOver proporciona descripciones por voz y en braille de los ítems de la pantalla del ordenador y permite controlar el ordenador mediante el uso del teclado.",
        "filename" : "VoiceOver.loctable",
        "language" : "es"
      },
      {
        "target" : "VoiceOver menyediakan perihalan item pada skrin komputer yang dituturkan dan dalam braille serta memberikan kawalan komputer melalui penggunaan papan kekunci.",
        "filename" : "VoiceOver.loctable",
        "language" : "ms"
      },
      {
        "target" : "VoiceOver произносит или переводит в шрифт Брайля описание объектов на экране и позволяет управлять компьютером, используя только клавиатуру.",
        "filename" : "VoiceOver.loctable",
        "language" : "ru"
      },
      {
        "target" : "VoiceOver fornisce descrizioni vocali e descrizioni Braille degli elementi sullo schermo e consente di controllare il computer mediante l'utilizzo della tastiera.",
        "filename" : "VoiceOver.loctable",
        "language" : "it"
      },
      {
        "target" : "VoiceOver giver talte beskrivelser og punktskriftbeskrivelser af emner på computerskærmen, og du kan styre computeren vha. tastaturet.",
        "filename" : "VoiceOver.loctable",
        "language" : "da"
      },
      {
        "target" : "VoiceOver nudi izgovorene opise stavki na zaslonu računala, kao i opise na brajici te pruža kontrolu nad računalom uz upotrebu tipkovnice.",
        "filename" : "VoiceOver.loctable",
        "language" : "hr"
      },
      {
        "target" : "VoiceOver proporciona descripciones por voz y en braille de los elementos de la pantalla de la computadora y permite controlar la computadora mediante el uso del teclado.",
        "filename" : "VoiceOver.loctable",
        "language" : "es_419"
      },
      {
        "target" : "VoiceOver कंप्यूटर स्क्रीन के आइटम के उच्चारित और ब्रेल विवरण और कीबोर्ड के उपयोग के माध्यम से कंप्यूटर का नियंत्रण प्रदान करता है।",
        "filename" : "VoiceOver.loctable",
        "language" : "hi"
      },
      {
        "target" : "VoiceOver beschreibt Objekte auf dem Computerbildschirm mit Sprache oder Brailleschrift. Du kannst VoiceOver für die Steuerung des Computers mithilfe der Tastatur verwenden.",
        "filename" : "VoiceOver.loctable",
        "language" : "de"
      },
      {
        "target" : "VoiceOver cung cấp phần mô tả bằng tiếng và bằng chữ nổi cho các mục trên màn hình máy tính và giúp người dùng điều khiển máy tính bằng bàn phím.",
        "filename" : "VoiceOver.loctable",
        "language" : "vi"
      },
      {
        "target" : "VoiceOver provides spoken and brailled descriptions of items on the computer screen and provides control of the computer through the use of the keyboard.",
        "filename" : "VoiceOver.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "VoiceOver poskytuje popisy položek na obrazovce počítače v mluvené formě a v Braillově písmu a umožňuje ovládat počítač pomocí klávesnice.",
        "filename" : "VoiceOver.loctable",
        "language" : "cs"
      },
      {
        "target" : "VoiceOver kuvailee tietokoneen näytön sisällön puheena tai pistekirjoituksena ja mahdollistaa tietokoneen ohjaamisen näppäimistöllä.",
        "filename" : "VoiceOver.loctable",
        "language" : "fi"
      },
      {
        "target" : "VoiceOver läser upp beskrivningar av objekt på skärmen eller skriver dem på en punktskriftsdisplay. Du kan dessutom styra datorn med hjälp av tangentbordet.",
        "filename" : "VoiceOver.loctable",
        "language" : "sv"
      },
      {
        "target" : "‏VoiceOver מספק תיאורים של הפריטים המופיעים על המסך בדיבור ובכתב ברייל ומאפשר לשלוט במסך באמצעות המקלדת.",
        "filename" : "VoiceOver.loctable",
        "language" : "he"
      },
      {
        "target" : "Το VoiceOver παρέχει εκφωνούμενες περιγραφές και περιγραφές Μπράιγ των στοιχείων οθόνης του υπολογιστή και επιτρέπει τον έλεγχο του υπολογιστή με χρήση του πληκτρολογίου.",
        "filename" : "VoiceOver.loctable",
        "language" : "el"
      },
      {
        "target" : "VoiceOver, bilgisayar ekranındaki öğelerin açıklamalarını sesli ve Braille kullanarak sunmasının yanı sıra bilgisayarın klavye kullanılarak denetlenmesini sağlar.",
        "filename" : "VoiceOver.loctable",
        "language" : "tr"
      },
      {
        "target" : "A VoiceOver funkció hangosan felolvasott és Braille-feliratokkal ellátott leírást biztosít a számítógép képernyőjén látható elemekhez és lehetővé teszi a számítógép vezérlését a billentyűzeten keresztül.",
        "filename" : "VoiceOver.loctable",
        "language" : "hu"
      },
      {
        "target" : "VoiceOverを使用すると、画面上の項目の説明をコンピュータで読み上げたり、点字で表示したりできます。また、キーボードだけでコンピュータを操作することもできます。",
        "filename" : "VoiceOver.loctable",
        "language" : "ja"
      },
      {
        "target" : "VoiceOver opisuje mową i alfabetem Braille'a rzeczy widoczne na ekranie komputera, a także umożliwia sterowanie komputerem za pomocą klawiatury.",
        "filename" : "VoiceOver.loctable",
        "language" : "pl"
      },
      {
        "target" : "VoiceOver poskytuje hovorené popisy alebo popisy v Braillovom písme pre položky na obrazovke počítača a umožňuje ovládanie počítača pomocou klávesnice.",
        "filename" : "VoiceOver.loctable",
        "language" : "sk"
      },
      {
        "target" : "“旁白”可提供电脑屏幕上的项目的口述和盲文描述，并可让你使用键盘来控制电脑。",
        "filename" : "VoiceOver.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "VoiceOver geeft gesproken beschrijvingen en beschrijvingen in braille weer van onderdelen op het computerscherm en maakt het mogelijk de computer met het toetsenbord te bedienen.",
        "filename" : "VoiceOver.loctable",
        "language" : "nl"
      },
      {
        "target" : "「旁白」能提供電腦螢幕項目的語音和點字描述，能讓你使用鍵盤來控制電腦。",
        "filename" : "VoiceOver.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "VoiceOver fournit des descriptions parlées et en braille des éléments affichés sur l’écran de l’ordinateur et permet de contrôler l’ordinateur à l’aide du clavier.",
        "filename" : "VoiceOver.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "VoiceOver озвучує елементи на екрані компʼютера й надає їх опис шрифтом Брайля. Також ця функція забезпечує керування компʼютером за допомогою тільки клавіатури.",
        "filename" : "VoiceOver.loctable",
        "language" : "uk"
      },
      {
        "target" : "VoiceOver provides spoken and brailled descriptions of items on the computer screen and provides control of the computer through the use of the keyboard.",
        "filename" : "VoiceOver.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "VoiceOver จะอ่านออกเสียงคำอธิบายและคำอธิบายแบบอักษรเบรลล์ของรายการต่างๆ บนหน้าจอคอมพิวเตอร์ และช่วยควบคุมเครื่องคอมพิวเตอร์ผ่านทางการใช้งานแป้นพิมพ์",
        "filename" : "VoiceOver.loctable",
        "language" : "th"
      },
      {
        "target" : "O VoiceOver faz descrições enunciadas e em braille dos elementos no ecrã e permite controlar o computador através do teclado.",
        "filename" : "VoiceOver.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "VoiceOver fournit des descriptions parlées et en Braille des éléments présents sur l’écran de l’ordinateur et permet de contrôler l’ordinateur à l’aide du clavier.",
        "filename" : "VoiceOver.loctable",
        "language" : "fr"
      }
    ],
