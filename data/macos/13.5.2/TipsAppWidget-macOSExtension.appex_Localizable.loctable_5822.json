    "WIDGET_DESCRIPTION" : [
      {
        "target" : "Get the most from your Apple devices with helpful hints and hidden gems.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Saca el máximo partido de tus dispositivos Apple con consejos útiles y trucos.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "Get the most from your Apple devices with helpful hints and hidden gems.",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Užitečné tipy a méně známé triky vám pomůžou využít zařízení Apple na maximum.",
        "filename" : "Localizable.loctable",
        "language" : "cs"
      },
      {
        "target" : "Užitočné rady a tipy na skryté funkcie vám pomôžu naplno využiť vaše Apple zariadenia.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "Iskoristite sve mogućnosti Apple uređaja pomoću korisnih savjeta i skrivenih dragulja.",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "Obtenha o máximo de seus dispositivos Apple com dicas úteis e curiosidades incríveis.",
        "filename" : "Localizable.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "유용한 팁과 숨겨진 기능을 확인하여 Apple 기기를 최대한 활용해 보세요.",
        "filename" : "Localizable.loctable",
        "language" : "ko"
      },
      {
        "target" : "Ota Apple-laitteistasi kaikki hyöty irti hyödyllisillä vinkeillä ja yllättävillä ominaisuuksilla.",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "Використовуйте пристрої Apple максимально ефективно з корисними підказками та порадами.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
        "target" : "Aproveite os seus dispositivos Apple ao máximo com dicas úteis e funcionalidades por desvendar.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Optimalkan perangkat Apple Anda dengan petunjuk berguna dan fitur tersembunyi.",
        "filename" : "Localizable.loctable",
        "language" : "id"
      },
      {
        "target" : "A legtöbbet hozhatja ki Apple-eszközeiből hasznos tippek és praktikus rejtett funkciók segítségével.",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "Επωφεληθείτε στο έπακρο από τις συσκευές Apple σας χάρη σε χρήσιμες συμβουλές και υποδείξεις.",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "Saca el mayor provecho a tus dispositivos Apple con consejos útiles y trucos escondidos.",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Khai thác tối đa thiết bị Apple của bạn với các gợi ý hữu ích và tính năng ẩn.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Praktische Hinweise und versteckte Funktionen für die optimale Nutzung deiner Apple-Geräte.",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "Få mest muligt ud af dine Apple-enheder med nyttige tips og skjulte funktioner.",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "حقق أقصى استفادة من أجهزة Apple باستخدام التلميحات المفيدة والميزات غير الظاهرة.",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "通过实用的提示和隐藏技巧，充分使用Apple设备。",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "役に立つヒントや今まで知らなかった便利な機能を使って、Appleデバイスを最大限に活用しましょう。",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "Profitați la maximum de dispozitivele dvs. Apple cu indicii utile și ponturi neprețuite.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Manfaatkan sepenuhnya peranti Apple anda dengan pembayang berguna dan fungsi rahsia.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Haal meer uit je Apple apparaten met nuttige aanwijzingen en verborgen juweeltjes.",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "Profitez au mieux de vos appareils Apple grâce à des suggestions utiles et des astuces cachées.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Sfrutta al massimo i dispositivi Apple grazie a suggerimenti utili e funzionalità imperdibili.",
        "filename" : "Localizable.loctable",
        "language" : "it"
      },
      {
        "target" : "Profitez au maximum de vos appareils Apple en découvrant des astuces utiles et des curiosités cachées.",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "וידג׳ט זה יאפשר לך להפיק את המרב ממכשירי Apple באמצעות עצות שימושיות ומאפיינים שלא הכרת.",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "Få ut mesta möjliga av dina Apple-enheter med användbara tips och dolda pärlor.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "सहायक संकेतों और छिपी ख़ूबियों से अपने Apple डिवाइस का पूरा लाभ उठाएँ।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "Få mest mulig glede av Apple-enhetene dine ved hjelp av nyttige tips og triks.",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "Pomocne porady i opisy przydatnych funkcji pozwalają optymalnie wykorzystać możliwości urządzeń Apple.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "Полезные советы и подсказки помогут пользоваться всеми возможностями устройств Apple.",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "透過實用的提示和隱藏的技巧，充分運用你的Apple裝置。",
        "filename" : "Localizable.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "ใช้งานอุปกรณ์ Apple ของคุณให้เกิดประโยชน์สูงสุดด้วยเกร็ดความรู้และคุณสมบัติที่ซ่อนอยู่",
        "filename" : "Localizable.loctable",
        "language" : "th"
