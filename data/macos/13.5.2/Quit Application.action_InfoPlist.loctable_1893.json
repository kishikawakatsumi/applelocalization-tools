    "AMDNote" : [
      {
        "target" : "Se non è selezionato “Chiedi di salvare le modifiche”, i dati nei documenti aperti potrebbero andare persi.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Jika “Minta untuk menyimpan perubahan” tidak dipilih, data dalam dokumen terbuka mungkin hilang.",
        "filename" : "InfoPlist.loctable",
        "language" : "ms"
      },
      {
        "target" : "Ak nie je zvolená možnosť „Potvrdiť uloženie zmien“, môže dôjsť k strate dát v otvorených dokumentoch.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "Hvis «Spør for å arkivere endringer» ikke er markert, er det mulig at data i åpne dokumenter går tapt.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "Nếu không chọn “Hỏi để lưu thay đổi”, dữ liệu trong tài liệu đang mở có thể bị mất.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Om ”Fråga om ändringar ska sparas” inte markeras kan data i öppna dokument gå förlorade.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Se não estiver selecionada a opção “Perguntar se pretende guardar alterações”, podem perder‑se dados nos documentos abertos.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Jika ”Tanya untuk menyimpan perubahan” tidak dipilih, data pada dokumen yang terbuka dapat hilang.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "If “Ask to save changes” is not selected, data in open documents may be lost.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Dacă nu este selectată opțiunea “Solicită salvarea modificărilor”, este posibil ca datele din documentele deschise să fie pierdute.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      },
      {
        "target" : "Als 'Vraag of wijzigingen moeten worden bewaard' niet is geselecteerd, is het mogelijk dat niet-bewaarde gegevens in open documenten verloren gaan.",
        "filename" : "InfoPlist.loctable",
        "language" : "nl"
      },
      {
        "target" : "Si l’opció “Preguntar si es volen desar els canvis” no està seleccionada, les dades dels documents oberts podrien perdre’s.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "If “Ask to save changes” is not selected, data in open documents may be lost.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Ha nincs kijelölve a „Rákérdezés a módosítások mentésére” lehetőség, a megnyitott dokumentumokban található adatok elveszhetnek.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "Si la opción “Preguntar si desean guardarse los cambios” no está seleccionada, los datos de los documentos abiertos pueden perderse.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "Jos ”Kysy tallennetaanko muutokset” ei ole valittuna, avoimissa dokumenteissa olevia tietoja voidaan menettää.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "Jeśli opcja „Zapytaj, czy zachować zmiany” nie jest zaznaczona, dane z otwartych dokumentów mogą być utracone.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "في حالة عدم تحديد \"مطالبة بحفظ التغييرات\"، ربما يتم فقد البيانات في المستندات المفتوحة.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "“変更の保存を確認”が選択されていない場合、開いている書類のデータが失われれることがあります。",
