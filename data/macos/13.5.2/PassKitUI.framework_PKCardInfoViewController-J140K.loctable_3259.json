    "X4S-LK-dJf.title" : [
      {
        "target" : "Apple Pay ถูกปิดใช้งานเนื่องจากการตั้งค่าความปลอดภัยของ Mac เครื่องนี้ถูกแก้ไข",
        "filename" : "PKCardInfoViewController-J140K.loctable",
        "language" : "th"
      },
      {
        "target" : "Apple Pay er deaktivert fordi sikkerhetsinnstillingene på denne Macen ble endret.",
        "filename" : "PKCardInfoViewController-J140K.loctable",
        "language" : "no"
      },
      {
        "target" : "L’Apple Pay s’ha desactivat perquè s’ha modificat la configuració de seguretat d’aquest Mac.",
        "filename" : "PKCardInfoViewController-J140K.loctable",
        "language" : "ca"
      },
      {
        "target" : "Apple Pay je onemogućen jer su sigurnosne postavke ovog Maca izmijenjene.",
        "filename" : "PKCardInfoViewController-J140K.loctable",
        "language" : "hr"
      },
      {
        "target" : "Se desactivó Apple Pay debido a que se modificó la configuración de seguridad de esta Mac.",
        "filename" : "PKCardInfoViewController-J140K.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Apple Pay has been disabled because the security settings of this Mac were modified.",
