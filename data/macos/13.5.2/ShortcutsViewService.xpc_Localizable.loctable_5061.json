    "This content cannot be previewed because an error occurred." : [
      {
        "target" : "Konten ini tidak dapat dipratinjau karena terjadi kesalahan.",
        "filename" : "Localizable.loctable",
        "language" : "id"
      },
      {
        "target" : "एरर होने का कारण इस कॉन्टेंट का प्रीव्यू नहीं देखा जा सकता है।",
        "filename" : "Localizable.loctable",
        "language" : "hi"
      },
      {
        "target" : "Không thể xem trước nội dung này do đã xảy ra lỗi.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "エラーが起きたため、このコンテンツはプレビューできません。",
        "filename" : "Localizable.loctable",
        "language" : "ja"
      },
      {
        "target" : "This content cannot be previewed because an error occurred.",
        "filename" : "Localizable.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "A tartalom előnézete nem tekinthető meg, mert hiba történt.",
        "filename" : "Localizable.loctable",
        "language" : "hu"
      },
      {
        "target" : "Er is geen voorvertoning van dit materiaal beschikbaar, omdat er zich een fout heeft voorgedaan.",
        "filename" : "Localizable.loctable",
        "language" : "nl"
      },
      {
        "target" : "ไม่สามารถดูตัวอย่างเนื้อหานี้ได้เนื่องจากเกิดข้อผิดพลาดขึ้น",
        "filename" : "Localizable.loctable",
        "language" : "th"
      },
      {
        "target" : "Für diesen Inhalt ist keine Vorschau möglich, da ein Fehler aufgetreten ist.",
        "filename" : "Localizable.loctable",
        "language" : "de"
      },
      {
        "target" : "No es pot previsualitzar el contingut perquè hi ha hagut un error.",
        "filename" : "Localizable.loctable",
        "language" : "ca"
      },
      {
        "target" : "This content cannot be previewed because an error occurred.",
        "filename" : "Localizable.loctable",
        "language" : "en"
      },
      {
        "target" : "Não é possível pré‑visualizar este conteúdo porque ocorreu um erro.",
        "filename" : "Localizable.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Δεν είναι δυνατή η προεπισκόπηση αυτού του περιεχομένου, επειδή παρουσιάστηκε σφάλμα.",
        "filename" : "Localizable.loctable",
        "language" : "el"
      },
      {
        "target" : "لا يمكن معاينة هذا المحتوى بسبب حدوث خطأ.",
        "filename" : "Localizable.loctable",
        "language" : "ar"
      },
      {
        "target" : "Ovaj sadržaj ne može se pregledati jer je došlo do greške.",
        "filename" : "Localizable.loctable",
        "language" : "hr"
      },
      {
        "target" : "Innholdet kan ikke forhåndsvises fordi det oppsto en feil.",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "Este contenido no se puede previsualizar porque se ha producido un error.",
        "filename" : "Localizable.loctable",
        "language" : "es"
      },
      {
        "target" : "Ocurrió un error y el contenido no se puede previsualizar.",
        "filename" : "Localizable.loctable",
        "language" : "es_419"
      },
      {
        "target" : "This content cannot be previewed because an error occurred.",
        "filename" : "Localizable.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Acest conținut nu poate fi previzualizat deoarece a survenit o eroare.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "無法預覽此內容，因為發生錯誤。",
