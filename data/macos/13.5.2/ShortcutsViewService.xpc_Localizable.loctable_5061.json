      },
      {
        "target" : "Não é possível pré-visualizar este conteúdo porque ocorreu um erro.",
        "filename" : "Localizable.loctable",
        "language" : "pt"
      },
      {
        "target" : "Kandungan ini tidak boleh dipratonton kerana ralat telah berlaku.",
        "filename" : "Localizable.loctable",
        "language" : "ms"
      },
      {
        "target" : "Nie można wyświetlić podglądu zawartości; wystąpił błąd.",
        "filename" : "Localizable.loctable",
        "language" : "pl"
      },
      {
        "target" : "לא ניתן להציג תוכן זה בתצוגה מקדימה משום שאירעה שגיאה.",
        "filename" : "Localizable.loctable",
        "language" : "he"
      },
      {
        "target" : "由于发生错误，此内容无法预览。",
        "filename" : "Localizable.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Náhľad tohto obsahu sa nedá zobraziť, pretože sa vyskytla chyba.",
        "filename" : "Localizable.loctable",
        "language" : "sk"
      },
      {
        "target" : "Der kan ikke vises et eksempel på dette indhold, fordi der opstod en fejl.",
        "filename" : "Localizable.loctable",
        "language" : "da"
      },
      {
        "target" : "Bir hata oluştuğu için bu içeriğin önizlemesi gösterilemiyor.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "Ce contenu ne peut pas être prévisualisé car une erreur est survenue.",
        "filename" : "Localizable.loctable",
        "language" : "fr"
      },
      {
        "target" : "Цей вміст неможливо передоглянути, оскільки сталася помилка.",
