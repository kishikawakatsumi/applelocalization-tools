    "100212.title" : [
      {
        "target" : "Jos et tee mitään, tietokone käynnistyy uudelleen automaattisesti 10 minuutin kuluttua.",
        "filename" : "RestartScheduled.loctable",
        "language" : "fi"
      },
      {
        "target" : "Jika Anda tidak melakukan apa pun, komputer akan mulai ulang secara otomatis dalam 10 menit.",
        "filename" : "RestartScheduled.loctable",
        "language" : "id"
      },
      {
        "target" : "Se você não fizer nada, o computador reiniciará automaticamente em 10 minutos.",
        "filename" : "RestartScheduled.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "אם לא תגיב\/י, המחשב יופעל מחדש באופן אוטומטי בעוד 10 דקות.",
        "filename" : "RestartScheduled.loctable",
        "language" : "he"
      },
      {
        "target" : "Sans action de votre part, l’ordinateur redémarrera automatiquement dans 10 minutes.",
        "filename" : "RestartScheduled.loctable",
        "language" : "fr"
      },
      {
        "target" : "في حالة عدم القيام بأي إجراء، سيقوم الكمبيوتر بإعادة التشغيل تلقائيًا خلال ١٠ دقائق.",
        "filename" : "RestartScheduled.loctable",
        "language" : "ar"
      },
      {
        "target" : "Ako ništa ne učinite, računalo će se automatski ponovno uključiti za 10 minuta.",
        "filename" : "RestartScheduled.loctable",
        "language" : "hr"
      },
      {
        "target" : "Als je niets doet, wordt de computer over 10 minuten automatisch opnieuw opgestart.",
        "filename" : "RestartScheduled.loctable",
        "language" : "nl"
      },
      {
        "target" : "Se non fai nulla, il computer si riavvierà automaticamente tra 10 minuti.",
        "filename" : "RestartScheduled.loctable",
        "language" : "it"
      },
      {
        "target" : "何も操作をしないと、コンピュータは10分で自動的に再起動します。",
        "filename" : "RestartScheduled.loctable",
        "language" : "ja"
      },
      {
        "target" : "Počítač sa pri nečinnosti automaticky reštartuje po 10 minútach.",
        "filename" : "RestartScheduled.loctable",
        "language" : "sk"
      },
      {
        "target" : "Si no haces nada, la computadora se reiniciará automáticamente dentro de 10 minutos.",
        "filename" : "RestartScheduled.loctable",
        "language" : "es_419"
      },
      {
        "target" : "If you do nothing, the computer will restart automatically in 10 minutes.",
        "filename" : "RestartScheduled.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Jika anda tidak buat apa-apa, komputer akan mula semula secara automatik dalam 10 minit.",
        "filename" : "RestartScheduled.loctable",
        "language" : "ms"
      },
      {
        "target" : "Hvis du ikke foretager dig noget, starter computeren automatisk igen om 10 minutter.",
        "filename" : "RestartScheduled.loctable",
        "language" : "da"
      },
      {
        "target" : "Jeśli nie wykonasz żadnej czynności, komputer uruchomi się ponownie za 10 minut.",
