    "AMDSummary" : [
      {
        "target" : "Toiminto asettaa edellisen toiminnon antaman tekstin etummaisen TeXturi-dokumentin tekstiksi.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "Denne handlingen setter inn teksten videresendt fra forrige handling i det øverste Tekstredigering-dokumentet.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "Această acțiune configurează documentul TextEdit cel mai din față cu textul transmis din acțiunea anterioară.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      },
      {
        "target" : "פעולה זו מגדירה את מסמך ״עורך המלל״ הקדמי ביותר למלל המועבר מהפעולה הקודמת.",
        "filename" : "InfoPlist.loctable",
        "language" : "he"
      },
      {
        "target" : "Questa azione imposta il documento di TextEdit in primo piano con il testo dell'azione precedente.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Με αυτήν την ενέργεια, ορίζεται το έγγραφο TextEdit σε πρώτο πλάνο στο κείμενο που διαβιβάζεται από την προηγούμενη ενέργεια.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "Åtgärden infogar den text som överförs från föregående åtgärd i det översta dokumentet i Textredigerare.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Tindakan ini mengatur dokumen TextEdit paling depan menjadi teks yang diteruskan dari tindakan sebelumnya.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "前のアクションから渡されたテキストを最前面のテキストエディット書類に設定します。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "target" : "Denne handling indstiller det forreste TextEdit-dokument til teksten videreført fra den forrige handling.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "target" : "此動作會將最前方的「文字編輯」文件內容，設定至上一個動作傳來的文字。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Esta acción coloca el texto derivado de la acción anterior en el documento de TextEdit situado en primer plano.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "Ця дія додає поточний документ Мініредактора до тексту, отриманого в результаті попередньої дії.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "يقوم هذا الإجراء بتعيين مستند TextEdit الأمامي إلى النص الذي تم تمريره إليه من الإجراء السابق.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Ez a művelet az előző műveletből továbbított szövegre módosítja a legelső Szövegszerkesztő dokumentumot.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "Ta czynność ustala znajdujący się na wierzchu dokument TextEdit, jako docelowy dla tekstu przekazywanego z poprzedniej czynności.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "Esta ação altera o conteúdo do documento ativo no Editor de Texto para o texto passado da ação anterior.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Cette action définit le texte transmis par l’action précédente comme document TextEdit de premier plan.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Tác vụ này đặt tài liệu TextEdit ở phía trước nhất thành văn bản được chuyển vào từ tác vụ trước đó.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Aquesta acció ajusta el document de TextEdit obert en primer pla al text transferit des de l’acció anterior.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "Bei dieser Aktion wird der Text aus der vorherigen Aktion in das vorderste TextEdit-Dokument eingefügt.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "การทำงานนี้จะตั้งค่าเอกสาร TextEdit ด้านหน้าสุดให้เป็นข้อความที่ส่งผ่านมาจากการทำงานก่อนหน้า",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "target" : "Esta ação ajusta o documento do Editor de Texto em primeiro plano ao texto procedente da ação anterior.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt"
      },
      {
        "target" : "यह क्रिया सबसे सामने के TextEdit दस्तावेज़ को पिछली क्रिया से पास किए गए टेक्स्ट पर सेट करती है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Esta acción coloca el texto derivado de la acción anterior en el documento de TextEdit situado en primer plano.",
        "filename" : "InfoPlist.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Данное действие устанавливает активированный документ TextEdit для текста, переданного из следующего действия.",
        "filename" : "InfoPlist.loctable",
        "language" : "ru"
      },
      {
        "target" : "Tato akce vloží text předaný z předchozí akce do dokumentu TextEditu v popředí.",
