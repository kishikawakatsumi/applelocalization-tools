    "100221.title" : [
      {
        "target" : "Si vous ne faites rien, l’ordinateur suspendra automatiquement son activité dans 10 minutes.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Αν δεν κάνετε κάποια ενέργεια, ο υπολογιστής σας θα μεταβεί αυτόματα σε κατάσταση ύπνου σε 10 λεπτά.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "el"
      },
      {
        "target" : "何も操作をしないと、コンピュータは10分で自動的にスリープ状態になります。",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ja"
      },
      {
        "target" : "Si no haces nada, el ordenador entrará en reposo automáticamente dentro de 10 minutos.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "es"
      },
      {
        "target" : "If you do nothing, the computer will go to sleep automatically in 10 minutes.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Hiçbir şey yapmazsanız bilgisayar 10 dakika içinde otomatik olarak uyku durumuna geçecektir.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "tr"
      },
      {
        "target" : "Hvis du ikke foretager dig noget, går computeren automatisk på vågeblus om 10 minutter.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "da"
      },
      {
        "target" : "אם לא תגיב\/י, המחשב יעבור למצב שינה באופן אוטומטי בעוד 10 דקות.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "he"
      },
      {
        "target" : "Se non fai nulla, il computer entrerà in stop automaticamente tra 10 minuti.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "it"
      },
      {
        "target" : "Jika anda tidak buat apa-apa, komputer akan masuk tidur secara automatik dalam 10 minit.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ms"
      },
      {
        "target" : "若不執行任何動作，電腦將於10分鐘後自動進入睡眠。",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "If you do nothing, the computer will go to sleep automatically in 10 minutes.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Si no fas res, l’ordinador entrarà en repòs automàticament d’aquí a 10 minuts.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ca"
      },
      {
        "target" : "Als je niets doet, wordt de computer over 10 minuten automatisch in de sluimerstand gezet.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "nl"
      },
      {
        "target" : "Jeśli nie wykonasz żadnej czynności, komputer uśnie za 10 minut.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "pl"
      },
      {
        "target" : "Počítač pri nečinnosti automaticky zaspí po 10 minútach.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "sk"
      },
      {
        "target" : "Si no haces nada, la computadora entrará en reposo automáticamente dentro de 10 minutos.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Nếu bạn không thực hiện hành động nào, máy tính sẽ tự động chuyển sang chế độ ngủ trong 10 phút nữa.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "vi"
      },
      {
        "target" : "यदि आप कुछ नहीं करेंगे, तो कंप्यूटर 10 मिनट में ऑटोमैटिकली स्लीप मोड में चला जाएगा।",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "hi"
      },
      {
        "target" : "Якщо ви не відповісте, компʼютер засне автоматично через 10 хвилин.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "uk"
      },
      {
        "target" : "Если не производить никаких действий, компьютер автоматически перейдет в режим сна. До режима сна 10 мин.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ru"
      },
      {
        "target" : "如果你不执行任何操作，电脑将在10分钟后自动进入睡眠状态。",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "في حالة عدم القيام بأي إجراء، سيدخل الكمبيوتر في وضع الإسبات تلقائيًا خلال ١٠ دقائق.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ar"
      },
      {
        "target" : "Om du inte gör något kommer datorn automatiskt att gå i vila om 10 minuter.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "sv"
      },
      {
        "target" : "Jos et tee mitään, tietokone menee nukkumaan automaattisesti 10 minuutin kuluttua.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "fi"
      },
      {
        "target" : "Se você não fizer nada, o computador entrará em repouso automaticamente em 10 minutos.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Pokud nic neuděláte, počítač bude za 10 minut automaticky uspán.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "cs"
      },
      {
        "target" : "Dacă nu faceți nimic, computerul va intra în adormire automat peste 10 minute.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "ro"
      },
      {
        "target" : "Sans action de votre part, l’ordinateur suspendra automatiquement son activité dans 10 minutes.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "fr"
      },
      {
        "target" : "Hvis du ikke gjør noe, vil maskinen gå i dvale automatisk om 10 minutter.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "no"
      },
      {
        "target" : "Jika Anda tidak melakukan apa pun, komputer akan tidur secara otomatis dalam 10 menit.",
        "filename" : "GuestSleepScheduled.loctable",
        "language" : "id"
      },
      {
        "target" : "Se não efetuar qualquer ação, o computador entrará automaticamente em pausa dentro de 10 minutos.",
