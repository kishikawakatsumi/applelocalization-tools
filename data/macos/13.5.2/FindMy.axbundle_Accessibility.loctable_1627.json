    "distance.maximum.reached" : [
      {
        "target" : "वर्तमान में अधिकतम दूरी पर। इसे अधिक पर ऐडजस्ट नहीं किया जा सकता है।",
        "filename" : "Accessibility.loctable",
        "language" : "hi"
      },
      {
        "target" : "Maksimum distanse er nådd. Kan ikke justere høyere.",
        "filename" : "Accessibility.loctable",
        "language" : "no"
      },
      {
        "target" : "Currently at maximum distance. Cannot adjust any higher.",
        "filename" : "Accessibility.loctable",
        "language" : "en"
      },
      {
        "target" : "Максимальное расстояние. Перемещение дальше невозможно.",
        "filename" : "Accessibility.loctable",
        "language" : "ru"
      },
      {
        "target" : "Distance maximale atteinte. Impossible de l’augmenter davantage.",
        "filename" : "Accessibility.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Şu anda maksimum mesafede. Daha yükseğe ayarlanamıyor.",
        "filename" : "Accessibility.loctable",
        "language" : "tr"
      },
      {
        "target" : "تم بلوغ أقصى مسافة حاليًا. لا يمكن ضبطها أعلى من ذلك.",
        "filename" : "Accessibility.loctable",
        "language" : "ar"
      },
      {
        "target" : "Aktuell auf der größten Distanz, kann nicht höher eingestellt werden.",
        "filename" : "Accessibility.loctable",
        "language" : "de"
      },
      {
        "target" : "A la máxima distancia ahora mismo. No se puede ajustar a más.",
        "filename" : "Accessibility.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Pada jarak maksimum sekarang. Tidak boleh dilaraskan lebih tinggi.",
        "filename" : "Accessibility.loctable",
        "language" : "ms"
      },
      {
        "target" : "現在、最大距離です。これ以上大きくできません。",
        "filename" : "Accessibility.loctable",
        "language" : "ja"
      },
      {
        "target" : "Jelenleg a maximális távolság van beállítva. Nem állítható magasabb értékre.",
        "filename" : "Accessibility.loctable",
        "language" : "hu"
      },
      {
        "target" : "Hiện đang ở khoảng cách tối đa. Không thể điều chỉnh cao hơn.",
        "filename" : "Accessibility.loctable",
        "language" : "vi"
      },
      {
        "target" : "Foi atingida a distância máxima. Não é possível ajustar mais.",
        "filename" : "Accessibility.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Поточна відстань на максимумі. Неможливо зробити вище.",
        "filename" : "Accessibility.loctable",
        "language" : "uk"
      },
      {
        "target" : "נמצא כעת במרחק המקסימלי. לא ניתן לשנות לערך גבוה יותר.",
        "filename" : "Accessibility.loctable",
        "language" : "he"
      },
      {
        "target" : "目前位於最遠距離。無法再調整更多。",
        "filename" : "Accessibility.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Momenteel op maximale afstand. Kan niet verder worden aangepast.",
        "filename" : "Accessibility.loctable",
        "language" : "nl"
      },
      {
        "target" : "Έχει οριστεί η μέγιστη απόσταση. Δεν είναι δυνατή η περαιτέρω αύξηση.",
