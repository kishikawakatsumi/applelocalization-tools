    "controlRequestUnknown" : [
      {
        "target" : "Гостевой пользователь с адресом %@ запрашивает разрешение на общий доступ к Вашему экрану.\r\rНажмите «Общий экран», только если Вы знаете этого человека.",
        "filename" : "Localizable.loctable",
        "language" : "ru"
      },
      {
        "target" : "Osoitteesta %@ vieraileva käyttäjä pyytää lupaa jakaa näyttösi.\r\rKlikkaa ”Jaa näyttö” vain, jos olet varma, että tunnet tämän henkilön.",
        "filename" : "Localizable.loctable",
        "language" : "fi"
      },
      {
        "target" : "%@ adresinden bağlanan konuk kullanıcı ekranınızı paylaşma izni istiyor.\r\rYalnızca bu kişiyi tanıdığınızdan eminseniz Ekranı Paylaş’ı tıklayın.",
        "filename" : "Localizable.loctable",
        "language" : "tr"
      },
      {
        "target" : "En gjestebruker som er koblet til fra adressen %@, ber om tillatelse til å dele skjermen din.\r\rKlikk på Del skjerm kun hvis du er sikker på at du kjenner denne personen.",
        "filename" : "Localizable.loctable",
        "language" : "no"
      },
      {
        "target" : "Un utilizator vizitator care se conectează de la adresa %@ solicită permisiunea să partajeze ecranul dvs.\r\rFaceți clic pe Partajează ecranul doar în cazul în care cunoașteți cu certitudine această persoană.",
        "filename" : "Localizable.loctable",
        "language" : "ro"
      },
      {
        "target" : "Một người dùng khách kết nối từ địa chỉ %@ đang yêu cầu quyền chia sẻ màn hình của bạn.\r\rChỉ bấm Chia sẻ màn hình nếu bạn chắc chắn biết người này.",
        "filename" : "Localizable.loctable",
        "language" : "vi"
      },
      {
        "target" : "Un utilisateur invité se connectant avec l’adresse « %@ » demande l’autorisation de partager votre écran.\r\rNe cliquez sur Partage d’écran que si vous connaissez cette personne.",
        "filename" : "Localizable.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "En gästanvändare på adressen %@ ber om tillstånd att dela din skärm.\r\rKlicka inte på Dela skärm om du inte är säker på att du vet vem den här personen är.",
        "filename" : "Localizable.loctable",
        "language" : "sv"
      },
      {
        "target" : "Гість за адресою %@ просить дозвіл на доступ до вашого екрана.\r\rНатисніть «Надати доступ», якщо ви знаєте цю людину.",
        "filename" : "Localizable.loctable",
        "language" : "uk"
      },
      {
