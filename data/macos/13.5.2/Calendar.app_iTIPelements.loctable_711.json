    "100047.title" : [
      {
        "target" : "Denne kalender indeholder nye begivenheder. Vælg en modtagerkalender:",
        "filename" : "iTIPelements.loctable",
        "language" : "da"
      },
      {
        "target" : "Denne kalenderen inneholder nye hendelser. Velg en målkalender:",
        "filename" : "iTIPelements.loctable",
        "language" : "no"
      },
      {
        "target" : "このカレンダーには新規のイベントがあります。登録先にするカレンダーを選択してください:",
        "filename" : "iTIPelements.loctable",
        "language" : "ja"
      },
      {
        "target" : "Kalender ini berisi acara baru. Pilih kalender tujuan:",
        "filename" : "iTIPelements.loctable",
        "language" : "id"
      },
      {
        "target" : "Ten kalendarz zawiera nowe wydarzenia. Wybierz kalendarz docelowy:",
        "filename" : "iTIPelements.loctable",
        "language" : "pl"
      },
      {
        "target" : "Bu takvim yeni etkinlikler içeriyor. Lütfen bir hedef takvim seçin:",
        "filename" : "iTIPelements.loctable",
        "language" : "tr"
      },
      {
        "target" : "Lịch này có chứa sự kiện mới. Hãy chọn lịch đích:",
        "filename" : "iTIPelements.loctable",
        "language" : "vi"
      },
      {
        "target" : "Ez a naptár új eseményeket tartalmaz. Kérjük, jelöljön ki egy célnaptárt:",
        "filename" : "iTIPelements.loctable",
        "language" : "hu"
      },
      {
        "target" : "This calendar contains new events. Please select a destination calendar:",
        "filename" : "iTIPelements.loctable",
        "language" : "en_GB"
      },
