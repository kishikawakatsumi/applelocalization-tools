      },
      {
        "target" : "Chọn thiết bị Bluetooth từ danh sách thiết bị. Nếu bạn không tìm thấy thiết bị của mình, hãy đảm bảo thiết bị \"có thể tìm thấy\"",
        "filename" : "DeviceSelector.loctable",
        "language" : "vi"
      },
