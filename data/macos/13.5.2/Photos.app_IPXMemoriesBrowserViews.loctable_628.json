    "Ku7-j0-lri.title" : [
      {
        "target" : "Es kann eine Weile dauern, wenn deine Mediathek das erste Mal gescannt wird.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "de"
      },
      {
        "target" : "A pesquisa da fototeca pela primeira vez pode demorar algum tempo.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Перше сканування вашої фототеки може тривати певний час.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "uk"
      },
      {
        "target" : "Det kan tage et stykke tid at gennemsøge dit bibliotek første gang.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "da"
      },
      {
        "target" : "Ίσως χρειαστεί λίγος χρόνος για σάρωση της βιβλιοθήκης σας για πρώτη φορά.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "el"
      },
      {
        "target" : "Первое сканирование медиатеки может занять некоторое время.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "ru"
      },
      {
        "target" : "Het kan even duren om je bibliotheek voor de eerste keer te doorzoeken.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "nl"
      },
      {
        "target" : "Arşivinizin ilk kez taranması biraz zaman alabilir.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "tr"
      },
      {
        "target" : "Kirjaston käyminen läpi ensimmäistä kertaa saattaa kestää hetken.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "fi"
      },
      {
        "target" : "قد يستغرق فحص مكتبتك لأول مرة بعض الوقت.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "ar"
      },
      {
        "target" : "Prvo skeniranje vaše medijateke može potrajati neko vrijeme.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "hr"
      },
      {
        "target" : "आपकी लाइब्रेरी को पहली बार स्कैन करने में थोड़ा समय लग सकता है।",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "hi"
      },
      {
        "target" : "第一次掃描圖庫時可能需要一些時間。",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "การสแกนคลังของคุณเป็นครั้งแรกอาจใช้เวลาสักพัก",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "th"
      },
      {
        "target" : "Det kan ta en stund att söka igenom biblioteket för första gången.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "sv"
      },
      {
        "target" : "Có thể mất một lúc để quét thư viện của bạn trong lần đầu tiên.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "vi"
      },
      {
        "target" : "Det kan ta noe tid å søke gjennom biblioteket første gangen.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "no"
      },
      {
        "target" : "A könyvtár első beolvasása eltarthat egy ideig.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "hu"
      },
      {
        "target" : "La première analyse de votre bibliothèque peut prendre du temps.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "fr"
      },
      {
        "target" : "Prima scanare a bibliotecii poate dura mai mult.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "ro"
      },
      {
        "target" : "Pierwsze skanowanie biblioteki może trochę potrwać.",
        "filename" : "IPXMemoriesBrowserViews.loctable",
        "language" : "pl"
      },
      {
        "target" : "はじめてライブラリをスキャンするときは多少時間がかかることがあります。",
