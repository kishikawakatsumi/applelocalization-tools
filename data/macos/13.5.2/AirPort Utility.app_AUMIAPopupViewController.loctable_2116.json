    "15.title" : [
      {
        "target" : "%@ var tidigare en del av ditt nätverk. Kontrollera att den fortfarande är inom räckvidd och är ansluten till en strömkälla.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "sv"
      },
      {
        "target" : "%@ was previously part of your network. Check that it is still in range of your network and is plugged into a power point.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "%@ oli aiemmin osa verkkoasi. Tarkista, että se on yhä verkon kantaman sisällä ja että se on liitetty virtalähteeseen.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "fi"
      },
      {
        "target" : "Urządzenie %@ było wcześniej częścią Twojej sieci. Sprawdź, czy nadal jest w zasięgu sieci i czy jest podłączone do źródła zasilania.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "pl"
      },
      {
        "target" : "%@ sebelum ini adalah sebahagian daripada rangkaian anda. Semak sama ada ia masih dalam liputan rangkaian anda dan dipasang ke salur kuasa.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ms"
      },
      {
        "target" : "‏%@ היה פעם ברשת שלך. ודא\/י שהוא עדיין בטווח של הרשת ושהוא מחובר לחשמל.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "he"
      },
      {
        "target" : "%@ fazia parte de sua rede anteriormente. Certifique-se de que ainda esteja dentro do raio de alcance de sua rede e conectado a uma tomada.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "pt"
      },
      {
        "target" : "%@ var tidligere en del af dit netværk. Kontroller, at den stadig er inden for rækkevidde af netværket og er sluttet til en stikkontakt.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "da"
      },
      {
        "target" : "%@은(는) 이전에 사용자의 네트워크에 속해 있었습니다. 아직도 네트워크의 적용 범위 내에 있고 전원 콘센트에 연결되어 있는지 확인하십시오.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ko"
      },
      {
        "target" : "%@ faisait précédemment partie de votre réseau. Vérifiez que votre périphérique se trouve toujours dans le rayon de détection de votre réseau et est branché à une prise de courant.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "%@ a făcut parte anterior din rețeaua dvs. Verificați dacă mai este în raza de acțiune a rețelei și cuplat la o priză electrică.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ro"
      },
      {
        "target" : "%@ पहले आपके नेटवर्क में था। जाँच लें कि क्या यह अभी भी आपके नेटवर्क की रेंज में है और पावर आउटलेट में इसका प्लग लगा है।",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "hi"
      },
      {
        "target" : "%@ formaba parte de tu red. Comprueba que todavía se encuentra dentro del radio de alcance de la red y que está conectado a una toma de corriente.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "es"
      },
      {
        "target" : "A(z) %@ eddig a hálózat része volt. Ellenőrizze, hogy még mindig a hálózat hatókörében található-e, és be van-e dugva a konnektorba.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "hu"
      },
      {
        "target" : "%@ was previously part of your network. Check that it is still in range of your network and is plugged into a power point.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "“%@”は以前このネットワーク構成の一部でした。現在もネットワークの圏内にあること、および電源コンセントに接続されていることを確認してください。",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ja"
      },
      {
        "target" : "%@ formaba parte de tu red. Verifica que todavía se encuentra dentro del radio de alcance de la red y que tiene conexión a una toma de corriente.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "es_419"
      },
      {
        "target" : "%@ var tidligere en del av nettverket. Kontroller at enheten fortsatt er innenfor nettverkets rekkevidde og er koblet til et strømuttak.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "no"
      },
      {
        "target" : "%@ maakte voorheen deel uit van je netwerk. Controleer of het apparaat zich nog binnen bereik van het netwerk bevindt en of het is aangesloten op een stopcontact.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "nl"
      },
      {
        "target" : "%@ faisait précédemment partie de votre réseau. Vérifiez que votre périphérique se trouve toujours dans le rayon de détection de votre réseau et est branché à une prise de courant.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "fr"
      },
      {
        "target" : "%@ trước đây là một phần trong mạng của bạn. Hãy kiểm tra xem thiết bị này còn nằm trong phạm vi mạng của bạn và được cắm vào nguồn điện không.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "vi"
      },
      {
        "target" : "“%@”以前加入过你的网络。请检查它是否仍在网络范围内，并已插入电源插座。",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "「%@」之前是你網路的一部分。請檢查其是否仍在網路的通訊範圍內，並插入電源插座。",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "‏‪%@‬ كان جزءًا من الشبكة. تأكد من أنه لا يزال في نطاق الشبكة وأنه متصل بمصدر الطاقة.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ar"
      },
      {
        "target" : "Zariadenie %@ bolo súčasťou vašej siete. Skontrolujte, či je stále v dosahu siete a pripojené k zdroju napájania.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "sk"
      },
      {
        "target" : "%[tt]@อยู่ในรายการเครือข่ายของคุณก่อนหน้านี้ ให้ตรวจสอบว่า อุปกรณ์นั้นยังอยู่ในระยะเครือข่ายของคุณ และต่อกับเต้ารับไฟฟ้า",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "th"
      },
      {
        "target" : "Пристрій %@ раніше був частиною вашої мережі. Перевірте, чи він залишається в області дії мережі та чи підключений до джерела живлення.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "uk"
      },
      {
        "target" : "%@ gehörte zuvor zu deinem Netzwerk. Überprüfe, dass sich das Gerät weiterhin in Reichweite deines Netzwerks befindet und an der Stromversorgung angeschlossen ist.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "de"
      },
      {
        "target" : "Zařízení %@ bylo doposud součástí vaší sítě. Zkontrolujte, zda je stále v dosahu sítě a zda je zapojeno do zásuvky.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "cs"
      },
      {
        "target" : "「%@」之前是你網絡的一部份。請檢查裝置是否仍在網絡範圍內，並已插入電源插座。",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Το «%@» αποτελούσε στο παρελθόν μέρος του δικτύου σας. Ελέγξτε ότι βρίσκεται ακόμη εντός της εμβέλειας του δικτύου σας και ότι είναι συνδεδεμένο σε πρίζα ρεύματος.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "el"
      },
      {
        "target" : "%@ sebelumnya bagian dari jaringan Anda. Pastikan pemancar ini masih dalam cakupan jaringan Anda dan tersambung ke stop kontak.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "id"
      },
      {
        "target" : "Устройство «%@» ранее было частью Вашей сети. Проверьте, находится ли оно еще в зоне действия сети и подключено ли оно к электророзетке.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ru"
      },
      {
        "target" : "%@ formava part de la teva xarxa. Comprova que encara estigui a l’abast de la xarxa i connectada al corrent.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "ca"
      },
      {
        "target" : "%@ je prethodno bio dio vaše mreže. Provjerite je li još uvijek u dometu mreže i spojen na strujnu utičnicu.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "hr"
      },
      {
        "target" : "%@ daha önce ağınızın bir parçasıydı. Onun hâlâ ağınızın kapsama alanında ve bir elektrik prizine takılı olup olmadığını denetleyin.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "tr"
      },
      {
        "target" : "%@ faceva precedentemente parte della rete. Verifica che si trovi ancora nel raggio di azione della rete e sia collegato a un presa elettrica.",
        "filename" : "AUMIAPopupViewController.loctable",
        "language" : "it"
