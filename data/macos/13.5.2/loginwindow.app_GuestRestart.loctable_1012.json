        "language" : "no"
      },
      {
        "target" : "Si vous redémarrez, vos fichiers seront supprimés.",
        "filename" : "GuestRestart.loctable",
        "language" : "fr"
      },
      {
        "target" : "Si reinicias el ordenador, tus archivos se eliminarán.",
        "filename" : "GuestRestart.loctable",
        "language" : "es"
      },
      {
        "target" : "Jika anda mula semula, fail anda akan dipadamkan.",
        "filename" : "GuestRestart.loctable",
        "language" : "ms"
      },
      {
        "target" : "Se riavvii il computer, i file saranno eliminati.",
        "filename" : "GuestRestart.loctable",
        "language" : "it"
      },
      {
