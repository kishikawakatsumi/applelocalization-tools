        "language" : "ko"
      },
      {
        "target" : "再起動すると、ファイルが削除されます。",
        "filename" : "GuestRestart.loctable",
        "language" : "ja"
      },
      {
        "target" : "Ponowne uruchomienie komputera spowoduje usunięcie plików.",
