    "AMDSummary" : [
      {
        "target" : "Ця дія відправляє вихідні листи Пошти.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "This action sends the outgoing email messages in the Mail application.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "此操作将使用“邮件”应用程序来发送所有待发的电子邮件。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Åtgärden skickar utgående mejl i appen Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Esta acción envía los mensajes de correo salientes de la aplicación Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "es_419"
      },
      {
        "target" : "이 동작은 Mail 응용 프로그램에서 보내는 이메일 메시지를 전송합니다.",
        "filename" : "InfoPlist.loctable",
        "language" : "ko"
      },
      {
        "target" : "Esta ação envia as mensagens de e-mail de saída do aplicativo Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt"
      },
      {
        "target" : "這項動作會將所有「郵件」應用程式中的外寄電子郵件傳送出去。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Toiminto lähettää Mail-apissa olevat lähtevät sähköpostiviestit.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "Данное действие отправляет сообщения e-mail в Почте.",
        "filename" : "InfoPlist.loctable",
        "language" : "ru"
      },
      {
        "target" : "“メール”アプリケーションで送信メールメッセージを送信します。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "target" : "Tindakan ini mengirimkan pesan email keluar di aplikasi Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "Tato akce odešle odchozí e‑mailové zprávy z Mailu.",
        "filename" : "InfoPlist.loctable",
        "language" : "cs"
      },
      {
        "target" : "यह क्रिया मेल ऐप्लिकेशन में आउटगोइंग ईमेल संदेश भेजती है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Tác vụ này gửi các email đi trong ứng dụng Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "การทำงานนี้ส่งข้อความเมลออกในแอปพลิเคชันเมล",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "target" : "Bei dieser Aktion werden die ausgehenden E-Mails im Programm „Mail“ gesendet.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "Met deze taak verstuur je de uitgaande e-mailberichten in de app Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "nl"
      },
      {
        "target" : "Cette action expédie tous les courriels sortants de l’application Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Denne handling sender de udgående e-mailbeskeder i appen Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "target" : "Esta ação envia as mensagens de e‑mail que estiverem por enviar no Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "פעולה זו שולחת את הודעות הדוא״ל היוצאות ביישום ״דואר״.",
        "filename" : "InfoPlist.loctable",
        "language" : "he"
      },
      {
        "target" : "此動作會傳送「郵件」應用程式中的寄出電郵。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Με αυτήν την ενέργεια, γίνεται αποστολή των εξερχόμενων μηνυμάτων email στην εφαρμογή Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "This action sends the outgoing email messages in the Mail application.",
        "filename" : "InfoPlist.loctable",
        "language" : "en"
      },
      {
        "target" : "Esta acción envía los mensajes de correo salientes de la aplicación Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "Denne handlingen sender de utgående e-postmeldingene i Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "Táto akcia odošle odchádzajúce emailové správy v aplikácii Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "Questa azione invia i messaggi in uscita dell'applicazione Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Bu işlem, Mail uygulamasındaki giden e-posta iletilerini gönderir.",
        "filename" : "InfoPlist.loctable",
        "language" : "tr"
      },
      {
        "target" : "Această acțiune trimite mesajele e-mail în curs de expediere în aplicația Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      },
      {
        "target" : "This action sends the outgoing email messages in the Mail application.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Tindakan ini menghantar mesej e-mel keluar dalam aplikasi Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "ms"
      },
      {
        "target" : "Ez a művelet elküldi a kimenő e-mail-üzeneteket a Mail appban.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "يقوم هذا الإجراء بإرسال رسائل البريد الإلكتروني الصادرة في تطبيق البريد.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Ovim se postupkom šalju odlazne e-mail poruke iz aplikacije Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
        "target" : "Cette action expédie tous les e-mails sortants de l’application Mail.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "Ta czynność wysyła wychodzące wiadomości email w aplikacji Poczta.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "Aquesta acció envia els missatges de correu sortints de l’aplicació Mail.",
        "filename" : "InfoPlist.loctable",
