    "NSUserNotificationsUsageDescription" : [
      {
        "target" : "คุณจะได้รับการอัปเดตเกี่ยวกับคุณสมบัติที่ถูกปิดกั้นโดยล็อคดาวน์",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "target" : "Du erhältst Neuigkeiten über Funktionen, die vom Blockierungsmodus blockiert wurden.",
        "filename" : "InfoPlist.loctable",
        "language" : "de"
      },
      {
        "target" : "Ви отримуватимете актуальні відомості про функції, заблоковані режимом карантину.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "Recibirás actualizaciones de las funciones bloqueadas por el modo hermético.",
        "filename" : "InfoPlist.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Bạn sẽ nhận được các cập nhật về các tính năng đã bị chặn bởi Phong tỏa.",
        "filename" : "InfoPlist.loctable",
        "language" : "vi"
      },
      {
        "target" : "Вы будете получать оповещения о функциях, которые не работают в режиме блокировки.",
        "filename" : "InfoPlist.loctable",
        "language" : "ru"
      },
      {
        "target" : "Je ontvangt updates over functies die door de isolatiemodus zijn geblokkeerd.",
        "filename" : "InfoPlist.loctable",
        "language" : "nl"
      },
      {
        "target" : "Recibirás actualizaciones de las funciones que ha bloqueado el modo de aislamiento.",
        "filename" : "InfoPlist.loctable",
        "language" : "es"
      },
      {
        "target" : "Primit ćete ažuriranja o značajkama koje je Zaključavanje blokiralo.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
        "target" : "Rebràs actualitzacions sobre les funcions que el mode d’aïllament hagi bloquejat.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "You’ll get updates about features that have been blocked by Lockdown.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_GB"
      },
      {
        "target" : "Budete dostávat oznámení o funkcích, jejichž použití režim blokování zabránil.",
        "filename" : "InfoPlist.loctable",
        "language" : "cs"
      },
      {
        "target" : "차단 모드로 인해 차단된 기능에 대해 업데이트를 받게 됩니다.",
        "filename" : "InfoPlist.loctable",
        "language" : "ko"
      },
      {
        "target" : "You’ll get updates about features that have been blocked by Lockdown.",
        "filename" : "InfoPlist.loctable",
        "language" : "en"
      },
      {
        "target" : "针对被“锁定模式”阻止的功能，你将收到相关更新。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN"
      },
      {
        "target" : "Vous recevrez des alertes lorsque des fonctionnalités seront bloquées par le mode Isolement.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "יישלחו אליך עדכונים בנוגע למאפיינים שנחסמו על-ידי ״מצב נעילה״.",
        "filename" : "InfoPlist.loctable",
        "language" : "he"
      },
      {
        "target" : "Du får opdateringer om funktioner, der er blevet blokeret af Nedlukning.",
        "filename" : "InfoPlist.loctable",
        "language" : "da"
      },
      {
        "target" : "Anda akan menerima kemas kini tentang ciri yang telah disekat oleh Penyekatan.",
        "filename" : "InfoPlist.loctable",
        "language" : "ms"
      },
      {
        "target" : "Θα λαμβάνετε ενημερώσεις σχετικά με τις δυνατότητες που έχουν αποκλειστεί από την Απομόνωση.",
        "filename" : "InfoPlist.loctable",
        "language" : "el"
      },
      {
        "target" : "Du får uppdateringar om funktioner som har blockerats av Låst läge.",
        "filename" : "InfoPlist.loctable",
        "language" : "sv"
      },
      {
        "target" : "Riceverai aggiornamenti sulle funzionalità che sono state bloccate dall'isolamento.",
        "filename" : "InfoPlist.loctable",
        "language" : "it"
      },
      {
        "target" : "Będziesz otrzymywać powiadomienia o funkcjach zablokowanych przez tryb blokady.",
        "filename" : "InfoPlist.loctable",
        "language" : "pl"
      },
      {
        "target" : "Kilit Modu tarafından engellenen özellikler hakkında güncellemeler alırsınız.",
        "filename" : "InfoPlist.loctable",
        "language" : "tr"
      },
      {
        "target" : "Anda akan mendapatkan pembaruan mengenai fitur yang telah diblokir oleh Kuncitara.",
        "filename" : "InfoPlist.loctable",
        "language" : "id"
      },
      {
        "target" : "ستحصل على تحديثات عن الميزات التي حظرها نمط المنع.",
        "filename" : "InfoPlist.loctable",
        "language" : "ar"
      },
      {
        "target" : "Saat tiedotteita ominaisuuksista, jotka sulkutila on estänyt.",
        "filename" : "InfoPlist.loctable",
        "language" : "fi"
      },
      {
        "target" : "Receberá atualizações sobre funcionalidades que foram bloqueadas pelo modo de bloqueio.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_PT"
      },
      {
        "target" : "Vous recevrez des mises à jour sur les fonctionnalités bloquées par le mode de confinement.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Értesítéseket fog kapni a Zárt mód miatt letiltott funkciókról.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "ロックダウンによってブロックされている機能に関するアップデートを受け取ります。",
        "filename" : "InfoPlist.loctable",
        "language" : "ja"
      },
      {
        "target" : "你將會收到有關已被「封鎖模式」阻擋的功能更新項目。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "針對遭到「封閉模式」阻擋的功能，你會收到相關通知。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Du vil få oppdateringer om funksjoner som er blokkert av Sikringsmodus.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "आप उन फ़ीचर के बारे में अपडेट प्राप्त करेंगे जिन्हें लॉकडाउन से ब्लॉक कर दिया गया है।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "You’ll get updates about features that have been blocked by Lockdown.",
        "filename" : "InfoPlist.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Você receberá atualizações sobre os recursos que foram bloqueados pelo Modo de Bloqueio.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt_BR"
      },
      {
        "target" : "Budete dostávať hlásenia o funkciách, ktorých použitiu zabránil režim blokovania.",
        "filename" : "InfoPlist.loctable",
        "language" : "sk"
      },
      {
        "target" : "Veți primi actualizări despre funcționalitățile care au fost blocate de modul Izolare.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      }
    ],
