    "SWITCH_SOURCE_EARBUD_FOOTER_TEXT" : [
      {
        "target" : "Bruk Bryterkontroll ved hjelp av stemmen når AirPods er koblet til enheten.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "no"
      },
      {
        "target" : "Χρησιμοποιήστε τον Διακόπτη ελέγχου με οποιαδήποτε φωνητική εντολή όταν τα AirPods είναι ζευγοποιημένα με αυτήν τη συσκευή.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "el"
      },
      {
        "target" : "Use Switch Control by making any vocalization when your AirPods are paired to this device.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "en"
      },
      {
        "target" : "Sterowanie przełącznikami będzie reagować na Twój głos, gdy AirPods są połączone w parę z urządzeniem.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "pl"
      },
      {
        "target" : "ใช้การควบคุมสวิตช์โดยการพูดเมื่อ AirPods ของคุณจับคู่กับอุปกรณ์นี้",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "th"
      },
      {
        "target" : "Gunakan Kontrol Pengalihan dengan melakukan vokalisasi apa pun saat AirPods Anda dipasangkan ke perangkat ini.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "id"
      },
      {
        "target" : "Use Switch Control by making any vocalisation when your AirPods are paired to this device.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Käytä kytkinohjausta ääntelemällä, kun AirPods-kuulokkeista on tehty pari tämän laitteen kanssa.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "fi"
      },
      {
        "target" : "Gebruik schakelbediening door geluid te maken wanneer je AirPods zijn gekoppeld aan dit apparaat.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "nl"
      },
      {
        "target" : "आपके AirPods के इस डिवाइस से पेयर किए जाने पर कोई उच्चारण करके स्विच कंट्रोल का उपयोग करें।",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "hi"
      },
      {
        "target" : "ניתן להשתמש ב״בקרת מתגים״ על-ידי הפקת קול כאשר ה-AirPods מקושרים למכשיר זה.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "he"
      },
      {
        "target" : "Gunakan Kawalan Suis dengan menyebut sesuatu apabila AirPods anda dipasangkan ke peranti ini.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "ms"
      },
      {
        "target" : "Utilisez Contrôle de sélection en énonçant quelque chose lorsque vos AirPods sont jumelés à cet appareil.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Управляйте Виртуальным контроллером с помощью голоса, когда между наушниками AirPods и этим устройством создана пара.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "ru"
      },
      {
        "target" : "在AirPods與此裝置配對時，發出聲音來使用「切換控制」。",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "當你的AirPods與此裝置配對時，可透過任何説話來使用「切換控制」。",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "Benutze die Schaltersteuerung, indem du bei mit diesem Gerät gekoppelten AirPods Laute vokalisierst.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "de"
      },
      {
        "target" : "Usa la función Control por botón al hablar cuando tus AirPods se enlacen con este dispositivo.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Usa l'opzione “Controllo interruttori” con qualsiasi tipo di modulazione della voce quando gli AirPods sono connessi a questo dispositivo.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "it"
      },
      {
        "target" : "Use o Controle Assistivo fazendo qualquer vocalização quando os AirPods estiverem emparelhados com este dispositivo.",
        "filename" : "SwitchControl-b288.loctable",
        "language" : "pt"
