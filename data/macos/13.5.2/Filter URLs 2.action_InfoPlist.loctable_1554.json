    "AMDSummary" : [
      {
        "target" : "यह क्रिया निर्धारित करती है कि चयनित आइटम निर्दिष्ट मानदंडों को पूरा करते हैं या नहीं।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Ця дія відбирає елементи за заданими критеріями.",
        "filename" : "InfoPlist.loctable",
        "language" : "uk"
      },
      {
        "target" : "這項動作決定所選項目是否符合指定原則。",
        "filename" : "InfoPlist.loctable",
        "language" : "zh_TW"
      },
      {
        "target" : "Tindakan ini menentukan sama ada item dipilih memenuhi kriteria yang ditentukan.",
        "filename" : "InfoPlist.loctable",
        "language" : "ms"
      },
      {
        "target" : "Aquesta acció determina si els ítems seleccionats satisfan els criteris especificats.",
        "filename" : "InfoPlist.loctable",
        "language" : "ca"
      },
      {
        "target" : "Tato akce určí, zda vybrané položky vyhovují zadaným kritériím.",
        "filename" : "InfoPlist.loctable",
        "language" : "cs"
      },
      {
        "target" : "이 동작은 선택된 항목이 지정된 기준에 부합하는지 결정합니다.",
        "filename" : "InfoPlist.loctable",
        "language" : "ko"
      },
      {
        "target" : "Esta ação determina se os itens selecionados cumprem os critérios especificados.",
        "filename" : "InfoPlist.loctable",
        "language" : "pt"
      },
      {
        "target" : "Cette action détermine si les éléments sélectionnés répondent aux critères indiqués.",
        "filename" : "InfoPlist.loctable",
        "language" : "fr_CA"
      },
      {
        "target" : "Ez a művelet megállapítja, hogy a kijelölt elemek megfelelnek-e a megadott feltételeknek.",
        "filename" : "InfoPlist.loctable",
        "language" : "hu"
      },
      {
        "target" : "Această acțiune determină dacă articolele selectate îndeplinesc criteriile specificate.",
        "filename" : "InfoPlist.loctable",
        "language" : "ro"
      },
      {
        "target" : "Esta acción determina si los elementos seleccionados cumplen los criterios especificados.",
        "filename" : "InfoPlist.loctable",
        "language" : "es_419"
      },
      {
        "target" : "Bu işlem, seçilen öğelerin belirtilen ölçüte uyup uymadığını belirler.",
