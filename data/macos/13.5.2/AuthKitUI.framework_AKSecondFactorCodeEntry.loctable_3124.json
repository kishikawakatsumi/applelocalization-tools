    "ReO-2r-o9H.title" : [
      {
        "target" : "Your Apple ID can only be used from devices you approve.",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "Solo puedes usar tu ID de Apple desde dispositivos que hayas aprobado.",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "es"
      },
      {
        "target" : "Votre identifiant Apple ne peut être utilisé qu’avec les appareils que vous autorisez.",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "fr"
      },
      {
        "target" : "你的Apple ID只能用於你已許可的裝置。",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "zh_HK"
      },
      {
        "target" : "ID‑ul dvs. Apple poate fi utilizat doar de pe dispozitivele pe care le aprobați.",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "ro"
      },
      {
        "target" : "Deine Apple-ID kann nur auf Geräten verwendet werden, die du bestätigst.",
        "filename" : "AKSecondFactorCodeEntry.loctable",
        "language" : "de"
      },
      {
        "target" : "Dit Apple-id kan kun bruges på enheder, som du godkender.",
