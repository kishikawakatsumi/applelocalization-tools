      {
        "language" : "ro",
        "filename" : "Localizable.strings",
        "target" : "Vizualizați widgeturi utile, expuneți pozele favorite sau afișați ceasul perfect. Glisați spre stânga sau spre dreapta pentru a comuta între acestea."
      },
      {
        "filename" : "Localizable.strings",
        "language" : "hr",
        "target" : "Pogledajte korisne widgete, izložite omiljene fotografije ili podesite prikaz savršenog sata. Povucite ulijevo ili udesno kako biste ih izmijenili."
