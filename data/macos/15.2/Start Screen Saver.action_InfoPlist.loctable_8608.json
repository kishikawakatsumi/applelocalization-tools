  "localizations" : {
    "AMDSummary" : [
      {
        "language" : "el",
        "target" : "Με αυτήν την ενέργεια, εκτελείται η προφύλαξη οθόνης που επιλέχθηκε στον πίνακα προτιμήσεων για το «Γραφείο εργασίας και προφύλαξη οθόνης».",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "zh_TW",
        "target" : "這項動作將啟動「桌面與螢幕保護程式」偏好設定面板裡所選的螢幕保護程式。",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Ovim će se postupkom pokrenuti zaštita zaslona odabrana u prozoru postavki Radna površina i zaštita zaslona.",
        "filename" : "InfoPlist.loctable",
        "language" : "hr"
      },
      {
        "language" : "ro",
        "target" : "Această acțiune va porni screensaverul selectat din panoul de preferințe Desktop și screensaver.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ja",
        "target" : "“デスクトップとスクリーンセーバ”環境設定パネルで選択されているスクリーンセーバを開始します。",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Ta czynność uruchamia wygaszacz ekranu wybrany w panelu preferencji „Wygaszacz i biurko”",
        "language" : "pl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "en_GB",
        "filename" : "InfoPlist.loctable",
        "target" : "This action will start the screen saver selected in the Desktop & Screen Saver preference pane."
      },
      {
        "language" : "da",
        "filename" : "InfoPlist.loctable",
        "target" : "Denne handling vil starte den skærmskåner, der er valgt i vinduet Skrivebord & skærmskåner."
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "zh_CN",
        "target" : "此操作将启动在“桌面与屏幕保护程序”偏好设置面板中选定的屏幕保护程序。"
      },
      {
        "language" : "pt_PT",
        "target" : "Esta ação inicia a proteção de ecrã selecionada no painel de preferências Secretária e Proteção de Ecrã.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "tr",
        "filename" : "InfoPlist.loctable",
        "target" : "Bu işlem, Masaüstü ve Ekran Koruyucu tercih bölümünde seçilen ekran koruyucuyu başlatacaktır."
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Toiminto käynnistää Työpöytä ja näytönsäästö -osiossa valitun näytönsäästäjän.",
        "language" : "fi"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ko",
        "target" : "이 동작은 데스크탑 및 화면 보호기 환경설정 패널에서 선택된 화면 보호기를 시작합니다."
      },
      {
        "language" : "en_AU",
        "target" : "This action will start the screen saver selected in the Desktop & Screen Saver preference pane.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "zh_HK",
        "target" : "此動作將啟動「桌面與螢幕保護程式」偏好設定面板內所選的螢幕保護程式。",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sv",
        "target" : "Åtgärden startar den skärmsläckare som valts i inställningspanelen Skrivbord och skärmsläckare."
      },
      {
        "language" : "hu",
        "target" : "Ez a művelet elindítja az Íróasztal és képernyővédő beállításpanelen kijelölt képernyővédőt.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "id",
        "target" : "Tindakan ini akan memulai penghemat layar yang dipilih di panel preferensi Desktop & Penghemat Layar.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "es_419",
        "target" : "Esta acción inicia el protector de pantalla seleccionado en el panel de preferencias Escritorio y protector de pantalla.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "sk",
        "target" : "Táto akcia spustí šetrič obrazovky vybraný v paneli nastavení Plocha a šetrič obrazovky."
      },
      {
        "target" : "Tato akce spustí spořič obrazovky vybraný na panelu předvoleb Plocha a spořič.",
        "filename" : "InfoPlist.loctable",
        "language" : "cs"
      },
      {
        "target" : "פעולה זו תפעיל את שומר המסך שנבחר בחלונית ההעדפות ״מכתבה ושומר מסך״.",
        "language" : "he",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Questa azione avvierà il salvaschermo selezionato nel pannello delle preferenze Desktop e Salvaschermo.",
        "language" : "it",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "This action will start the screen saver selected in the Desktop & Screen Saver preference pane.",
        "language" : "en",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "यह क्रिया डेस्कटॉप और स्क्रीन सेवर प्राथमिकता पेन में चयनित स्क्रीन सेवर चालू करेगी।",
        "filename" : "InfoPlist.loctable",
        "language" : "hi"
      },
      {
        "target" : "Denne handlingen starter skjermspareren som er valgt i Skrivebord og skjermsparer-valgpanelet.",
        "filename" : "InfoPlist.loctable",
        "language" : "no"
      },
      {
        "target" : "Cette action démarre le nouvel économiseur d’écran choisi dans les Préférences Bureau et économiseur d’écran",
        "filename" : "InfoPlist.loctable",
        "language" : "fr"
      },
      {
        "target" : "Esta acción inicia el salvapantallas seleccionado en el panel de preferencias “Escritorio y salvapantallas”.",
        "language" : "es",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "fr_CA",
        "target" : "Cette action démarre le nouvel économiseur d’écran choisi dans la fenêtre de préférences Bureau  et économiseur d’écran.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "ar",
        "target" : "يبدأ هذا الإجراء في تشغيل شاشة التوقف المحددة في جزء التفضيلات سطح المكتب وشاشة التوقف."
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Tác vụ này sẽ khởi động trình bảo vệ màn hình đã chọn trong khung tùy chọn Màn hình nền & Trình bảo vệ màn hình.",
        "language" : "vi"
      },
      {
        "language" : "ms",
        "target" : "Tindakan ini akan memulakan penyelamat skrin yang dipilih dalam anak tetingkap keutamaan Desktop & Penyelamat Skrin.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "uk",
        "target" : "Ця дія запускає екранні заставки, вибрані в панелі параметрів «Робочий стіл і заставка».",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "S tem dejanjem se zažene ohranjevalnik zaslona, izbran v podoknu z nastavitvami Namizje in ohranjevalnik zaslona.",
        "language" : "sl",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "การทำงานนี้จะเริ่มภาพพักหน้าจอที่เลือกในบานหน้าต่างการตั้งค่าเดสก์ท็อปและภาพพักหน้าจอ",
        "filename" : "InfoPlist.loctable",
        "language" : "th"
      },
      {
        "filename" : "InfoPlist.loctable",
        "language" : "nl",
        "target" : "Met deze taak start je de schermbeveiliging die is geselecteerd in het paneel 'Bureaublad en schermbeveiliging' in Systeemvoorkeuren."
      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Aquesta acció activarà l’estalvi de pantalla seleccionat al tauler de preferències “Escriptori i estalvi de pantalla”.",
        "language" : "ca"
      },
      {
        "target" : "Bei dieser Aktion wird der Bildschirmschoner gestartet, der in der Systemeinstellung „Schreibtisch & Bildschirmschoner“ ausgewählt wurde.",
        "language" : "de",
        "filename" : "InfoPlist.loctable"
      },
      {
        "language" : "ru",
        "target" : "При выполнении данного действия будет запущена заставка экрана, выбранная в настройках «Рабочий стол и заставка».",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Esta ação iniciará o protetor de tela selecionado no painel de preferências Mesa e Protetor de Tela.",
