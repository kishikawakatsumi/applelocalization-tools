    "DriverKitSettings_FormDescription" : [
      {
        "language" : "de",
        "filename" : "DriverKitSettings.strings",
        "target" : "Treiber arbeiten im Hintergrund und erweitern die Funktionen deines Geräts. Apps können mit deren Hilfe mit externer Hardware kommunizieren."
      },
      {
        "target" : "Drivers work in the background to extend the functionality of your device. They allow apps to communicate with external hardware.",
        "filename" : "DriverKitSettings.strings",
        "language" : "en_AU"
      },
      {
        "language" : "ar",
        "target" : "تعمل برامج التشغيل في الخلفية لتوسيع وظائف جهازك، فهي تسمح للتطبيقات بالاتصال بالأجهزة الخارجية.",
        "filename" : "DriverKitSettings.strings"
      },
      {
        "filename" : "DriverKitSettings.strings",
        "language" : "ja",
        "target" : "ドライバはバックグラウンドで動作し、デバイスの機能を拡張します。ドライバによりアプリが外部ハードウェアと通信できるようになります。"
      },
      {
        "language" : "es_419",
        "target" : "Los drivers trabajan en segundo plano para extender la funcionalidad de tu dispositivo y permiten que las apps se comuniquen con hardware externo.",
        "filename" : "DriverKitSettings.strings"
      },
      {
        "language" : "zh_CN",
        "target" : "驱动程序会在后台工作，以扩展设备功能。它们可允许App与外接硬件通信。",
        "filename" : "DriverKitSettings.strings"
      },
      {
        "language" : "es",
        "filename" : "DriverKitSettings.strings",
        "target" : "Los drivers se ejecutan en segundo plano para mejorar la funcionalidad de tu dispositivo y permiten que las apps se comuniquen con el hardware externo."
      },
      {
        "filename" : "DriverKitSettings.strings",
        "language" : "it",
        "target" : "I driver vengono eseguiti in background per ampliare le funzionalità del dispositivo. Consentono alle app di comunicare con l’hardware esterno."
      },
      {
        "filename" : "DriverKitSettings.strings",
        "language" : "ko",
        "target" : "기기의 기능을 확장하기 위해 드라이버가 백그라운드에서 동작합니다. 드라이버는 앱이 외부 하드웨어와 커뮤니케이션하도록 허용합니다."
      },
      {
        "filename" : "DriverKitSettings.strings",
        "language" : "zh_HK",
        "target" : "在背景運作的驅動程式可延伸你的裝置功能，允許App與外置硬件通訊。"
      },
      {
        "target" : "在背景運作的驅動程式可延伸你的裝置功能，允許App與外接硬體通訊。",
        "language" : "zh_TW",
        "filename" : "DriverKitSettings.strings"
      },
      {
        "target" : "Drivers work in the background to extend the functionality of your device. They allow apps to communicate with external hardware.",
        "filename" : "DriverKitSettings.strings",
        "language" : "en_GB"
      },
      {
        "language" : "fr_CA",
        "target" : "Les pilotes fonctionnent en arrière-plan pour étendre la fonctionnalité de votre appareil. Ils permettent aux apps de communiquer avec des périphériques externes.",
        "filename" : "DriverKitSettings.strings"
      },
      {
        "language" : "fr",
        "target" : "Les gestionnaires sont exécutés en arrière-plan pour accroître les fonctionnalités de votre appareil. Ils autorisent notamment les apps à communiquer avec le matériel externe.",
        "filename" : "DriverKitSettings.strings"
      }
    ],
