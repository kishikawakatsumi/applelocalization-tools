    "ScreenTimeEnabledUserNotificationBody" : [
      {
        "language" : "de",
        "target" : "Erziehungsberechtigte können in Familienfreigabe die Bildschirmzeit und Wochenberichte sehen, App-Limits sowie diverse Beschränkungen festlegen.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Parents or guardians in Family Sharing can view your screen time and weekly reports, set app limits and set restrictions for content and privacy.",
        "filename" : "Localizable.strings",
        "language" : "en_AU"
      },
      {
        "target" : "يمكن للوالدين أو ولي الأمر في ميزة المشاركة العائلية الاطلاع على مدة استخدام الجهاز لديك والتقارير الأسبوعية الخاصة بك، وإعداد حدود التطبيقات ووضع قيود على المحتوى والخصوصية.",
        "filename" : "Localizable.strings",
        "language" : "ar"
      },
      {
        "language" : "ja",
        "filename" : "Localizable.strings",
        "target" : "ファミリー共有の親\/保護者は、画面を見ている時間および週間レポートの表示、アプリの制限の設定、コンテンツとプライバシーに関する制限の設定ができます。"
      },
      {
        "language" : "en",
        "filename" : "Localizable.strings",
        "target" : "Parents or guardians in Family Sharing can view your screen time and weekly reports, set app limits, and set restrictions for content and privacy."
      },
      {
        "target" : "Los padres o tutores en Compartir en familia pueden ver tu tiempo en pantalla y reportes semanales, definir límites para apps, y restringir contenido y privacidad.",
        "filename" : "Localizable.strings",
        "language" : "es_419"
      },
      {
        "target" : "“家人共享”中的父母或监护人可以查看你的屏幕使用时间和周报、设置App限额并为内容和隐私设定限制。",
        "language" : "zh_CN",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Los padres o tutores que utilicen “En familia” pueden ver tu tiempo de uso y tus informes semanales, establecer límites para las apps y definir restricciones de contenido y privacidad.",
        "filename" : "Localizable.strings",
        "language" : "es"
      },
      {
        "language" : "it",
        "target" : "I genitori\/tutori di “In famiglia” possono vedere tempo di utilizzo e resoconti settimanali, impostare limiti per le app e stabilire restrizioni per contenuti e privacy.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "ko",
        "filename" : "Localizable.strings",
        "target" : "가족 공유의 부모 또는 보호자가 사용자의 스크린 타임 및 주간 리포트를 보고, 앱 시간 제한을 설정하고, 콘텐츠 및 개인정보 보호 제한을 설정할 수 있습니다."
      },
      {
        "target" : "「家人共享」中的家長或監護人可以查看你的螢幕使用時間和每週報告、設定App限制，並設定內容和私隱限制。",
        "filename" : "Localizable.strings",
        "language" : "zh_HK"
      },
      {
        "target" : "「家人共享」中的家長或監護人可以檢視你的螢幕使用時間和每週報告、設定App限制，並設定內容和隱私權限制。",
        "filename" : "Localizable.strings",
        "language" : "zh_TW"
      },
      {
        "target" : "Los padres o tutores en Compartir en familia pueden ver tu tiempo en pantalla y reportes semanales, definir límites para apps, y restringir contenido y privacidad.",
        "filename" : "Localizable.strings",
        "language" : "es_US"
      },
      {
        "language" : "en_GB",
        "target" : "Parents or guardians in Family Sharing can view your screen time and weekly reports, set app limits, and set restrictions for content and privacy.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Partage familial permet aux parents de voir le temps d’écran et les rapports, et d’ajouter des limites d’apps et des restrictions de contenu et de confidentialité.",
        "language" : "fr_CA"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "fr",
        "target" : "Les parents\/tuteurs membres du partage familial peuvent voir votre temps d’écran et vos rapports hebdomadaires, et définir des limites d’app et des restrictions de contenu et de confidentialité."
      }
