{
  "localizations" : {
    "eed_onboarding_share_emergency_call_detail_watch_%@" : [
      {
        "language" : "de",
        "filename" : "Localizable-tinker.strings",
        "target" : "Deine Apple Watch kann automatisch die Informationen des Notfallpasses von %@ mit dem Rettungsdienst teilen, der diesen Anruf annimmt.\nDadurch kann die erforderliche Hilfe schneller eintreffen."
      },
      {
        "target" : "Apple Watch can automatically send the information in %@’s Medical ID to the dispatcher who answers ^[their](referentConcept: 1) call. \nThis can speed up the process of getting you the care you need.",
        "filename" : "Localizable-tinker.strings",
        "language" : "en_AU"
      },
      {
        "language" : "ar",
        "target" : "بإمكان Apple Watch إرسال المعلومات الموجودة في هوية %@ الطبية تلقائيًا إلى موظف خدمة الطوارئ الذي يرد على مكالمته.\nوبهذا يمكنك الحصول على الرعاية التي تحتاجها بصورة أسرع.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "filename" : "Localizable-tinker.strings",
        "target" : "%1$@さんのメディカルIDの情報を、%1$@さんの電話に応答する緊急通報指令係にApple Watchから自動的に送信できます。\nこれにより、あなたに必要な対応をするためのプロセスが短縮されます。",
        "language" : "ja"
      },
      {
        "target" : "Apple Watch can automatically send the information in %@’s Medical ID to the dispatcher who answers ^[their](referentConcept:1) call. \nThis can speed up the process of getting you the care you need.",
        "language" : "en",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "target" : "El Apple Watch puede enviar automáticamente la información de la ficha médica de %@ a quien responda su llamada.\nEsto puede agilizar el proceso para brindarle el cuidado que necesita.",
        "filename" : "Localizable-tinker.strings",
        "language" : "es_419"
      },
      {
        "language" : "zh_CN",
        "target" : "Apple Watch可自动将%@医疗急救卡中的信息发送给电话调度员。\n此功能可让你更快获得所需救护。",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "es",
        "target" : "El Apple Watch puede enviar automáticamente la información incluida en los datos médicos de %@ a la persona que atienda la llamada. \nDe ese modo, se podrá agilizar el proceso de asistencia necesaria.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "filename" : "Localizable-tinker.strings",
        "target" : "Apple Watch può inviare automaticamente le informazioni della cartella clinica di %@ alla persona che risponde alla chiamata. \nQuesto può velocizzare le operazioni di soccorso necessarie.",
        "language" : "it"
      },
      {
        "target" : "Apple Watch can automatically send the information in %@’s Medical ID to the operator who answers ^[their](referentConcept: 1) call. \nThis can speed up the process of getting you the care you need.",
        "language" : "en_IN",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "target" : "Apple Watch가 %@님의 전화에 응답하는 구조 차량 배차 담당자에게 해당 사용자의 의료 정보를 자동으로 보낼 수 있습니다.\n이를 통해 필요한 조치를 더욱 빠르게 제공받을 수 있습니다.",
        "filename" : "Localizable-tinker.strings",
        "language" : "ko"
      },
      {
        "filename" : "Localizable-tinker.strings",
        "target" : "Apple Watch可自動將%@的醫療檔案資料傳送給接聽電話的派遣員。\n這可加快向你提供所需救護的過程。",
        "language" : "zh_HK"
      },
      {
        "target" : "Apple Watch可自動傳送%@的「醫療卡」資訊給接聽電話的派遣員。\n這樣可加速取得所需救護的程序。",
        "filename" : "Localizable-tinker.strings",
        "language" : "zh_TW"
      },
      {
        "language" : "es_US",
        "target" : "El Apple Watch puede enviar automáticamente la información de la ficha médica de %@ a quien responda su llamada.\nEsto puede agilizar el proceso para brindarle el cuidado que necesita.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "en_GB",
        "target" : "Apple Watch can automatically send the information in %@’s Medical ID to the operator who answers ^[their](referentConcept: 1) call. \nThis can speed up the process of getting you the care you need.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "fr_CA",
        "filename" : "Localizable-tinker.strings",
        "target" : "L’Apple Watch peut automatiquement envoyer les informations de la fiche médicale ^[de %@](inflect: true) au répartiteur qui répond à l’appel. \nCela peut permettre que l’on vous prenne plus rapidement en charge."
      },
      {
        "language" : "fr",
        "filename" : "Localizable-tinker.strings",
        "target" : "L’Apple Watch peut envoyer automatiquement les renseignements de la fiche médicale ^[de %@](inflect: true) au coordinateur qui répond à son appel.\nCela peut accélérer sa prise en charge."
      }
    ],
    "TINKER_MEDICAL_ID_DETAIL" : [
      {
        "language" : "de",
        "target" : "Bei einem Notfall kann der Notfallpass durch Drücken der Seitentaste aufgerufen werden. Diese Informationen können den Ersthelfer:innen helfen, eine bessere Versorgung zu gewährleisten.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "en_AU",
        "target" : "In an emergency, Medical ID can be accessed by pressing the side button. This information can help first responders provide better care.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "ar",
        "filename" : "Localizable-tinker.strings",
        "target" : "في حالة الطوارئ، يمكن الوصول إلى هويتك الطبية بالضغط على الزر الجانبي. يمكن أن تساعد هذه المعلومات المسعفين الأوليين في تقديم رعاية صحية أفضل."
      },
      {
        "target" : "緊急時には、サイドボタンを押すとメディカルIDにアクセスできます。この情報は応急手当にあたってくれる人（ファーストレスポンダー）がより良い救護を行うのに役に立ちます。",
        "language" : "ja",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "target" : "In an emergency, Medical ID can be accessed by pressing the side button. This information can help first responders provide better care.",
        "language" : "en",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "es_419",
        "target" : "En caso de emergencia, se puede acceder a la ficha médica presionando el botón lateral. Esta información puede ayudar al personal de auxilio a brindar un mejor cuidado.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "zh_CN",
        "target" : "发生紧急状况时，可按下侧边按钮访问医疗急救卡。此信息有助于急救人员提供更好的救护。",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "target" : "En caso de emergencia, se puede acceder a los datos médicos pulsando el botón lateral. Esta información puede ayudar a los servicios de emergencia a proporcionar una mejor atención.",
        "language" : "es",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "filename" : "Localizable-tinker.strings",
        "language" : "it",
        "target" : "In caso di emergenza, è possibile accedere alla cartella clinica premendo il tasto laterale. Queste informazioni possono aiutare i soccorritori a offrire l’assistenza migliore."
      },
      {
        "language" : "en_IN",
        "filename" : "Localizable-tinker.strings",
        "target" : "In an emergency, Medical ID can be accessed by pressing the side button. This information can help first responders provide better care."
      },
      {
        "filename" : "Localizable-tinker.strings",
        "target" : "긴급상황이 발생한 경우 측면 버튼을 누르면 의료 정보에 접근할 수 있습니다. 이 정보는 긴급 구조원의 구조 활동에 도움이 될 수 있습니다.",
        "language" : "ko"
      },
      {
        "language" : "zh_HK",
        "target" : "在緊急情況下，按下側邊按鈕即可取用醫療急救卡。此資料有助急救人員提供更好的救護。",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "zh_TW",
        "filename" : "Localizable-tinker.strings",
        "target" : "緊急狀況時可按下側邊按鈕來取用「醫療卡」。此資訊可協助第一急救員提供更佳的醫療服務。"
      },
      {
        "target" : "En caso de emergencia, se puede acceder a la ficha médica presionando el botón lateral. Esta información puede ayudar al personal de auxilio a brindar un mejor cuidado.",
        "filename" : "Localizable-tinker.strings",
        "language" : "es_US"
      },
      {
        "language" : "en_GB",
        "target" : "In an emergency, Medical ID can be accessed by pressing the side button. This information can help first responders provide better care.",
        "filename" : "Localizable-tinker.strings"
      },
      {
        "language" : "fr_CA",
        "filename" : "Localizable-tinker.strings",
        "target" : "En cas d’urgence, la fiche médicale peut être consultée en appuyant sur le bouton latéral. Ces informations peuvent aider les premiers répondants à mieux vous soigner."
      },
      {
        "target" : "En cas d’urgence, la fiche médicale est accessible en appuyant sur le bouton latéral. Les informations contenues peuvent aider les équipes de premiers secours à prodiguer de meilleurs soins.",
        "language" : "fr",
        "filename" : "Localizable-tinker.strings"
      }
    ],
