    "OPEN_FAMILY_SETTINGS_DESCRIPTION" : [
      {
        "filename" : "Localizable.strings",
        "language" : "de",
        "target" : "Überprüfe, was Familienmitglieder teilen und worauf sie zugreifen können, und verwalte Einstellungen für Accounts von Kindern sowie die Kindersicherung."
      },
      {
        "target" : "See what family members can access and share, and manage child account settings and parental controls.",
        "filename" : "Localizable.strings",
        "language" : "en_AU"
      },
      {
        "target" : "معرفة ما يمكن لأفراد العائلة الوصول إليه ومشاركته، وإدارة إعدادات حسابات الأطفال والإشراف العائلي.",
        "filename" : "Localizable.strings",
        "language" : "ar"
      },
      {
        "language" : "ja",
        "target" : "ファミリーメンバーが何にアクセスや共有できるかを確認したり、お子様のアカウント設定やペアレンタルコントロールを管理することができます。",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "See what family members can access and share, and manage child account settings and parental controls.",
        "filename" : "Localizable.strings",
        "language" : "en"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Revisa lo que tus familiares pueden compartir o a lo que pueden acceder, y administra los controles parentales y la configuración de las cuentas para menores.",
        "language" : "es_419"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "zh_CN",
        "target" : "查看家庭成员可访问和共享的内容，以及管理儿童账户设置和家长控制。"
      },
      {
        "target" : "Consulta a qué pueden acceder y qué pueden compartir los miembros de tu familia, y gestiona los ajustes de las cuentas infantiles y los controles parentales.",
        "filename" : "Localizable.strings",
        "language" : "es"
      },
      {
        "language" : "it",
        "filename" : "Localizable.strings",
        "target" : "Rivedi i dati che possono condividere coloro che fanno parte della famiglia e quelli a cui possono accedere. Gestisci le impostazioni degli account per bambini e i controlli parentali."
