    "Aza-tI-YAn.title" : [
      {
        "target" : "Signa sobre un paper blanc.\nA continuació, situa’l de manera\nque sigui visible a la càmera.",
        "language" : "ca",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "pl",
        "target" : "Podpisz się na białej kartce.\nNastępnie przytrzymaj ją przed kamerą."
      },
      {
        "language" : "vi",
        "target" : "Ký tên bạn trên tờ giấy trắng.\nSau đó, giữ tờ giấy ở phía trước camera.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "target" : "Tandatangan nama anda pada kertas putih.\nKemudian tahan ia untuk kelihatan kepada kamera.",
        "language" : "ms",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "Semnați‑vă numele pe o hârtie albă.\nApoi țineți semnătura în câmpul vizual al camerei.",
        "language" : "ro"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "在白紙上簽名。\n然後將紙張顯示於相機前。",
        "language" : "zh_TW"
      },
      {
        "language" : "id",
        "target" : "Tanda tangani nama Anda di kertas putih.\nLalu angkat agar terlihat oleh kamera.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "fr",
        "target" : "Signez sur du papier blanc.\nMontrez ensuite ce papier à la caméra.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "ar",
        "target" : "قم بتوقيع اسمك على ورقة بيضاء.\nثم أمسك بها بحيث تكون ظاهرة للكاميرا."
      },
      {
        "language" : "uk",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "Поставте свій підпис на білому аркуші паперу.\nПотім розташуйте аркуш так, щоб підпис було видно в камеру."
      },
      {
        "target" : "Podepište se na bílém papíru.\nPoté papír podržte před kamerou.",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "cs"
      },
      {
        "target" : "在白紙上簽名。\n然後將紙張顯示於攝影機前。",
        "language" : "zh_HK",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "es_419",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "Firma en un papel blanco.\nLuego sostenlo para que la cámara lo pueda ver."
      },
      {
        "target" : "Sign your name on white paper.\nThen hold it to be visible to the camera.",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "白い紙に署名してください。次に、\nその紙をカメラに写るようにしたまま固定してください。",
        "language" : "ja",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "zh_CN",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "在白纸上签名。\n然后将白纸放到摄像头的捕捉范围内。"
      },
      {
        "language" : "en_GB",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "Sign your name on white paper.\nThen hold it so it’s visible to the camera."
      },
      {
        "target" : "सफ़ेद काग़ज़ पर अपने हस्ताक्षर करें।\nफिर कैमरे के सामने उसे रखें।",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "hi"
      },
      {
        "language" : "th",
        "target" : "เซ็นชื่อของคุณบนกระดาษสีขาว\nแล้วถือกระดาษแผ่นนั้นไว้ให้กล้องเห็นชัด",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "sl",
        "target" : "Podpišite se na bel papir.\nNato papir pridržite tako, da bo viden kameri."
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "sv",
        "target" : "Skriv din signatur på vitt papper.\nHåll sedan upp papperet framför kameran."
      },
      {
        "target" : "Skriv signaturen din på et hvitt ark.\nHold det deretter opp mot kameraet.",
        "language" : "no",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "ru",
        "target" : "Распишитесь на белой бумаге. Затем поднесите\nлист к камере так, чтобы было видно подпись.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "target" : "Podpíšte sa na biely papier.\nPotom podržte podpis pred kamerou.",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "sk"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "el",
        "target" : "Υπογράψτε το όνομά σας σε λευκό χαρτί.\nΜετά κρατήστε το έτσι ώστε να είναι ορατό στην κάμερα."
      },
      {
        "target" : "Signez sur du papier blanc.\nMontrez ensuite ce papier à la caméra.",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "fr_CA"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "target" : "Unterschreibe auf einem weißen Blatt Papier.\nHalte es anschließend gut sichtbar in die Kamera.",
        "language" : "de"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "pt_PT",
        "target" : "Assine o seu nome em papel branco.\nSegure o papel ao nível da câmara."
      },
      {
        "target" : "Zet je handtekening op een stuk wit papier\nen houd het papier voor de camera.",
        "language" : "nl",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "he",
        "target" : "חתום\/י את שמך על פיסת נייר לבן.\nלאחר\/י מכן, החזק\/י אותה מול המצלמה.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "language" : "it",
        "target" : "Scrivi la firma su un foglio bianco.\nQuindi mostrala alla fotocamera.",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "target" : "Írja le a nevét egy fehér papírra.\nTartsa a papírt a kamera elé.",
        "language" : "hu",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "target" : "Firma en un papel en blanco.\nA continuación, sostén el papel delante de la cámara.",
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "es"
      },
      {
        "target" : "Underskriv med dit navn på hvidt papir.\nHold det derefter op, så det er synligt for kameraet.",
        "language" : "da",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "tr",
        "target" : "Beyaz bir kâğıda imzanızı atın.\nSonra onu kamera tarafından görülebilecek şekilde tutun."
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "ko",
        "target" : "흰 종이에 이름을 서명하십시오.\n카메라 앞에 종이가 보이도록 들고 계십시오."
      },
      {
        "target" : "Kirjoita nimesi valkoiselle paperille.\nPidä paperia sen jälkeen siten, että kamera näkee sen.",
        "language" : "fi",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "target" : "Potpišite se na komadiću bijelog papira.\nZatim držite papir da bude vidljiv kameri.",
        "language" : "hr",
        "filename" : "AKSignatureCameraCaptureView.loctable"
      },
      {
        "filename" : "AKSignatureCameraCaptureView.loctable",
        "language" : "pt",
        "target" : "Assine seu nome em papel branco.\nDepois, segure-o voltado para a câmera."
      }
    ],
