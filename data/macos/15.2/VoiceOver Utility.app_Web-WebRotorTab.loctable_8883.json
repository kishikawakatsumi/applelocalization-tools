    "5504695.title" : [
      {
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "nl",
        "target" : "Schakel een onderdeel in of uit door het bijbehorende aankruisvak in of uit te schakelen. Met ⌘↑ en ⌘↓ kun je de volgorde van de onderdelen wijzigen."
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "항목을 활성화 또는 비활성화하려면 체크상자를 선택합니다. 항목 순서를 바꾸려면, ⌘↑ 및 ⌘↓를 사용합니다.",
        "language" : "ko"
      },
      {
        "target" : "Označite kućicu kako biste omogućili ili onemogućili stavku.\nZa promjenu redoslijeda stavki koristite ⌘↑ i ⌘↓.",
        "language" : "hr",
        "filename" : "Web-WebRotorTab.loctable"
      },
      {
        "language" : "pt",
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "Selecione uma caixa para ativar ou desativar um item. Para reordená-los, use ⌘↑ e ⌘↓."
      },
      {
        "target" : "选择复选框以启用或停用项目。若要将项目重新排序，请使用⌘↑键和⌘↓键。",
        "language" : "zh_CN",
        "filename" : "Web-WebRotorTab.loctable"
      },
      {
        "target" : "Επιλέξτε ένα πλαίσιο επιλογής για ενεργοποίηση ή απενεργοποίηση ενός στοιχείου. Για να αναδιατάξετε τα στοιχεία, χρησιμοποιήστε τους συνδυασμούς πλήκτρων ⌘↑ και ⌘↓.",
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "el"
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "कोई आइटम सक्षम या अक्षम करने के लिए चेकबॉक्स चुनें। आइटम को रीऑर्डर करने के लिए ⌘↑ और ⌘↓ उपयोग करें।",
        "language" : "hi"
      },
      {
        "language" : "es_US",
        "target" : "Selecciona una casilla para activar o desactivar un elemento.\nPara volver a ordenar los elementos, usa ⌘↑ y ⌘↓.",
        "filename" : "Web-WebRotorTab.loctable"
      },
      {
        "language" : "ms",
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "Pilih kotak semak untuk mendayakan atau menyahdayakan item. Untuk menyusun semula item, gunakan ⌘↑ dan ⌘↓."
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "zh_TW",
        "target" : "勾選註記框來啟用或停用項目。若要重新排序項目，請使用⌘↑和⌘↓。"
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "Select a tick box to enable or disable an item. To reorder the items, use ⌘↑ and ⌘↓.",
        "language" : "en_AU"
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "da",
        "target" : "Vælg et afkrydsningsfelt for at slå et emne til eller fra. Du ændrer rækkefølge på emnerne vha. ⌘↑ og ⌘↓."
      },
      {
        "target" : "Pilih kotak centang untuk mengaktifkan atau menonaktifkan item. Untuk mengurutkan ulang item, gunakan ⌘↑ dan ⌘↓.",
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "id"
      },
      {
        "filename" : "Web-WebRotorTab.loctable",
        "language" : "de",
        "target" : "Wähle ein Markierungsfeld aus, um ein Objekt zu aktivieren oder zu deaktivieren. Um die Objekte neu anzuordnen, verwende ⌘↑ und ⌘↓."
      },
      {
        "language" : "ca",
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "Selecciona una casella per activar o desactivar un ítem. Per reordenar els ítems, utilitza ⌘↑ i ⌘↓."
      },
      {
        "language" : "fi",
        "filename" : "Web-WebRotorTab.loctable",
        "target" : "Ota kohde käyttöön tai poista se käytöstä valitsemalla valintaneliö. Jos haluat muuttaa kohteiden järjestystä, paina ⌘↑ ja ⌘↓."
      },
      {
        "target" : "Zaškrtnutím políčka zapnete alebo zakážete položku. Na zmenu poradia položiek použite ⌘↑ a ⌘↓.",
        "language" : "sk",
        "filename" : "Web-WebRotorTab.loctable"
