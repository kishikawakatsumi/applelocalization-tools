        "language" : "de"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "en_AU",
        "target" : "A request for Guest User access has been sent to the owner of this Apple Vision Pro. Once they approve, you’ll capture your eye and hand set-up."
      },
      {
        "language" : "ar",
