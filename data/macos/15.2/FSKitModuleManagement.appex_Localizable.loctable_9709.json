        "filename" : "Localizable.loctable"
      },
      {
        "language" : "ar",
        "target" : "تسمح لك ملحقات نظام الملفات بتوسيع وظائف نظام الملفات في macOS دون الحاجة إلى الوصول على مستوى kernel.",
        "filename" : "Localizable.loctable"
      },
      {
        "filename" : "Localizable.loctable",
        "language" : "pl",
        "target" : "Rozszerzenia systemu plików umożliwiają rozszerzenie funkcjonalności systemu plików macOS bez konieczności dostępu na poziomie jądra."
      },
      {
        "language" : "es_419",
        "target" : "Las extensiones del sistema de archivos te permiten ampliar la funcionalidad del sistema de macOS sin requerir acceso al kernel.",
        "filename" : "Localizable.loctable"
