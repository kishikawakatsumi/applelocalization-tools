      {
        "filename" : "Localizable.strings",
        "language" : "es_419",
        "target" : "Puedes elegir los episodios y programas que quieres descargar automáticamente a tu Apple Watch."
      },
      {
        "target" : "Izberete lahko, katere epizode in oddaje naj se samodejno prenesejo v uro Apple Watch.",
