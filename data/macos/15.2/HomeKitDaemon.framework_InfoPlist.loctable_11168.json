      },
      {
        "filename" : "InfoPlist.loctable",
        "target" : "Az Otthon ennek az eszköznek a helyzetét használja a HomeKit-kompatibilis kiegészítőkhöz való csatlakozáshoz és azok automatizálásához.",
        "language" : "hu"
      },
      {
        "language" : "it",
        "filename" : "InfoPlist.loctable",
        "target" : "L’app Casa utilizza la posizione del dispositivo per connettersi agli accessori compatibili con HomeKit e automatizzarne l’uso."
      },
      {
        "language" : "pt",
        "target" : "O app Casa usa a localização deste dispositivo para conectar-se e para automatizar acessórios compatíveis com o HomeKit.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "target" : "Hjem bruker posisjonen til denne enheten for å koble til og automatisere HomeKit-aktiverte tilbehør.",
