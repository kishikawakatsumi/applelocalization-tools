  "localizations" : {
    "Reset Identifier Description" : [
      {
        "filename" : "Localizable.strings",
        "language" : "de",
        "target" : "Aktiviere diese Option, um die von Apple News und „Aktien“ verwendete ID zurückzusetzen und den Herausgebern von News Statistiken zu melden. Die ID wird beim nächsten Öffnen von Apple „Aktien“ zurückgesetzt."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Turn on to reset the identifier used by Apple News and Stocks to report statistics to news publishers. The identifier will be reset the next time you open Apple Stocks.",
        "language" : "en_AU"
      },
      {
        "target" : "يجب التشغيل لإعادة تعيين المعرّف الذي تستخدمه Apple News وتطبيق الأسهم لإرسال الإحصائيات إلى ناشري الأخبار. سيتم إعادة تعيين المعرّف في المرة القادمة التي تفتح فيها Apple Stocks.",
        "filename" : "Localizable.strings",
        "language" : "ar"
      },
      {
        "target" : "Apple Newsと“株価”で統計レポートをニュース提供元に報告するのに使用されている識別子をリセットするにはオンにします。識別子は“株価”を次回開いたときにリセットされます。",
        "filename" : "Localizable.strings",
        "language" : "ja"
      },
      {
        "language" : "en",
        "target" : "Turn on to reset the identifier used by Apple News and Stocks to report statistics to news publishers. The identifier will be reset the next time you open Apple Stocks.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "es_419",
        "target" : "Activa para restablecer el identificador que usan Apple News y Bolsa para reportar estadísticas a los editores de noticias. El identificador se restablecerá la próxima vez que abras la app Bolsa.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "zh_CN",
        "filename" : "Localizable.strings",
        "target" : "打开以还原Apple News和“股市”用于向新闻发行机构报告数据的标识符。下次打开Apple“股市”时，标识符将还原。"
      },
      {
        "language" : "es",
        "filename" : "Localizable.strings",
        "target" : "Activa esta opción para restablecer el identificador usado por Apple News y Bolsa para enviar estadísticas a los editores de noticias. El identificador se restablecerá la próxima vez que abras la app Bolsa."
      },
      {
        "target" : "Attiva l’opzione per inizializzare l’identificativo utilizzato da Apple News e Borsa per fornire statistiche a chi pubblica le notizie. L’operazione verrà completata la prossima volta che apri Borsa.",
        "filename" : "Localizable.strings",
        "language" : "it"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "en_IN",
        "target" : "Turn on to reset the identifier used by Apple News and Stocks to report statistics to news publishers. The identifier will be reset the next time you open Apple Stocks."
      },
      {
        "language" : "ko",
        "target" : "Apple News 및 주식 앱이 뉴스 발행인에게 통계 관련 정보를 리포트하는 데 사용하는 식별자를 재설정하려면 켜십시오. 다음번에 Apple 주식을 열 때 식별자가 재설정됩니다.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "zh_HK",
        "target" : "開啟以重設Apple News和「股市」用於回報統計資料予新聞出版社的識別碼。識別碼會在你下次打開Apple「股市」時重設。",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "開啟來重置Apple News和「股市」所用的識別碼以將統計資料回報給新聞出版商。識別碼會在你下次打開「股市」時重置。",
        "filename" : "Localizable.strings",
        "language" : "zh_TW"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "en_GB",
        "target" : "Turn on to reset the identifier used by Apple News and Stocks to report statistics to news publishers. The identifier will be reset the next time you open Apple Stocks."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Activez cette option afin de réinitialiser l’identifiant utilisé par Apple News et Bourse pour transmettre des statistiques aux éditeurs de nouvelles. L’identifiant sera réinitialisé lors de la prochaine ouverture de Bourse.",
        "language" : "fr_CA"
      },
      {
        "language" : "fr",
        "filename" : "Localizable.strings",
        "target" : "Activez cette option pour réinitialiser l’identifiant utilisé par Apple News et Bourse pour la transmission de statistiques aux éditeurs. La réinitialisation aura lieu à la prochaine ouverture de l’app Bourse."
