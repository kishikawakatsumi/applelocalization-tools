      {
        "filename" : "Accessibility.strings",
        "language" : "uk",
        "target" : "Прикладіть задню камеру до центра своєї картки, а потім повільно відведіть iPhone назад."
      },
      {
        "target" : "Apunta al centro de la tarjeta con la cámara posterior y luego desplaza lentamente hacia atrás tu iPhone.",
        "filename" : "Accessibility.strings",
        "language" : "es_419"
      },
      {
        "language" : "zh_CN",
