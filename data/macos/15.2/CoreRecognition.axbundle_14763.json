    "camera.scan.card.hint" : [
      {
        "target" : "Platziere die rückseitige Kamera auf der Mitte deiner Karte und ziehe dein iPhone dann langsam zurück.",
        "language" : "de",
        "filename" : "Accessibility.strings"
      },
      {
        "target" : "יש להניח את המצלמה האחורית על מרכז הכרטיס שלך. לאחר מכן, יש להרחיק את ה-iPhone באיטיות.",
        "language" : "he",
        "filename" : "Accessibility.strings"
      },
      {
        "language" : "en_AU",
        "filename" : "Accessibility.strings",
        "target" : "Place your back-facing camera on the centre of your card. Then, slowly pull your iPhone back."
      },
      {
        "target" : "ركز الكاميرا الخلفية على منتصف البطاقة، ثم اسحب iPhone للخلف ببطء.",
        "filename" : "Accessibility.strings",
        "language" : "ar"
      },
      {
        "language" : "el",
        "filename" : "Accessibility.strings",
        "target" : "Τοποθετήστε την πίσω κάμερα στο κέντρο της κάρτας. Μετά, τραβήξτε αργά το iPhone προς τα πίσω."
      },
      {
        "filename" : "Accessibility.strings",
        "language" : "ja",
        "target" : "背面カメラをカードの中央に置いてから、iPhoneをゆっくりとカードから離してください。"
