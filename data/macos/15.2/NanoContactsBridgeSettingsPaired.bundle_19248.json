    "SHORT_NAME_FORMAT_EXPLANATORY" : [
      {
        "target" : "A veces, los nombres se acortan para ahorrar espacio en la pantalla. Esto no afecta los nombres chinos, japoneses y coreanos.",
        "filename" : "NanoContactsBridgeSettingsPaired.strings",
        "language" : "es_419"
      },
      {
        "filename" : "NanoContactsBridgeSettingsPaired.strings",
        "target" : "Kratka imena se včasih uporabljajo za prikaz več imen na zaslonu. Ta nastavitev ne vpliva na kitajska, japonska in korejska imena.",
