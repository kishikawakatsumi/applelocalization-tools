    "DATA_SHARING_OPT_IN_BODY" : [
      {
        "language" : "de",
        "target" : "Hilf mit, Siri und die Diktierfunktion zu verbessern, indem du Apple erlaubst, Audiointeraktionen mit Siri, der Diktier- sowie der Übersetzungsfunktion auf dieser Apple Watch zu speichern und zu prüfen.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "he",
        "target" : "באפשרותך לעזור לשפר את Siri ואת ״הכתבה״ על ידי מתן הרשאה ל-Apple לשמור ולבדוק את השמע של האינטראקציות שלך עם Siri, עם ״הכתבה״ ועם ״תרגום״ ב-Apple Watch זה."
      },
      {
        "language" : "en_AU",
        "target" : "Help improve Siri and Dictation by allowing Apple to store and review audio interactions with Siri, Dictation and Translate on this Apple Watch.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "ساعد في تحسين Siri والإملاء عن طريق السماح لشركة Apple بتخزين ومراجعة تفاعلاتك الصوتية مع Siri والإملاء والترجمة على هذه الـ Apple Watch.",
        "language" : "ar"
      },
      {
        "target" : "Βοηθήστε στη βελτίωση του Siri και της Υπαγόρευσης επιτρέποντας στην Apple να αποθηκεύει και να εξετάζει τις ηχητικές αλληλεπιδράσεις με το Siri, την Υπαγόρευση και τη Μετάφραση σε αυτό το Apple Watch.",
        "filename" : "Localizable.strings",
        "language" : "el"
      },
      {
        "language" : "ja",
        "target" : "Siri、音声入力、翻訳に対する操作の音声をこのApple Watchからオーディオ収録したものを、Appleが保存しレビューすることを許可することで、Siriと音声入力の改善にご協力いただけます。",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "en",
        "target" : "Help improve Siri and Dictation by allowing Apple to store and review audio interactions with Siri, Dictation, and Translate on this Apple Watch.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Допомагайте вдосконалювати Siri й Диктування, дозволивши Apple зберігати й аналізувати аудіозаписи ваших взаємодій із Siri, Диктуванням і Перекладом із цього Apple Watch.",
        "language" : "uk",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "es_419",
        "target" : "Ayuda a mejorar Siri y Dictado al permitirle a Apple almacenar y revisar audio de tus interacciones con Siri, Dictado y Traducir en este Apple Watch.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "允许Apple储存和检查此Apple Watch上与Siri、“听写”和“翻译”的交互音频，帮助改进Siri和“听写”。",
        "filename" : "Localizable.strings",
        "language" : "zh_CN"
      },
      {
        "language" : "es",
        "target" : "Ayuda a mejorar Siri y Dictado permitiendo a Apple almacenar y revisar el audio de tus interacciones con Siri, Dictado y Traducir en este Apple Watch.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "sl",
        "target" : "Dovolite družbi Apple, da shranjuje in pregleduje zvočne komunikacije s Siri, funkcijo Narekovanje ter Prevajalnikom v tej uri Apple Watch, ter tako pomagajte izboljšati Siri in funkcijo Narekovanje.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "pt_BR",
        "target" : "Para ajudar a melhorar a Siri e o Ditado, permita que a Apple armazene e revise as interações de áudio com esses dois recursos e o app Traduzir neste Apple Watch."
      },
      {
        "language" : "da",
        "filename" : "Localizable.strings",
        "target" : "Hjælp med at forbedre Siri og Diktering ved at tillade Apple at opbevare og gennemgå lyd fra dine interaktioner med Siri, Diktering og Oversæt på dette Apple Watch."
