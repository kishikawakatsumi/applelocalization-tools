      },
      {
        "language" : "fi",
        "target" : "Avaa Ohjauskeskus pitämällä @@TV@@ painettuna kaukosäätimessä. Ohjauskeskuksessa voit vaihtaa käyttäjää, laittaa laitteen nukkumaan ja muuta",
        "filename" : "Localizable.strings"
