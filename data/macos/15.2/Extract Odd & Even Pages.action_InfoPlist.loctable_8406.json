        "language" : "sl"
      },
      {
        "language" : "hu",
        "target" : "Ezzel a művelettel kigyűjtheti a páros vagy páratlan oldalakat egy adott PDF-dokumentumból, majd az oldalakból új PDF-dokumentumot hozhat létre.",
        "filename" : "InfoPlist.loctable"
      },
      {
        "filename" : "InfoPlist.loctable",
