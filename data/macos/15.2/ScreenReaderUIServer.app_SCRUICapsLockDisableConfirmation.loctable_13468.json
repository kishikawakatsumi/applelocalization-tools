    "w1n-Mh-Ulf.title" : [
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "he",
        "target" : "‏VoiceOver הוגדר לשימוש ב-Caps Lock ככפתור לשינוי. האם ברצונך להשתמש בכפתורים Control ו-Option במקום?"
      },
      {
        "target" : "VoiceOver está configurado para usar Bloqueo de Mayúsculas como la tecla modificadora. ¿Quieres usar las teclas Control y Opción en su lugar?",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "es_419"
      },
      {
        "language" : "fr",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "VoiceOver est configuré de telle sorte que la touche Verr. Maj. est la touche de modification VoiceOver. Voulez-vous utiliser les touches Contrôle et Option à la place ?"
      },
      {
        "language" : "zh_TW",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "target" : "「旁白」是設定為使用大寫鎖定鍵做為「旁白」變更鍵。你要改用Control和Option鍵嗎？"
      },
      {
        "language" : "fi",
        "target" : "VoiceOver on asetettu käyttämään caps lock -näppäintä VoiceOver-muuntonäppäimenä. Käytetäänkö sen sijaan ctrl- tai optionäppäintä?",
        "filename" : "SCRUICapsLockDisableConfirmation.loctable"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
        "language" : "pt",
        "target" : "O VoiceOver está configurado para usar a tecla Caps Lock como modificador do VoiceOver. Deseja usar Control e Option ao invés?"
      },
      {
        "filename" : "SCRUICapsLockDisableConfirmation.loctable",
