  "framework" : "EventKitTCCFullAccessNotificationUIExtension.appex",
  "bundlePath" : "\/Library\/Developer\/CoreSimulator\/Volumes\/iOS_22C150\/Library\/Developer\/CoreSimulator\/Profiles\/Runtimes\/iOS 18.2.simruntime\/Contents\/Resources\/RuntimeRoot\/System\/Library\/PrivateFrameworks\/EventKitTCCUI.framework\/PlugIns\/EventKitTCCFullAccessNotificationUIExtension.appex",
  "localizations" : {
    "Calendar events may include additional data, such as locations, email addresses, or notes." : [
      {
        "target" : "Kalenderereignisse können zusätzliche Daten wie Orte, E‑Mail-Adressen oder Notizen enthalten.",
        "filename" : "Localizable.strings",
        "language" : "de"
      },
      {
        "language" : "he",
        "filename" : "Localizable.strings",
        "target" : "אירועי לוח שנה עשויים לכלול נתונים נוספים כגון פרטי מיקום, כתובות דוא״ל או פתקים."
      },
      {
        "target" : "Calendar events may include additional data, such as locations, email addresses or notes.",
        "filename" : "Localizable.strings",
        "language" : "en_AU"
      },
      {
        "language" : "ar",
        "target" : "قد تتضمن أحداث التقويم بيانات إضافية مثل المواقع أو عناوين البريد الإلكتروني أو الملاحظات.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Τα γεγονότα Ημερολογίου ενδέχεται να περιλαμβάνουν επιπρόσθετα δεδομένα, όπως τοποθεσίες, διευθύνσεις email ή σημειώσεις.",
        "language" : "el"
      },
      {
        "target" : "カレンダーの予定には、場所、メールアドレス、メモなどの追加データが含まれる場合があります。",
        "filename" : "Localizable.strings",
        "language" : "ja"
      },
      {
        "target" : "Calendar events may include additional data, such as locations, email addresses, or notes.",
        "language" : "en",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Події календаря можуть містити додаткові дані, як‑от місця, е‑адреси або примітки.",
        "filename" : "Localizable.strings",
        "language" : "uk"
      },
      {
        "target" : "Los eventos del calendario podrían incluir datos adicionales como ubicaciones, direcciones de correo o notas.",
        "filename" : "Localizable.strings",
        "language" : "es_419"
      },
      {
        "language" : "zh_CN",
        "target" : "日历日程可能包括额外数据，例如位置、电子邮件地址或备注。",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "es",
        "filename" : "Localizable.strings",
        "target" : "Los eventos del calendario pueden incluir datos adicionales, como ubicaciones, direcciones de correo electrónico o notas."
      },
      {
        "filename" : "Localizable.strings",
        "language" : "sl",
        "target" : "Dogodki v koledarju lahko vključujejo dodatne podatke, kot so lokacije, e-poštni naslovi ali zapiski."
      },
      {
        "language" : "pt_BR",
        "target" : "Os eventos do calendário podem incluir dados adicionais, como localizações, endereços de e‑mail ou notas.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Kalenderbegivenheder indeholder muligvis yderligere data, f.eks. lokaliteter, e‑mailadresser eller noter.",
        "language" : "da"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "it",
        "target" : "Gli eventi del calendario potrebbero includere altri dati, come posizioni, indirizzi email o note."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Събитията от календара може да включват допълнителни данни като местоположения, имейл адреси или бележки.",
        "language" : "bg"
      },
      {
        "language" : "sk",
        "target" : "Súčasťou udalostí kalendára môžu byť ďalšie dáta, napríklad miesta, emailové adresy alebo poznámky.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Күнтізбе оқиғалары геолокациялар, эл. пошта мекенжайлары немесе жазбалар сияқты қосымша деректерді қамтуы мүмкін.",
        "language" : "kk",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Os eventos do calendário podem incluir dados adicionais, como localizações, endereços de e‑mail ou notas.",
        "filename" : "Localizable.strings",
        "language" : "pt_PT"
      },
      {
        "language" : "ms",
        "target" : "Peristiwa kalendar mungkin termasuk data tambahan, seperti lokasi, alamat e‑mel atau nota.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "sv",
        "target" : "Kalenderaktiviteter kan innehålla ytterligare data, till exempel platsinformation, e-postadresser eller anteckningar."
      },
      {
        "language" : "cs",
        "filename" : "Localizable.strings",
        "target" : "Události v kalendáři můžou obsahovat dodatečná data, jako jsou místa, e‑mailové adresy nebo poznámky."
      },
      {
        "filename" : "Localizable.strings",
        "language" : "ko",
        "target" : "캘린더 이벤트에는 위치, 이메일 주소 또는 메모 등의 추가적인 데이터가 포함될 수 있습니다."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Kalender­hendelser kan inneholde tilleggsdata som sted, e‑postadresser og notater.",
        "language" : "no"
      },
      {
        "target" : "A naptáreseményekben további adatok szerepelhetnek, például helyzetek, e-mail-címek vagy jegyzetek.",
        "filename" : "Localizable.strings",
        "language" : "hu"
      },
      {
        "language" : "zh_HK",
        "target" : "日曆行程可能包括其他資料，例如位置、電郵地址或備註等。",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Takvim etkinlikleri; konum, e-posta adresleri veya notlar gibi ek veriler içerebilir.",
        "filename" : "Localizable.strings",
        "language" : "tr"
      },
      {
        "language" : "pl",
        "target" : "Wydarzenia kalendarza mogą zawierać dodatkowe dane, na przykład położenie, adresy email lub notatki.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "行事曆行程可能包含其他資料，例如地點、電子郵件地址或附註。",
        "filename" : "Localizable.strings",
        "language" : "zh_TW"
      },
      {
        "language" : "en_GB",
        "target" : "Calendar events may include additional data, such as locations, email addresses or notes.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Các sự kiện lịch có thể bao gồm dữ liệu bổ sung, ví dụ như vị trí, địa chỉ email hoặc ghi chú.",
        "language" : "vi",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Kalendoriaus įvykiuose gali būti papildomų duomenų, pvz., vietovės, el. pašto adresai arba užrašai.",
        "language" : "lt"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "События календаря могут содержать дополнительные данные, такие как геопозиции, адреса электронной почты или заметки.",
        "language" : "ru"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "fr_CA",
        "target" : "Les événements de calendrier peuvent inclure des données supplémentaires telles que des lieux, des adresses courriel ou des notes."
      },
      {
        "target" : "Les évènements du calendrier peuvent inclure des données supplémentaires telles que des lieux, des adresses e-mail ou des notes.",
        "filename" : "Localizable.strings",
        "language" : "fr"
      },
      {
        "target" : "Kalenteritapahtumat saattavat sisältää lisätietoja, kuten sijainteja, sähköpostiosoitteita tai muistiinpanoja.",
        "filename" : "Localizable.strings",
        "language" : "fi"
      },
      {
        "language" : "id",
        "target" : "Acara Kalender mungkin menyertakan data tambahan, seperti lokasi, alamat email, atau catatan.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "nl",
        "target" : "Agenda-activiteiten kunnen aanvullende gegevens bevatten, zoals locaties, e‑mailadressen of notities.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "th",
        "filename" : "Localizable.strings",
        "target" : "กิจกรรมปฏิทินอาจมีข้อมูลเพิ่มเติม เช่น ตำแหน่งที่ตั้ง ที่อยู่อีเมล หรือโน้ต"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "ro",
        "target" : "Evenimentele calendaristice pot include date suplimentare, precum localizări, adrese de e‑mail sau notițe."
      },
      {
        "language" : "hr",
        "filename" : "Localizable.strings",
        "target" : "Kalendarski događaji mogu sadržavati dodatne podatke poput lokacija, e-mail adresa ili bilješki."
      },
      {
        "filename" : "Localizable.strings",
        "language" : "hi",
        "target" : "कैलेंडर इवेंट में अतिरिक्त डेटा जैसे कि स्थान, ईमेल पते या नोट्स शामिल हो सकते हैं।"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "ca",
        "target" : "Els esdeveniments de calendari poden incloure ubicacions, adreces electròniques i notes, entre altres dades."
      }
