  "localizations" : {
    "ENABLE_ALERT_MESSAGE %@" : [
      {
        "target" : "L’app %@ vol afegir contactes en una llista pròpia. Per eliminar algun contacte que s’hagi afegit d’aquesta manera, ves a la configuració.",
        "filename" : "ContactProvider.loctable",
        "language" : "ca"
      },
      {
        "language" : "zh_HK",
        "target" : "%@想將其聯絡人加入，作為自己的列表。透過此方式加入的聯絡人可以從「設定」中移除。",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "ar",
        "target" : "يرغب تطبيق %@ في إضافة جهات اتصاله على أنها قائمته الخاصة. ستتم إزالة جهات الاتصال المضافة بهذه الطريقة من الإعدادات.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "%@ vill lägga till sina kontakter som sin egen lista. Du kan ta bort kontakter som blivit tillagda på detta sätt från Inställningar.",
        "filename" : "ContactProvider.loctable",
        "language" : "sv"
      },
      {
        "target" : "%@ vil legge til kontaktene sine i en egen liste. Kontakter som legges til på denne måten, kan fjernes fra Innstillinger.",
        "language" : "no",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "%@ would like to add its contacts as its own List. Contacts added this way can be removed from Settings.",
        "filename" : "ContactProvider.loctable",
        "language" : "en_AU"
      },
      {
        "target" : "%@ ingin menambahkan kontaknya sebagai Daftarnya sendiri. Kontak yang ditambahkan dengan cara ini dapat dihapus dari Pengaturan.",
        "filename" : "ContactProvider.loctable",
        "language" : "id"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "ru",
        "target" : "Приложение «%@» собирается добавить сохраненные в нем контакты в собственный список. Контакты, добавленные таким образом, можно удалить в Настройках."
      },
      {
        "target" : "%@ souhaite ajouter ses contacts en créant sa propre liste. Les contacts ajoutés de cette manière peuvent être supprimés dans Réglages.",
        "language" : "fr",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "pt_BR",
        "target" : "O app %@ deseja adicionar contatos em uma Lista própria. É possível remover os contatos adicionados desta forma nos Ajustes.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ would like to add its contacts as its own List. Contacts added this way can be removed from Settings.",
        "language" : "en"
      },
      {
        "language" : "cs",
        "filename" : "ContactProvider.loctable",
        "target" : "Aplikace %@ chce přidat své kontakty jako vlastní seznam. Kontakty přidané tímto způsobem lze smazat v Nastavení."
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "ro",
        "target" : "%@ ar dori să adauge contactele sale într‑o listă proprie. Contactele adăugate astfel pot fi eliminate din Configurări."
      },
      {
        "target" : "%@ अपने संपर्कों को अपनी ख़ुद की सूची के रूप में जोड़ना चाहता है। इस तरह से जोड़े गए संपर्कों को सेटिंग्ज़ से हटाया जा सकता है।",
        "filename" : "ContactProvider.loctable",
        "language" : "hi"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "ja",
        "target" : "%1$[tt]@から、%1$[tt]@の連絡先を専用のリストに追加できるようにすることを求められています。この方法で追加された連絡先は“設定”から削除できます。"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ möchte Kontakte als eigene Liste hinzufügen. Auf diese Weise hinzugefügte Kontakte können aus den Einstellungen entfernt werden.",
        "language" : "de"
      },
      {
        "target" : "%@, kişilerini kendi listesi olarak eklemek istiyor. Bu şekilde eklenen kişiler Ayarlar’da silinebilir.",
        "filename" : "ContactProvider.loctable",
        "language" : "tr"
      },
      {
        "language" : "th",
        "target" : "%[tt]@ต้องการที่จะเพิ่มรายชื่อเป็นลิสต์ของตัวเอง รายชื่อที่เพิ่มในแบบนี้สามารถเอาออกจากการตั้งค่าได้",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "pt_PT",
        "target" : "A aplicação %@ pretende adicionar os respetivos contactos numa lista própria. Os contactos que forem adicionados podem ser removidos nas Definições.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "hr",
        "filename" : "ContactProvider.loctable",
        "target" : "%@ želi dodavati svoje kontakte u vlastiti popis. Kontakti koji su dodani na ovaj način mogu se ukloniti u Postavkama."
      },
      {
        "language" : "sl",
        "target" : "Aplikacija %@ želi svoje stike dodati kot lasten seznam. Stike, dodane na ta način, lahko odstranite v Nastavitvah.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "Apka %@ chce pridať svoje kontakty ako vlastný zoznam. Takto pridané kontakty môžete odstrániť v Nastaveniach.",
        "language" : "sk"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%[tt]@想要將其聯絡人加入成個別列表。透過此方式加入的聯絡人可以從「設定」中移除。",
        "language" : "zh_TW"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "it",
        "target" : "%@ vorrebbe aggiungere i propri contatti come elenco separato. I contatti aggiunti in questo modo possono essere rimossi da Impostazioni."
      },
      {
        "language" : "zh_CN",
        "target" : "%[tt]@想要添加其联系人并单独创建列表。以此方式添加的联系人可从“设置”移除。",
        "filename" : "ContactProvider.loctable"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "es",
        "target" : "%@ quiere añadir sus contactos en una lista propia. Para eliminar los contactos que se hayan añadido así, debes ir a Ajustes."
      },
      {
        "language" : "da",
        "target" : "%@ vil tilføje sine kontakter som sin egen liste. Kontakter, der tilføjes på denne måde, kan fjernes fra Indstillinger.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "es_419",
        "target" : "%@ quiere agregar sus contactos como una lista propia. Los que se agreguen así, se pueden eliminar de Configuración.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "Програма «%@» хоче додати свої контакти окремим списком. Такі контакти можна вилучити з Параметрів.",
        "language" : "uk",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "nl",
        "target" : "%@ wil contacten toevoegen als eigen lijst. Contacten die op deze manier worden toegevoegd, kunnen worden verwijderd uit Instellingen.",
        "filename" : "ContactProvider.loctable"
      },
      {
        "language" : "fr_CA",
        "filename" : "ContactProvider.loctable",
        "target" : "%@ souhaite ajouter ses contacts dans sa propre liste. Les contacts ajoutés de la sorte peuvent être supprimés à partir de Réglages."
      },
      {
        "target" : "היישום ״⁨%@⁩״ מבקש להוסיף את אנשי הקשר שלו בתור רשימה נפרדת. ניתן להסיר אנשי קשר שנוספים בצורה זו דרך ״הגדרות״.",
        "language" : "he",
        "filename" : "ContactProvider.loctable"
      },
      {
        "target" : "Η εφαρμογή «%@» θέλει να προσθέσει τις επαφές της ως δική της λίστα. Οι επαφές που προσθέτονται με αυτόν τον τρόπο μπορούν να αφαιρεθούν από τις Ρυθμίσεις.",
        "filename" : "ContactProvider.loctable",
        "language" : "el"
      },
      {
        "target" : "%@ 앱이 자체적으로 연락처 목록을 추가하려고 합니다. 이렇게 추가된 연락처는 설정에서 제거할 수 있습니다.",
        "filename" : "ContactProvider.loctable",
        "language" : "ko"
      },
      {
        "target" : "%@ mahu menambah kenalannya sebagai Senarainya sendiri. Kenalan yang ditambahkan melalui cara ini boleh dikeluarkan daripada Seting.",
        "language" : "ms",
        "filename" : "ContactProvider.loctable"
      },
      {
        "filename" : "ContactProvider.loctable",
        "language" : "hu",
        "target" : "A(z) %@ szeretné saját listaként hozzáadni a saját kontaktjait. Az ilyen módon hozzáadott kontaktokat a Beállításokban távolíthatja el."
      },
      {
        "target" : "Aplikacja %@ chce dodać swoje kontakty na osobnej liście. Kontakty dodane w ten sposób można usunąć w Ustawieniach.",
        "filename" : "ContactProvider.loctable",
        "language" : "pl"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ haluaa lisätä yhteystietonsa omaksi listakseen. Tällä tavalla lisätyt yhteystiedot voidaan poistaa Asetuksissa.",
        "language" : "fi"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ muốn thêm các liên hệ dưới dạng Danh sách riêng. Các liên hệ được thêm theo cách này có thể được xóa từ Cài đặt.",
        "language" : "vi"
      },
      {
        "filename" : "ContactProvider.loctable",
        "target" : "%@ would like to add its contacts as its own List. Contacts added this way can be removed from Settings.",
        "language" : "en_GB"
