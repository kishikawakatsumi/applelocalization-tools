        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Tu ubicación se usa para etiquetar dónde se han tomado las fotos y vídeos, lo que mejora la búsqueda y la función de recuerdos.",
        "filename" : "InfoPlist.strings",
        "language" : "es"
      },
      {
        "target" : "Vaša lokacija se uporablja za označevanje, kje so bile fotografije in videi posneti, kar omogoča lažje iskanje fotografij in izboljša spomine.",
        "language" : "sl",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "pt_BR",
        "filename" : "InfoPlist.strings",
        "target" : "Sua localização é usada para identificar onde fotos e vídeos são feitos, o que melhora a busca de fotos e as memórias."
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "da",
        "target" : "Din lokalitet bruges til at tagge, hvor fotos og videoer blev taget. Dette forbedrer fotosøgning og minder."
      },
      {
        "filename" : "InfoPlist.strings",
