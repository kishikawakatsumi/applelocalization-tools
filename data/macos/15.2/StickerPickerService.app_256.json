    "NSCameraUsageDescription" : [
      {
        "filename" : "InfoPlist.strings",
        "target" : "„Memoji“ verwendet die Kamera, um dein Gesicht zu erfassen und die Memoji-Figuren zu animieren.",
        "language" : "de"
      },
      {
        "target" : "‏Memoji משתמש במצלמה כדי לעקוב אחר הפנים שלך ולהנפיש בובות Memoji.",
        "language" : "he",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "en_AU",
        "target" : "Memoji uses the camera to track your face and animate Memoji puppets.",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "ar",
        "filename" : "InfoPlist.strings",
        "target" : "يستخدم ميموجي الكاميرا لتتبع وجهك وتحريك دمى ميموجي."
      },
      {
        "language" : "el",
        "target" : "Το Memoji χρησιμοποιεί την κάμερα για ανίχνευση του προσώπου σας και κίνηση των φιγούρων memoji.",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "ja",
        "target" : "ミー文字では、あなたの顔を追跡してミー文字のパペットをアニメートするためにカメラを使用します。",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Memoji використовує камеру, щоб стежити за рухами вашого обличчя та анімувати образи Memoji.",
        "filename" : "InfoPlist.strings",
        "language" : "uk"
      },
      {
        "filename" : "InfoPlist.strings",
        "target" : "Los Memojis usan la cámara para reconocer tu cara y animar marionetas Memoji.",
        "language" : "es_419"
      },
      {
        "language" : "zh_CN",
        "filename" : "InfoPlist.strings",
        "target" : "拟我表情使用相机跟踪你的脸部并制作拟我表情人物动画。"
      },
      {
        "language" : "es",
        "filename" : "InfoPlist.strings",
        "target" : "Los Memojis usan la cámara para imitar el movimiento de tu cara y animar los personajes."
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "sl",
        "target" : "Funkcija Memoji uporablja kamero, da sledi vašemu obrazu in animira lutke Memoji."
      },
      {
        "target" : "Os Memojis usam a câmera para seguir os movimentos do seu rosto e animar os personagens.",
        "filename" : "InfoPlist.strings",
        "language" : "pt_BR"
      },
      {
        "language" : "da",
        "filename" : "InfoPlist.strings",
        "target" : "Memoji bruger kameraet til at registrere dit ansigt og animere Memoji-figurer."
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "it",
        "target" : "Le Memoji usano la fotocamera per il rilevamento del volto e l’animazione delle figure."
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "bg",
        "target" : "Memoji използва камерата, за да проследява вашето лице и да анимира марионетките Memoji."
      },
      {
        "target" : "Memoji používa kameru na sledovanie vašej tváre a animovanie bábok Memoji.",
        "language" : "sk",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "kk",
        "target" : "Memoji бет-әлпетіңізді қайталау және Memoji кейіпкерлерін анимациялау үшін камераны пайдаланады.",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "pt_PT",
