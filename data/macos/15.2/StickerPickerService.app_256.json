      },
      {
        "language" : "ms",
        "target" : "Memoji menggunakan kamera untuk menjejak muka anda dan menganimasikan patung Memoji.",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Memoji använder kameran till att spåra ditt ansikte och animera Memoji-dockor.",
