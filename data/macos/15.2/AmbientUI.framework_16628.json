      {
        "language" : "ar",
        "target" : "عرض الأدوات المفيدة أو عرض صورك المفضلة أو عرض الساعة المثالية. اسحب إلى اليمين أو اليسار للتبديل بينها.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "ja",
