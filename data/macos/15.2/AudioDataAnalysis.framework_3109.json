  "localizations" : {
    "MigrationAlertMessage" : [
      {
        "target" : "Die Geräuschpegel der Kopfhörer werden jetzt acht Tage gespeichert, um ggf. Mitteilungen zum Schutz deines Gehörs zu generieren. Nach acht Tagen werden die Daten gelöscht.",
        "language" : "de",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Headphone Audio Levels will now be saved for eight days to provide notifications that may protect your hearing. The data will be deleted after eight days.",
        "language" : "en_AU",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "ar",
        "target" : "سيتم الآن حفظ مستويات صوت سماعة الرأس لثمانية أيام لتقديم إشعارات قد تحمي سمعك. وسيتم حذف البيانات بعد ثمانية أيام.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "ヘッドホン音量が8日間に渡って保存され、聴覚保護のための通知を提供できるようになりました。データは8日後に削除されます。",
        "filename" : "Localizable.strings",
        "language" : "ja"
      },
      {
        "language" : "en",
        "filename" : "Localizable.strings",
        "target" : "Headphone Audio Levels will now be saved for eight days to provide notifications that may protect your hearing. The data will be deleted after eight days."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "Los niveles de audio de audífonos se guardarán durante ocho días para enviar notificaciones que podrían proteger tu audición; al acabar ese plazo, se borrarán.",
        "language" : "es_419"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "zh_CN",
        "target" : "“耳机音量”现将存储八天以提供可保护你听力的通知。八天后数据将删除。"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "El nivel de audio de los auriculares se conservará durante ocho días para así poder enviarte notificaciones que ayuden a proteger tu oído. Pasado ese tiempo, los datos se eliminarán.",
        "language" : "es"
      },
      {
        "language" : "it",
        "filename" : "Localizable.strings",
        "target" : "Per inviarti le notifiche volte a proteggere l’udito, ora i livelli audio delle cuffie verranno salvati per otto giorni. Una volta trascorso questo arco di tempo, i dati saranno eliminati."
      },
      {
        "language" : "ko",
