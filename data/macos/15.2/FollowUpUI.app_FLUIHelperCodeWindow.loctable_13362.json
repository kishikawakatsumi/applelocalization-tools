      },
      {
        "language" : "da",
        "target" : "Dit Apple-id bruges til at logge ind på en ny enhed.",
        "filename" : "FLUIHelperCodeWindow.loctable"
      },
      {
        "filename" : "FLUIHelperCodeWindow.loctable",
        "target" : "Apple ID anda sedang digunakan untuk mendaftar masuk ke peranti baharu.",
