    "5im-bq-WOS.title" : [
      {
        "language" : "ro",
        "target" : "ID‑ul dvs. Apple este utilizat pentru autentificarea pe un dispozitiv nou.",
        "filename" : "FLUIHelperCodeWindow.loctable"
      },
      {
        "target" : "Your Apple ID is being used to sign into a new device.",
        "language" : "en_AU",
        "filename" : "FLUIHelperCodeWindow.loctable"
      },
      {
        "language" : "ca",
        "filename" : "FLUIHelperCodeWindow.loctable",
        "target" : "El teu ID d’Apple s’està fent servir per iniciar sessió a un dispositiu nou"
      },
      {
        "filename" : "FLUIHelperCodeWindow.loctable",
        "target" : "Ditt Apple-ID används till att logga in på en ny enhet.",
        "language" : "sv"
      },
      {
        "language" : "fi",
        "filename" : "FLUIHelperCodeWindow.loctable",
        "target" : "Apple ID:täsi käytetään sisäänkirjautumiseen uudessa laitteessa."
      },
      {
        "target" : "사용자의 Apple ID가 새로운 기기에 로그인하기 위해 사용되고 있습니다.",
        "language" : "ko",
        "filename" : "FLUIHelperCodeWindow.loctable"
      },
      {
        "language" : "vi",
        "target" : "ID Apple của bạn đang được sử dụng để đăng nhập vào một thiết bị mới.",
        "filename" : "FLUIHelperCodeWindow.loctable"
      },
      {
        "target" : "È stato richiesto l’accesso al tuo ID Apple su un nuovo dispositivo.",
        "filename" : "FLUIHelperCodeWindow.loctable",
        "language" : "it"
      },
      {
        "language" : "pt_BR",
        "target" : "Seu ID Apple está sendo usado para iniciar a sessão em um novo dispositivo.",
