    "SYNC_PERMISSION_ALERT_MESSAGE" : [
      {
        "language" : "de",
        "target" : "„%@“ möchte Trainings zur Apple Watch hinzufügen. Die App wird dadurch auch abrufen können, ob diese Trainings abgeschlossen wurden.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "״%@״ מבקש אישור להוסיף אימונים ל-Apple Watch. היישום יוכל גם לקבל מידע לגבי השלמה או אי השלמה של אימונים אלו.",
        "language" : "he",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "en_AU",
        "target" : "“%@” would like to add workouts to Apple Watch. The app will also be able to read whether or not these workouts have been completed.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "ar",
        "target" : "يرغب \"%@\" في إضافة تمارين إلى Apple Watch. سيتمكن التطبيق أيضًا من معرفة إذا كانت هذه التمارين قد اكتملت أم لا.",
        "filename" : "Localizable.strings"
      },
      {
        "target" : "Αίτημα από «%@» για προσθήκη προπονήσεων στο Apple Watch. Η εφαρμογή θα μπορεί επίσης να ελέγχει αν αυτές οι προπονήσεις έχουν ολοκληρωθεί.",
        "language" : "el",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "ja",
        "target" : "“%@”でワークアウトをApple Watchに追加しようとしています。このアプリでこれらのワークアウトが完了したかどうかも読み込むことができます。",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "en",
        "target" : "“%@” would like to add workouts to Apple Watch. The app will also be able to read whether or not these workouts have been completed."
      },
      {
        "language" : "uk",
        "filename" : "Localizable.strings",
        "target" : "«%@» хоче додавати тренування на Apple Watch. Ця програма також знатиме, чи ці тренування було виконано."
      },
      {
        "target" : "%@ quiere agregar entrenamientos al Apple Watch. La app también podrá saber si se completan o no esos entrenamientos.",
        "language" : "es_419",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "“%@”想要将体能训练添加到Apple Watch。此App还可以读取这些体能训练是否已完成。",
        "language" : "zh_CN"
      },
      {
        "language" : "es",
        "target" : "La app %@ quiere añadir entrenos al Apple Watch y tener acceso a ellos para saber si se han completado o no.",
        "filename" : "Localizable.strings"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "»%@« želi dodajati vadbe v uro Apple Watch. Prav tako bo lahko aplikacija prebrala, ali so te vadbe dokončane ali ne.",
        "language" : "sl"
      },
      {
        "target" : "O app “%@” deseja adicionar exercícios ao Apple Watch. O app também poderá constatar se esses exercícios foram ou não concluídos.",
        "filename" : "Localizable.strings",
        "language" : "pt_BR"
      },
      {
        "filename" : "Localizable.strings",
        "target" : "“%@” vil føje træninger til Apple Watch. Appen vil også kunne aflæse, om disse træninger er blevet gennemført.",
        "language" : "da"
      },
      {
        "filename" : "Localizable.strings",
        "language" : "it",
        "target" : "%@ vorrebbe aggiungere gli allenamenti su Apple Watch. L’app potrà anche leggere se sono stati completati o meno."
      },
      {
        "filename" : "Localizable.strings",
        "target" : "„%@“ иска да добавя тренировки към Apple Watch. Приложението също така ще може да прочете дали тези тренировки са изпълнени или не.",
        "language" : "bg"
      },
      {
        "language" : "sk",
        "filename" : "Localizable.strings",
        "target" : "Apka %@ chce pridávať tréningy na Apple Watch. Zároveň bude môcť zistiť, či tieto tréningy boli alebo neboli dokončené."
      },
      {
        "target" : "«%@» Apple Watch қолданбасына жаттығуларды қосқысы келеді. Сондай‑ақ қолданба осы жаттығулардың аяқталған-аяқталмағанын оқи алады.",
        "filename" : "Localizable.strings",
        "language" : "kk"
