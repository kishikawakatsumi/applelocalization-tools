    "DEFAULT_LOCATION_SECTION_FOOTER" : [
      {
        "target" : "Wähle einen Ort aus, für den die Meeresdaten in den Zifferblattkomplikationen angezeigt werden sollen. Du kannst Orte mit der App „Gezeiten“ hinzufügen oder löschen.",
        "language" : "de",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "language" : "he",
        "target" : "באפשרותך לבחור את המיקומים שברצונך לראות את הנתונים הימיים שלהם בתצוגות של עיצוב השעון. ניתן להוסיף או למחוק מיקומים באמצעות היישום ״גאות ושפל״.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "language" : "en_AU",
        "filename" : "DefaultLocationSettings.strings",
        "target" : "Choose which location’s marine data you would like to see in watch face complications. You can add or delete locations using the Tides app."
      },
      {
        "language" : "ar",
        "target" : "اختر الموقع الذي تود عرض بياناته البحرية في إضافات واجهة الساعة. يمكنك إضافة أو حذف المواقع باستخدام تطبيق المد والجزر.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "target" : "Επιλέξτε την τοποθεσία για την οποία θέλετε να εμφανίζονται τα θαλάσσια δεδομένα στις πολυπλοκότητες της πρόσοψης ρολογιού. Μπορείτε να προσθέσετε ή να διαγράψετε τοποθεσίες χρησιμοποιώντας την εφαρμογή «Παλίρροιες».",
        "filename" : "DefaultLocationSettings.strings",
        "language" : "el"
      },
      {
        "language" : "ja",
        "target" : "文字盤のコンプリケーションに、どの場所の海洋データを表示するかを選択します。潮位アプリを使って、場所を追加したり削除したりできます。",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "target" : "Оберіть місце, для якого потрібно показувати дані про припливи й відпливи у функціях циферблата. Можна додавати й видаляти місця в програмі «Припливи».",
        "filename" : "DefaultLocationSettings.strings",
        "language" : "uk"
      },
      {
        "language" : "es_419",
        "target" : "Elige la ubicación cuyos datos sobre el mar quieres mostrar en las complicaciones de la carátula. Puedes agregar o eliminar ubicaciones mediante la app Mareas.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "target" : "选择要在表盘复杂功能中显示哪里的海洋数据。你可以使用“潮汐”App添加或删除位置。",
        "filename" : "DefaultLocationSettings.strings",
        "language" : "zh_CN"
      },
      {
        "language" : "es",
        "target" : "Selecciona de qué ubicación quieres ver la información sobre el mar en la esfera del reloj. Puedes añadir o eliminar ubicaciones en la app Mareas.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "target" : "Izberite lokacijo, za katero želite v komplikacijah na številčnici videti podatke o značilnostih morja. Lokacije lahko dodajate ali brišete v aplikaciji Plimovanje.",
        "filename" : "DefaultLocationSettings.strings",
        "language" : "sl"
      },
      {
        "language" : "pt_BR",
        "target" : "Escolha a localização da qual mostrar dados marítimos nas complicações do mostrador. Você pode adicionar ou apagar localizações no app Marés.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "target" : "Vælg, hvilken lokalitets havdata du vil se på urskivekomplikationer. Du kan tilføje og slette lokaliteter vha. appen Tidevand.",
        "filename" : "DefaultLocationSettings.strings",
        "language" : "da"
      },
      {
        "language" : "it",
        "target" : "Scegli la posizione di cui vuoi vedere i dati marittimi nelle complicazioni del quadrante. Puoi aggiungere o eliminare posizioni dall’app Marea.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "language" : "sk",
        "target" : "Vyberte, pre ktoré miesto chcete zobrazovať informácie o mori v komplikáciách na ciferníku. Miesta môžete pridávať alebo vymazávať v apke Príliv.",
        "filename" : "DefaultLocationSettings.strings"
      },
      {
        "language" : "pt_PT",
        "target" : "Escolha a localização cujos dados de marés gostaria de ver nas complicações do mostrador. Pode adicionar e apagar cidades através da aplicação Marés.",
