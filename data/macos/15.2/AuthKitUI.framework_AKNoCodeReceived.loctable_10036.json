      {
        "filename" : "AKNoCodeReceived.loctable",
        "language" : "vi",
        "target" : "Nếu bạn không nhận được mã thì bạn có thể gửi một mã khác đến một thiết bị khác được đăng nhập bằng ID Apple của bạn."
      },
      {
        "filename" : "AKNoCodeReceived.loctable",
        "target" : "Si no has recibido un código, puedes enviar otro código a otro dispositivo en el que hayas iniciado sesión con tu ID de Apple.",
        "language" : "es"
      },
      {
        "filename" : "AKNoCodeReceived.loctable",
        "target" : "Wenn du keinen Code erhalten hast, kannst du einen anderen Code an ein anderes Gerät senden, an dem du mit deiner Apple-ID angemeldet bist.",
