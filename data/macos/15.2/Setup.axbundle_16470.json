    "pairing.video.description" : [
      {
        "filename" : "Accessibility.strings",
        "language" : "de",
        "target" : "Ein Video mit Tausenden im Kreis wirbelnden, schimmernden kleinen Lichtern. Es wird zum Konfigurieren dieses iPhone verwendet wird, wenn es beim Koppeln mit dem blauen Kreis auf dem Bildschirm des anderen Geräts ausgerichtet wird."
      },
      {
        "language" : "en_AU",
        "target" : "A video of thousands of tiny shimmering lights swirling in a sphere, which is used to set up this iPhone when aligned with the blue circle on your other device's pairing screen.",
        "filename" : "Accessibility.strings"
      },
      {
        "target" : "فيديو لآلاف الأضواء المتألقة الصغيرة تحتشد في الكرة السماوية يستخدم في إقران هذا الـ iPhone عند محاذاته بالدائرة الزرقاء على شاشة الاقتران على جهازك الآخر.",
        "language" : "ar",
        "filename" : "Accessibility.strings"
      },
      {
        "language" : "ja",
        "target" : "多数の光点が渦巻き状に回転するビデオ。ほかのデバイスのペアリング画面の青い円内に収めることでこのiPhoneを設定できます。",
        "filename" : "Accessibility.strings"
      },
      {
        "target" : "A video of thousands of tiny shimmering lights swirling in a sphere, that is used to setup this iPhone when aligned with the blue circle on your other device's pairing screen.",
        "filename" : "Accessibility.strings",
        "language" : "en"
      },
