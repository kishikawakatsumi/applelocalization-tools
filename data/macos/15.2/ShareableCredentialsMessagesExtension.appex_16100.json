  "localizations" : {
    "NSContactsUsageDescription" : [
      {
        "language" : "de",
        "target" : "Dein Name und deine Zahlungsinformationen werden automatisch vorausgefüllt und du bist besser geschützt vor Betrugsfällen.",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "he",
        "target" : "הרשאת גישה זו תשמש כדי למלא מראש את שמך ואת פרטי החיוב שלך כדי לסייע במניעת הונאות.",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "en_AU",
        "filename" : "InfoPlist.strings",
        "target" : "This will be used to pre-fill your name and billing information and to help prevent fraud."
      },
      {
        "filename" : "InfoPlist.strings",
        "target" : "سيتم استخدام هذه المعلومات لإجراء التعبئة التلقائية لاسمك ولمعلومات الفوترة وللمساعدة في منع الاحتيال.",
        "language" : "ar"
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "el",
        "target" : "Η πρόσβαση θα χρησιμοποιηθεί για προσυμπλήρωση του ονόματός σας και των στοιχείων τιμολόγησης, καθώς και για αποτροπή απάτης."
      },
      {
        "language" : "ja",
        "target" : "詐欺行為を防止するために、あなたの名前と請求情報をあらかじめ入力するのにこれを使用します。",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "This will be used to prefill your name and billing information and to help prevent fraud.",
        "language" : "en",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Це використовуватиметься для автозаповнення вашого імені та платіжних даних, а також для запобігання шахрайству.",
        "filename" : "InfoPlist.strings",
        "language" : "uk"
      },
      {
        "target" : "Se utilizará para llenar los campos con tu nombre e información bancaria, y ayudar a prevenir fraudes.",
        "filename" : "InfoPlist.strings",
        "language" : "es_419"
      },
      {
        "target" : "这将用于预填写你的姓名和账单信息以及防范欺诈行为。",
        "filename" : "InfoPlist.strings",
        "language" : "zh_CN"
      },
      {
        "language" : "es",
        "target" : "Se usará para rellenar tu nombre e información de facturación, así como para ayudar a prevenir fraudes.",
        "filename" : "InfoPlist.strings"
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "sl",
        "target" : "To bo uporabljeno za vnaprejšnje izpolnjevanje vašega imena in podatkov za obračunavanje in za pomoč pri preprečevanju goljufij."
      },
      {
        "language" : "pt_BR",
        "target" : "Isso será usado para preencher o seu nome e informações de cobrança e para ajudar a impedir fraudes.",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Dette vil blive brugt til at udfylde dit navn og dine betalingsoplysninger og til at forhindre svindel.",
        "language" : "da",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "I contatti verranno utilizzati per precompilare il tuo nome e i dati di fatturazione e per prevenire le frodi.",
        "filename" : "InfoPlist.strings",
        "language" : "it"
      },
      {
        "filename" : "InfoPlist.strings",
        "language" : "bg",
        "target" : "Тези данни ще се използват за предварително попълване на вашето име и информация за фактуриране, както и за предотвратяване на измами."
      },
      {
        "language" : "sk",
        "target" : "Bude sa používať na vypĺňanie vášho mena a fakturačných údajov a ako pomoc pri predchádzaní podvodom.",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Бұл ақпарат атыңыз бен төлем туралы ақпаратты автоматты түрде толтыру және алаяқтықтың алдын алу үшін пайдаланылады.",
        "language" : "kk",
        "filename" : "InfoPlist.strings"
      },
      {
        "language" : "pt_PT",
        "target" : "Os dados serão usados para preencher o seu nome e informação de faturação e para ajudar a prevenir fraudes.",
        "filename" : "InfoPlist.strings"
      },
      {
        "target" : "Ini akan digunakan untuk mempraisi nama dan maklumat pengebilan anda serta untuk membantu mencegah penipuan.",
