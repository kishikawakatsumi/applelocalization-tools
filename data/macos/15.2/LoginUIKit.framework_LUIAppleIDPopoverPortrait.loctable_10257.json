        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "language" : "pt_PT"
      },
      {
        "language" : "sv",
        "target" : "Du kan skapa ett nytt kontolösenord genom att logga in med ditt Apple‑konto.",
        "filename" : "LUIAppleIDPopoverPortrait.loctable"
      },
      {
        "filename" : "LUIAppleIDPopoverPortrait.loctable",
        "language" : "pl",
        "target" : "Możesz wyzerować hasło konta, używając danych swojego konta Apple."
