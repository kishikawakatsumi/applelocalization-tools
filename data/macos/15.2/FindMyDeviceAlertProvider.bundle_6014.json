    "FMD_FMW_UPGRADE_ALERT_TEXT" : [
      {
        "language" : "de",
        "target" : "Mit diesem Update wird „Meine Apple Watch suchen“ aktiviert. Weitere Informationen sind in der iOS-App „iPhone-Suche“ oder auf iCloud.com erhältlich.",
        "filename" : "Localizable.strings"
      },
      {
        "language" : "he",
        "filename" : "Localizable.strings",
        "target" : "עדכון זה מפעיל את ״איתור השעון שלי״. פרטים נוספים ניתן למצוא ביישום ה-iPhone ״איתור״ ב-iOS או ב-iCloud.com."
      },
      {
        "filename" : "Localizable.strings",
        "language" : "en_AU",
        "target" : "This update enables Find My Watch. See the Find My iPhone app on iOS or iCloud.com for more information."
      },
      {
        "target" : "يؤدي هذا التحديث إلى تمكين \"العثور على الساعة\". انتقل إلى تطبيق \"العثور على iPhone\" على iOS أو iCloud.com لمزيد من المعلومات.",
        "language" : "ar",
        "filename" : "Localizable.strings"
      },
      {
